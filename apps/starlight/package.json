{
  "name": "@implementos/pos-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentación Starlight de POS Platform",
  "engines": {
    "node": ">=22.19 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "node scripts/prepare-content.mjs && astro dev --host 127.0.0.1 --port 4207",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-content.mjs",
    "typecheck": "node scripts/prepare-content.mjs && astro check",
    "check": "node scripts/check.cjs",
    "preview": "node scripts/serve.cjs",
    "sync:catalog": "node scripts/sync-monorepo-catalog.mjs"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8",
    "fontkit": "2.0.4",
    "mermaid": "12.2.0",
    "playwright": "1.59.1",
    "typescript": "5.9.3"
  }
}
