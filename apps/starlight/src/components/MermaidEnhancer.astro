<script>
  function addDiagramViewer(figure: HTMLElement, output: HTMLElement, index: number) {
    const drawing = output.querySelector('svg');
    if (!drawing) return;
    const headings = [...document.querySelectorAll('h2, h3, h4')];
    const heading = headings.filter(item => item.compareDocumentPosition(figure) & Node.DOCUMENT_POSITION_FOLLOWING).at(-1);
    const title = `Diagrama${heading?.textContent ? ` · ${heading.textContent.trim()}` : ' de arquitectura'}`;
    const id = `mermaid-viewer-${index}`;

    const controls = document.createElement('div');
    controls.className = 'mermaid-viewer-actions';
    const open = document.createElement('button');
    open.type = 'button';
    open.className = 'pos-visual-button';
    open.textContent = 'Ampliar diagrama';
    open.setAttribute('aria-haspopup', 'dialog');
    open.setAttribute('aria-controls', id);
    const download = document.createElement('a');
    download.textContent = 'Descargar SVG';
    download.download = `pos-diagrama-${index + 1}.svg`;
    download.href = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(new XMLSerializer().serializeToString(drawing))}`;
    controls.append(open, download);
    output.insertAdjacentElement('afterend', controls);

    const dialog = document.createElement('dialog');
    dialog.id = id;
    dialog.className = 'pos-diagram__dialog';
    dialog.setAttribute('aria-labelledby', `${id}-title`);
    dialog.innerHTML = '<div class="pos-diagram__toolbar"><strong></strong><button type="button" class="pos-visual-button" autofocus>Cerrar</button></div><div class="pos-diagram__zoom"><label>Escala <input type="range" min="40" max="200" step="10" value="100"></label><output>100 %</output><span>Desplázate para recorrer el diagrama.</span></div><div class="pos-diagram__canvas" tabindex="0" role="region" aria-label="Diagrama ampliado; utiliza las flechas para desplazarte"></div>';
    const titleElement = dialog.querySelector<HTMLElement>('strong')!;
    titleElement.id = `${id}-title`;
    titleElement.textContent = title;
    const canvas = dialog.querySelector<HTMLElement>('.pos-diagram__canvas')!;
    const zoom = dialog.querySelector<HTMLInputElement>('input')!;
    const zoomLabel = dialog.querySelector<HTMLOutputElement>('output')!;
    const close = dialog.querySelector<HTMLButtonElement>('button')!;
    figure.append(dialog);

    open.addEventListener('click', () => {
      // Keep only one copy: Mermaid markers and accessible IDs remain unique.
      output.style.minHeight = `${output.getBoundingClientRect().height}px`;
      canvas.append(drawing);
      zoom.value = '100';
      zoomLabel.textContent = '100 %';
      canvas.style.setProperty('--diagram-scale', '1');
      dialog.showModal();
      canvas.scrollTo({ top: 0, left: 0 });
    });
    zoom.addEventListener('input', () => {
      canvas.style.setProperty('--diagram-scale', String(Number(zoom.value) / 100));
      zoomLabel.textContent = `${zoom.value} %`;
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      output.append(drawing);
      output.style.removeProperty('min-height');
      open.focus({ preventScroll: true });
    });
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
  }

  const figures = [...document.querySelectorAll<HTMLElement>('[data-mermaid-figure]')];
  if (figures.length) {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: 'base',
      themeVariables: { primaryColor: '#edf3ff', primaryTextColor: '#17213a', primaryBorderColor: '#0545ba', lineColor: '#526480', fontFamily: 'system-ui, sans-serif' },
      flowchart: { htmlLabels: false, useMaxWidth: true }, sequence: { useMaxWidth: true },
    });
    for (const [index, figure] of figures.entries()) {
      const source = figure.querySelector('[data-mermaid-source]')?.textContent || '';
      const output = figure.querySelector<HTMLElement>('.mermaid-output');
      const status = figure.querySelector<HTMLElement>('.mermaid-status');
      if (!output) continue;
      try {
        const { svg } = await mermaid.render(`pos-diagram-${index}`, source);
        output.innerHTML = svg;
        figure.dataset.rendered = 'true';
        if (status) status.hidden = true;
        addDiagramViewer(figure, output, index);
      } catch {
        if (status) status.textContent = 'La definición del diagrama está disponible debajo.';
        figure.querySelector('details')?.setAttribute('open', '');
      }
    }
  }
</script>
