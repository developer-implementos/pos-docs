---
import { flows } from './flows';
interface Props {
  scenario: 'sale' | 'pricing';
  title?: string;
}
const { scenario, title } = Astro.props;
const flow = flows[scenario];
const first = flow.steps[0];
const labelId = `flow-${scenario}`;
---

<pos-flow-player data-flow={JSON.stringify(flow)}>
  <section class="pos-flow" aria-labelledby={labelId}>
    <header class="pos-flow__header">
      <span class="pos-flow__eyebrow">Recorrido de la propuesta</span>
      <h2 id={labelId}>{title ?? flow.title}</h2>
      <p>{flow.description}</p>
    </header>
    <ol class="pos-flow__nodes" aria-label="Participantes y estado actual">
      {flow.nodes.map((node, index) => (
        <li class="pos-flow__node" data-state={first.nodes[index].state}>
          <span class="pos-flow__node-number" aria-hidden="true">{index + 1}</span>
          <strong>{node.title}</strong>
          <span class="pos-flow__node-detail">{node.detail}</span>
          <span class="pos-flow__node-status" data-node-status>{first.nodes[index].status}</span>
        </li>
      ))}
    </ol>
    <div class="pos-flow__route" data-flow-route data-moving={Boolean(first.route)}>
      <span class="pos-flow__packet" aria-hidden="true"></span>
      <span data-flow-route-label>{first.route ?? 'Sin intercambio entre participantes en este paso.'}</span>
    </div>
    <div class="pos-flow__step" aria-live="polite" aria-atomic="true">
      <div class="pos-flow__step-heading">
        <span class="pos-flow__counter" data-flow-counter>Paso 1 de {flow.steps.length}</span>
        <h3 data-flow-title>{first.title}</h3>
      </div>
      <p data-flow-description>{first.description}</p>
      <div class="pos-flow__outcomes">
        <div class="pos-flow__outcome pos-flow__outcome--confirmed"><strong>Confirmado hasta aquí</strong><p data-flow-confirmed>{first.confirmed}</p></div>
        <div class="pos-flow__outcome pos-flow__outcome--pending"><strong>Pendiente o condicionado</strong><p data-flow-pending>{first.pending}</p></div>
      </div>
      <pre class="pos-flow__code" aria-label="Pseudocódigo ilustrativo"><code data-flow-code>{first.code}</code></pre>
      <span class="pos-flow__code-label">Pseudocódigo · expresa el contrato, no una implementación ejecutable.</span>
    </div>
    <div class="pos-flow__controls" aria-label="Controles del recorrido">
      <button type="button" class="pos-visual-button" data-flow-action="previous" disabled>Anterior</button>
      <button type="button" class="pos-visual-button pos-visual-button--primary" data-flow-action="play" aria-pressed="false">Reproducir</button>
      <button type="button" class="pos-visual-button" data-flow-action="next">Siguiente</button>
      <button type="button" class="pos-visual-button pos-flow__reset" data-flow-action="reset">Reiniciar</button>
    </div>
    <label class="pos-flow__seek">Paso
      <input type="range" data-flow-seek min="1" max={flow.steps.length} value="1" step="1" aria-label="Ir a un paso del recorrido" aria-valuetext={`1 de ${flow.steps.length}: ${first.title}`} />
    </label>
    <p class="pos-flow__boundary">{flow.boundary}</p>
    <noscript><p>Activa JavaScript para recorrer los pasos de esta simulación. El diagrama y la explicación de esta página también describen el flujo completo.</p></noscript>
  </section>
</pos-flow-player>

<script>
  import type { FlowScenario } from './flows';

  class PosFlowPlayer extends HTMLElement {
    private timer: ReturnType<typeof setInterval> | undefined;
    private aborter: AbortController | undefined;
    private playing = false;

    connectedCallback() {
      if (this.aborter) return;
      this.aborter = new AbortController();
      const { signal } = this.aborter;
      let flow: FlowScenario;
      try { flow = JSON.parse(this.dataset.flow ?? ''); } catch { return; }
      let index = 0;
      const play = this.querySelector<HTMLButtonElement>('[data-flow-action="play"]');
      const previous = this.querySelector<HTMLButtonElement>('[data-flow-action="previous"]');
      const next = this.querySelector<HTMLButtonElement>('[data-flow-action="next"]');
      const seek = this.querySelector<HTMLInputElement>('[data-flow-seek]');
      const route = this.querySelector<HTMLElement>('[data-flow-route]');
      const nodes = Array.from(this.querySelectorAll<HTMLElement>('.pos-flow__node'));
      if (!play || !previous || !next || !seek || !route) return;

      const text = (key: string, value: string) => {
        const element = this.querySelector(`[data-flow-${key}]`);
        if (element) element.textContent = value;
      };
      const pause = () => {
        this.playing = false;
        clearInterval(this.timer);
        this.timer = undefined;
        play.textContent = 'Reproducir';
        play.setAttribute('aria-pressed', 'false');
        this.dataset.playing = 'false';
      };
      const render = () => {
        const step = flow.steps[index];
        text('title', step.title);
        text('description', step.description);
        text('confirmed', step.confirmed);
        text('pending', step.pending);
        text('code', step.code);
        text('counter', `Paso ${index + 1} de ${flow.steps.length}`);
        text('route-label', step.route ?? 'Sin intercambio entre participantes en este paso.');
        route.dataset.moving = String(Boolean(step.route));
        seek.value = String(index + 1);
        seek.setAttribute('aria-valuetext', `${index + 1} de ${flow.steps.length}: ${step.title}`);
        previous.disabled = index === 0;
        next.disabled = index === flow.steps.length - 1;
        nodes.forEach((node, nodeIndex) => {
          node.dataset.state = step.nodes[nodeIndex].state;
          const status = node.querySelector('[data-node-status]');
          if (status) status.textContent = step.nodes[nodeIndex].status;
        });
        if (index === flow.steps.length - 1) pause();
      };
      this.addEventListener('click', (event) => {
        const target = event.target as Element;
        const action = target.closest<HTMLElement>('[data-flow-action]')?.dataset.flowAction;
        if (!action) return;
        if (action === 'play') {
          if (this.playing) { pause(); return; }
          if (index === flow.steps.length - 1) { index = 0; render(); }
          this.playing = true;
          this.dataset.playing = 'true';
          play.textContent = 'Pausar';
          play.setAttribute('aria-pressed', 'true');
          this.timer = setInterval(() => { index = Math.min(index + 1, flow.steps.length - 1); render(); }, 12000);
          return;
        }
        pause();
        if (action === 'previous') index = Math.max(0, index - 1);
        if (action === 'next') index = Math.min(flow.steps.length - 1, index + 1);
        if (action === 'reset') index = 0;
        render();
      }, { signal });
      seek.addEventListener('input', () => { pause(); index = Number(seek.value) - 1; render(); }, { signal });
      document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); }, { signal });
      render();
    }

    disconnectedCallback() {
      clearInterval(this.timer);
      this.timer = undefined;
      this.playing = false;
      this.aborter?.abort();
      this.aborter = undefined;
    }
  }
  if (!customElements.get('pos-flow-player')) customElements.define('pos-flow-player', PosFlowPlayer);
</script>
