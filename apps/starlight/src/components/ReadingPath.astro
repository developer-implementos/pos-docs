---
import {readingPath, generatedPages, siteBase} from '../../content-map.mjs';
---
<ol class="reading-path">
  {readingPath.map(entry => <li>
    <a href={`${siteBase}${entry.route}/`}>{entry.title}</a>
    <p>{generatedPages.find(page => page.route === entry.route)?.description || 'Responsabilidades, una venta completa y estado de la propuesta.'}</p>
  </li>)}
</ol>
<style>
  .reading-path { padding-inline-start: 1.5rem; }
  .reading-path li { padding-inline-start: .4rem; margin-block: 1rem; }
  .reading-path p { margin-block: .25rem 0; color: var(--sl-color-gray-2); font-size: .925rem; }
</style>
