---
import catalog from '../data/legacy-endpoints.json';

interface Props { app: 'backend' | 'backend-concentrador' }
const { app } = Astro.props;
const entries = catalog.applications[app];
const groups = [...new Set(entries.map(entry => entry.group))];
const methods = [...new Set(entries.map(entry => entry.method))];
const sourceBase = `${catalog.repository}/blob/${catalog.commit}/`;
const groupId = (group: string) => 'capability-' + group.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-$/, '');
const statusLabels: Record<string, string> = {
  implemented: 'Método presente · no ejecutado',
  empty: 'Método vacío',
  missing: 'Método ausente',
  render: 'Vista renderizada',
};
---

<pos-endpoint-catalog>
  <h2>Buscar una operación</h2>
  <div class="endpoint-filters" data-pagefind-ignore hidden>
    <label>Buscar endpoint
      <input type="search" data-endpoint-query placeholder="Ruta, descripción o controlador" autocomplete="off" />
    </label>
    <label>Método
      <select data-endpoint-method>
        <option value="">Todos</option>
        {methods.map(method => <option value={method}>{method === 'ON' ? 'Vista (Route.on)' : method}</option>)}
      </select>
    </label>
    <label>Funcionalidad
      <select data-endpoint-group>
        <option value="">Todas</option>
        {groups.map(group => <option value={group}>{group}</option>)}
      </select>
    </label>
  </div>
  <p class="endpoint-counter" role="status" aria-live="polite" aria-atomic="true" data-endpoint-count data-pagefind-ignore>{entries.length} rutas documentadas</p>
  <p data-endpoint-empty hidden>No hay coincidencias. Prueba con otra palabra o selecciona todos los métodos y funcionalidades.</p>
  <details class="endpoint-overview">
    <summary>Áreas funcionales y responsabilidades ({groups.length})</summary>
    <p>Estas áreas agrupan las rutas para encontrarlas; no representan servicios desplegados ni módulos independientes. Los conteos incluyen las vistas auxiliares, identificadas por separado.</p>
    <table>
      <thead><tr><th>Área</th><th>Responsabilidad</th><th>Rutas</th></tr></thead>
      <tbody>{groups.map(group => <tr>
        <td><a href={`#${groupId(group)}`}>{group}</a></td>
        <td>{catalog.groupDescriptions[group as keyof typeof catalog.groupDescriptions]}</td>
        <td>{entries.filter(entry => entry.group === group).length}</td>
      </tr>)}</tbody>
    </table>
  </details>
  {app === 'backend' && <details class="endpoint-responsibilities">
    <summary>Correspondencia con el resumen de responsabilidades</summary>
    <p>El resumen funcional y este catálogo describen la misma API. Una responsabilidad puede abarcar más de un área; las rutas completas aparecen una sola vez debajo.</p>
    <table><thead><tr><th>Responsabilidad</th><th>Áreas del catálogo</th></tr></thead><tbody>
      {catalog.responsibilities.map(responsibility => <tr><td>{responsibility.name}</td><td>
        {responsibility.groups.map((group, index) => <>{index > 0 && ' · '}<a href={`#${groupId(group)}`}>{group}</a></>)}
      </td></tr>)}
    </tbody></table>
  </details>}
  {groups.map(group => (
    <section class="endpoint-group" data-endpoint-section>
      <h2 id={groupId(group)}>{group}</h2>
      {entries.filter(entry => entry.group === group).map(entry => (
        <article class="endpoint-entry" id={entry.id} data-endpoint-entry data-method={entry.method} data-group={group}>
          <h3>
            <span class="endpoint-method">{entry.method === 'ON' ? 'VISTA' : entry.method}</span>
            <a href={`#${entry.id}`} aria-label={`${entry.method === 'ON' ? 'Vista' : entry.method} ${entry.path}`}><code>{entry.path}</code></a>
          </h3>
          <p class="endpoint-description">{entry.description}</p>
          {entry.notes && <p class="endpoint-note">{entry.notes}</p>}
          <p class="endpoint-meta" data-pagefind-ignore>
            <span class:list={{ 'endpoint-incomplete': ['empty', 'missing'].includes(entry.handlerStatus) }}>{statusLabels[entry.handlerStatus]}</span>
            <span>{entry.scope === 'auth group' ? 'Grupo con auth' : 'Sin auth declarado en la ruta'}</span>
          </p>
          <details class="endpoint-source" data-pagefind-ignore>
            <summary>Ver implementación y declaración</summary>
            <p><code>{entry.target}</code></p>
            <p>
              <a href={`${sourceBase}${app}/start/routes.js#L${entry.line}`}>Declaración de la ruta</a>
              {entry.handlerFile && entry.handlerLine && <> · <a href={`${sourceBase}${entry.handlerFile}#L${entry.handlerLine}`}>Método del controlador</a></>}
            </p>
          </details>
        </article>
      ))}
    </section>
  ))}
</pos-endpoint-catalog>

<script>
  class EndpointCatalog extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const query = this.querySelector<HTMLInputElement>('[data-endpoint-query]');
      const method = this.querySelector<HTMLSelectElement>('[data-endpoint-method]');
      const group = this.querySelector<HTMLSelectElement>('[data-endpoint-group]');
      const counter = this.querySelector<HTMLElement>('[data-endpoint-count]');
      const empty = this.querySelector<HTMLElement>('[data-endpoint-empty]');
      const controls = this.querySelector<HTMLElement>('.endpoint-filters');
      if (!query || !method || !group || !counter || !empty || !controls) return;
      this.dataset.ready = 'true';
      controls.hidden = false;
      const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const entries = [...this.querySelectorAll<HTMLElement>('[data-endpoint-entry]')].map(element => ({ element, text: normalize(element.textContent || '') }));
      const sections = [...this.querySelectorAll<HTMLElement>('[data-endpoint-section]')];
      const filter = () => {
        const terms = normalize(query.value).trim().split(/\s+/).filter(Boolean);
        let count = 0;
        for (const { element, text } of entries) {
          const visible = (!method.value || element.dataset.method === method.value)
            && (!group.value || element.dataset.group === group.value)
            && terms.every(term => text.includes(term));
          element.hidden = !visible;
          if (visible) count++;
        }
        for (const section of sections) section.hidden = !section.querySelector('[data-endpoint-entry]:not([hidden])');
        counter.textContent = `${count} de ${entries.length} rutas`;
        empty.hidden = count !== 0;
      };
      query.addEventListener('input', filter);
      method.addEventListener('change', filter);
      group.addEventListener('change', filter);
      this.querySelectorAll<HTMLAnchorElement>('a[href^="#capability-"]').forEach(link => link.addEventListener('click', () => {
        query.value = ''; method.value = ''; group.value = ''; filter();
      }));
    }
  }
  if (!customElements.get('pos-endpoint-catalog')) customElements.define('pos-endpoint-catalog', EndpointCatalog);
</script>

<style>
  pos-endpoint-catalog { display: block; }
  pos-endpoint-catalog [hidden] { display: none !important; }
  .endpoint-filters { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.5fr); gap: 1rem; margin-block: 1.5rem .5rem; }
  .endpoint-filters label { display: grid; align-content: start; gap: .35rem; margin: 0; font-size: .875rem; font-weight: 600; }
  .endpoint-filters :is(input, select) { width: 100%; min-width: 0; min-height: 44px; margin: 0; padding: .6rem .7rem; border: 1px solid var(--sl-color-gray-4); border-radius: .4rem; font: inherit; font-weight: 400; color: var(--sl-color-white); background: var(--sl-color-bg); }
  .endpoint-filters input::placeholder { color: var(--sl-color-gray-3); }
  .endpoint-counter { color: var(--sl-color-gray-2); font-size: .875rem; }
  .endpoint-group { margin-block: 2rem; }
  .endpoint-entry { border-bottom: 1px solid var(--sl-color-gray-5); padding-block: 1.3rem; margin: 0; scroll-margin-top: 6rem; }
  .endpoint-entry h3 { display: flex; align-items: baseline; flex-wrap: wrap; gap: .5rem .8rem; padding: 0; margin: 0; font-size: 1rem; }
  .endpoint-entry h3 a { min-width: 0; margin: 0; overflow-wrap: anywhere; }
  .endpoint-entry h3 code { padding: 0; color: inherit; background: transparent; font-size: .95rem; white-space: normal; overflow-wrap: anywhere; }
  .endpoint-method { padding: .1rem .5rem; border-radius: .3rem; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); font-family: var(--sl-font-mono); font-size: .75rem; font-weight: 700; }
  .endpoint-description { margin-block: .7rem .5rem; }
  .endpoint-note { margin-block: .5rem; padding-inline-start: .8rem; border-inline-start: 3px solid var(--sl-color-gray-4); font-size: .925rem; }
  .endpoint-meta { display: flex; flex-wrap: wrap; gap: .25rem 1.2rem; margin-block: .7rem; color: var(--sl-color-gray-2); font-size: .8rem; }
  .endpoint-meta span { margin: 0; }
  .endpoint-incomplete { color: var(--sl-color-white); font-weight: 700; }
  .endpoint-source { margin-top: .7rem; font-size: .8rem; }
  .endpoint-source summary { width: fit-content; min-height: 44px; display: flex; align-items: center; gap: .5rem; cursor: pointer; color: var(--sl-color-text-accent); font-weight: 600; }
  .endpoint-source p { margin: .4rem 0; overflow-wrap: anywhere; }
  @media (max-width: 40rem) { .endpoint-filters { grid-template-columns: 1fr; gap: .75rem; } }
  @media print { .endpoint-filters, .endpoint-counter { display: none; } }
</style>
