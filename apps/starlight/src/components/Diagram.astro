---
interface Props {
  src: string; alt: string; title?: string; caption?: string; sourceHref?: string;
  interactiveHref?: string; downloadHref?: string; width?: number; height?: number;
}
const { src, alt, caption, sourceHref, interactiveHref, downloadHref = src,
  title = caption?.split(' · ')[0] || 'Diagrama de arquitectura', width = 1600, height = 1000 } = Astro.props;
const labelId = `diagram-${crypto.randomUUID()}`;
const Preview = interactiveHref ? 'a' : 'button';
---
<pos-diagram>
  <figure class="pos-diagram">
    <Preview type={interactiveHref ? undefined : 'button'} href={interactiveHref} class="pos-diagram__preview"
      data-diagram-open={interactiveHref ? undefined : ''} data-diagram-explore={interactiveHref ? '' : undefined}
      aria-label={`${interactiveHref ? 'Explorar' : 'Ampliar'}: ${title}`} aria-haspopup={interactiveHref ? undefined : 'dialog'}>
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      <span class="pos-diagram__expand" aria-hidden="true">{interactiveHref ? 'Explorar arquitectura' : 'Ampliar diagrama'}</span>
    </Preview>
    <figcaption>
      {caption && <span class="pos-diagram__caption">{caption}</span>}
      <span class="pos-diagram__links">
        <a href={downloadHref} download>Descargar SVG{interactiveHref ? ' completo' : ''}</a>
        {sourceHref && <a href={sourceHref} download>Archivo editable</a>}
      </span>
    </figcaption>
  </figure>
  {!interactiveHref && <dialog class="pos-diagram__dialog" aria-labelledby={labelId}>
    <div class="pos-diagram__toolbar">
      <strong id={labelId}>{title}</strong>
      <button type="button" class="pos-visual-button" data-diagram-close autofocus>Cerrar</button>
    </div>
    <div class="pos-diagram__zoom">
      <button type="button" class="pos-visual-button" data-diagram-fit aria-pressed="true">Ajustar</button>
      <button type="button" class="pos-visual-button" data-diagram-actual aria-pressed="false">Tamaño real</button>
      <label><span class="sr-only">Escala del diagrama</span><input type="range" data-diagram-scale min="1" max="200" step="1" value="100" /></label>
      <output data-diagram-scale-label aria-live="off">100 %</output>
    </div>
    <div class="pos-diagram__canvas" tabindex="0" role="region" aria-label="Diagrama ampliado. Flechas para desplazarse, más y menos para ampliar, cero para ajustar.">
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" draggable="false" />
    </div>
  </dialog>}
</pos-diagram>
<script>
  import { bindDiagramViewport } from '../scripts/diagram-viewport';
  class PosDiagram extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      const openButton = this.querySelector<HTMLButtonElement>('[data-diagram-open]');
      const drawing = dialog?.querySelector<HTMLImageElement>('.pos-diagram__canvas img');
      if (!dialog || !openButton || !drawing || this.cleanup) return;
      this.cleanup = bindDiagramViewport({ dialog, openButton, drawing });
    }
    disconnectedCallback() { this.cleanup?.(); this.cleanup = undefined; }
  }
  if (!customElements.get('pos-diagram')) customElements.define('pos-diagram', PosDiagram);
</script>
