---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  sourceHref?: string;
  width?: number;
  height?: number;
}

const { src, alt, caption, sourceHref, width = 1600, height = 1000 } = Astro.props;
const labelId = `diagram-${crypto.randomUUID()}`;
---

<pos-diagram>
  <figure class="pos-diagram">
    <button type="button" class="pos-diagram__preview" data-diagram-open aria-label={`Ampliar: ${alt}`} aria-haspopup="dialog">
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      <span class="pos-diagram__expand" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5M3 3l6 6m12-6-6 6M3 21l6-6m12 6-6-6" /></svg>
        Ampliar diagrama
      </span>
    </button>
    <figcaption>
      {caption && <span class="pos-diagram__caption">{caption}</span>}
      <span class="pos-diagram__links">
        <a href={src} target="_blank" rel="noopener">Abrir imagen</a>
        <a href={src} download>Descargar imagen</a>
        {sourceHref && <a href={sourceHref} download>Archivo editable</a>}
      </span>
    </figcaption>
  </figure>
  <dialog class="pos-diagram__dialog" aria-labelledby={labelId}>
    <div class="pos-diagram__toolbar">
      <strong id={labelId}>{alt}</strong>
      <button type="button" class="pos-visual-button" data-diagram-close autofocus>Cerrar</button>
    </div>
    <div class="pos-diagram__zoom">
      <label>Escala <input type="range" data-diagram-scale min="40" max="200" step="10" value="100" /></label>
      <output data-diagram-scale-label>100 %</output>
      <span>Desplázate para recorrer el diagrama.</span>
    </div>
    <div class="pos-diagram__canvas" tabindex="0" role="region" aria-label="Diagrama ampliado; utiliza las flechas para desplazarte">
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </div>
    <div class="pos-diagram__dialog-links">
      <a href={src} download>Descargar imagen</a>
      {sourceHref && <a href={sourceHref} download>Descargar editable</a>}
    </div>
  </dialog>
</pos-diagram>

<script>
  class PosDiagram extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const dialog = this.querySelector<HTMLDialogElement>('dialog');
      const openButton = this.querySelector<HTMLButtonElement>('[data-diagram-open]');
      const closeButton = this.querySelector<HTMLButtonElement>('[data-diagram-close]');
      const scale = this.querySelector<HTMLInputElement>('[data-diagram-scale]');
      const scaleLabel = this.querySelector<HTMLOutputElement>('[data-diagram-scale-label]');
      const canvas = this.querySelector<HTMLElement>('.pos-diagram__canvas');
      if (!dialog || !openButton || !closeButton || !scale || !scaleLabel || !canvas) return;

      openButton.addEventListener('click', () => {
        dialog.showModal();
        scale.value = '100';
        canvas.style.setProperty('--diagram-scale', '1');
        scaleLabel.textContent = '100 %';
        canvas.scrollTo({ top: 0, left: 0 });
      });
      closeButton.addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => openButton.focus({ preventScroll: true }));
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
      });
      scale.addEventListener('input', () => {
        canvas.style.setProperty('--diagram-scale', String(Number(scale.value) / 100));
        scaleLabel.textContent = `${scale.value} %`;
      });
    }
  }
  if (!customElements.get('pos-diagram')) customElements.define('pos-diagram', PosDiagram);
</script>
