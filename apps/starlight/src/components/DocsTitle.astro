---
import { searchProfile } from '../../search-profile.mjs';
const profile = searchProfile(Astro.locals.starlightRoute.entry.id);
---
<h1 id="_top" data-pagefind-weight={profile.titleWeight}>{Astro.locals.starlightRoute.entry.data.title}</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
