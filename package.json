{
  "name": "pos-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentación técnica y presentaciones de POS Platform",
  "engines": { "node": ">=22.19 <23 || >=24 <25" },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "setup": "npm --prefix apps/starlight ci",
    "dev": "npm --prefix apps/starlight run dev",
    "validate": "npm --prefix apps/starlight run validate",
    "typecheck": "npm --prefix apps/starlight run typecheck",
    "build": "npm --prefix apps/starlight run build",
    "check": "npm --prefix apps/starlight run check",
    "preview": "npm --prefix apps/starlight run preview",
    "verify": "npm run portal:test && npm run presentations:test && npm run architecture:test && npm run validate && npm run typecheck && npm run build && npm run check && npm run architecture:check && npm run presentations:check && npm run roadmap:check && npm run portal:check && npm run viewer:check",
    "sync:catalog": "npm --prefix apps/starlight run sync:catalog",
    "evidence:capture": "node tools/capture-product-evidence.mjs",
    "progress:sync": "node tools/sync-project-progress.mjs",
    "progress:test": "node --test portal/progress.test.mjs portal/progress-view.test.mjs tools/sync-project-progress.test.mjs",
    "presentations:build": "node presentations/tools/build.mjs",
    "architecture:build": "node tools/architecture/build.mjs",
    "architecture:check": "node tools/architecture/check.mjs",
    "architecture:test": "node --test tools/architecture/model.test.mjs",
    "presentations:test": "node --test presentations/tools/diagrams.test.mjs presentations/tools/navigation.test.mjs presentations/tools/source-text.test.mjs tools/roadmap.test.mjs",
    "presentations:check": "node presentations/tools/check.mjs",
    "roadmap:check": "node tools/check-roadmap.mjs",
    "portal:test": "node --test portal/catalog.test.mjs portal/previews.test.mjs portal/progress.test.mjs portal/progress-view.test.mjs tools/sync-project-progress.test.mjs",
    "portal:build": "node portal/build.mjs",
    "portal:check": "node portal/check.mjs",
    "viewer:check": "node portal/viewer.check.mjs",
    "materials:previews": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/generate-material-previews.ps1"
  }
}
