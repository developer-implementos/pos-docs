{
  "name": "pos-docs",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Documentación técnica y presentaciones de POS Platform",
  "engines": {
    "node": ">=22.19 <23 || >=24 <25"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "local-ci:test": "node --test tools/local-ci/*.test.mjs",
    "skills:check": "node tools/agent-skills/sync.mjs --check",
    "skills:sync": "node tools/agent-skills/sync.mjs --write",
    "skills:test": "node --test tools/agent-skills/sync.test.mjs",
    "setup": "npm --prefix apps/starlight ci",
    "dev": "npm --prefix apps/starlight run dev",
    "validate": "npm --prefix apps/starlight run validate",
    "typecheck": "npm --prefix apps/starlight run typecheck",
    "build": "npm --prefix apps/starlight run build",
    "check": "npm --prefix apps/starlight run check",
    "preview": "npm --prefix apps/starlight run preview",
    "verify": "npm run local-ci:test && npm run odd:test && npm run odd:check && npm run governance:test && npm run release:test && npm run release:check && npm run project-import:test && npm run review:test && npm run review:check && npm run skills:test && npm run skills:check && npm run editorial:check && npm run editorial:test && npm run portal:test && npm run presentations:test && npm run architecture:test && npm run diagrams:test && npm run validate && npm run typecheck && npm run build && npm run check && npm run architecture:check && npm run presentations:check && npm run roadmap:check && npm run portal:check && npm run viewer:check && npm run reference:test && npm run explore:test && npm run reference:check && npm run explore:check && npm run follow-up:check && npm run project:check",
    "sync:catalog": "npm --prefix apps/starlight run sync:catalog",
    "evidence:capture": "node tools/capture-product-evidence.mjs",
    "progress:sync": "node tools/sync-project-progress.mjs",
    "progress:test": "node --test portal/progress.test.mjs tools/sync-project-progress.test.mjs",
    "presentations:build": "node presentations/tools/build.mjs",
    "architecture:build": "node tools/architecture/build.mjs",
    "architecture:check": "node tools/architecture/check.mjs",
    "architecture:test": "node --test tools/architecture/model.test.mjs tools/architecture/lifecycles.test.mjs",
    "diagrams:test": "node --test tools/diagrams/selective-generation.test.mjs tools/diagrams/route-layout.test.mjs tools/diagrams/package-freshness.test.mjs",
    "diagrams:test:integration": "node --test tools/diagrams/selective-generation.integration.test.mjs",
    "presentations:test": "node --test presentations/tools/diagrams.test.mjs presentations/tools/navigation.test.mjs presentations/tools/source-text.test.mjs tools/roadmap.test.mjs",
    "presentations:check": "node presentations/tools/check.mjs",
    "roadmap:check": "node tools/check-roadmap.mjs",
    "portal:test": "node --test portal/changelog.test.mjs portal/catalog.test.mjs portal/previews.test.mjs portal/progress.test.mjs tools/sync-project-progress.test.mjs portal/follow-up.test.mjs tools/sync-project-follow-up.test.mjs portal/project.test.mjs portal/project-view.test.mjs portal/render.test.mjs portal/planning.test.mjs tools/sync-project-planning.test.mjs portal/questions.test.mjs tools/sync-project-questions.test.mjs portal/rules.test.mjs tools/sync-project-rules.test.mjs && npm --prefix apps/starlight run test:search",
    "portal:build": "node portal/build.mjs",
    "portal:check": "node portal/check.mjs",
    "viewer:check": "node portal/viewer.check.mjs",
    "materials:previews": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/generate-material-previews.ps1",
    "reference:sync": "node tools/product-reference/sync.mjs",
    "reference:test": "node --test tools/product-reference/bundle.test.mjs apps/starlight/scripts/prepare-content.test.mjs apps/starlight/scripts/editorial-reviews.test.mjs apps/starlight/scripts/navigation.test.mjs tools/capture-product-evidence.test.mjs",
    "reference:check": "node tools/product-reference/check.mjs",
    "explore:build": "node tools/archify/build.mjs && node tools/product-reference/explore-index.mjs",
    "explore:test": "node --test tools/archify/*.test.mjs",
    "explore:check": "node tools/archify/check.mjs",
    "follow-up:sync": "node tools/sync-project-follow-up.mjs",
    "follow-up:test": "node --test portal/follow-up.test.mjs tools/sync-project-follow-up.test.mjs",
    "follow-up:check": "node portal/follow-up.check.mjs",
    "project:test": "node --test portal/project.test.mjs portal/project-view.test.mjs portal/render.test.mjs",
    "project:check": "node portal/project.check.mjs",
    "planning:sync": "node tools/sync-project-planning.mjs",
    "planning:test": "node --test portal/planning.test.mjs tools/sync-project-planning.test.mjs",
    "questions:sync": "node tools/sync-project-questions.mjs",
    "questions:test": "node --test portal/questions.test.mjs tools/sync-project-questions.test.mjs",
    "rules:sync": "node tools/sync-project-rules.mjs",
    "rules:test": "node --test portal/rules.test.mjs tools/sync-project-rules.test.mjs",
    "editorial:test": "node --test tools/editorial/*.test.mjs",
    "editorial:check": "node tools/editorial/check.mjs",
    "editorial:pr-check": "node tools/editorial/pr-check.mjs",
    "odd:test": "node --test tools/odd/*.test.mjs",
    "odd:check": "node tools/odd/check.mjs --check && node tools/odd/upstream.mjs --check && node tools/odd/distribute.mjs --check",
    "governance:test": "node --test tools/repository-governance.test.mjs tools/git-isolation.test.mjs",
    "release:test": "node --test tools/release/*.test.mjs",
    "release:check": "node tools/release/check.mjs",
    "release:entries": "node tools/release/snapshot-changes.mjs",
    "project-import:test": "node --test tools/project-import/*.test.mjs",
    "review:test": "node --test tools/automated-review/review.test.mjs",
    "review:check": "node tools/automated-review/distribute.mjs --check"
  }
}
