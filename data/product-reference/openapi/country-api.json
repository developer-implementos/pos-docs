                        "aggregateType": "sale",
                        "contractVersion": 1,
                        "eventId": "10000000-0000-4000-8000-000000000070",
                        "eventType": "SaleConfirmed",
                        "occurredAt": "2026-11-18T12:00:00.000Z",
                        "payload": {
                          "aggregateId": "10000000-0000-4000-8000-000000000071",
                          "aggregateVersion": 1,
                          "contractVersion": 1,
                          "eventId": "10000000-0000-4000-8000-000000000070",
                          "eventType": "SaleConfirmed",
                          "occurredAt": "2026-11-18T12:00:00.000Z",
                          "payload": {
                            "currency": "CLP",
                            "currencyScale": 0,
                            "paymentId": "10000000-0000-4000-8000-000000000072",
                            "quoteId": "10000000-0000-4000-8000-000000000074",
                            "saleId": "10000000-0000-4000-8000-000000000071",
                            "shiftId": "10000000-0000-4000-8000-000000000073",
                            "total": "11900"
                          },
                          "scope": {
                            "branchId": "10000000-0000-4000-8000-000000000002",
                            "countryId": "CL",
                            "installationId": "10000000-0000-4000-8000-000000000005",
                            "legalEntityId": "10000000-0000-4000-8000-000000000001",
                            "registerId": "10000000-0000-4000-8000-000000000003"
                          }
                        },
                        "payloadHash": "4276358c038116a13506bd492e1c88bf2f6f03ad7a2bfcf88bfbd8ede3e4ab8a",
                        "sequence": 1
                      }
                    ],
                    "origin": {
                      "branchId": "10000000-0000-4000-8000-000000000002",
                      "countryId": "CL",
                      "installationId": "10000000-0000-4000-8000-000000000081"
                    }
                  }
                }
              },
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "batchId": {
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "type": "string"
                  },
                  "contractVersion": {
                    "const": 1,
                    "type": "number"
                  },
                  "events": {
                    "items": {
                      "additionalProperties": true,
                      "description": "Evento DeliverEvents v1: eventId, eventType, contractVersion, aggregateType, aggregateId, sequence, occurredAt, payload y payloadHash. Un evento que no cumple su contrato vuelve como invalid sin rechazar el lote.",
                      "properties": {
                        "eventId": {
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "eventId"
                      ],
                      "type": "object"
                    },
                    "maxItems": 100,
                    "minItems": 1,
                    "type": "array"
                  },
                  "origin": {
                    "additionalProperties": false,
                    "properties": {
                      "branchId": {
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                        "type": "string"
                      },
                      "countryId": {
                        "maxLength": 100,
                        "minLength": 1,
                        "type": "string"
                      },
                      "installationId": {
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "countryId",
                      "branchId",
                      "installationId"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "contractVersion",
                  "batchId",
                  "origin",
                  "events"
                ],
                "type": "object"
              }
            }
