{
  "components": {
    "headers": {
      "CorrelationId": {
        "description": "Identificador de correlación generado por el servidor; hoy coincide con x-request-id.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RequestId": {
        "description": "Identificador de la solicitud generado por el servidor; es la referencia ante soporte.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Segundos que conviene esperar antes de reintentar, cuando la API los indica.",
        "required": false,
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "schemas": {},
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "Sesión opaca caducable; no es un JWT.",
        "scheme": "bearer",
        "type": "http"
      },
      "device": {
        "bearerFormat": "JWT",
        "description": "Credencial privada de instalación del host de periféricos; no acepta sesiones de operador.",
        "scheme": "bearer",
        "type": "http"
      },
      "workload": {
        "bearerFormat": "JWT",
        "description": "Credencial de carga de trabajo de una sucursal, provisional hasta la identidad de F03-06; no acepta sesiones de operador.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Identidad técnica, verificación de PostgreSQL de país y recepción durable de los lotes DeliverEvents de las sucursales. Recibir un evento no lo aplica ni lo integra con el ERP; no hay maestros ni integración ERP.",
    "title": "POS Platform · API de País",
    "version": "1.0.0"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.1.0",
  "paths": {
    "/api/v1": {
      "get": {
        "description": "Identifica el servicio y la versión de API disponible para el cliente.",
        "operationId": "countryGetInfo",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "apiVersion": {
                      "const": "1",
                      "description": "Versión de la API.",
                      "type": "string"
                    },
                    "mode": {
                      "const": "foundation",
                      "description": "Base de API, sin operaciones de negocio ni integraciones conectadas.",
                      "type": "string"
                    },
                    "service": {
                      "const": "country-api",
                      "description": "Identificador del servicio.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "service",
                    "apiVersion",
                    "mode"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Información de la API disponible.",
            "headers": {
              "x-correlation-id": {
                "$ref": "#/components/headers/CorrelationId"
              },
              "x-request-id": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          }
        },
        "summary": "Obtener información del servicio de país",
        "tags": [
          "Plataforma"
        ]
      }
    },
    "/api/v1/sync/deliveries": {
      "post": {
        "description": "Recibe el lote DeliverEvents v1 que envía el worker de sincronización de una sucursal autenticada con su credencial de carga de trabajo, provisional hasta F03-06; sin credencial configurada la recepción responde `UNAUTHORIZED`. El origen declarado debe ser el autenticado, o la respuesta es `SCOPE_MISMATCH`. Un lote que no cumple el sobre (más de 100 eventos, más de 512 KiB, `eventId` repetidos o ausentes) se rechaza completo con `VALIDATION_ERROR`. Cada evento recibe un resultado después del COMMIT del inbox: `accepted` (guardado ahora con su trabajo pendiente), `duplicate` (ya recibido con el mismo hash), `conflict` (`eventId` o posición del agregado ya ocupados por otro contenido), `invalid` (no cumple su contrato) o `retryable` (falta la secuencia anterior o la base no está disponible). Un evento inválido no rechaza a los demás. Recibir un evento no lo aplica ni lo integra con el ERP.",
        "operationId": "deliverEventsV1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "oneSale": {
                  "summary": "Lote de una sucursal con una venta confirmada",
