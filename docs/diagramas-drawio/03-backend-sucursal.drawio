          <mxGeometry x="0" y="0" width="1394.351953" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3271-0-title" value="Un monolito modular, un proceso" parent="group-notes-3271-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="366.870117" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3271-0-body" value="Los bloques interiores llaman código TypeScript. No hay HTTP ni bases separadas entre módulos. UI valida experiencia; el backend&#10;valida permisos, integridad, turno y capacidades antes de mutar negocio." parent="group-notes-3271-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1290.136719" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-3271-1-bg" value="" parent="group-notes-3271-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1394.351953" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3271-1-title" value="Transacción y efectos externos" parent="group-notes-3271-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="345.068359" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3271-1-body" value="Intención de pago durable antes de invocar el proveedor; resultado y confirmación local después. Venta + auditoría + outbox se confirman&#10;juntas. Venta, pago, fiscalidad y ERP conservan estados separados y recuperación explícita." parent="group-notes-3271-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1344.073242" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-3271-2-bg" value="" parent="group-notes-3271-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1394.351953" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3271-2-title" value="Precios y caja son dominios diferentes" parent="group-notes-3271-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="426.599121" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3271-2-body" value="La cotización fija versión inmutable y revalida vigencia antes de cobrar. Turno de caja no equivale a sesión de acceso. Devoluciones y&#10;compensaciones son nuevas operaciones auditables; no reescritura de historia." parent="group-notes-3271-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1306.49707" height="55" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3493.985645" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-0-bg" value="" parent="group-notes-3569-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-0-title" value="pos-desktop" parent="group-notes-3569-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="136.193848" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-0-body" value="Contenedor · Angular (frontend) · Tauri (shell nativa)&#10;&#10;apps/pos-desktop entrega la aplicación completa: la shell nativa Tauri aloja el frontend Angular. Tiene&#10;arranque, configuración nativa y build propios. Comparte con pos-mobile libs/client-shell: raíz,&#10;configuración, rutas, guards y layout Angular; esta biblioteca no es la shell nativa ni un proceso&#10;adicional. Solicita capacidades de dispositivos a branch-api; no transporta trabajos a device-agent ni&#10;necesita mantenerse abierto para que éste opere. Distribución e integración nativa requieren&#10;homologación; no posee autoridad de ventas. F02 instala device-agent y su journal en el mismo&#10;puesto Windows; son procesos independientes. El perfil dedicado sólo recibe trabajos asignados a&#10;ese puesto.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos&#10;dependientes." parent="group-notes-3569-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="986.12207" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-1-bg" value="" parent="group-notes-3569-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-1-title" value="pos-mobile" parent="group-notes-3569-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="122.277832" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-1-body" value="Contenedor · Angular (frontend) · Capacitor (shell nativa)&#10;&#10;apps/pos-mobile entrega la aplicación completa: la shell nativa Capacitor aloja el frontend Angular.&#10;Tiene arranque, configuración nativa y build propios. Comparte con pos-desktop libs/client-shell: raíz,&#10;configuración, rutas, guards y layout Angular; esta biblioteca no es la shell nativa ni un proceso&#10;adicional. Los adaptadores actuales son mock. Instalación, ciclo de vida, almacenamiento y&#10;capacidades nativas requieren pruebas Android/iOS; no hay acceso SQL ni permisos implícitos por&#10;empaquetar la interfaz. El acceso móvil a periféricos compartidos se habilita en F06 tras&#10;homologación y asignación explícita. Solicita capacidades a branch-api; no usa por defecto el agente&#10;dedicado a otro puesto ni depende de pos-desktop como relé.&#10;&#10;AUTORIDAD · Comparte interfaz y contratos; no otra autoridad de ventas.&#10;&#10;CONTINUIDAD · Requiere conexión autorizada al backend de sucursal. El móvil no incorpora&#10;autonomía sin LAN." parent="group-notes-3569-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="984.811523" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-2-bg" value="" parent="group-notes-3569-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-2-title" value="device-agent" parent="group-notes-3569-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="143.151855" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-2-body" value="Contenedor · C# / .NET · Windows&#10;&#10;apps/device-agent implementa el host .NET 10/SQLite y protocolo durable integrado en el corte&#10;parcial F02; el driver físico está no disponible. El perfil inicial es el mismo puesto Windows que&#10;pos-desktop, con proceso independiente y HTTPS saliente hacia branch-api. Conserva recepción,&#10;intento y evidencia; consume un permiso de ejecución de un uso antes del efecto y no repite un&#10;trabajo al restaurar SQLite. La interoperabilidad real no homologa instalación, SDK ni hardware. F05&#10;valida el perfil dedicado. F06 incorpora impresoras de recibos y etiquetas en red y una estación&#10;compartida certificada, con la misma aplicación y contratos de propiedad; no habilita&#10;automáticamente MICR, cajón, pagos ni acceso móvil a cualquier caja. El servidor de sucursal no&#10;aloja el agente por defecto. Spool aceptado no acredita impresión física.&#10;&#10;AUTORIDAD · F02: agente dedicado al puesto y sus dispositivos; branch-api autoriza sólo trabajos&#10;del puesto asignado. F06 amplía a una estación compartida homologada con un único controlador por&#10;dispositivo físico.&#10;&#10;CONTINUIDAD · Sin LAN no obtiene trabajos nuevos. Conserva evidencia del trabajo en curso para&#10;reanudar su reporte; un resultado incierto no autoriza repetir el efecto." parent="group-notes-3569-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="995.542969" height="495" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-3-bg" value="" parent="group-notes-3569-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-3-title" value="API de comandos" parent="group-notes-3569-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="197.338867" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-3-body" value="Componente · Controllers NestJS / Fastify&#10;&#10;Autentica el puesto, valida esquema, propaga commandId y contexto de usuario/sucursal, aplica&#10;límites y entrega un resultado inequívoco o pendiente.&#10;&#10;AUTORIDAD · Contrato del backend; no escribe tablas por fuera de los casos de uso.&#10;&#10;CONTINUIDAD · API local por LAN; rechaza comandos cuando falta una capacidad requerida." parent="group-notes-3569-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="940.446289" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-4-bg" value="" parent="group-notes-3569-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-4-title" value="Acceso y administración" parent="group-notes-3569-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="269.555664" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-4-body" value="Componente · libs/backend/administration&#10;&#10;Compone autorización y configuración operativa por usuario, sucursal y país. La identidad de usuario&#10;y puesto se comprueba en servidor; el menú no es frontera de autorización. Las reglas offline,&#10;revocación y aprobaciones requieren implementación y acuerdo.&#10;&#10;AUTORIDAD · Permisos y evidencia de sesión según política local autorizada.&#10;&#10;CONTINUIDAD · La vigencia offline y revocación requieren política expresa; no acceso indefinido." parent="group-notes-3569-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="986.916992" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-5-bg" value="" parent="group-notes-3569-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-5-title" value="Ventas y devoluciones" parent="group-notes-3569-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="248.779297" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-5-body" value="Componente · libs/backend/sales + returns&#10;&#10;Fija versión de precios al preparar la venta, registra intención y resultado de pagos y documentos;&#10;compensaciones y devoluciones son nuevas operaciones auditables.&#10;&#10;AUTORIDAD · Escritor de ventas y devoluciones; conserva referencias, versiones y estados.&#10;&#10;CONTINUIDAD · Permite solo operaciones soportadas por datos, límites y política vigentes." parent="group-notes-3569-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="955.077148" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-6-bg" value="" parent="group-notes-3569-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-6-title" value="Catálogo, precios y ofertas" parent="group-notes-3569-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="297.375488" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-6-body" value="Componente · libs/backend/pricing + catalog&#10;&#10;Lee una versión completa validada e inmutable. Los deltas construyen una nueva candidata aislada a&#10;partir de la versión base; nunca parchean la activa. La cotización conserva versión, origen y reglas&#10;para explicar su cálculo; fijarla no prolonga su vigencia. Antes de iniciar el pago se revalida y, si la&#10;política exige recalcular, se confirma el importe revisado. Una actualización no altera el importe,&#10;identidad ni referencia de un pago iniciado o incierto.&#10;&#10;AUTORIDAD · Lector del espejo PostgreSQL; no redefine el maestro corporativo.&#10;&#10;CONTINUIDAD · No depende de una consulta de precio remoto para las ventas offline autorizadas." parent="group-notes-3569-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="990.666016" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-7-bg" value="" parent="group-notes-3569-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-7-title" value="Caja, cobranzas y anticipos" parent="group-notes-3569-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="305.712891" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-7-body" value="Componente · libs/backend/cash + collections&#10;&#10;Los módulos cash y collections conservan límites distintos dentro del mismo proceso. Gestionan&#10;apertura/cierre y movimientos de caja, además de cobranzas y anticipos habilitados. Turno de caja,&#10;sesión de acceso, saldo, abono y depósito no son equivalentes. Cada efecto conserva identidad,&#10;autorización y auditoría; no se consume crédito global offline sin política explícita.&#10;&#10;AUTORIDAD · Libro de movimientos y turnos de sucursal, con autorización y auditoría.&#10;&#10;CONTINUIDAD · Opera localmente; excepciones y límites requieren una política aprobada." parent="group-notes-3569-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="968.913086" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-8-bg" value="" parent="group-notes-3569-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-8-title" value="Pagos y dispositivos" parent="group-notes-3569-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="226.501465" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-8-body" value="Componente · libs/backend/payments + devices&#10;&#10;Payments conserva intentos y estados financieros; devices autoriza trabajos por capacidad, equipo y&#10;agente, con jobId y hash del contenido, y procesa evidencia técnica. device-agent inicia HTTPS&#10;autenticado para obtener trabajos y reportar resultados. F02/F05: pos-desktop solicita a branch-api&#10;operaciones para su puesto dedicado. La estación compartida y el acceso móvil a periféricos son&#10;expansión F06 sujeta a homologación. No mantiene una transacción PostgreSQL abierta al esperar al&#10;hardware o proveedor. Pagos por SDK local son una capacidad futura por homologar, independiente&#10;de la impresión; API remota y SDK no se ejecutan simultáneamente para un mismo intento.&#10;&#10;AUTORIDAD · Conserva identidad de intento y referencia del proveedor; no inventa resultado.&#10;&#10;CONTINUIDAD · Si el proveedor no responde: pendiente/desconocido, consulta o resolución&#10;operativa." parent="group-notes-3569-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="995.489258" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-9-bg" value="" parent="group-notes-3569-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-9-title" value="Fiscalidad y adaptadores" parent="group-notes-3569-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="277.941895" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-9-body" value="Componente · libs/backend/fiscal&#10;&#10;Separa confirmación de venta de validez fiscal. Un timeout fiscal mantiene la referencia original y la&#10;incertidumbre hasta consultar o conciliar.&#10;&#10;AUTORIDAD · Conserva identidad del documento y estados de emisión/aceptación/transmisión.&#10;&#10;CONTINUIDAD · Solo modalidades legal y técnicamente habilitadas; falta de capacidad bloquea esa&#10;acción." parent="group-notes-3569-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="981.986328" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-10-bg" value="" parent="group-notes-3569-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-10-title" value="Reportes y seguimiento" parent="group-notes-3569-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="262.634277" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-10-body" value="Componente · libs/backend/reporting&#10;&#10;Compone lecturas autorizadas de sales, payments, fiscal y devices sin sustituir su autoridad. Un&#10;expediente conserva evidencia de apertura, motivo, responsable, versión e historial. Abrir, asignar y&#10;registrar una conclusión requieren permisos explícitos; la versión evita sobrescribir cambios de otro&#10;operador. Cerrar el seguimiento no confirma un pago, no libera reservas ni ejecuta emisiones o&#10;impresiones. Esta ficha describe la responsabilidad propuesta; el corte F02 enlaza implementación y&#10;evidencia verificadas.&#10;&#10;AUTORIDAD · Es propietario de los expedientes de seguimiento y su historial durable. Consulta&#10;estados mediante contratos de sus contextos propietarios; no escribe dinero, ventas, documentos&#10;fiscales ni trabajos de dispositivos.&#10;&#10;CONTINUIDAD · Consulta evidencia persistida en sucursal y conserva el seguimiento autorizado con&#10;PostgreSQL disponible. Una respuesta perdida se recupera con el comando original; no se repite un&#10;efecto financiero." parent="group-notes-3569-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="988.001953" height="440" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-11-bg" value="" parent="group-notes-3569-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-11-title" value="Persistencia transaccional" parent="group-notes-3569-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="290.41748" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-11-body" value="Componente · Repositorios + contrato outbox (sync)&#10;&#10;Confirma negocio, auditoría y contrato outbox de libs/backend/sync en la misma transacción de&#10;PostgreSQL de sucursal. Cada módulo conserva propiedad de sus datos. No engloba llamadas a&#10;proveedores ni ERP. Los logs de Pino no sustituyen la auditoría persistida en este commit.&#10;&#10;AUTORIDAD · Un commit sobre PostgreSQL de sucursal; restricciones e idempotencia de comandos.&#10;&#10;CONTINUIDAD · La operación no se confirma si el commit falla. Falta de disco exige política de&#10;bloqueo." parent="group-notes-3569-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="994.887695" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-12-bg" value="" parent="group-notes-3569-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-12-title" value="Base técnica compartida" parent="group-notes-3569-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="273.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-12-body" value="Componente · shared/backend · composición objetivo&#10;&#10;Composición de bootstrap, config, http/worker, health y observability. Pino registra diagnóstico&#10;estructurado; Sentry es opt-in y requiere filtrado. El objetivo organizacional es libs/shared/backend; la&#10;evidencia del producto identifica la base actualmente implementada. No se presume un proyecto Nx&#10;por subcarpeta.&#10;&#10;AUTORIDAD · Mecanismos de proceso: configuración validada, errores y correlación. No contiene&#10;reglas monetarias ni auditoría de negocio.&#10;&#10;CONTINUIDAD · Falla cerrada ante configuración inválida. La ausencia de telemetría no altera el&#10;resultado de negocio." parent="group-notes-3569-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="986.874023" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-13-bg" value="" parent="group-notes-3569-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-13-title" value="Datos de sucursal" parent="group-notes-3569-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-13-body" value="Contenedor de datos · PostgreSQL&#10;&#10;branch-api y branch-sync-worker acceden al mismo PostgreSQL de la sucursal con&#10;responsabilidades y permisos distintos. Ventas, caja, pagos y evidencia fiscal se conservan aquí.&#10;devices es propietario de los trabajos autorizados, su auditoría y las observaciones de periféricos&#10;recibidas del agente; estos registros conservan identidad y referencia al documento, sin formar parte&#10;de la misma transacción de confirmación de venta. El journal SQLite privado del agente sólo registra&#10;ejecución técnica. Inbox, outbox, cursores y staging tienen restricciones y transacciones según cada&#10;operación. Las llamadas de red quedan fuera de esas transacciones. Catálogo, precios y&#10;promociones son réplicas de lectura autorizadas, no maestros independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API escribe negocio; worker&#10;escribe su esquema técnico y publica espejos por un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica respaldo, alta disponibilidad ni&#10;recuperación automática." parent="group-notes-3569-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="980.750977" height="440" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-14-bg" value="" parent="group-notes-3569-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-14-title" value="Proveedor de pagos" parent="group-notes-3569-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-14-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Autoriza o informa el resultado del pago. Transbank con terminal local en Chile y Niubiz en Perú&#10;proceden de las fuentes revisadas. Mercado Pago Point es un ejemplo presencial ilustrativo, sin&#10;adopción ni integración acreditadas; Webpay Plus es un ejemplo de pago online de Transbank,&#10;distinto de su terminal de tienda. En España se informan BBVA/Redsys con TPV portátiles sin&#10;conexión a Gira y conciliación contable; no se presume una API o SDK ya integrado. Cada ruta y&#10;capacidad requiere homologación. Pago, venta, documento fiscal e integración ERP tienen estados&#10;distintos. No repetir un cargo incierto ni cambiar de proveedor para resolverlo automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra intento, referencia y&#10;resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout puede dejar resultado&#10;desconocido." parent="group-notes-3569-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="969.836914" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-15-bg" value="" parent="group-notes-3569-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1039.763965" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-15-title" value="Proveedor de facturación" parent="group-notes-3569-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="279.333496" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3569-15-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Acepta/Ingydev aparecen en el código legacy chileno y EFACT en las fuentes de Perú. Gira se&#10;informa como solución de España; su modalidad fiscal, interfaces y capacidades deben confirmarse.&#10;Estos ejemplos no seleccionan un proveedor corporativo ni acreditan adaptadores homologados para&#10;POS Platform. SII y SUNAT son autoridades tributarias, no estos proveedores de software; en&#10;España corresponde la autoridad del régimen y territorio aplicables. Emisión, aceptación y&#10;transmisión se modelan por separado. No se inventa un proveedor común ni una capacidad de&#10;consulta o idempotencia no acreditada.&#10;&#10;AUTORIDAD · La solución prepara, emite o transmite documentos por cuenta del contribuyente&#10;según su contrato. La autoridad tributaria es distinta: SII en Chile, SUNAT en Perú y la autoridad&#10;aplicable en España.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se promete&#10;universalmente." parent="group-notes-3569-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="989.398438" height="440" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5814.485645" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5880.485645" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. F01: operación local persistida. F02: host .NET/SQLite y protocolo integrados en un corte parcial; drivers físicos pendientes. F05: piloto por puesto. F06: red y estación compartida por homologar, sin autoridad de ventas. Sincronización e integración siguen propuestas. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5949.485645" width="3811.96582" height="67.5" as="geometry" />
        </mxCell>
