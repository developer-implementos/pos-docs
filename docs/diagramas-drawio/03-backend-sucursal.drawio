        <mxCell id="legend-desc" value="Flecha: iniciador → destino; texto: propósito y protocolo. Conector discontinuo: expansión F06. Borde discontinuo: límite o condición indicada." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=19;align=left;verticalAlign=top;">
