        </mxCell>
        <mxCell id="reading-title" value="Contratos que gobiernan esta vista" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3724.4" width="496.3125" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3788-0-bg" value="" parent="group-notes-3788-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1000.406641" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3788-0-title" value="BullMQ y Redis en la red ERP" parent="group-notes-3788-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="334.851074" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3788-0-body" value="Librería elegida dentro de erp-worker; Redis de trabajos propio en la red ERP. Admite jobs&#10;técnicos, preparación y consultas de conciliación con límites de concurrencia. Reclama por&#10;HTTPS al iniciar ejecución y reconstruye pendientes desde país. JobId y lock técnico no&#10;sustituyen el lease de negocio. Implementación pendiente." parent="group-notes-3788-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="886.552734" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-3788-1-bg" value="" parent="group-notes-3788-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1000.406641" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3788-1-title" value="Fachada, ACL y adaptador" parent="group-notes-3788-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="298.803711" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3788-1-body" value="Son componentes dentro de apps/erp-worker y libs/backend/erp. La fachada expresa&#10;capacidades POS; la ACL traduce identidades, unidades, estados y errores; cada adaptador&#10;resuelve el protocolo AX, custom o Gira que se homologue." parent="group-notes-3788-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="901.344727" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3788-2-bg" value="" parent="group-notes-3788-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1000.406641" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3788-2-title" value="Resultado incierto y conciliación" parent="group-notes-3788-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="355.737305" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3788-2-body" value="Persistir identidad de operación y evidencia antes de reintentar. Si el ERP pudo aplicar, consultar&#10;o conciliar; no repetir a ciegas ni prometer exactly-once. country-api conserva trabajo y&#10;resultados; el worker no abre SQL hacia la base de país." parent="group-notes-3788-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="945.333984" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4066.65" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-0-bg" value="" parent="group-notes-4142-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="714.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-0-title" value="country-api" parent="group-notes-4142-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="123.669434" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-0-body" value="Contenedor · NestJS + Fastify / Node.js · BullMQ&#10;&#10;apps/country-api autentica el ámbito país/entidad/sucursal. Confirma&#10;inbox, proyección operativa y outbox en un único commit antes del&#10;ACK de aplicación. Expone trabajo y resultados al erp-worker mediante&#10;HTTPS saliente iniciado por ese worker. Valida, publica y sirve&#10;versiones preparadas mediante MasterDataSourcePort en erp-worker;&#10;no ejecuta la ACL ni carga masiva pesada en un endpoint. La caché&#10;opcional acelera lecturas reconstruibles, con PostgreSQL como fuente&#10;durable. BullMQ es la librería elegida dentro del mismo proceso para&#10;programar publicaciones y ejecutar tareas breves fuera de HTTP. Usa&#10;Redis de trabajos exclusivo de país; PostgreSQL conserva solicitudes,&#10;calendario, outbox y resultados para reconstruir jobs. La preparación&#10;pesada se ejecuta en erp-worker. La decisión está adoptada; su&#10;integración todavía no está implementada.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y&#10;outbox juntos antes del ACK de aplicación. Conserva autoridad de&#10;versiones, manifiestos y publicación de maestros.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su&#10;caída genera atraso de sincronización." parent="group-notes-4142-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="695.814453" height="605" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-1-bg" value="" parent="group-notes-4142-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="714.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-1-title" value="Admisión y ejecución ERP" parent="group-notes-4142-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="293.188477" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-1-body" value="Componente · libs/backend/erp + worker&#10;&#10;El consumidor BullMQ solicita o renueva el claim por HTTPS cuando&#10;dispone de capacidad de ejecución; no retiene leases de negocio en&#10;una cola larga. Aplica límites por contrato y destino, preserva identidad&#10;y versión, y no ejecuta fuera del lease autorizado. Un job reentregado&#10;consulta el estado durable y la evidencia antes de actuar; no repite un&#10;efecto financiero incierto.&#10;&#10;AUTORIDAD · Respeta lease, identidad, destino y versión fijados al&#10;crear el intento.&#10;&#10;CONTINUIDAD · Backoff y ventanas limitan reintentos; lease expirado&#10;no autoriza duplicar un efecto incierto." parent="group-notes-4142-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="690.9375" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-2-bg" value="" parent="group-notes-4142-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="714.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-2-title" value="Cliente de country-api" parent="group-notes-4142-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="243.188477" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-2-body" value="Componente · HTTPS autenticado · contrato POS&#10;&#10;Solicita trabajo, renueva leases cuando el contrato lo permite, obtiene&#10;estado y reporta resultados a country-api. Un resultado no confirmado&#10;permanece incierto hasta consultar o reconciliar; no fabrica otra&#10;operación.&#10;&#10;AUTORIDAD · Inicia conexiones salientes; no abre SQL remoto ni una&#10;API entrante obligatoria.&#10;&#10;CONTINUIDAD · Reconecta con la misma identidad; un reporte sin&#10;acuse se reentrega o consulta." parent="group-notes-4142-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="688.037109" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-3-bg" value="" parent="group-notes-4142-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="714.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-3-title" value="Extracción de maestros" parent="group-notes-4142-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="261.218262" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-3-body" value="Componente · MasterDataSourcePort · TypeScript&#10;&#10;Obtiene snapshot o deltas con corte consistente desde la fuente&#10;autorizada del país, prepara porciones y solicita claim, upload y finalize&#10;a country-api mediante el cliente HTTPS. La autoridad de publicación&#10;permanece en país. Acceso de red y capacidades de la fuente deben&#10;homologarse.&#10;&#10;AUTORIDAD · erp-worker compone un adaptador de fuente con&#10;identidad, claims y presupuesto aislados de las operaciones&#10;financieras.&#10;&#10;CONTINUIDAD · Sin origen homologado, claim válido o corte íntegro&#10;no finaliza la publicación. Reintenta porciones identificadas sin SQL&#10;WAN." parent="group-notes-4142-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="693.375977" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-4-bg" value="" parent="group-notes-4142-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-4-title" value="Fachada de integración POS" parent="group-notes-4142-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="321.032715" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-4-body" value="Componente · libs/backend/erp · TypeScript&#10;&#10;Recibe la operación y el contexto persistidos. Encapsula emisión,&#10;consulta y conciliación bajo contratos del POS; delega traducción y&#10;protocolo sin compartir detalles del ERP con ventas o caja.&#10;&#10;AUTORIDAD · Contrato canónico desacoplado de tablas,&#10;identificadores y SDK del ERP.&#10;&#10;CONTINUIDAD · Declara capacidades y resultados permitidos por&#10;integración; no promete equivalencias inexistentes." parent="group-notes-4142-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="654.263672" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-5-bg" value="" parent="group-notes-4142-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-5-title" value="ACL por país y contrato" parent="group-notes-4142-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="262.634277" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-5-body" value="Componente · libs/backend/erp · TypeScript&#10;&#10;Traduce modelos POS a modelos ERP y viceversa: identificadores,&#10;documentos, moneda, unidades, impuestos, estados y errores. AX,&#10;custom y Gira requieren contratos propios; compartir fachada no vuelve&#10;intercambiables sus capacidades.&#10;&#10;AUTORIDAD · Mapeos versionados, destino fijo y referencias de&#10;correlación; no reglas monetarias inventadas.&#10;&#10;CONTINUIDAD · Una traducción incompatible se rechaza con&#10;evidencia; no cambia silenciosamente de país ni ERP." parent="group-notes-4142-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="698.231445" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-6-bg" value="" parent="group-notes-4142-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-6-title" value="Adaptadores AX / custom / Gira" parent="group-notes-4142-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="351.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-6-body" value="Componente · Protocolo de cada ERP por homologar&#10;&#10;Chile usa AX on-premise; no se presupone API Dynamics 365. Perú&#10;custom y España Gira tienen interfaces por relevar. REST, WCF, SDK o&#10;acceso permitido se encapsulan según evidencia; no se habilita SQL&#10;directo desde sucursales o clientes.&#10;&#10;AUTORIDAD · Usa el destino y las credenciales del entorno autorizado;&#10;registra referencias técnicas.&#10;&#10;CONTINUIDAD · Timeout o respuesta perdida no equivale a rechazo;&#10;consulta cuando la capacidad exista." parent="group-notes-4142-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="700.261719" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-7-bg" value="" parent="group-notes-4142-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-7-title" value="Resultado y conciliación" parent="group-notes-4142-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="268.200684" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-7-body" value="Componente · libs/backend/erp · TypeScript&#10;&#10;Clasifica respuestas y errores. Si el resultado es incierto, mantiene&#10;identidad y consulta/conciliación según capacidad homologada; una&#10;intervención operativa conserva evidencia. Entrega el resultado al&#10;cliente de country-api para persistirlo.&#10;&#10;AUTORIDAD · Preserva intento y referencia del ERP al registrar el&#10;resultado en país.&#10;&#10;CONTINUIDAD · No repite automáticamente un efecto financiero de&#10;resultado desconocido." parent="group-notes-4142-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="665.177734" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-8-bg" value="" parent="group-notes-4142-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="631.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-8-title" value="Base técnica compartida" parent="group-notes-4142-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="273.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-8-body" value="Componente · shared/backend · composición objetivo&#10;&#10;Composición de bootstrap, config, http/worker, health y observability.&#10;Pino registra diagnóstico estructurado; Sentry es opt-in y requiere&#10;filtrado. El objetivo organizacional es libs/shared/backend; la evidencia&#10;del producto identifica la base actualmente implementada. No se&#10;presume un proyecto Nx por subcarpeta.&#10;&#10;AUTORIDAD · Mecanismos de proceso: configuración validada, errores&#10;y correlación. No contiene reglas monetarias ni auditoría de negocio.&#10;&#10;CONTINUIDAD · Falla cerrada ante configuración inválida. La ausencia&#10;de telemetría no altera el resultado de negocio." parent="group-notes-4142-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="700.21875" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-9-bg" value="" parent="group-notes-4142-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="631.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-9-title" value="ERP del país" parent="group-notes-4142-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-9-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú&#10;son antecedentes; versión, interfaces y capacidades deben&#10;confirmarse. No se afirma que exista el adaptador objetivo en&#10;producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la&#10;base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no&#10;revierte una venta local confirmada." parent="group-notes-4142-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="688.413086" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-10-bg" value="" parent="group-notes-4142-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="631.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-10-title" value="Fuentes de maestros y precios" parent="group-notes-4142-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-10-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener responsable,&#10;contrato, versión y vigencia. La fuente de precios no se sustituye por&#10;una tabla editada libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no se asigna al&#10;ERP por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la&#10;política autorizada." parent="group-notes-4142-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="688.509766" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-11-bg" value="" parent="group-notes-4142-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="631.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-11-title" value="Ejecución de trabajos técnicos" parent="group-notes-4142-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="337.695312" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-11-body" value="Componente · BullMQ · librería Node.js&#10;&#10;Librería elegida, aún no implementada. Programa&#10;extracción/preparación de maestros, consultas de conciliación y tareas&#10;técnicas con backoff, jitter, límites de intentos y cierre controlado. El&#10;consumidor reclama el trabajo durable al iniciar la ejecución; el lock&#10;BullMQ y el lease de negocio cumplen funciones distintas.&#10;Reconciliación por HTTPS reconstruye jobs desde&#10;solicitudes/resultados de país. La deduplicación por jobId reduce&#10;reentregas técnicas, pero las restricciones de negocio y las&#10;capacidades homologadas del ERP resuelven efectos inciertos.&#10;&#10;AUTORIDAD · Componente interno de erp-worker. Separa&#10;concurrencia y presupuesto de preparación masiva y tareas&#10;financieras; Redis está dentro de la red ERP.&#10;&#10;CONTINUIDAD · Sin país no obtiene autorización nueva. Una&#10;reentrega o un job stalled conserva identidad y exige consultar el&#10;estado antes de repetir efectos externos." parent="group-notes-4142-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="689.691406" height="522.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-12-bg" value="" parent="group-notes-4142-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="744.30498" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-12-title" value="Redis · trabajos de ERP" parent="group-notes-4142-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="268.17627" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4142-12-body" value="Contenedor de datos · Redis dedicado · BullMQ&#10;&#10;Dependencia obligatoria de la arquitectura elegida, aún no&#10;implementada. BullMQ almacena colas, retrasos y metadatos técnicos&#10;en esta instancia con noeviction y persistencia operada. Límites&#10;separados para preparación masiva y operaciones/consultas de&#10;conciliación. La recuperación usa country-api por HTTPS; no abre&#10;Redis ni PostgreSQL a través de WAN. El job técnico no sustituye el&#10;lease de negocio ni el resultado ERP y nunca habilita reenviar&#10;ciegamente una operación incierta.&#10;&#10;AUTORIDAD · Instancia exclusiva de erp-worker en la red autorizada&#10;del ERP. No comparte Redis con país ni con su caché; el estado de&#10;negocio reside en PostgreSQL de país.&#10;&#10;CONTINUIDAD · Sin Redis local se detiene la admisión de jobs ERP. Al&#10;recuperar, consulta por HTTPS trabajo, intentos y resultados durables&#10;antes de reconstruir pendientes." parent="group-notes-4142-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="700.21875" height="495" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6662.15" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6728.15" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. device-agent: C#/.NET Windows propuesto, aún no implementado. F02/F05: puesto dedicado con SQLite técnico. F06: red y estación compartida homologada; sin autoridad de ventas. Backend,&#10;datos e integración: diseño por implementar. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6797.15" width="3023.586914" height="90" as="geometry" />
        </mxCell>
