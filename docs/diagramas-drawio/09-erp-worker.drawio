        <mxCell id="erpMasterSource" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=1.5;fillColor=#EDF3FF;rounded=0;arcSize=8;">
          <mxGeometry x="1856.264453" y="2234.8" width="440.55" height="134.4" as="geometry" />
