        <mxCell id="scope" value="Un proceso apps/erp-worker con BullMQ y Redis de trabajos en la red autorizada del ERP. Fachada, ACL, protocolo y preparación son componentes internos; trabajo durable y resultados se consultan por HTTPS en país." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=24;align=left;verticalAlign=top;">
