        </mxCell>
        <mxCell id="reading-title" value="Contratos que gobiernan esta vista" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3321.2" width="496.3125" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-0-bg" value="" parent="group-notes-3385-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-0-title" value="Trabajo durable y destino estable" parent="group-notes-3385-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="368.75" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-0-body" value="erp-worker solicita trabajo a country-api mediante conexión saliente. El&#10;claim con lease, los intentos y el destino persistido impiden reasignaciones&#10;silenciosas. Un lease vencido no demuestra que un efecto externo haya&#10;fallado." parent="group-notes-3385-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="730.060547" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-1-bg" value="" parent="group-notes-3385-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-1-title" value="Fachada, ACL y adaptador" parent="group-notes-3385-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="298.803711" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-1-body" value="Son componentes dentro de apps/erp-worker y libs/backend/erp. La&#10;fachada expresa capacidades POS; la ACL traduce identidades, unidades,&#10;estados y errores; cada adaptador resuelve el protocolo AX, custom o Gira&#10;que se homologue." parent="group-notes-3385-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="728.921875" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-2-bg" value="" parent="group-notes-3385-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-2-title" value="Resultado incierto y conciliación" parent="group-notes-3385-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="355.737305" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-2-body" value="Persistir identidad de operación y evidencia antes de reintentar. Si el ERP&#10;pudo aplicar, consultar o conciliar; no repetir a ciegas ni prometer&#10;exactly-once. country-api conserva trabajo y resultados; el worker no abre&#10;SQL hacia la base de país." parent="group-notes-3385-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="720.242188" height="110" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3663.45" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-0-bg" value="" parent="group-notes-3738-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-0-title" value="country-api" parent="group-notes-3738-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="123.669434" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-0-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/country-api autentica el ámbito país/entidad/sucursal. Confirma&#10;inbox, proyección operativa y outbox en un único commit antes del ACK de&#10;aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS&#10;saliente iniciado por ese worker. Valida, publica y sirve versiones&#10;preparadas mediante MasterDataSourcePort en erp-worker; no ejecuta la&#10;ACL ni carga masiva pesada en un endpoint. La caché opcional acelera&#10;lecturas reconstruibles, con PostgreSQL como fuente durable.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y&#10;outbox juntos antes del ACK de aplicación. Conserva autoridad de&#10;versiones, manifiestos y publicación de maestros.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su caída&#10;genera atraso de sincronización." parent="group-notes-3738-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="731.306641" height="440" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-1-bg" value="" parent="group-notes-3738-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-1-title" value="Planificador y ejecutor" parent="group-notes-3738-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="245.959473" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-1-body" value="Componente · libs/backend/erp + worker&#10;&#10;El proceso supervisado obtiene trabajo mediante el cliente de country-api.&#10;Limita concurrencia por contrato/ERP, conserva el destino de pendientes&#10;durante una migración y drena o interrumpe admisión de forma controlada.&#10;&#10;AUTORIDAD · Respeta lease, identidad, destino y versión fijados al crear&#10;el intento.&#10;&#10;CONTINUIDAD · Backoff y ventanas limitan reintentos; lease expirado no&#10;autoriza duplicar un efecto incierto." parent="group-notes-3738-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="730.071289" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-2-bg" value="" parent="group-notes-3738-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-2-title" value="Cliente de country-api" parent="group-notes-3738-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="243.188477" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-2-body" value="Componente · HTTPS autenticado · contrato POS&#10;&#10;Solicita trabajo, renueva leases cuando el contrato lo permite, obtiene&#10;estado y reporta resultados a country-api. Un resultado no confirmado&#10;permanece incierto hasta consultar o reconciliar; no fabrica otra operación.&#10;&#10;AUTORIDAD · Inicia conexiones salientes; no abre SQL remoto ni una API&#10;entrante obligatoria.&#10;&#10;CONTINUIDAD · Reconecta con la misma identidad; un reporte sin acuse&#10;se reentrega o consulta." parent="group-notes-3738-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="729.609375" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-3-bg" value="" parent="group-notes-3738-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-3-title" value="Extracción de maestros" parent="group-notes-3738-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="261.218262" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-3-body" value="Componente · MasterDataSourcePort · TypeScript&#10;&#10;Obtiene snapshot o deltas con corte consistente desde la fuente&#10;autorizada del país, prepara porciones y solicita claim, upload y finalize a&#10;country-api mediante el cliente HTTPS. La autoridad de publicación&#10;permanece en país. Acceso de red y capacidades de la fuente deben&#10;homologarse.&#10;&#10;AUTORIDAD · erp-worker compone un adaptador de fuente con identidad,&#10;claims y presupuesto aislados de las operaciones financieras.&#10;&#10;CONTINUIDAD · Sin origen homologado, claim válido o corte íntegro no&#10;finaliza la publicación. Reintenta porciones identificadas sin SQL WAN." parent="group-notes-3738-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="727.213867" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-4-bg" value="" parent="group-notes-3738-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-4-title" value="Fachada de integración POS" parent="group-notes-3738-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="321.032715" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-4-body" value="Componente · libs/backend/erp · TypeScript&#10;&#10;Recibe la operación y el contexto persistidos. Encapsula emisión, consulta&#10;y conciliación bajo contratos del POS; delega traducción y protocolo sin&#10;compartir detalles del ERP con ventas o caja.&#10;&#10;AUTORIDAD · Contrato canónico desacoplado de tablas, identificadores y&#10;SDK del ERP.&#10;&#10;CONTINUIDAD · Declara capacidades y resultados permitidos por&#10;integración; no promete equivalencias inexistentes." parent="group-notes-3738-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="726.397461" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-5-bg" value="" parent="group-notes-3738-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-5-title" value="ACL por país y contrato" parent="group-notes-3738-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="262.634277" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-5-body" value="Componente · libs/backend/erp · TypeScript&#10;&#10;Traduce modelos POS a modelos ERP y viceversa: identificadores,&#10;documentos, moneda, unidades, impuestos, estados y errores. AX, custom&#10;y Gira requieren contratos propios; compartir fachada no vuelve&#10;intercambiables sus capacidades.&#10;&#10;AUTORIDAD · Mapeos versionados, destino fijo y referencias de&#10;correlación; no reglas monetarias inventadas.&#10;&#10;CONTINUIDAD · Una traducción incompatible se rechaza con evidencia;&#10;no cambia silenciosamente de país ni ERP." parent="group-notes-3738-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="732.488281" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-6-bg" value="" parent="group-notes-3738-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-6-title" value="Adaptadores AX / custom / Gira" parent="group-notes-3738-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="351.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-6-body" value="Componente · Protocolo de cada ERP por homologar&#10;&#10;Chile usa AX on-premise; no se presupone API Dynamics 365. Perú&#10;custom y España Gira tienen interfaces por relevar. REST, WCF, SDK o&#10;acceso permitido se encapsulan según evidencia; no se habilita SQL&#10;directo desde sucursales o clientes.&#10;&#10;AUTORIDAD · Usa el destino y las credenciales del entorno autorizado;&#10;registra referencias técnicas.&#10;&#10;CONTINUIDAD · Timeout o respuesta perdida no equivale a rechazo;&#10;consulta cuando la capacidad exista." parent="group-notes-3738-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="700.261719" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-7-bg" value="" parent="group-notes-3738-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-7-title" value="Resultado y conciliación" parent="group-notes-3738-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="268.200684" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-7-body" value="Componente · libs/backend/erp · TypeScript&#10;&#10;Clasifica respuestas y errores. Si el resultado es incierto, mantiene&#10;identidad y consulta/conciliación según capacidad homologada; una&#10;intervención operativa conserva evidencia. Entrega el resultado al cliente&#10;de country-api para persistirlo.&#10;&#10;AUTORIDAD · Preserva intento y referencia del ERP al registrar el&#10;resultado en país.&#10;&#10;CONTINUIDAD · No repite automáticamente un efecto financiero de&#10;resultado desconocido." parent="group-notes-3738-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="711.755859" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-8-bg" value="" parent="group-notes-3738-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-8-title" value="Base técnica compartida" parent="group-notes-3738-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="273.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-8-body" value="Componente · shared/backend · composición objetivo&#10;&#10;Composición de bootstrap, config, http/worker, health y observability. Pino&#10;registra diagnóstico estructurado; Sentry es opt-in y requiere filtrado. El&#10;objetivo organizacional es libs/shared/backend; la evidencia del producto&#10;identifica la base actualmente implementada. No se presume un proyecto&#10;Nx por subcarpeta.&#10;&#10;AUTORIDAD · Mecanismos de proceso: configuración validada, errores y&#10;correlación. No contiene reglas monetarias ni auditoría de negocio.&#10;&#10;CONTINUIDAD · Falla cerrada ante configuración inválida. La ausencia de&#10;telemetría no altera el resultado de negocio." parent="group-notes-3738-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="728.792969" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-9-bg" value="" parent="group-notes-3738-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-9-title" value="ERP del país" parent="group-notes-3738-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-9-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú son&#10;antecedentes; versión, interfaces y capacidades deben confirmarse. No se&#10;afirma que exista el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la&#10;base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no&#10;revierte una venta local confirmada." parent="group-notes-3738-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="729.996094" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-10-bg" value="" parent="group-notes-3738-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="776.857422" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-10-title" value="Fuentes de maestros y precios" parent="group-notes-3738-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3738-10-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener responsable,&#10;contrato, versión y vigencia. La fuente de precios no se sustituye por una&#10;tabla editada libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP&#10;por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la&#10;política autorizada." parent="group-notes-3738-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="721.080078" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5763.95" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5829.95" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. device-agent: C#/.NET Windows propuesto, aún no implementado; journal técnico SQLite, sin autoridad de&#10;ventas. Backend, datos e integración: diseño por implementar. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5898.95" width="2330.165039" height="90" as="geometry" />
        </mxCell>
