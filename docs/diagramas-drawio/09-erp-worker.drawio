        <mxCell id="legend-desc" value="Flecha: iniciador → destino; texto: propósito y protocolo. Borde discontinuo: límite nombrado. Todo el contenido es editable." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=19;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="330" width="1039.266602" height="23.75" as="geometry" />
        </mxCell>
        <mxCell id="reading-title" value="Contratos que gobiernan esta vista" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3321.2" width="496.3125" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-0-bg" value="" parent="group-notes-3385-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="246.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-0-title" value="Trabajo durable y destino estable" parent="group-notes-3385-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="368.75" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-0-body" value="erp-worker solicita trabajo a country-api mediante conexión&#10;saliente. El claim con lease, los intentos y el destino&#10;persistido impiden reasignaciones silenciosas. Un lease&#10;vencido no demuestra que un efecto externo haya fallado." parent="group-notes-3385-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="575.953125" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-1-bg" value="" parent="group-notes-3385-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="246.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-1-title" value="Fachada, ACL y adaptador" parent="group-notes-3385-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="298.803711" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-1-body" value="Son componentes dentro de apps/erp-worker y&#10;libs/backend/erp. La fachada expresa capacidades POS; la&#10;ACL traduce identidades, unidades, estados y errores;&#10;cada adaptador resuelve el protocolo AX, custom o Gira&#10;que se homologue." parent="group-notes-3385-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="577.25293" height="137.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-2-bg" value="" parent="group-notes-3385-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="246.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-2-title" value="Resultado incierto y conciliación" parent="group-notes-3385-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="355.737305" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3385-2-body" value="Persistir identidad de operación y evidencia antes de&#10;reintentar. Si el ERP pudo aplicar, consultar o conciliar; no&#10;repetir a ciegas ni prometer exactly-once. country-api&#10;conserva trabajo y resultados; el worker no abre SQL hacia&#10;la base de país." parent="group-notes-3385-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="578.413086" height="137.5" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3690.95" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-0-bg" value="" parent="group-notes-3766-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-0-title" value="country-api" parent="group-notes-3766-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="123.669434" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-0-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/country-api autentica el ámbito país/entidad/sucursal.&#10;Confirma inbox, proyección operativa y outbox en un único&#10;commit antes del ACK de aplicación. Expone trabajo y&#10;resultados al erp-worker mediante HTTPS saliente iniciado&#10;por ese worker. Sirve publicaciones preparadas por un&#10;publicador separado; no ejecuta la ACL ni carga masiva&#10;pesada en un endpoint. La caché opcional acelera lecturas&#10;reconstruibles, con PostgreSQL como fuente durable.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox,&#10;efecto local y outbox juntos antes del ACK de aplicación.&#10;&#10;CONTINUIDAD · No participa en la transacción local de&#10;sucursal. Su caída genera atraso de sincronización." parent="group-notes-3766-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="574.857422" height="440" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-1-bg" value="" parent="group-notes-3766-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-1-title" value="Planificador y ejecutor" parent="group-notes-3766-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="245.959473" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-1-body" value="Componente · libs/backend/erp + worker&#10;&#10;El proceso supervisado obtiene trabajo mediante el cliente&#10;de country-api. Limita concurrencia por contrato/ERP,&#10;conserva el destino de pendientes durante una migración y&#10;drena o interrumpe admisión de forma controlada.&#10;&#10;AUTORIDAD · Respeta lease, identidad, destino y versión&#10;fijados al crear el intento.&#10;&#10;CONTINUIDAD · Backoff y ventanas limitan reintentos;&#10;lease expirado no autoriza duplicar un efecto incierto." parent="group-notes-3766-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="576.039062" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-2-bg" value="" parent="group-notes-3766-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-2-title" value="Cliente de country-api" parent="group-notes-3766-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="243.188477" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-2-body" value="Componente · HTTPS autenticado · contrato POS&#10;&#10;Solicita trabajo, renueva leases cuando el contrato lo&#10;permite, obtiene estado y reporta resultados a country-api.&#10;Un resultado no confirmado permanece incierto hasta&#10;consultar o reconciliar; no fabrica otra operación.&#10;&#10;AUTORIDAD · Inicia conexiones salientes; no abre SQL&#10;remoto ni una API entrante obligatoria.&#10;&#10;CONTINUIDAD · Reconecta con la misma identidad; un&#10;reporte sin acuse se reentrega o consulta." parent="group-notes-3766-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="569.873047" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-3-bg" value="" parent="group-notes-3766-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-3-title" value="Fachada de integración POS" parent="group-notes-3766-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="321.032715" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-3-body" value="Componente · libs/backend/erp · TypeScript&#10;&#10;Recibe la operación y el contexto persistidos. Encapsula&#10;emisión, consulta y conciliación bajo contratos del POS;&#10;delega traducción y protocolo sin compartir detalles del&#10;ERP con ventas o caja.&#10;&#10;AUTORIDAD · Contrato canónico desacoplado de tablas,&#10;identificadores y SDK del ERP.&#10;&#10;CONTINUIDAD · Declara capacidades y resultados&#10;permitidos por integración; no promete equivalencias&#10;inexistentes." parent="group-notes-3766-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="559.667969" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-4-bg" value="" parent="group-notes-3766-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-4-title" value="ACL por país y contrato" parent="group-notes-3766-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="262.634277" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-4-body" value="Componente · libs/backend/erp · TypeScript&#10;&#10;Traduce modelos POS a modelos ERP y viceversa:&#10;identificadores, documentos, moneda, unidades,&#10;impuestos, estados y errores. AX, custom y Gira requieren&#10;contratos propios; compartir fachada no vuelve&#10;intercambiables sus capacidades.&#10;&#10;AUTORIDAD · Mapeos versionados, destino fijo y&#10;referencias de correlación; no reglas monetarias&#10;inventadas.&#10;&#10;CONTINUIDAD · Una traducción incompatible se rechaza&#10;con evidencia; no cambia silenciosamente de país ni ERP." parent="group-notes-3766-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="571.011719" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-5-bg" value="" parent="group-notes-3766-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-5-title" value="Adaptadores AX / custom / Gira" parent="group-notes-3766-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="351.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-5-body" value="Componente · Protocolo de cada ERP por homologar&#10;&#10;Chile usa AX on-premise; no se presupone API Dynamics&#10;365. Perú custom y España Gira tienen interfaces por&#10;relevar. REST, WCF, SDK o acceso permitido se&#10;encapsulan según evidencia; no se habilita SQL directo&#10;desde sucursales o clientes.&#10;&#10;AUTORIDAD · Usa el destino y las credenciales del&#10;entorno autorizado; registra referencias técnicas.&#10;&#10;CONTINUIDAD · Timeout o respuesta perdida no equivale&#10;a rechazo; consulta cuando la capacidad exista." parent="group-notes-3766-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="570.206055" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-6-bg" value="" parent="group-notes-3766-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-6-title" value="Resultado y conciliación" parent="group-notes-3766-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="268.200684" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-6-body" value="Componente · libs/backend/erp · TypeScript&#10;&#10;Clasifica respuestas y errores. Si el resultado es incierto,&#10;mantiene identidad y consulta/conciliación según&#10;capacidad homologada; una intervención operativa&#10;conserva evidencia. Entrega el resultado al cliente de&#10;country-api para persistirlo.&#10;&#10;AUTORIDAD · Preserva intento y referencia del ERP al&#10;registrar el resultado en país.&#10;&#10;CONTINUIDAD · No repite automáticamente un efecto&#10;financiero de resultado desconocido." parent="group-notes-3766-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="553.899414" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-7-bg" value="" parent="group-notes-3766-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-7-title" value="Base técnica compartida" parent="group-notes-3766-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="273.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-7-body" value="Componente · shared/backend · composición objetivo&#10;&#10;Composición de bootstrap, config, http/worker, health y&#10;observability. Pino registra diagnóstico estructurado; Sentry&#10;es opt-in y requiere filtrado. El objetivo organizacional es&#10;libs/shared/backend; la evidencia del producto identifica la&#10;base actualmente implementada. No se presume un&#10;proyecto Nx por subcarpeta.&#10;&#10;AUTORIDAD · Mecanismos de proceso: configuración&#10;validada, errores y correlación. No contiene reglas&#10;monetarias ni auditoría de negocio.&#10;&#10;CONTINUIDAD · Falla cerrada ante configuración inválida.&#10;La ausencia de telemetría no altera el resultado de&#10;negocio." parent="group-notes-3766-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="577.994141" height="440" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-8-bg" value="" parent="group-notes-3766-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="626.102539" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-8-title" value="ERP del país" parent="group-notes-3766-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3766-8-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y&#10;custom en Perú son antecedentes; versión, interfaces y&#10;capacidades deben confirmarse. No se afirma que exista el&#10;adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada&#10;país; no la base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración&#10;pendiente; no revierte una venta local confirmada." parent="group-notes-3766-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="580.454102" height="330" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5465.7" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5531.7" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Angular + Tauri (escritorio), Angular + Capacitor (móvil) y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5600.7" width="1643.80957" height="67.5" as="geometry" />
        </mxCell>
