        </mxCell>
        <mxCell id="notes-1997-0-title" value="Aplicaciones, procesos y propiedad" parent="group-notes-1997-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="393.286133" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1997-0-body" value="Los seis nombres de app identifican sus proyectos en apps/. PostgreSQL de sucursal conserva negocio y espejo comercial; PostgreSQL de país conserva&#10;integración y proyecciones. El publicador de maestros es una responsabilidad cuyo proceso sigue por asignar." parent="group-notes-1997-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1506.602539" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-1997-1-bg" value="" parent="group-notes-1997-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1609.932031" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1997-1-title" value="Entrega durable y ACK de aplicación" parent="group-notes-1997-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="408.581543" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1997-1-body" value="País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un&#10;ACK no certifica contabilización ERP, aceptación fiscal ni liquidación del pago." parent="group-notes-1997-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1531.030273" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-1997-2-bg" value="" parent="group-notes-1997-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1609.932031" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1997-2-title" value="Caché y capacidades condicionales" parent="group-notes-1997-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="397.473145" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1997-2-body" value="Redis de país es opcional y reconstruible para country-api; no reemplaza PostgreSQL ni el espejo local. El puente de periféricos depende del SDK homologado&#10;y ejecuta comandos autorizados. Ninguna de estas piezas crea otra autoridad de ventas." parent="group-notes-1997-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1555.597656" height="55" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2220.05" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-0-bg" value="" parent="group-notes-2295-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-0-title" value="Cajero" parent="group-notes-2295-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="73.64502" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-0-body" value="Persona · Operación humana&#10;&#10;Usa el cliente del puesto. Abrir o cerrar sesión de usuario no equivale a abrir o cerrar el turno de caja.&#10;&#10;AUTORIDAD · Ejecuta operaciones con permisos; no administra la base.&#10;&#10;CONTINUIDAD · Acceso local y operaciones habilitadas según vigencia, permisos y política offline." parent="group-notes-2295-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="990.526367" height="192.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-1-bg" value="" parent="group-notes-2295-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-1-title" value="pos-desktop" parent="group-notes-2295-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="136.193848" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-1-body" value="Contenedor · Angular + Tauri&#10;&#10;pos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio;&#10;hardware, SDK y distribución requieren homologación. Su registro técnico de periféricos no lo convierte en autoridad&#10;de ventas.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes." parent="group-notes-2295-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1136.072266" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-2-bg" value="" parent="group-notes-2295-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-2-title" value="pos-mobile" parent="group-notes-2295-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="122.277832" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-2-body" value="Contenedor · Angular + Capacitor&#10;&#10;pos-mobile tiene arranque y bundle propios, compuestos con client-shell. Los adaptadores actuales son mock.&#10;Instalación, ciclo de vida, almacenamiento y capacidades nativas requieren pruebas Android/iOS; no hay acceso SQL&#10;ni permisos implícitos por empaquetar la interfaz.&#10;&#10;AUTORIDAD · Comparte interfaz y contratos; no otra autoridad de ventas.&#10;&#10;CONTINUIDAD · Requiere conexión autorizada al backend de sucursal. El móvil no incorpora autonomía sin LAN." parent="group-notes-2295-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1148.329102" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-3-bg" value="" parent="group-notes-2295-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-3-title" value="Puente de periféricos" parent="group-notes-2295-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="236.254883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-3-body" value="Contenedor condicional · Proceso nativo según SDK&#10;&#10;El cliente transporta el comando autorizado por backend al agente; no inventa importe, permiso ni otro intento. Puede&#10;requerir .NET u otro runtime por contrato del proveedor. Se representa como límite por homologar, no como SDK&#10;aprobado.&#10;&#10;AUTORIDAD · Ejecuta identidad y autorización emitidas por backend; registro técnico de evidencia, sin base de&#10;ventas.&#10;&#10;CONTINUIDAD · Una caída de LAN tras un cobro exige recuperar evidencia; no autoriza otro cobro." parent="group-notes-2295-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1145.922852" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-4-bg" value="" parent="group-notes-2295-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-4-title" value="branch-api" parent="group-notes-2295-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="118.127441" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-4-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/branch-api compone los contextos operativos: sales/returns, cash/collections, pricing/catalog, payments/devices,&#10;fiscal, reporting y administration. sync aporta el contrato outbox que se confirma con negocio. El transporte pertenece&#10;a branch-sync-worker y la ACL ERP a erp-worker. Bibliotecas no equivalen a microservicios; las capacidades de&#10;negocio aún requieren implementación.&#10;&#10;AUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos internos, un proceso.&#10;&#10;CONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del escritor autorizado." parent="group-notes-2295-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1150.713867" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-5-bg" value="" parent="group-notes-2295-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-5-title" value="Datos de sucursal" parent="group-notes-2295-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-5-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Ventas, caja, pagos y evidencia fiscal son locales. Inbox, outbox, cursores y staging tienen restricciones y&#10;transacciones. Catálogo, precios y promociones son réplicas de lectura autorizadas, no maestros independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API escribe negocio; worker escribe su&#10;esquema técnico y publica espejos por un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica respaldo, alta disponibilidad ni recuperación&#10;automática." parent="group-notes-2295-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1109.173828" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-6-bg" value="" parent="group-notes-2295-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-6-title" value="branch-sync-worker" parent="group-notes-2295-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="219.506836" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-6-body" value="Contenedor · NestJS / Node.js · sin servidor HTTP&#10;&#10;apps/branch-sync-worker compone libs/backend/sync con pricing/catalog para preparar y activar versiones. Entrega&#10;outbox por HTTPS con identidad y cursor; confirma acuses durables. El proceso supervisado sigue activo aunque el&#10;cliente se cierre. Descarga, staging, validación y activación conservan límites transaccionales.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita reintentos y trabajo en curso." parent="group-notes-2295-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1132.387695" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-7-bg" value="" parent="group-notes-2295-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-7-title" value="country-api" parent="group-notes-2295-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="123.669434" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-7-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único&#10;commit antes del ACK de aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS saliente iniciado por&#10;ese worker. Valida, publica y sirve versiones preparadas mediante MasterDataSourcePort en erp-worker; no ejecuta la&#10;ACL ni carga masiva pesada en un endpoint. La caché opcional acelera lecturas reconstruibles, con PostgreSQL&#10;como fuente durable.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación.&#10;Conserva autoridad de versiones, manifiestos y publicación de maestros.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización." parent="group-notes-2295-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1152.722656" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-8-bg" value="" parent="group-notes-2295-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-8-title" value="Datos operativos de país" parent="group-notes-2295-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-8-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención, backups y deduplicación deben cubrir el horizonte de&#10;replay y restauración. ACK de aplicación local no equivale a contabilización ERP.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox, outbox, versiones y resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo concurrente offline de saldos globales." parent="group-notes-2295-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1143.452148" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-9-bg" value="" parent="group-notes-2295-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-9-title" value="Redis · caché de país (opcional)" parent="group-notes-2295-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="358.520508" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-9-body" value="Contenedor de datos · Redis · datos reconstruibles&#10;&#10;Ampliación opcional sujeta a medición, capacidad y operación. La API comprueba identidad, ámbito y autorización&#10;antes de leer. Las claves incluyen país, entidad legal, versión y alcance de permisos cuando afecte al resultado; un&#10;prefijo no sustituye autorización. TTL y vigencia comercial son independientes. El fallback limita concurrencia, esperas&#10;y llenados para proteger PostgreSQL. No es la inbox, outbox, base de ventas ni único registro de permisos, dinero o&#10;trabajos; no implica BullMQ ni Redis en cada sucursal. Las versiones inmutables evitan mezclar publicaciones y&#10;PostgreSQL resuelve la versión autorizada.&#10;&#10;AUTORIDAD · Country-api lee y escribe entradas identificadas por país, entidad y versión. PostgreSQL conserva la&#10;autoridad y el estado durable.&#10;&#10;CONTINUIDAD · Un miss, expiración o caída permite consultar PostgreSQL con límites de carga y espera. La&#10;ausencia de caché no es condición del commit; la capacidad del origen sigue siendo necesaria." parent="group-notes-2295-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1153.130859" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-10-bg" value="" parent="group-notes-2295-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-10-title" value="erp-worker" parent="group-notes-2295-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="119.470215" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-10-body" value="Contenedor · NestJS / Node.js · libs/backend/erp&#10;&#10;apps/erp-worker se ejecuta en la red autorizada del ERP e inicia HTTPS autenticado hacia country-api para reclamar&#10;trabajo, renovar su lease y registrar resultados. Mantiene destino, versión de contrato e identidad de intento. Fachada,&#10;ACL y adaptadores son componentes de libs/backend/erp, no servicios HTTP separados obligatorios. Chile: AX; Perú:&#10;custom; España: Gira, con interfaces por homologar. No accede por SQL remoto a PostgreSQL de país. La&#10;preparación de maestros usa una identidad y presupuesto propios, conexión saliente a country-api y contrato de&#10;fuente homologado; no ejecuta SQL WAN.&#10;&#10;AUTORIDAD · Proceso con fachada, ACL y adaptadores internos. Prepara maestros por MasterDataSourcePort con&#10;identidad y presupuesto aislados; country-api conserva publicaciones y resultados durables.&#10;&#10;CONTINUIDAD · Si país o ERP no responde, conserva identidad y resultado incierto. Consulta o concilia antes de&#10;repetir un efecto." parent="group-notes-2295-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1153.238281" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-11-bg" value="" parent="group-notes-2295-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-11-title" value="ERP del país" parent="group-notes-2295-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-11-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú son antecedentes; versión, interfaces y&#10;capacidades deben confirmarse. No se afirma que exista el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no revierte una venta local confirmada." parent="group-notes-2295-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1076.077148" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-12-bg" value="" parent="group-notes-2295-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="329.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-12-title" value="Fuentes de maestros y precios" parent="group-notes-2295-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-12-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener responsable, contrato, versión y vigencia. La fuente de&#10;precios no se sustituye por una tabla editada libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la política autorizada." parent="group-notes-2295-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1095.756836" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-13-bg" value="" parent="group-notes-2295-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="329.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-13-title" value="Proveedor de pagos" parent="group-notes-2295-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-13-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Pago, venta, documento fiscal e integración ERP tienen estados distintos. No repetir un cargo incierto ni cambiar de&#10;proveedor para resolverlo automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout puede dejar resultado desconocido." parent="group-notes-2295-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1129.959961" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-14-bg" value="" parent="group-notes-2295-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1201.449023" height="329.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-14-title" value="Proveedor fiscal" parent="group-notes-2295-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="179.248047" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2295-14-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Emisión, aceptación y transmisión se modelan por separado. No se inventa un proveedor común ni una capacidad de&#10;consulta o idempotencia no acreditada.&#10;&#10;AUTORIDAD · Autoridad y validez tributaria según régimen y proveedor.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se promete universalmente." parent="group-notes-2295-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1145.901367" height="220" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4073.05" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4139.05" width="1681.240234" height="25" as="geometry" />
        </mxCell>
