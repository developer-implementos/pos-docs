        <mxCell id="notes-2050-0-title" value="Aplicaciones, procesos y propiedad" parent="group-notes-2050-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="393.286133" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2050-0-body" value="Siete aplicaciones objetivo tienen nombre en apps/: seis cuentan con base técnica o scaffold; device-agent es propuesta aún no implementada. PostgreSQL de sucursal conserva negocio y espejo; país&#10;conserva integración. SQLite es el journal técnico privado del agente." parent="group-notes-2050-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1963.704102" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-2050-1-bg" value="" parent="group-notes-2050-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="2089.681641" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2050-1-title" value="Entrega durable y ACK de aplicación" parent="group-notes-2050-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="408.581543" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2050-1-body" value="País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un ACK no certifica contabilización ERP, aceptación&#10;fiscal ni liquidación del pago." parent="group-notes-2050-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="2012.441406" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-2050-2-bg" value="" parent="group-notes-2050-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="2089.681641" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2050-2-title" value="Trabajos y capacidades del despliegue" parent="group-notes-2050-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="431.298828" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2050-2-body" value="BullMQ requiere Redis exclusivo de trabajos en país y otro en red ERP. Redis caché país es opcional y separado. PostgreSQL conserva autoridad y pendientes reconstruibles. F02/F05 instala device-agent en&#10;el puesto Windows: obtiene trabajos asignados por HTTPS LAN y conserva SQLite local. No depende de la ventana pos-desktop. La línea discontinua indica expansión F06 a red y estación compartida&#10;homologada; no otro proyecto ni pagos habilitados." parent="group-notes-2050-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="2028.404297" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2300.35" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-0-bg" value="" parent="group-notes-2375-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-0-title" value="Cajero" parent="group-notes-2375-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="73.64502" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-0-body" value="Persona · Operación humana&#10;&#10;Usa el cliente del puesto. Abrir o cerrar sesión de usuario no equivale a abrir o cerrar el turno de caja.&#10;&#10;AUTORIDAD · Ejecuta operaciones con permisos; no administra la base.&#10;&#10;CONTINUIDAD · Acceso local y operaciones habilitadas según vigencia, permisos y política offline." parent="group-notes-2375-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="990.526367" height="192.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-1-bg" value="" parent="group-notes-2375-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-1-title" value="pos-desktop" parent="group-notes-2375-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="136.193848" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-1-body" value="Contenedor · Angular (frontend) · Tauri (shell nativa)&#10;&#10;apps/pos-desktop entrega la aplicación completa: la shell nativa Tauri aloja el frontend Angular. Tiene arranque, configuración nativa y build propios.&#10;Comparte con pos-mobile libs/client-shell: raíz, configuración, rutas, guards y layout Angular; esta biblioteca no es la shell nativa ni un proceso adicional.&#10;Solicita capacidades de dispositivos a branch-api; no transporta trabajos a device-agent ni necesita mantenerse abierto para que éste opere. Distribución e&#10;integración nativa requieren homologación; no posee autoridad de ventas. F02 instala device-agent y su journal en el mismo puesto Windows; son&#10;procesos independientes. El perfil dedicado sólo recibe trabajos asignados a ese puesto.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes." parent="group-notes-2375-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1511.56543" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-2-bg" value="" parent="group-notes-2375-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-2-title" value="pos-mobile" parent="group-notes-2375-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="122.277832" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-2-body" value="Contenedor · Angular (frontend) · Capacitor (shell nativa)&#10;&#10;apps/pos-mobile entrega la aplicación completa: la shell nativa Capacitor aloja el frontend Angular. Tiene arranque, configuración nativa y build propios.&#10;Comparte con pos-desktop libs/client-shell: raíz, configuración, rutas, guards y layout Angular; esta biblioteca no es la shell nativa ni un proceso adicional.&#10;Los adaptadores actuales son mock. Instalación, ciclo de vida, almacenamiento y capacidades nativas requieren pruebas Android/iOS; no hay acceso SQL&#10;ni permisos implícitos por empaquetar la interfaz. El acceso móvil a periféricos compartidos se habilita en F06 tras homologación y asignación explícita.&#10;Solicita capacidades a branch-api; no usa por defecto el agente dedicado a otro puesto ni depende de pos-desktop como relé.&#10;&#10;AUTORIDAD · Comparte interfaz y contratos; no otra autoridad de ventas.&#10;&#10;CONTINUIDAD · Requiere conexión autorizada al backend de sucursal. El móvil no incorpora autonomía sin LAN." parent="group-notes-2375-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1512.768555" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-3-bg" value="" parent="group-notes-2375-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-3-title" value="device-agent" parent="group-notes-2375-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="143.151855" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-3-body" value="Contenedor · C# / .NET · Windows&#10;&#10;Aplicación objetivo apps/device-agent, aún no implementada. Primera entrega F02: proceso autónomo instalado en el mismo puesto Windows que&#10;pos-desktop; controla periféricos USB/serie mediante drivers o SDK homologados y conserva allí su journal SQLite. El piloto F05 valida ese perfil dedicado.&#10;Opera sin la ventana de pos-desktop abierta e inicia HTTPS LAN autenticado hacia branch-api para obtener trabajos del puesto y reportar evidencia. Cada&#10;trabajo conserva jobId, hash, destino y autorización; spool aceptado no acredita impresión física. F06 incorpora impresoras de recibos y etiquetas en red y&#10;una estación compartida certificada, con la misma aplicación y contratos de propiedad; no habilita automáticamente MICR, cajón, pagos ni acceso móvil a&#10;cualquier caja. El servidor de sucursal no aloja el agente por defecto.&#10;&#10;AUTORIDAD · F02: agente dedicado al puesto y sus dispositivos; branch-api autoriza sólo trabajos del puesto asignado. F06 amplía a una estación&#10;compartida homologada con un único controlador por dispositivo físico.&#10;&#10;CONTINUIDAD · Sin LAN no obtiene trabajos nuevos. Conserva evidencia del trabajo en curso para reanudar su reporte; un resultado incierto no autoriza&#10;repetir el efecto." parent="group-notes-2375-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1516.334961" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-4-bg" value="" parent="group-notes-2375-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-4-title" value="Journal técnico de dispositivos" parent="group-notes-2375-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="339.074707" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-4-body" value="Contenedor de datos · SQLite&#10;&#10;F02/F05: diario técnico local del puesto; F06: diario propio de cada instancia certificada, nunca una SQLite compartida por red. Persistencia técnica&#10;propuesta. Registra recepción durable, identidad de agente y equipo, hash del contenido, intento y evidencia del driver/spooler. Mismo jobId con distinto&#10;hash es conflicto. Guarda evidencia antes de reportarla; no interpreta spool accepted como impresión física. Restore o pérdida del journal exige reconciliar&#10;antes de repetir efectos; un lease vencido no prueba que el hardware no actuó.&#10;&#10;AUTORIDAD · Privado de device-agent en el puesto Windows inicial. No contiene ventas, caja, precios ni autoridad financiera.&#10;&#10;CONTINUIDAD · Conserva jobId, hash y estados técnicos durante cortes de LAN; al reconectar reporta con la misma identidad." parent="group-notes-2375-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1507.837891" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-5-bg" value="" parent="group-notes-2375-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-5-title" value="branch-api" parent="group-notes-2375-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="118.127441" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-5-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/branch-api compone los contextos operativos: sales/returns, cash/collections, pricing/catalog, payments/devices, fiscal, reporting y administration.&#10;sync aporta el contrato outbox que se confirma con negocio. El transporte pertenece a branch-sync-worker y la ACL ERP a erp-worker. Bibliotecas no&#10;equivalen a microservicios; las capacidades de negocio aún requieren implementación. devices autoriza y conserva trabajos, auditoría y observaciones de&#10;periféricos en PostgreSQL de sucursal. Recibe evidencia de device-agent por conexiones iniciadas por el agente; los clientes no actúan como relé.&#10;Registrar o imprimir un trabajo conserva la referencia del documento y no modifica la confirmación de la venta.&#10;&#10;AUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos internos, un proceso.&#10;&#10;CONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del escritor autorizado." parent="group-notes-2375-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1505.399414" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-6-bg" value="" parent="group-notes-2375-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-6-title" value="Datos de sucursal" parent="group-notes-2375-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-6-body" value="Contenedor de datos · PostgreSQL&#10;&#10;branch-api y branch-sync-worker acceden al mismo PostgreSQL de la sucursal con responsabilidades y permisos distintos. Ventas, caja, pagos y evidencia&#10;fiscal se conservan aquí. devices es propietario de los trabajos autorizados, su auditoría y las observaciones de periféricos recibidas del agente; estos&#10;registros conservan identidad y referencia al documento, sin formar parte de la misma transacción de confirmación de venta. El journal SQLite privado del&#10;agente sólo registra ejecución técnica. Inbox, outbox, cursores y staging tienen restricciones y transacciones según cada operación. Las llamadas de red&#10;quedan fuera de esas transacciones. Catálogo, precios y promociones son réplicas de lectura autorizadas, no maestros independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API escribe negocio; worker escribe su esquema técnico y publica espejos por un&#10;contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica respaldo, alta disponibilidad ni recuperación automática." parent="group-notes-2375-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1516.313477" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-7-bg" value="" parent="group-notes-2375-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-7-title" value="branch-sync-worker" parent="group-notes-2375-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="219.506836" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-7-body" value="Contenedor · NestJS / Node.js · sin servidor HTTP&#10;&#10;apps/branch-sync-worker compone libs/backend/sync con pricing/catalog para preparar y activar versiones. Entrega outbox por HTTPS con identidad y&#10;cursor; confirma acuses durables. El proceso supervisado sigue activo aunque el cliente se cierre. Descarga, staging, validación y activación conservan&#10;límites transaccionales. No requiere Redis ni BullMQ por sucursal: el control de pendientes, calendario, cursores y activación utiliza PostgreSQL local y&#10;HTTPS.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita reintentos y trabajo en curso." parent="group-notes-2375-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1478.436523" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-8-bg" value="" parent="group-notes-2375-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-8-title" value="country-api" parent="group-notes-2375-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="123.669434" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-8-body" value="Contenedor · NestJS + Fastify / Node.js · BullMQ&#10;&#10;apps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único commit antes del ACK de aplicación.&#10;Expone trabajo y resultados al erp-worker mediante HTTPS saliente iniciado por ese worker. Valida, publica y sirve versiones preparadas mediante&#10;MasterDataSourcePort en erp-worker; no ejecuta la ACL ni carga masiva pesada en un endpoint. La caché opcional acelera lecturas reconstruibles, con&#10;PostgreSQL como fuente durable. BullMQ es la librería elegida dentro del mismo proceso para programar publicaciones y ejecutar tareas breves fuera de&#10;HTTP. Usa Redis de trabajos exclusivo de país; PostgreSQL conserva solicitudes, calendario, outbox y resultados para reconstruir jobs. La preparación&#10;pesada se ejecuta en erp-worker. La decisión está adoptada; su integración todavía no está implementada.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación. Conserva autoridad de versiones,&#10;manifiestos y publicación de maestros.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización." parent="group-notes-2375-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1516.399414" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-9-bg" value="" parent="group-notes-2375-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-9-title" value="Datos operativos de país" parent="group-notes-2375-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-9-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención, backups y deduplicación deben cubrir el horizonte de replay y restauración. ACK de&#10;aplicación local no equivale a contabilización ERP. Conserva también calendarios, solicitudes de publicación, intentos y checkpoints durables. La outbox&#10;permite encolar tras el commit y un reconciliador reconstruye jobs pendientes sin confiar en la permanencia del historial Redis.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox, outbox, versiones y resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo concurrente offline de saldos globales." parent="group-notes-2375-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1484.269531" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-10-bg" value="" parent="group-notes-2375-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-10-title" value="Redis · trabajos de país" parent="group-notes-2375-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="264.025879" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-10-body" value="Contenedor de datos · Redis dedicado · BullMQ&#10;&#10;Dependencia obligatoria de la arquitectura elegida, aún no implementada. Red privada, autenticación y TLS según despliegue; sin conexión desde&#10;sucursales ni desde la red ERP. Persistencia Redis y política noeviction para proteger jobs, capacidad y retención acotadas. El relay encola después del&#10;commit PostgreSQL y la reconciliación reconstruye pendientes por identidad estable. Perder Redis no autoriza repetir efectos; BullMQ no ofrece&#10;exactamente una vez sobre sistemas externos.&#10;&#10;AUTORIDAD · Instancia exclusiva del dominio país; separada del Redis de caché. PostgreSQL conserva calendario, solicitudes, outbox y resultados de&#10;negocio.&#10;&#10;CONTINUIDAD · Si falla, se detiene la programación y ejecución de jobs del país. Los pendientes durables se conservan en PostgreSQL; no revierte&#10;ventas confirmadas ni habilita ACK sin commit." parent="group-notes-2375-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1484.226562" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-11-bg" value="" parent="group-notes-2375-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-11-title" value="Redis · trabajos de ERP" parent="group-notes-2375-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="268.17627" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-11-body" value="Contenedor de datos · Redis dedicado · BullMQ&#10;&#10;Dependencia obligatoria de la arquitectura elegida, aún no implementada. BullMQ almacena colas, retrasos y metadatos técnicos en esta instancia con&#10;noeviction y persistencia operada. Límites separados para preparación masiva y operaciones/consultas de conciliación. La recuperación usa country-api&#10;por HTTPS; no abre Redis ni PostgreSQL a través de WAN. El job técnico no sustituye el lease de negocio ni el resultado ERP y nunca habilita reenviar&#10;ciegamente una operación incierta.&#10;&#10;AUTORIDAD · Instancia exclusiva de erp-worker en la red autorizada del ERP. No comparte Redis con país ni con su caché; el estado de negocio reside&#10;en PostgreSQL de país.&#10;&#10;CONTINUIDAD · Sin Redis local se detiene la admisión de jobs ERP. Al recuperar, consulta por HTTPS trabajo, intentos y resultados durables antes de&#10;reconstruir pendientes." parent="group-notes-2375-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1489.844727" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-12-bg" value="" parent="group-notes-2375-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-12-title" value="Redis · caché de país (opcional)" parent="group-notes-2375-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="358.520508" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-12-body" value="Contenedor de datos · Redis · datos reconstruibles&#10;&#10;Ampliación opcional sujeta a medición, capacidad y operación. La API comprueba identidad, ámbito y autorización antes de leer. Las claves incluyen país,&#10;entidad legal, versión y alcance de permisos cuando afecte al resultado; un prefijo no sustituye autorización. TTL y vigencia comercial son independientes.&#10;El fallback limita concurrencia, esperas y llenados para proteger PostgreSQL. No es la inbox, outbox, base de ventas ni único registro de permisos, dinero&#10;o trabajos; se despliega en una instancia separada de Redis de trabajos y no implica Redis en cada sucursal. Las versiones inmutables evitan mezclar&#10;publicaciones y PostgreSQL resuelve la versión autorizada.&#10;&#10;AUTORIDAD · Country-api lee y escribe entradas identificadas por país, entidad y versión. PostgreSQL conserva la autoridad y el estado durable.&#10;&#10;CONTINUIDAD · Un miss, expiración o caída permite consultar PostgreSQL con límites de carga y espera. La ausencia de caché no es condición del&#10;commit; la capacidad del origen sigue siendo necesaria." parent="group-notes-2375-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1506.645508" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-13-bg" value="" parent="group-notes-2375-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-13-title" value="erp-worker" parent="group-notes-2375-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="119.470215" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-13-body" value="Contenedor · NestJS / Node.js · BullMQ&#10;&#10;apps/erp-worker se ejecuta en la red autorizada del ERP e inicia HTTPS autenticado hacia country-api para reclamar trabajo, renovar su lease y registrar&#10;resultados. Mantiene destino, versión de contrato e identidad de intento. Fachada, ACL y adaptadores son componentes de libs/backend/erp, no servicios&#10;HTTP separados obligatorios. Chile: AX; Perú: custom; España: Gira, con interfaces por homologar. No accede por SQL remoto a PostgreSQL de país. La&#10;preparación de maestros usa una identidad y presupuesto propios, conexión saliente a country-api y contrato de fuente homologado; no ejecuta SQL WAN.&#10;BullMQ organiza trabajos técnicos, preparación de maestros y consultas de conciliación dentro del mismo proceso. Utiliza Redis de trabajos exclusivo de la&#10;red ERP y obtiene el estado durable por HTTPS de country-api. La cola puede reentregar: antes de actuar revalida estado y autorización; un resultado&#10;financiero incierto se consulta o concilia, no se repite automáticamente. La integración BullMQ está elegida, aún no implementada.&#10;&#10;AUTORIDAD · Proceso con fachada, ACL y adaptadores internos. Prepara maestros por MasterDataSourcePort con identidad y presupuesto aislados;&#10;country-api conserva publicaciones y resultados durables.&#10;&#10;CONTINUIDAD · Si país o ERP no responde, conserva identidad y resultado incierto. Consulta o concilia antes de repetir un efecto." parent="group-notes-2375-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1515.668945" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-14-bg" value="" parent="group-notes-2375-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-14-title" value="ERP del país" parent="group-notes-2375-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-14-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú son antecedentes; versión, interfaces y capacidades deben confirmarse. No se&#10;afirma que exista el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no revierte una venta local confirmada." parent="group-notes-2375-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1463.741211" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-15-bg" value="" parent="group-notes-2375-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-15-title" value="Fuentes de maestros y precios" parent="group-notes-2375-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-15-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener responsable, contrato, versión y vigencia. La fuente de precios no se sustituye por una tabla&#10;editada libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la política autorizada." parent="group-notes-2375-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1460.196289" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-16-bg" value="" parent="group-notes-2375-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-16-title" value="Proveedor de pagos" parent="group-notes-2375-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-16-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Autoriza o informa el resultado del pago. Transbank con terminal local en Chile y Niubiz en Perú proceden de las fuentes revisadas. Mercado Pago Point&#10;es un ejemplo presencial ilustrativo, sin adopción ni integración acreditadas; Webpay Plus es un ejemplo de pago online de Transbank, distinto de su&#10;terminal de tienda. En España se informan BBVA/Redsys con TPV portátiles sin conexión a Gira y conciliación contable; no se presume una API o SDK ya&#10;integrado. Cada ruta y capacidad requiere homologación. Pago, venta, documento fiscal e integración ERP tienen estados distintos. No repetir un cargo&#10;incierto ni cambiar de proveedor para resolverlo automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout puede dejar resultado desconocido." parent="group-notes-2375-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1506.162109" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-17-bg" value="" parent="group-notes-2375-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-17-title" value="Proveedor de facturación" parent="group-notes-2375-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="279.333496" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-17-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Acepta/Ingydev aparecen en el código legacy chileno y EFACT en las fuentes de Perú. Gira se informa como solución de España; su modalidad fiscal,&#10;interfaces y capacidades deben confirmarse. Estos ejemplos no seleccionan un proveedor corporativo ni acreditan adaptadores homologados para POS&#10;Platform. SII y SUNAT son autoridades tributarias, no estos proveedores de software; en España corresponde la autoridad del régimen y territorio&#10;aplicables. Emisión, aceptación y transmisión se modelan por separado. No se inventa un proveedor común ni una capacidad de consulta o idempotencia&#10;no acreditada.&#10;&#10;AUTORIDAD · La solución prepara, emite o transmite documentos por cuenta del contribuyente según su contrato. La autoridad tributaria es distinta: SII en&#10;Chile, SUNAT en Perú y la autoridad aplicable en España.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se promete universalmente." parent="group-notes-2375-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1514.745117" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-18-bg" value="" parent="group-notes-2375-18" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-18-title" value="Periféricos del puesto" parent="group-notes-2375-18" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="240.405273" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-18-body" value="Hardware externo · USB / serie · driver / SDK&#10;&#10;Perfil inicial F02 y piloto F05: impresora de recibos, etiquetas o lector MICR conectado al puesto Windows mediante USB/serie y driver o SDK homologado.&#10;No se ofrece a otros puestos o móviles por defecto. La impresión conserva referencia de documento y trabajo; el spooler sólo informa recepción técnica.&#10;La reimpresión requiere autorización explícita. Compartir dispositivos por red es una expansión F06 con homologación por modelo; cajón, MICR y&#10;terminales de pago no heredan esa capacidad.&#10;&#10;AUTORIDAD · Un único device-agent autorizado opera cada equipo físico. La aplicación solicita capacidades a branch-api.&#10;&#10;CONTINUIDAD · La capacidad depende del equipo, driver y estado físico. Un timeout puede dejar resultado incierto." parent="group-notes-2375-18" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1516.270508" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-19-bg" value="" parent="group-notes-2375-19" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1561.26123" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-19-title" value="Periféricos de red · F06" parent="group-notes-2375-19" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="261.218262" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2375-19-body" value="Hardware externo · TCP/IP · driver / SDK homologado&#10;&#10;Expansión F06 posterior al piloto F05 del puesto dedicado. Homologar impresoras de recibos y etiquetas accesibles por red y, cuando se requiera, una&#10;estación compartida Windows que ejecute la misma apps/device-agent. La línea discontinua representa una capacidad futura; no instala otro agente en el&#10;servidor por defecto. Mantener protocolo HTTPS con branch-api, propiedad exclusiva, configuración, diagnóstico, journal local y control de concurrencia.&#10;Homologar el acceso de móviles por permisos y destino explícitos. MICR, cajón y pagos requieren evaluación propia; una impresora de red no los habilita.&#10;&#10;AUTORIDAD · Un controlador activo por dispositivo físico, asignado a una instancia certificada de la misma apps/device-agent. No es otra aplicación del&#10;monorepo.&#10;&#10;CONTINUIDAD · Sin LAN no se aceptan trabajos nuevos. Cortes, reconexión o cambio de controlador no autorizan repetir un efecto incierto." parent="group-notes-2375-19" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1505.334961" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4864.1" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4930.1" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. device-agent: C#/.NET Windows propuesto, aún no implementado. F02/F05: puesto dedicado con SQLite técnico. F06: red y estación compartida homologada; sin autoridad de ventas. Backend, datos e integración: diseño por implementar. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4999.1" width="3583.889648" height="67.5" as="geometry" />
        </mxCell>
