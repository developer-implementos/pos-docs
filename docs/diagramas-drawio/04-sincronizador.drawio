        <mxCell id="legend-desc" value="Flecha: iniciador → destino; texto: propósito y protocolo. Borde discontinuo: límite nombrado. Todo el contenido es editable." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=19;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="330" width="1039.266602" height="23.75" as="geometry" />
        </mxCell>
        <mxCell id="reading-title" value="Contratos que gobiernan esta vista" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2969.135645" width="496.3125" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3033-0-bg" value="" parent="group-notes-3033-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="862.514258" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3033-0-title" value="Programado, incremental o manual" parent="group-notes-3033-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="390.478516" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3033-0-body" value="Calendario y zona horaria IANA, ventanas, límites, backoff y jitter son configuración&#10;explícita. Carga masiva programada o manual utiliza el mismo pipeline auditado.&#10;Una ejecución manual no salta validaciones." parent="group-notes-3033-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="812.786133" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3033-1-bg" value="" parent="group-notes-3033-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="862.514258" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3033-1-title" value="Recibido no equivale a aplicado" parent="group-notes-3033-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="353.027344" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3033-1-body" value="Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una candidata&#10;completa aislada; snapshot incorpora cambios posteriores al corte H, incluyendo&#10;bajas. Toda candidata pasa por validación antes de activar." parent="group-notes-3033-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="794.889648" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3033-2-bg" value="" parent="group-notes-3033-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="862.514258" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3033-2-title" value="Publicación atómica, sin bloqueo prolongado" parent="group-notes-3033-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="496.166992" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3033-2-body" value="Descarga, checksum, referencias, cobertura, compatibilidad y vigencia se validan&#10;fuera del commit final. Una transacción corta cambia inbox aplicada + puntero&#10;activo + cursor aplicado. Impedir regresión por snapshots lentos y retener versiones&#10;referenciadas." parent="group-notes-3033-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="817.469727" height="110" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3311.385645" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-0-bg" value="" parent="group-notes-3386-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="640.885693" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-0-title" value="Planificador y supervisor" parent="group-notes-3386-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="272.338867" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-0-body" value="Componente · Worker TypeScript&#10;&#10;Carga incremental continua según política, bulk programable&#10;y recuperación manual usan el mismo pipeline validado.&#10;Zona horaria IANA, límites, backoff y jitter son configuración&#10;explícita.&#10;&#10;AUTORIDAD · Checkpoint y calendario por flujo; operación&#10;auditada.&#10;&#10;CONTINUIDAD · Cierra admisión, drena o conserva&#10;checkpoint; no convierte timeout en rechazo." parent="group-notes-3386-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="593.119141" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-1-bg" value="" parent="group-notes-3386-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="640.885693" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-1-title" value="Emisor de outbox" parent="group-notes-3386-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="194.543457" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-1-body" value="Componente · Worker TypeScript / HTTPS&#10;&#10;Lee outbox confirmada, arma lotes acotados y mantiene&#10;commandId/eventId, país, sucursal, versión de contrato y&#10;secuencia. La entrega es al menos una vez, no exactly once&#10;universal.&#10;&#10;AUTORIDAD · Reintento de los mismos eventos; claim/lease&#10;técnico con recuperación.&#10;&#10;CONTINUIDAD · Conserva cola durable; no elimina&#10;pendientes por pérdida de conexión." parent="group-notes-3386-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="595.03125" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-2-bg" value="" parent="group-notes-3386-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="640.885693" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-2-title" value="Receptor de deltas y acuses" parent="group-notes-3386-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="315.454102" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-2-body" value="Componente · Worker TypeScript / HTTPS&#10;&#10;Los acuses del país llegan por respuestas o consulta&#10;autenticada. Un acuse perdido provoca replay con identidad&#10;original; nunca inventa un número ERP.&#10;&#10;AUTORIDAD · Distingue ACK de aplicación local de&#10;resultado financiero/fiscal/ERP.&#10;&#10;CONTINUIDAD · Reanuda desde cursor durable; si hay&#10;huecos, solicita recuperación." parent="group-notes-3386-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="585.835938" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-3-bg" value="" parent="group-notes-3386-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="640.885693" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-3-title" value="Inbox y deduplicación" parent="group-notes-3386-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="240.441895" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-3-body" value="Componente · Transacciones SQL / TypeScript&#10;&#10;Detecta duplicados, desorden y huecos. Aplica deltas a una&#10;candidata aislada y la entrega al validador. Descarga y&#10;preparación quedan fuera de la transacción final; al activar&#10;se confirman inbox aplicada, efecto y cursor aplicado juntos.&#10;&#10;AUTORIDAD · Inbox recibida, staging y cursor de recepción&#10;son durables; no equivalen a inbox aplicada ni cursor&#10;aplicado.&#10;&#10;CONTINUIDAD · Replay repetido no duplica el efecto local.&#10;Restore exige conciliar evidencia." parent="group-notes-3386-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="588.209961" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-4-bg" value="" parent="group-notes-3386-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="640.885693" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-4-title" value="Carga de snapshot" parent="group-notes-3386-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="211.254883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-4-body" value="Componente · Descarga HTTPS / TypeScript&#10;&#10;Carga masiva programada o manual; recibe manifiesto,&#10;versión, cobertura y watermark. Verifica chunks/checksum y&#10;recupera deltas posteriores antes de declarar una versión&#10;lista.&#10;&#10;AUTORIDAD · Staging aislado; datasetVersion y watermark&#10;de origen identificables.&#10;&#10;CONTINUIDAD · La versión activa sigue sirviendo mientras&#10;se descarga o falla una carga." parent="group-notes-3386-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="584.439453" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-5-bg" value="" parent="group-notes-3386-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="640.885693" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-5-title" value="Validador de publicación" parent="group-notes-3386-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="270.556641" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-5-body" value="Componente · Reglas TypeScript / SQL&#10;&#10;Verifica checksum, referencias, monotonicidad, watermark,&#10;cantidad, fechas y compatibilidad fuera de la transacción&#10;final de activación. La candidata validada permanece&#10;identificada e inmutable; no se retiene una transacción&#10;durante la descarga.&#10;&#10;AUTORIDAD · Impide activar lotes parciales o&#10;incompatibles.&#10;&#10;CONTINUIDAD · Si no pasa validación se mantiene la&#10;versión previa, dentro de su vigencia autorizada." parent="group-notes-3386-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="574.685547" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-6-bg" value="" parent="group-notes-3386-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="640.885693" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-6-title" value="Activación de versión" parent="group-notes-3386-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="236.230469" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-6-body" value="Componente · Transacción SQL / TypeScript&#10;&#10;Recibe una candidata completa e inmutable validada, de&#10;snapshot o deltas. Recomprueba precondiciones y cambia el&#10;puntero en un commit corto, sin descarga ni validación&#10;pesada dentro de SQL. Recibido no significa aplicado.&#10;&#10;AUTORIDAD · Commit corto de inbox aplicada,&#10;efecto/puntero y cursor aplicado; conserva versiones aún&#10;referenciadas.&#10;&#10;CONTINUIDAD · Nuevas cotizaciones usan la versión activa&#10;autorizada. Las abiertas conservan trazabilidad y se&#10;revalidan antes del pago; un pago iniciado o incierto&#10;mantiene importe e identidad." parent="group-notes-3386-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="594.34375" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-7-bg" value="" parent="group-notes-3386-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="640.885693" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-7-title" value="Datos de sucursal" parent="group-notes-3386-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-7-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Ventas, caja, pagos y evidencia fiscal son locales. Inbox,&#10;outbox, cursores y staging tienen restricciones y&#10;transacciones. Catálogo, precios y promociones son réplicas&#10;de lectura autorizadas, no maestros independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario&#10;autorizado. API escribe negocio; worker escribe su esquema&#10;técnico y publica espejos por un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No&#10;implica respaldo, alta disponibilidad ni recuperación&#10;automática." parent="group-notes-3386-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="591.862305" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-8-bg" value="" parent="group-notes-3386-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="640.885693" height="631.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-8-title" value="country-api" parent="group-notes-3386-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="123.669434" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3386-8-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/country-api autentica el ámbito país/entidad/sucursal.&#10;Confirma inbox, proyección operativa y outbox en un único&#10;commit antes del ACK de aplicación. Expone trabajo y&#10;resultados al erp-worker mediante HTTPS saliente iniciado&#10;por ese worker. Valida, publica y sirve versiones preparadas&#10;mediante MasterDataSourcePort en erp-worker; no ejecuta&#10;la ACL ni carga masiva pesada en un endpoint. La caché&#10;opcional acelera lecturas reconstruibles, con PostgreSQL&#10;como fuente durable.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox,&#10;efecto local y outbox juntos antes del ACK de aplicación.&#10;Conserva autoridad de versiones, manifiestos y publicación&#10;de maestros.&#10;&#10;CONTINUIDAD · No participa en la transacción local de&#10;sucursal. Su caída genera atraso de sincronización." parent="group-notes-3386-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="585.331055" height="522.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5113.635645" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5179.635645" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Angular + Tauri (escritorio), Angular + Capacitor (móvil) y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5248.635645" width="1643.80957" height="67.5" as="geometry" />
        </mxCell>
