        <mxCell id="legend-desc" value="Flecha: iniciador → destino; texto: propósito y protocolo. Borde discontinuo: límite nombrado. Todo el contenido es editable." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=19;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="330" width="1039.266602" height="23.75" as="geometry" />
        </mxCell>
        <mxCell id="reading-title" value="Contratos que gobiernan esta vista" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2493.135645" width="496.3125" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-2557-0-bg" value="" parent="group-notes-2557-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2557-0-title" value="Programado, incremental o manual" parent="group-notes-2557-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="390.478516" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2557-0-body" value="Calendario y zona horaria IANA, ventanas, límites, backoff y jitter son&#10;configuración explícita. Carga masiva programada o manual utiliza el&#10;mismo pipeline auditado. Una ejecución manual no salta validaciones." parent="group-notes-2557-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="683.632812" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2557-1-bg" value="" parent="group-notes-2557-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2557-1-title" value="Recibido no equivale a aplicado" parent="group-notes-2557-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="353.027344" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2557-1-body" value="Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una&#10;candidata completa aislada; snapshot incorpora cambios posteriores al&#10;corte H, incluyendo bajas. Toda candidata pasa por validación antes de&#10;activar." parent="group-notes-2557-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="694.675781" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-2557-2-bg" value="" parent="group-notes-2557-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2557-2-title" value="Publicación atómica, sin bloqueo prolongado" parent="group-notes-2557-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="496.166992" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2557-2-body" value="Descarga, checksum, referencias, cobertura, compatibilidad y vigencia se&#10;validan fuera del commit final. Una transacción corta cambia inbox aplicada&#10;+ puntero activo + cursor aplicado. Impedir regresión por snapshots lentos&#10;y retener versiones referenciadas." parent="group-notes-2557-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="734.9375" height="110" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2835.385645" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-0-bg" value="" parent="group-notes-2910-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-0-title" value="Planificador y supervisor" parent="group-notes-2910-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="272.338867" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-0-body" value="Componente · Worker TypeScript&#10;&#10;Carga incremental continua según política, bulk programable y&#10;recuperación manual usan el mismo pipeline validado. Zona horaria IANA,&#10;límites, backoff y jitter son configuración explícita.&#10;&#10;AUTORIDAD · Checkpoint y calendario por flujo; operación auditada.&#10;&#10;CONTINUIDAD · Cierra admisión, drena o conserva checkpoint; no&#10;convierte timeout en rechazo." parent="group-notes-2910-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="723.948242" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-1-bg" value="" parent="group-notes-2910-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-1-title" value="Emisor de outbox" parent="group-notes-2910-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="194.543457" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-1-body" value="Componente · Worker TypeScript / HTTPS&#10;&#10;Lee outbox confirmada, arma lotes acotados y mantiene&#10;commandId/eventId, país, sucursal, versión de contrato y secuencia. La&#10;entrega es al menos una vez, no exactly once universal.&#10;&#10;AUTORIDAD · Reintento de los mismos eventos; claim/lease técnico con&#10;recuperación.&#10;&#10;CONTINUIDAD · Conserva cola durable; no elimina pendientes por pérdida&#10;de conexión." parent="group-notes-2910-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="736.129883" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-2-bg" value="" parent="group-notes-2910-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-2-title" value="Receptor de deltas y acuses" parent="group-notes-2910-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="315.454102" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-2-body" value="Componente · Worker TypeScript / HTTPS&#10;&#10;Los acuses del país llegan por respuestas o consulta autenticada. Un&#10;acuse perdido provoca replay con identidad original; nunca inventa un&#10;número ERP.&#10;&#10;AUTORIDAD · Distingue ACK de aplicación local de resultado&#10;financiero/fiscal/ERP.&#10;&#10;CONTINUIDAD · Reanuda desde cursor durable; si hay huecos, solicita&#10;recuperación." parent="group-notes-2910-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="700.637695" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-3-bg" value="" parent="group-notes-2910-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-3-title" value="Inbox y deduplicación" parent="group-notes-2910-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="240.441895" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-3-body" value="Componente · Transacciones SQL / TypeScript&#10;&#10;Detecta duplicados, desorden y huecos. Aplica deltas a una candidata&#10;aislada y la entrega al validador. Descarga y preparación quedan fuera de&#10;la transacción final; al activar se confirman inbox aplicada, efecto y cursor&#10;aplicado juntos.&#10;&#10;AUTORIDAD · Inbox recibida, staging y cursor de recepción son durables;&#10;no equivalen a inbox aplicada ni cursor aplicado.&#10;&#10;CONTINUIDAD · Replay repetido no duplica el efecto local. Restore exige&#10;conciliar evidencia." parent="group-notes-2910-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="723.486328" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-4-bg" value="" parent="group-notes-2910-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-4-title" value="Carga de snapshot" parent="group-notes-2910-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="211.254883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-4-body" value="Componente · Descarga HTTPS / TypeScript&#10;&#10;Carga masiva programada o manual; recibe manifiesto, versión, cobertura&#10;y watermark. Verifica chunks/checksum y recupera deltas posteriores antes&#10;de declarar una versión lista.&#10;&#10;AUTORIDAD · Staging aislado; datasetVersion y watermark de origen&#10;identificables.&#10;&#10;CONTINUIDAD · La versión activa sigue sirviendo mientras se descarga o&#10;falla una carga." parent="group-notes-2910-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="734.873047" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-5-bg" value="" parent="group-notes-2910-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-5-title" value="Validador de publicación" parent="group-notes-2910-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="270.556641" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-5-body" value="Componente · Reglas TypeScript / SQL&#10;&#10;Verifica checksum, referencias, monotonicidad, watermark, cantidad,&#10;fechas y compatibilidad fuera de la transacción final de activación. La&#10;candidata validada permanece identificada e inmutable; no se retiene una&#10;transacción durante la descarga.&#10;&#10;AUTORIDAD · Impide activar lotes parciales o incompatibles.&#10;&#10;CONTINUIDAD · Si no pasa validación se mantiene la versión previa,&#10;dentro de su vigencia autorizada." parent="group-notes-2910-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="719.157227" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-6-bg" value="" parent="group-notes-2910-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-6-title" value="Activación de versión" parent="group-notes-2910-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="236.230469" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-6-body" value="Componente · Transacción SQL / TypeScript&#10;&#10;Recibe una candidata completa e inmutable validada, de snapshot o deltas.&#10;Recomprueba precondiciones y cambia el puntero en un commit corto, sin&#10;descarga ni validación pesada dentro de SQL. Recibido no significa&#10;aplicado.&#10;&#10;AUTORIDAD · Commit corto de inbox aplicada, efecto/puntero y cursor&#10;aplicado; conserva versiones aún referenciadas.&#10;&#10;CONTINUIDAD · Nuevas ventas usan la versión activa; ventas abiertas&#10;conservan la versión fijada." parent="group-notes-2910-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="737.494141" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-7-bg" value="" parent="group-notes-2910-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-7-title" value="Datos de sucursal" parent="group-notes-2910-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-7-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Ventas, caja, pagos y evidencia fiscal son locales. Inbox, outbox, cursores y&#10;staging tienen restricciones y transacciones. Catálogo, precios y&#10;promociones son réplicas de lectura autorizadas, no maestros&#10;independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API&#10;escribe negocio; worker escribe su esquema técnico y publica espejos por&#10;un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica&#10;respaldo, alta disponibilidad ni recuperación automática." parent="group-notes-2910-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="738.632812" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-8-bg" value="" parent="group-notes-2910-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="783.86582" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-8-title" value="API de país" parent="group-notes-2910-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="129.248047" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2910-8-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;Valida identidad y contrato; aplica el efecto/proyección local junto con inbox&#10;y outbox en un único commit antes de acusar aplicación. No basta guardar&#10;la recepción. El ACK no declara éxito de ERP, pago ni fiscalidad.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y&#10;outbox juntos antes del ACK de aplicación.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su caída&#10;genera atraso de sincronización." parent="group-notes-2910-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="734.604492" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4335.135645" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4401.135645" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Angular + Tauri (escritorio), Angular + Capacitor (móvil) y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4470.135645" width="1643.80957" height="67.5" as="geometry" />
        </mxCell>
