        </mxCell>
        <mxCell id="notes-1572-0-body" value="Sucursal conserva la venta original. País consolida una&#10;proyección. Precio, efecto financiero del pago, documento fiscal y&#10;contabilización ERP tienen autoridades y estados diferentes." parent="group-notes-1572-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="639.579102" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-1-bg" value="" parent="group-notes-1572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-1-title" value="Continuidad autorizada" parent="group-notes-1572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="257.128906" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-1-body" value="Perfil inicial: caída de WAN con LAN, backend y PostgreSQL de&#10;sucursal disponibles. Vigencia de precios, permisos, límites y&#10;capacidades de pago/fiscalidad determinan qué puede continuar." parent="group-notes-1572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="634.798828" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-2-bg" value="" parent="group-notes-1572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-2-title" value="Chile y evolución multinacional" parent="group-notes-1572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.845703" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-2-body" value="Antecedentes: Chile Dynamics AX on-premise; España Gira; Perú&#10;sistema custom. Interfaces por validar. No se asigna stock al POS&#10;ni se declara un ERP futuro ya aprobado." parent="group-notes-1572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="644.413086" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1822.990033" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-0-bg" value="" parent="group-notes-1898-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-0-title" value="Cajero" parent="group-notes-1898-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="73.64502" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-0-body" value="Persona · Operación humana&#10;&#10;Usa el cliente del puesto. Abrir o cerrar sesión de usuario no&#10;equivale a abrir o cerrar el turno de caja.&#10;&#10;AUTORIDAD · Ejecuta operaciones con permisos; no administra la&#10;base.&#10;&#10;CONTINUIDAD · Acceso local y operaciones habilitadas según&#10;vigencia, permisos y política offline." parent="group-notes-1898-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="652.53418" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-1-bg" value="" parent="group-notes-1898-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-1-title" value="Supervisor de sucursal" parent="group-notes-1898-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="254.284668" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-1-body" value="Persona · Operación humana&#10;&#10;Consulta resultados, autoriza acciones permitidas y resuelve&#10;incidencias con evidencia.&#10;&#10;AUTORIDAD · Responsable operativo; los comandos mantienen&#10;autorización y auditoría.&#10;&#10;CONTINUIDAD · Solo facultades previamente habilitadas; sin&#10;inventar autorización central." parent="group-notes-1898-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="630.566406" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-2-bg" value="" parent="group-notes-1898-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-2-title" value="Operación de plataforma" parent="group-notes-1898-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="275.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-2-body" value="Persona · Soporte autorizado&#10;&#10;Programa cargas y ventanas, supervisa atrasos, coordina&#10;restauraciones y conciliaciones.&#10;&#10;AUTORIDAD · Administra configuración y reintentos auditados; no&#10;corrige dinero con SQL libre.&#10;&#10;CONTINUIDAD · Consulta evidencia local; la plataforma de país&#10;puede estar inaccesible sin WAN." parent="group-notes-1898-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="647.667969" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-3-bg" value="" parent="group-notes-1898-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-3-title" value="POS corporativo" parent="group-notes-1898-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="183.410645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-3-body" value="Sistema de software · Plataforma de caja&#10;&#10;Sistema objetivo común para Chile, Perú y España. Aplicaciones&#10;completas con frontend Angular alojado por las shells nativas Tauri&#10;(escritorio) y Capacitor (móvil), aceptadas como dirección;&#10;backend, datos y topología son recomendaciones por validar.&#10;device-agent es la aplicación autónoma propuesta para operar&#10;periféricos desde un equipo Windows, bajo autorización del&#10;backend; su journal técnico no sustituye PostgreSQL.&#10;&#10;AUTORIDAD · La venta nace en sucursal; país mantiene la&#10;proyección consolidada.&#10;&#10;CONTINUIDAD · Perfil inicial: WAN caída con LAN y escritor de&#10;sucursal disponibles." parent="group-notes-1898-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="651.814453" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-4-bg" value="" parent="group-notes-1898-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-4-title" value="ERP del país" parent="group-notes-1898-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-4-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en&#10;Perú son antecedentes; versión, interfaces y capacidades deben&#10;confirmarse. No se afirma que exista el adaptador objetivo en&#10;producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país;&#10;no la base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente;&#10;no revierte una venta local confirmada." parent="group-notes-1898-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="635.830078" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-5-bg" value="" parent="group-notes-1898-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-5-title" value="Fuentes de maestros y precios" parent="group-notes-1898-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-5-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener&#10;responsable, contrato, versión y vigencia. La fuente de precios no&#10;se sustituye por una tabla editada libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no se asigna&#10;al ERP por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente dentro&#10;de la política autorizada." parent="group-notes-1898-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="646.49707" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-6-bg" value="" parent="group-notes-1898-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="659.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-6-title" value="Proveedor de pagos" parent="group-notes-1898-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-6-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Autoriza o informa el resultado del pago. Transbank con terminal&#10;local en Chile y Niubiz en Perú proceden de las fuentes revisadas.&#10;Mercado Pago Point es un ejemplo presencial ilustrativo, sin&#10;adopción ni integración acreditadas; Webpay Plus es un ejemplo&#10;de pago online de Transbank, distinto de su terminal de tienda. En&#10;España se informan BBVA/Redsys con TPV portátiles sin conexión&#10;a Gira y conciliación contable; no se presume una API o SDK ya&#10;integrado. Cada ruta y capacidad requiere homologación. Pago,&#10;venta, documento fiscal e integración ERP tienen estados&#10;distintos. No repetir un cargo incierto ni cambiar de proveedor para&#10;resolverlo automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS&#10;registra intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un&#10;timeout puede dejar resultado desconocido." parent="group-notes-1898-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="652.587891" height="522.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-7-bg" value="" parent="group-notes-1898-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="659.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-7-title" value="Proveedor de facturación" parent="group-notes-1898-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="279.333496" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-7-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Acepta/Ingydev aparecen en el código legacy chileno y EFACT en&#10;las fuentes de Perú. Gira se informa como solución de España; su&#10;modalidad fiscal, interfaces y capacidades deben confirmarse.&#10;Estos ejemplos no seleccionan un proveedor corporativo ni&#10;acreditan adaptadores homologados para POS Platform. SII y&#10;SUNAT son autoridades tributarias, no estos proveedores de&#10;software; en España corresponde la autoridad del régimen y&#10;territorio aplicables. Emisión, aceptación y transmisión se modelan&#10;por separado. No se inventa un proveedor común ni una&#10;capacidad de consulta o idempotencia no acreditada.&#10;&#10;AUTORIDAD · La solución prepara, emite o transmite documentos&#10;por cuenta del contribuyente según su contrato. La autoridad&#10;tributaria es distinta: SII en Chile, SUNAT en Perú y la autoridad&#10;aplicable en España.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal&#10;válidos; no se promete universalmente." parent="group-notes-1898-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="649.300781" height="550" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-8-bg" value="" parent="group-notes-1898-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="697.735303" height="659.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-8-title" value="Periféricos físicos" parent="group-notes-1898-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="195.88623" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-8-body" value="Hardware externo · Driver / SDK homologado&#10;&#10;Hardware de sucursal conectado al equipo que ejecuta&#10;device-agent. La impresión conserva referencia de documento y&#10;trabajo; el spooler sólo informa recepción técnica. Reimpresión es&#10;una operación autorizada explícita. Lectores y demás capacidades&#10;requieren contratos y homologación propios. El SDK de un&#10;terminal de pago no se presume habilitado por migrar impresión.&#10;&#10;AUTORIDAD · Un único device-agent autorizado opera cada&#10;equipo físico. La aplicación solicita capacidades a branch-api.&#10;&#10;CONTINUIDAD · La capacidad depende del equipo, driver y&#10;estado físico. Un timeout puede dejar resultado incierto." parent="group-notes-1898-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="650.62207" height="385" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3570.240033" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3636.240033" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. device-agent: C#/.NET Windows propuesto, aún no implementado; journal técnico&#10;SQLite, sin autoridad de ventas. Backend, datos e integración: diseño por implementar. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3705.240033" width="2132.041992" height="90" as="geometry" />
        </mxCell>
