        </mxCell>
        <mxCell id="notes-1572-0-body" value="Sucursal conserva la venta original. País consolida una proyección. Precio,&#10;efecto financiero del pago, documento fiscal y contabilización ERP tienen&#10;autoridades y estados diferentes." parent="group-notes-1572-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="732.509766" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-1-bg" value="" parent="group-notes-1572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-1-title" value="Continuidad autorizada" parent="group-notes-1572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="257.128906" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-1-body" value="Perfil inicial: caída de WAN con LAN, backend y PostgreSQL de sucursal&#10;disponibles. Vigencia de precios, permisos, límites y capacidades de&#10;pago/fiscalidad determinan qué puede continuar." parent="group-notes-1572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="712.078125" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-2-bg" value="" parent="group-notes-1572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-2-title" value="Chile y evolución multinacional" parent="group-notes-1572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.845703" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-2-body" value="Antecedentes: Chile Dynamics AX on-premise; España Gira; Perú sistema&#10;custom. Interfaces por validar. No se asigna stock al POS ni se declara un ERP&#10;futuro ya aprobado." parent="group-notes-1572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="774.039062" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1822.990033" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-0-bg" value="" parent="group-notes-1898-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-0-title" value="Cajero" parent="group-notes-1898-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="73.64502" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-0-body" value="Persona · Operación humana&#10;&#10;Usa el cliente del puesto. Abrir o cerrar sesión de usuario no equivale a abrir o&#10;cerrar el turno de caja.&#10;&#10;AUTORIDAD · Ejecuta operaciones con permisos; no administra la base.&#10;&#10;CONTINUIDAD · Acceso local y operaciones habilitadas según vigencia,&#10;permisos y política offline." parent="group-notes-1898-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="764.306641" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-1-bg" value="" parent="group-notes-1898-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-1-title" value="Supervisor de sucursal" parent="group-notes-1898-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="254.284668" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-1-body" value="Persona · Operación humana&#10;&#10;Consulta resultados, autoriza acciones permitidas y resuelve incidencias con&#10;evidencia.&#10;&#10;AUTORIDAD · Responsable operativo; los comandos mantienen autorización y&#10;auditoría.&#10;&#10;CONTINUIDAD · Solo facultades previamente habilitadas; sin inventar&#10;autorización central." parent="group-notes-1898-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="772.416992" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-2-bg" value="" parent="group-notes-1898-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-2-title" value="Operación de plataforma" parent="group-notes-1898-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="275.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-2-body" value="Persona · Soporte autorizado&#10;&#10;Programa cargas y ventanas, supervisa atrasos, coordina restauraciones y&#10;conciliaciones.&#10;&#10;AUTORIDAD · Administra configuración y reintentos auditados; no corrige&#10;dinero con SQL libre.&#10;&#10;CONTINUIDAD · Consulta evidencia local; la plataforma de país puede estar&#10;inaccesible sin WAN." parent="group-notes-1898-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="749.568359" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-3-bg" value="" parent="group-notes-1898-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="576.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-3-title" value="POS corporativo" parent="group-notes-1898-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="183.410645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-3-body" value="Sistema de software · Plataforma de caja&#10;&#10;Sistema objetivo común para Chile, Perú y España. Aplicaciones completas con&#10;frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor&#10;(móvil), aceptadas como dirección; backend, datos y topología son&#10;recomendaciones por validar. device-agent es la aplicación autónoma&#10;propuesta para operar periféricos desde un equipo Windows, bajo autorización&#10;del backend; su journal técnico no sustituye PostgreSQL. Primera entrega F02:&#10;agente dedicado en el puesto Windows con periféricos locales; piloto F05.&#10;Periféricos de red y estación compartida son expansión F06 condicionada a&#10;homologación.&#10;&#10;AUTORIDAD · La venta nace en sucursal; país mantiene la proyección&#10;consolidada.&#10;&#10;CONTINUIDAD · Perfil inicial: WAN caída con LAN y escritor de sucursal&#10;disponibles." parent="group-notes-1898-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="780.183594" height="467.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-4-bg" value="" parent="group-notes-1898-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="576.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-4-title" value="ERP del país" parent="group-notes-1898-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-4-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú son&#10;antecedentes; versión, interfaces y capacidades deben confirmarse. No se&#10;afirma que exista el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la base de&#10;ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no revierte una&#10;venta local confirmada." parent="group-notes-1898-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="778.980469" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-5-bg" value="" parent="group-notes-1898-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="576.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-5-title" value="Fuentes de maestros y precios" parent="group-notes-1898-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-5-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener responsable, contrato,&#10;versión y vigencia. La fuente de precios no se sustituye por una tabla editada&#10;libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP por&#10;defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la política&#10;autorizada." parent="group-notes-1898-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="780.226562" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-6-bg" value="" parent="group-notes-1898-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-6-title" value="Proveedor de pagos" parent="group-notes-1898-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-6-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Autoriza o informa el resultado del pago. Transbank con terminal local en Chile&#10;y Niubiz en Perú proceden de las fuentes revisadas. Mercado Pago Point es un&#10;ejemplo presencial ilustrativo, sin adopción ni integración acreditadas; Webpay&#10;Plus es un ejemplo de pago online de Transbank, distinto de su terminal de&#10;tienda. En España se informan BBVA/Redsys con TPV portátiles sin conexión a&#10;Gira y conciliación contable; no se presume una API o SDK ya integrado. Cada&#10;ruta y capacidad requiere homologación. Pago, venta, documento fiscal e&#10;integración ERP tienen estados distintos. No repetir un cargo incierto ni cambiar&#10;de proveedor para resolverlo automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra intento,&#10;referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout&#10;puede dejar resultado desconocido." parent="group-notes-1898-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="780.183594" height="467.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-7-bg" value="" parent="group-notes-1898-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-7-title" value="Proveedor de facturación" parent="group-notes-1898-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="279.333496" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-7-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Acepta/Ingydev aparecen en el código legacy chileno y EFACT en las fuentes&#10;de Perú. Gira se informa como solución de España; su modalidad fiscal,&#10;interfaces y capacidades deben confirmarse. Estos ejemplos no seleccionan un&#10;proveedor corporativo ni acreditan adaptadores homologados para POS&#10;Platform. SII y SUNAT son autoridades tributarias, no estos proveedores de&#10;software; en España corresponde la autoridad del régimen y territorio&#10;aplicables. Emisión, aceptación y transmisión se modelan por separado. No se&#10;inventa un proveedor común ni una capacidad de consulta o idempotencia no&#10;acreditada.&#10;&#10;AUTORIDAD · La solución prepara, emite o transmite documentos por cuenta&#10;del contribuyente según su contrato. La autoridad tributaria es distinta: SII en&#10;Chile, SUNAT en Perú y la autoridad aplicable en España.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se&#10;promete universalmente." parent="group-notes-1898-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="775.328125" height="495" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-8-bg" value="" parent="group-notes-1898-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-8-title" value="Periféricos del puesto" parent="group-notes-1898-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="240.405273" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-8-body" value="Hardware externo · USB / serie · driver / SDK&#10;&#10;Perfil inicial F02 y piloto F05: impresora de recibos, etiquetas o lector MICR&#10;conectado al puesto Windows mediante USB/serie y driver o SDK homologado.&#10;No se ofrece a otros puestos o móviles por defecto. La impresión conserva&#10;referencia de documento y trabajo; el spooler sólo informa recepción técnica. La&#10;reimpresión requiere autorización explícita. Compartir dispositivos por red es&#10;una expansión F06 con homologación por modelo; cajón, MICR y terminales de&#10;pago no heredan esa capacidad.&#10;&#10;AUTORIDAD · Un único device-agent autorizado opera cada equipo físico. La&#10;aplicación solicita capacidades a branch-api.&#10;&#10;CONTINUIDAD · La capacidad depende del equipo, driver y estado físico. Un&#10;timeout puede dejar resultado incierto." parent="group-notes-1898-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="781.44043" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-9-bg" value="" parent="group-notes-1898-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="827.227344" height="576.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-9-title" value="Periféricos de red · F06" parent="group-notes-1898-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="261.218262" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1898-9-body" value="Hardware externo · TCP/IP · driver / SDK homologado&#10;&#10;Expansión F06 posterior al piloto F05 del puesto dedicado. Homologar&#10;impresoras de recibos y etiquetas accesibles por red y, cuando se requiera, una&#10;estación compartida Windows que ejecute la misma apps/device-agent. La línea&#10;discontinua representa una capacidad futura; no instala otro agente en el&#10;servidor por defecto. Mantener protocolo HTTPS con branch-api, propiedad&#10;exclusiva, configuración, diagnóstico, journal local y control de concurrencia.&#10;Homologar el acceso de móviles por permisos y destino explícitos. MICR, cajón&#10;y pagos requieren evaluación propia; una impresora de red no los habilita.&#10;&#10;AUTORIDAD · Un controlador activo por dispositivo físico, asignado a una&#10;instancia certificada de la misma apps/device-agent. No es otra aplicación del&#10;monorepo.&#10;&#10;CONTINUIDAD · Sin LAN no se aceptan trabajos nuevos. Cortes, reconexión o&#10;cambio de controlador no autorizan repetir un efecto incierto." parent="group-notes-1898-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="782.654297" height="467.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4170.990033" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4236.990033" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. F01: operación local persistida. F02: host .NET/SQLite y protocolo en revisión; drivers físicos pendientes. F05: piloto por puesto.&#10;F06: red y estación compartida por homologar, sin autoridad de ventas. Sincronización e integración siguen propuestas. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4305.990033" width="2500.207031" height="90" as="geometry" />
        </mxCell>
