        </mxCell>
        <mxCell id="notes-3094-0-bg" value="" parent="group-notes-3094-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="2608.593164" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-0-title" value="Frontera de continuidad" parent="group-notes-3094-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="264.0625" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-0-body" value="Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen nuevos comandos dependientes; el puesto no se convierte en escritor de emergencia. Redis de trabajos existe en país y red ERP, sin acceso WAN ni&#10;Redis por sucursal. Su caída retrasa jobs; la venta local conserva sus dependencias de LAN y PostgreSQL." parent="group-notes-3094-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="2528.173828" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-1-bg" value="" parent="group-notes-3094-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="2608.593164" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-1-title" value="Puesto inicial y expansión F06" parent="group-notes-3094-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="337.695312" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-1-body" value="F02: pos-desktop y device-agent son procesos independientes en el mismo puesto Windows; SQLite técnico y periféricos USB/serie permanecen allí. F05 valida ese perfil. La línea discontinua representa F06: impresoras de red y estación compartida certificada&#10;con la misma aplicación. Ubicación de la instancia, permisos, concurrencia y acceso móvil se homologan antes de habilitarla; el servidor no es su ubicación predeterminada." parent="group-notes-3094-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="2539.882812" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-2-bg" value="" parent="group-notes-3094-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="2608.593164" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-2-title" value="Recuperación y operación" parent="group-notes-3094-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="290.454102" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-2-body" value="Backups fuera de la instancia y ensayos de restore. RPO/RTO, retención, dimensionamiento y alta disponibilidad deben validarse. Excluir al escritor antiguo antes de recuperar; réplica no reemplaza backup. Logs, métricas y trazas correlacionan operación e&#10;intento." parent="group-notes-3094-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="2502.414062" height="55" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3316.85" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-0-bg" value="" parent="group-notes-3392-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-0-title" value="pos-desktop" parent="group-notes-3392-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="136.193848" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-0-body" value="Contenedor · Angular (frontend) · Tauri (shell nativa)&#10;&#10;apps/pos-desktop entrega la aplicación completa: la shell nativa Tauri aloja el frontend Angular. Tiene arranque, configuración nativa y build propios. Comparte con pos-mobile libs/client-shell: raíz,&#10;configuración, rutas, guards y layout Angular; esta biblioteca no es la shell nativa ni un proceso adicional. Solicita capacidades de dispositivos a branch-api; no transporta trabajos a device-agent&#10;ni necesita mantenerse abierto para que éste opere. Distribución e integración nativa requieren homologación; no posee autoridad de ventas. F02 instala device-agent y su journal en el mismo&#10;puesto Windows; son procesos independientes. El perfil dedicado sólo recibe trabajos asignados a ese puesto.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes." parent="group-notes-3392-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1904.47168" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-1-bg" value="" parent="group-notes-3392-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-1-title" value="pos-mobile" parent="group-notes-3392-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="122.277832" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-1-body" value="Contenedor · Angular (frontend) · Capacitor (shell nativa)&#10;&#10;apps/pos-mobile entrega la aplicación completa: la shell nativa Capacitor aloja el frontend Angular. Tiene arranque, configuración nativa y build propios. Comparte con pos-desktop libs/client-shell:&#10;raíz, configuración, rutas, guards y layout Angular; esta biblioteca no es la shell nativa ni un proceso adicional. Los adaptadores actuales son mock. Instalación, ciclo de vida, almacenamiento y&#10;capacidades nativas requieren pruebas Android/iOS; no hay acceso SQL ni permisos implícitos por empaquetar la interfaz. El acceso móvil a periféricos compartidos se habilita en F06 tras&#10;homologación y asignación explícita. Solicita capacidades a branch-api; no usa por defecto el agente dedicado a otro puesto ni depende de pos-desktop como relé.&#10;&#10;AUTORIDAD · Comparte interfaz y contratos; no otra autoridad de ventas.&#10;&#10;CONTINUIDAD · Requiere conexión autorizada al backend de sucursal. El móvil no incorpora autonomía sin LAN." parent="group-notes-3392-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1902.043945" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-2-bg" value="" parent="group-notes-3392-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-2-title" value="device-agent" parent="group-notes-3392-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="143.151855" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-2-body" value="Contenedor · C# / .NET · Windows&#10;&#10;Aplicación objetivo apps/device-agent, aún no implementada. Primera entrega F02: proceso autónomo instalado en el mismo puesto Windows que pos-desktop; controla periféricos USB/serie&#10;mediante drivers o SDK homologados y conserva allí su journal SQLite. El piloto F05 valida ese perfil dedicado. Opera sin la ventana de pos-desktop abierta e inicia HTTPS LAN autenticado&#10;hacia branch-api para obtener trabajos del puesto y reportar evidencia. Cada trabajo conserva jobId, hash, destino y autorización; spool aceptado no acredita impresión física. F06 incorpora&#10;impresoras de recibos y etiquetas en red y una estación compartida certificada, con la misma aplicación y contratos de propiedad; no habilita automáticamente MICR, cajón, pagos ni acceso móvil&#10;a cualquier caja. El servidor de sucursal no aloja el agente por defecto.&#10;&#10;AUTORIDAD · F02: agente dedicado al puesto y sus dispositivos; branch-api autoriza sólo trabajos del puesto asignado. F06 amplía a una estación compartida homologada con un único&#10;controlador por dispositivo físico.&#10;&#10;CONTINUIDAD · Sin LAN no obtiene trabajos nuevos. Conserva evidencia del trabajo en curso para reanudar su reporte; un resultado incierto no autoriza repetir el efecto." parent="group-notes-3392-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1903.988281" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-3-bg" value="" parent="group-notes-3392-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-3-title" value="Journal técnico de dispositivos" parent="group-notes-3392-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="339.074707" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-3-body" value="Contenedor de datos · SQLite&#10;&#10;F02/F05: diario técnico local del puesto; F06: diario propio de cada instancia certificada, nunca una SQLite compartida por red. Persistencia técnica propuesta. Registra recepción durable,&#10;identidad de agente y equipo, hash del contenido, intento y evidencia del driver/spooler. Mismo jobId con distinto hash es conflicto. Guarda evidencia antes de reportarla; no interpreta spool&#10;accepted como impresión física. Restore o pérdida del journal exige reconciliar antes de repetir efectos; un lease vencido no prueba que el hardware no actuó.&#10;&#10;AUTORIDAD · Privado de device-agent en el puesto Windows inicial. No contiene ventas, caja, precios ni autoridad financiera.&#10;&#10;CONTINUIDAD · Conserva jobId, hash y estados técnicos durante cortes de LAN; al reconectar reporta con la misma identidad." parent="group-notes-3392-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1835.710938" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-4-bg" value="" parent="group-notes-3392-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-4-title" value="branch-api" parent="group-notes-3392-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="118.127441" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-4-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/branch-api compone los contextos operativos: sales/returns, cash/collections, pricing/catalog, payments/devices, fiscal, reporting y administration. sync aporta el contrato outbox que se&#10;confirma con negocio. El transporte pertenece a branch-sync-worker y la ACL ERP a erp-worker. Bibliotecas no equivalen a microservicios; las capacidades de negocio aún requieren&#10;implementación. devices autoriza y conserva trabajos, auditoría y observaciones de periféricos en PostgreSQL de sucursal. Recibe evidencia de device-agent por conexiones iniciadas por el&#10;agente; los clientes no actúan como relé. Registrar o imprimir un trabajo conserva la referencia del documento y no modifica la confirmación de la venta.&#10;&#10;AUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos internos, un proceso.&#10;&#10;CONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del escritor autorizado." parent="group-notes-3392-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1849.020508" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-5-bg" value="" parent="group-notes-3392-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-5-title" value="Datos de sucursal" parent="group-notes-3392-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-5-body" value="Contenedor de datos · PostgreSQL&#10;&#10;branch-api y branch-sync-worker acceden al mismo PostgreSQL de la sucursal con responsabilidades y permisos distintos. Ventas, caja, pagos y evidencia fiscal se conservan aquí. devices es&#10;propietario de los trabajos autorizados, su auditoría y las observaciones de periféricos recibidas del agente; estos registros conservan identidad y referencia al documento, sin formar parte de la&#10;misma transacción de confirmación de venta. El journal SQLite privado del agente sólo registra ejecución técnica. Inbox, outbox, cursores y staging tienen restricciones y transacciones según&#10;cada operación. Las llamadas de red quedan fuera de esas transacciones. Catálogo, precios y promociones son réplicas de lectura autorizadas, no maestros independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API escribe negocio; worker escribe su esquema técnico y publica espejos por un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica respaldo, alta disponibilidad ni recuperación automática." parent="group-notes-3392-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1878.368164" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-6-bg" value="" parent="group-notes-3392-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-6-title" value="branch-sync-worker" parent="group-notes-3392-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="219.506836" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-6-body" value="Contenedor · NestJS / Node.js · sin servidor HTTP&#10;&#10;apps/branch-sync-worker compone libs/backend/sync con pricing/catalog para preparar y activar versiones. Entrega outbox por HTTPS con identidad y cursor; confirma acuses durables. El&#10;proceso supervisado sigue activo aunque el cliente se cierre. Descarga, staging, validación y activación conservan límites transaccionales. No requiere Redis ni BullMQ por sucursal: el control de&#10;pendientes, calendario, cursores y activación utiliza PostgreSQL local y HTTPS.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita reintentos y trabajo en curso." parent="group-notes-3392-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1894.180664" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-7-bg" value="" parent="group-notes-3392-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-7-title" value="country-api" parent="group-notes-3392-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="123.669434" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-7-body" value="Contenedor · NestJS + Fastify / Node.js · BullMQ&#10;&#10;apps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único commit antes del ACK de aplicación. Expone trabajo y resultados al&#10;erp-worker mediante HTTPS saliente iniciado por ese worker. Valida, publica y sirve versiones preparadas mediante MasterDataSourcePort en erp-worker; no ejecuta la ACL ni carga masiva&#10;pesada en un endpoint. La caché opcional acelera lecturas reconstruibles, con PostgreSQL como fuente durable. BullMQ es la librería elegida dentro del mismo proceso para programar&#10;publicaciones y ejecutar tareas breves fuera de HTTP. Usa Redis de trabajos exclusivo de país; PostgreSQL conserva solicitudes, calendario, outbox y resultados para reconstruir jobs. La&#10;preparación pesada se ejecuta en erp-worker. La decisión está adoptada; su integración todavía no está implementada.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación. Conserva autoridad de versiones, manifiestos y publicación de maestros.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización." parent="group-notes-3392-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1848.461914" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-8-bg" value="" parent="group-notes-3392-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-8-title" value="Datos operativos de país" parent="group-notes-3392-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-8-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención, backups y deduplicación deben cubrir el horizonte de replay y restauración. ACK de aplicación local no equivale a contabilización&#10;ERP. Conserva también calendarios, solicitudes de publicación, intentos y checkpoints durables. La outbox permite encolar tras el commit y un reconciliador reconstruye jobs pendientes sin&#10;confiar en la permanencia del historial Redis.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox, outbox, versiones y resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo concurrente offline de saldos globales." parent="group-notes-3392-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1884.544922" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-9-bg" value="" parent="group-notes-3392-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-9-title" value="Redis · trabajos de país" parent="group-notes-3392-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="264.025879" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-9-body" value="Contenedor de datos · Redis dedicado · BullMQ&#10;&#10;Dependencia obligatoria de la arquitectura elegida, aún no implementada. Red privada, autenticación y TLS según despliegue; sin conexión desde sucursales ni desde la red ERP. Persistencia&#10;Redis y política noeviction para proteger jobs, capacidad y retención acotadas. El relay encola después del commit PostgreSQL y la reconciliación reconstruye pendientes por identidad estable.&#10;Perder Redis no autoriza repetir efectos; BullMQ no ofrece exactamente una vez sobre sistemas externos.&#10;&#10;AUTORIDAD · Instancia exclusiva del dominio país; separada del Redis de caché. PostgreSQL conserva calendario, solicitudes, outbox y resultados de negocio.&#10;&#10;CONTINUIDAD · Si falla, se detiene la programación y ejecución de jobs del país. Los pendientes durables se conservan en PostgreSQL; no revierte ventas confirmadas ni habilita ACK sin&#10;commit." parent="group-notes-3392-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1875.961914" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-10-bg" value="" parent="group-notes-3392-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-10-title" value="Redis · trabajos de ERP" parent="group-notes-3392-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="268.17627" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-10-body" value="Contenedor de datos · Redis dedicado · BullMQ&#10;&#10;Dependencia obligatoria de la arquitectura elegida, aún no implementada. BullMQ almacena colas, retrasos y metadatos técnicos en esta instancia con noeviction y persistencia operada. Límites&#10;separados para preparación masiva y operaciones/consultas de conciliación. La recuperación usa country-api por HTTPS; no abre Redis ni PostgreSQL a través de WAN. El job técnico no&#10;sustituye el lease de negocio ni el resultado ERP y nunca habilita reenviar ciegamente una operación incierta.&#10;&#10;AUTORIDAD · Instancia exclusiva de erp-worker en la red autorizada del ERP. No comparte Redis con país ni con su caché; el estado de negocio reside en PostgreSQL de país.&#10;&#10;CONTINUIDAD · Sin Redis local se detiene la admisión de jobs ERP. Al recuperar, consulta por HTTPS trabajo, intentos y resultados durables antes de reconstruir pendientes." parent="group-notes-3392-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1890.635742" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-11-bg" value="" parent="group-notes-3392-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-11-title" value="Redis · caché de país (opcional)" parent="group-notes-3392-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="358.520508" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-11-body" value="Contenedor de datos · Redis · datos reconstruibles&#10;&#10;Ampliación opcional sujeta a medición, capacidad y operación. La API comprueba identidad, ámbito y autorización antes de leer. Las claves incluyen país, entidad legal, versión y alcance de&#10;permisos cuando afecte al resultado; un prefijo no sustituye autorización. TTL y vigencia comercial son independientes. El fallback limita concurrencia, esperas y llenados para proteger&#10;PostgreSQL. No es la inbox, outbox, base de ventas ni único registro de permisos, dinero o trabajos; se despliega en una instancia separada de Redis de trabajos y no implica Redis en cada&#10;sucursal. Las versiones inmutables evitan mezclar publicaciones y PostgreSQL resuelve la versión autorizada.&#10;&#10;AUTORIDAD · Country-api lee y escribe entradas identificadas por país, entidad y versión. PostgreSQL conserva la autoridad y el estado durable.&#10;&#10;CONTINUIDAD · Un miss, expiración o caída permite consultar PostgreSQL con límites de carga y espera. La ausencia de caché no es condición del commit; la capacidad del origen sigue siendo&#10;necesaria." parent="group-notes-3392-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1902.720703" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-12-bg" value="" parent="group-notes-3392-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-12-title" value="erp-worker" parent="group-notes-3392-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="119.470215" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-12-body" value="Contenedor · NestJS / Node.js · BullMQ&#10;&#10;apps/erp-worker se ejecuta en la red autorizada del ERP e inicia HTTPS autenticado hacia country-api para reclamar trabajo, renovar su lease y registrar resultados. Mantiene destino, versión de&#10;contrato e identidad de intento. Fachada, ACL y adaptadores son componentes de libs/backend/erp, no servicios HTTP separados obligatorios. Chile: AX; Perú: custom; España: Gira, con&#10;interfaces por homologar. No accede por SQL remoto a PostgreSQL de país. La preparación de maestros usa una identidad y presupuesto propios, conexión saliente a country-api y contrato de&#10;fuente homologado; no ejecuta SQL WAN. BullMQ organiza trabajos técnicos, preparación de maestros y consultas de conciliación dentro del mismo proceso. Utiliza Redis de trabajos exclusivo&#10;de la red ERP y obtiene el estado durable por HTTPS de country-api. La cola puede reentregar: antes de actuar revalida estado y autorización; un resultado financiero incierto se consulta o&#10;concilia, no se repite automáticamente. La integración BullMQ está elegida, aún no implementada.&#10;&#10;AUTORIDAD · Proceso con fachada, ACL y adaptadores internos. Prepara maestros por MasterDataSourcePort con identidad y presupuesto aislados; country-api conserva publicaciones y&#10;resultados durables.&#10;&#10;CONTINUIDAD · Si país o ERP no responde, conserva identidad y resultado incierto. Consulta o concilia antes de repetir un efecto." parent="group-notes-3392-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1894.202148" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-13-bg" value="" parent="group-notes-3392-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-13-title" value="ERP del país" parent="group-notes-3392-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-13-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú son antecedentes; versión, interfaces y capacidades deben confirmarse. No se afirma que exista el adaptador objetivo en&#10;producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no revierte una venta local confirmada." parent="group-notes-3392-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1878.335938" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-14-bg" value="" parent="group-notes-3392-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-14-title" value="Proveedor de pagos" parent="group-notes-3392-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-14-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Autoriza o informa el resultado del pago. Transbank con terminal local en Chile y Niubiz en Perú proceden de las fuentes revisadas. Mercado Pago Point es un ejemplo presencial ilustrativo, sin&#10;adopción ni integración acreditadas; Webpay Plus es un ejemplo de pago online de Transbank, distinto de su terminal de tienda. En España se informan BBVA/Redsys con TPV portátiles sin&#10;conexión a Gira y conciliación contable; no se presume una API o SDK ya integrado. Cada ruta y capacidad requiere homologación. Pago, venta, documento fiscal e integración ERP tienen&#10;estados distintos. No repetir un cargo incierto ni cambiar de proveedor para resolverlo automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout puede dejar resultado desconocido." parent="group-notes-3392-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1877.541016" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-15-bg" value="" parent="group-notes-3392-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-15-title" value="Proveedor de facturación" parent="group-notes-3392-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="279.333496" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-15-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Acepta/Ingydev aparecen en el código legacy chileno y EFACT en las fuentes de Perú. Gira se informa como solución de España; su modalidad fiscal, interfaces y capacidades deben&#10;confirmarse. Estos ejemplos no seleccionan un proveedor corporativo ni acreditan adaptadores homologados para POS Platform. SII y SUNAT son autoridades tributarias, no estos proveedores&#10;de software; en España corresponde la autoridad del régimen y territorio aplicables. Emisión, aceptación y transmisión se modelan por separado. No se inventa un proveedor común ni una&#10;capacidad de consulta o idempotencia no acreditada.&#10;&#10;AUTORIDAD · La solución prepara, emite o transmite documentos por cuenta del contribuyente según su contrato. La autoridad tributaria es distinta: SII en Chile, SUNAT en Perú y la autoridad&#10;aplicable en España.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se promete universalmente." parent="group-notes-3392-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1881.59082" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-16-bg" value="" parent="group-notes-3392-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-16-title" value="Respaldo y recuperación" parent="group-notes-3392-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-16-body" value="Infraestructura · Backups PostgreSQL / herramienta por definir&#10;&#10;Backups externos a la instancia, pruebas de restore y exclusión del escritor anterior. Una réplica no sustituye un backup; alta disponibilidad requiere diseño y ensayos separados.&#10;&#10;AUTORIDAD · Operaciones define retención, RPO/RTO y reconstrucción de evidencia.&#10;&#10;CONTINUIDAD · No es un segundo escritor activo ni garantiza continuidad inmediata." parent="group-notes-3392-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1734.111328" height="192.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-17-bg" value="" parent="group-notes-3392-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-17-title" value="Observabilidad operativa (opcional)" parent="group-notes-3392-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="393.273926" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-17-body" value="Sistema externo · Recolector de logs / Sentry opt-in&#10;&#10;Pino produce logs estructurados y correlacionados en los procesos. Un destino de recolección y Sentry sólo se habilitan con configuración aprobada y datos sensibles filtrados. La telemetría&#10;ayuda a diagnosticar; no reemplaza auditoría transaccional, inbox/outbox, backups ni conciliación financiera.&#10;&#10;AUTORIDAD · Operación administra acceso, retención y datos permitidos. La auditoría de negocio permanece en PostgreSQL.&#10;&#10;CONTINUIDAD · La indisponibilidad de telemetría no confirma ni revierte operaciones; buffers y descarte tienen límites." parent="group-notes-3392-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1846.603516" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-18-bg" value="" parent="group-notes-3392-18" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-18-title" value="Fuentes de maestros y precios" parent="group-notes-3392-18" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-18-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener responsable, contrato, versión y vigencia. La fuente de precios no se sustituye por una tabla editada libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la política autorizada." parent="group-notes-3392-18" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1784.298828" height="192.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-19-bg" value="" parent="group-notes-3392-19" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-19-title" value="Periféricos del puesto" parent="group-notes-3392-19" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="240.405273" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-19-body" value="Hardware externo · USB / serie · driver / SDK&#10;&#10;Perfil inicial F02 y piloto F05: impresora de recibos, etiquetas o lector MICR conectado al puesto Windows mediante USB/serie y driver o SDK homologado. No se ofrece a otros puestos o móviles&#10;por defecto. La impresión conserva referencia de documento y trabajo; el spooler sólo informa recepción técnica. La reimpresión requiere autorización explícita. Compartir dispositivos por red es&#10;una expansión F06 con homologación por modelo; cajón, MICR y terminales de pago no heredan esa capacidad.&#10;&#10;AUTORIDAD · Un único device-agent autorizado opera cada equipo físico. La aplicación solicita capacidades a branch-api.&#10;&#10;CONTINUIDAD · La capacidad depende del equipo, driver y estado físico. Un timeout puede dejar resultado incierto." parent="group-notes-3392-19" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1902.677734" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-20-bg" value="" parent="group-notes-3392-20" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1950.444873" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-20-title" value="Periféricos de red · F06" parent="group-notes-3392-20" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="261.218262" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-20-body" value="Hardware externo · TCP/IP · driver / SDK homologado&#10;&#10;Expansión F06 posterior al piloto F05 del puesto dedicado. Homologar impresoras de recibos y etiquetas accesibles por red y, cuando se requiera, una estación compartida Windows que ejecute&#10;la misma apps/device-agent. La línea discontinua representa una capacidad futura; no instala otro agente en el servidor por defecto. Mantener protocolo HTTPS con branch-api, propiedad&#10;exclusiva, configuración, diagnóstico, journal local y control de concurrencia. Homologar el acceso de móviles por permisos y destino explícitos. MICR, cajón y pagos requieren evaluación propia;&#10;una impresora de red no los habilita.&#10;&#10;AUTORIDAD · Un controlador activo por dispositivo físico, asignado a una instancia certificada de la misma apps/device-agent. No es otra aplicación del monorepo.&#10;&#10;CONTINUIDAD · Sin LAN no se aceptan trabajos nuevos. Cortes, reconexión o cambio de controlador no autorizan repetir un efecto incierto." parent="group-notes-3392-20" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1894.191406" height="275" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6041.35" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6107.35" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. device-agent: C#/.NET Windows propuesto, aún no implementado. F02/F05: puesto dedicado con SQLite técnico. F06: red y estación compartida homologada; sin autoridad de ventas. Backend, datos e integración: diseño por implementar. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6176.35" width="3583.889648" height="67.5" as="geometry" />
        </mxCell>
        <mxCell id="terminalNode" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fillColor=#ffffff;rounded=0;arcSize=8;">
          <mxGeometry x="2668.47168" y="430" width="2052.058594" height="1046.4" as="geometry" />
        </mxCell>
        <mxCell id="terminalNode-title" value="Puesto Windows x N · perfil dedicado F02 / piloto F05" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=22;align=left;verticalAlign=top;">
