        </mxCell>
        <mxCell id="mobileNode-title" value="F06 · dispositivos móviles · Android/iOS por&#10;homologar" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="582.23418" y="444.399953" width="427.936523" height="55" as="geometry" />
        </mxCell>
        <mxCell id="serverNode" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fillColor=#ffffff;rounded=0;arcSize=8;">
          <mxGeometry x="64" y="965.2" width="1530.366211" height="1072.8" as="geometry" />
        </mxCell>
        <mxCell id="serverNode-title" value="Servidor de sucursal · entorno por homologar" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="82" y="979.599953" width="442.674805" height="27.5" as="geometry" />
        </mxCell>
        <mxCell id="countryNode" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fillColor=#ffffff;rounded=0;arcSize=8;">
          <mxGeometry x="6304.279492" y="1526.8" width="1633.5" height="980.4" as="geometry" />
        </mxCell>
        <mxCell id="countryNode-title" value="Plataforma de país · alojamiento por decidir" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=22;align=left;verticalAlign=top;">
