        </mxCell>
        <mxCell id="notes-2922-0-bg" value="" parent="group-notes-2922-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1136.277734" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2922-0-title" value="ACK local, resultado externo separado" parent="group-notes-2922-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="428.027344" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2922-0-body" value="country-api confirma inbox, efecto/proyección y outbox en una transacción antes del ACK. El trabajo ERP es&#10;durable; su aceptación, ejecución y conciliación conservan estados propios. El ACK de país no acredita el&#10;registro en el ERP." parent="group-notes-2922-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1056.569336" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2922-1-bg" value="" parent="group-notes-2922-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1136.277734" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2922-1-title" value="Caché opcional y reconstruible" parent="group-notes-2922-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.85791" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2922-1-body" value="Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad. Claves por país, entidad, versión y&#10;alcance de acceso; TTL e invalidación explícitos. Ante fallos, timeout corto y fallback limitado evitan saturar la&#10;base. Ventas, saldos y mensajes pendientes no dependen de esta caché." parent="group-notes-2922-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1067.526367" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2922-2-bg" value="" parent="group-notes-2922-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1136.277734" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2922-2-title" value="Programación elegida con BullMQ" parent="group-notes-2922-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="379.35791" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2922-2-body" value="country-api programa disparos y crea solicitudes breves fuera de HTTP. Redis de trabajos es obligatorio y&#10;distinto de la caché opcional. PostgreSQL conserva calendario, solicitudes, outbox y resultados; relay y&#10;reconciliación reconstruyen jobs. erp-worker prepara los snapshots/deltas. Integración aún no implementada." parent="group-notes-2922-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1062.692383" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3172.75" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-0-bg" value="" parent="group-notes-3248-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="741.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-0-title" value="branch-sync-worker" parent="group-notes-3248-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="219.506836" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-0-body" value="Contenedor · NestJS / Node.js · sin servidor HTTP&#10;&#10;apps/branch-sync-worker compone libs/backend/sync con pricing/catalog para&#10;preparar y activar versiones. Entrega outbox por HTTPS con identidad y cursor;&#10;confirma acuses durables. El proceso supervisado sigue activo aunque el cliente&#10;se cierre. Descarga, staging, validación y activación conservan límites&#10;transaccionales. No requiere Redis ni BullMQ por sucursal: el control de&#10;pendientes, calendario, cursores y activación utiliza PostgreSQL local y HTTPS.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de&#10;maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita&#10;reintentos y trabajo en curso." parent="group-notes-3248-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="800.067383" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-1-bg" value="" parent="group-notes-3248-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="741.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-1-title" value="erp-worker" parent="group-notes-3248-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="119.470215" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-1-body" value="Contenedor · NestJS / Node.js · BullMQ&#10;&#10;apps/erp-worker se ejecuta en la red autorizada del ERP e inicia HTTPS&#10;autenticado hacia country-api para reclamar trabajo, renovar su lease y registrar&#10;resultados. Mantiene destino, versión de contrato e identidad de intento. Fachada,&#10;ACL y adaptadores son componentes de libs/backend/erp, no servicios HTTP&#10;separados obligatorios. Chile: AX; Perú: custom; España: Gira, con interfaces por&#10;homologar. No accede por SQL remoto a PostgreSQL de país. La preparación de&#10;maestros usa una identidad y presupuesto propios, conexión saliente a&#10;country-api y contrato de fuente homologado; no ejecuta SQL WAN. BullMQ&#10;organiza trabajos técnicos, preparación de maestros y consultas de conciliación&#10;dentro del mismo proceso. Utiliza Redis de trabajos exclusivo de la red ERP y&#10;obtiene el estado durable por HTTPS de country-api. La cola puede reentregar:&#10;antes de actuar revalida estado y autorización; un resultado financiero incierto se&#10;consulta o concilia, no se repite automáticamente. La integración BullMQ está&#10;elegida, aún no implementada.&#10;&#10;AUTORIDAD · Proceso con fachada, ACL y adaptadores internos. Prepara&#10;maestros por MasterDataSourcePort con identidad y presupuesto aislados;&#10;country-api conserva publicaciones y resultados durables.&#10;&#10;CONTINUIDAD · Si país o ERP no responde, conserva identidad y resultado&#10;incierto. Consulta o concilia antes de repetir un efecto." parent="group-notes-3248-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="801.077148" height="632.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-2-bg" value="" parent="group-notes-3248-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="741.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-2-title" value="Entrada y autorización" parent="group-notes-3248-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="248.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-2-body" value="Componente · administration + sync · NestJS&#10;&#10;Controllers y guards de country-api validan identidad, país, entidad, sucursal y&#10;versión de contrato. Componen administration y sync; un token no habilita acceso&#10;a otros países ni a SQL.&#10;&#10;AUTORIDAD · Autentica sucursal o worker; propaga identidad y límites de&#10;país/entidad.&#10;&#10;CONTINUIDAD · Rechaza contratos o capacidades no autorizadas; no confunde&#10;recepción con aplicación." parent="group-notes-3248-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="797.338867" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-3-bg" value="" parent="group-notes-3248-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="741.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-3-title" value="Recepción de operaciones" parent="group-notes-3248-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="296.032715" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-3-body" value="Componente · libs/backend/sync&#10;&#10;Verifica orden, identidad y contrato; usa restricciones y una transacción para&#10;confirmar inbox, efecto/proyección local y outbox. El ACK certifica ese commit, no&#10;contabilización ERP, liquidación de pago ni aceptación fiscal.&#10;&#10;AUTORIDAD · Inbox, proyección operativa y outbox se confirman juntos antes del&#10;ACK.&#10;&#10;CONTINUIDAD · Un duplicado equivalente conserva resultado; igual ID con otro&#10;contenido es conflicto." parent="group-notes-3248-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="799.31543" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-4-bg" value="" parent="group-notes-3248-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-4-title" value="Trabajo y resultados ERP" parent="group-notes-3248-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="283.92334" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-4-body" value="Componente · sync + erp · contratos públicos propuestos&#10;&#10;Composición objetivo con contratos y casos de uso públicos de sync y erp:&#10;atiende solicitudes HTTPS salientes de erp-worker, reclama trabajo mediante&#10;transiciones condicionales y un lease limitado, preservando destino y versión.&#10;Registra resultados e incertidumbre con la identidad original. La ACL y los&#10;adaptadores de proveedor se ejecutan sólo en erp-worker; esta vista no afirma&#10;que estos imports estén implementados en la base actual.&#10;&#10;AUTORIDAD · Country-api conserva intentos, lease, destino, versión y&#10;referencias durables.&#10;&#10;CONTINUIDAD · Lease vencido no demuestra que una llamada externa se haya&#10;detenido; resultado incierto exige consulta/conciliación." parent="group-notes-3248-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="786.295898" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-5-bg" value="" parent="group-notes-3248-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-5-title" value="Publicaciones y consultas" parent="group-notes-3248-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="286.26709" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-5-body" value="Componente · catalog + pricing + reporting&#10;&#10;Expone manifiestos, deltas, chunks y consultas de estado por ámbito.&#10;PostgreSQL identifica la versión autorizada y su watermark.&#10;Catalog/pricing/reporting conservan sus contratos; country-api no construye&#10;cargas masivas dentro de la solicitud HTTP.&#10;&#10;AUTORIDAD · Lee publicaciones completas y autorizadas; la extracción y&#10;preparación pesada se ejecutan en erp-worker.&#10;&#10;CONTINUIDAD · Sólo sirve versiones compatibles y vigentes; una caché no&#10;cambia su autoridad." parent="group-notes-3248-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="742.188477" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-6-bg" value="" parent="group-notes-3248-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-6-title" value="Publicación de maestros" parent="group-notes-3248-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="272.363281" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-6-body" value="Componente · catalog / pricing / sync · TypeScript&#10;&#10;Componente propuesto dentro de country-api. Recibe porciones idempotentes y&#10;finalización desde erp-worker por HTTPS, valida cobertura, corte e integridad y&#10;confirma versión, manifiesto y evento. La preparación pesada permanece en el&#10;adaptador de fuente del worker; no ocurre dentro de una petición. Los disparos&#10;programados y la creación breve de solicitudes se orquestan con BullMQ fuera de&#10;la petición HTTP; calendario, identidad de ejecución y estado de publicación&#10;permanecen en PostgreSQL.&#10;&#10;AUTORIDAD · country-api conserva la autoridad de candidata, versión,&#10;manifiesto, paquetes y publicación en país.&#10;&#10;CONTINUIDAD · Una carga incompleta no sustituye la publicación vigente. Las&#10;sucursales continúan según vigencia y políticas." parent="group-notes-3248-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="799.766602" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-7-bg" value="" parent="group-notes-3248-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-7-title" value="Puerto de caché opcional" parent="group-notes-3248-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="282.141113" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-7-body" value="Componente · Adaptador TypeScript / cache-aside&#10;&#10;Consulta Redis sólo cuando está habilitado y después de comprobar autorización,&#10;país, entidad y alcance de permisos. Comprueba versión y vigencia; TTL controla&#10;retención/frescura técnica, no autoriza una versión comercial vencida.&#10;Reconstruye entradas desde PostgreSQL con límites de concurrencia, espera y&#10;llenados para evitar saturar el origen. Una clave o prefijo no es una frontera de&#10;seguridad. No contiene leases, outbox ni resultados financieros únicos.&#10;&#10;AUTORIDAD · Claves por país, entidad y versión; PostgreSQL conserva la&#10;verdad durable.&#10;&#10;CONTINUIDAD · Miss, expiración o fallo permite leer PostgreSQL con carga y&#10;espera limitadas; la caché no es condición del commit." parent="group-notes-3248-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="801.044922" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-8-bg" value="" parent="group-notes-3248-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-8-title" value="Persistencia de país" parent="group-notes-3248-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.12207" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-8-body" value="Componente · Repositorios TypeScript / SQL&#10;&#10;Composición objetivo de persistencia para sync y los contratos públicos de erp:&#10;coordina inbox, proyección y outbox; conserva trabajo ERP, leases, intentos y&#10;resultados mediante transiciones condicionales. Las respuestas HTTP y la caché&#10;no reemplazan el registro durable. La llamada ERP y sus adaptadores quedan&#10;fuera de esta transacción y del proceso country-api.&#10;&#10;AUTORIDAD · Transacciones y restricciones por país/entidad; no otro escritor&#10;libre de ventas de sucursal.&#10;&#10;CONTINUIDAD · Un commit fallido no produce ACK de aplicación ni resultado&#10;definitivo." parent="group-notes-3248-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="791.183594" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-9-bg" value="" parent="group-notes-3248-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-9-title" value="Base técnica compartida" parent="group-notes-3248-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="273.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-9-body" value="Componente · shared/backend · composición objetivo&#10;&#10;Composición de bootstrap, config, http/worker, health y observability. Pino registra&#10;diagnóstico estructurado; Sentry es opt-in y requiere filtrado. El objetivo&#10;organizacional es libs/shared/backend; la evidencia del producto identifica la base&#10;actualmente implementada. No se presume un proyecto Nx por subcarpeta.&#10;&#10;AUTORIDAD · Mecanismos de proceso: configuración validada, errores y&#10;correlación. No contiene reglas monetarias ni auditoría de negocio.&#10;&#10;CONTINUIDAD · Falla cerrada ante configuración inválida. La ausencia de&#10;telemetría no altera el resultado de negocio." parent="group-notes-3248-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="798.617188" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-10-bg" value="" parent="group-notes-3248-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-10-title" value="Datos operativos de país" parent="group-notes-3248-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-10-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención, backups y&#10;deduplicación deben cubrir el horizonte de replay y restauración. ACK de&#10;aplicación local no equivale a contabilización ERP. Conserva también calendarios,&#10;solicitudes de publicación, intentos y checkpoints durables. La outbox permite&#10;encolar tras el commit y un reconciliador reconstruye jobs pendientes sin confiar&#10;en la permanencia del historial Redis.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox, outbox, versiones y&#10;resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo concurrente&#10;offline de saldos globales." parent="group-notes-3248-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="800.625977" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-11-bg" value="" parent="group-notes-3248-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-11-title" value="Redis · caché de país (opcional)" parent="group-notes-3248-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="358.520508" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-11-body" value="Contenedor de datos · Redis · datos reconstruibles&#10;&#10;Ampliación opcional sujeta a medición, capacidad y operación. La API comprueba&#10;identidad, ámbito y autorización antes de leer. Las claves incluyen país, entidad&#10;legal, versión y alcance de permisos cuando afecte al resultado; un prefijo no&#10;sustituye autorización. TTL y vigencia comercial son independientes. El fallback&#10;limita concurrencia, esperas y llenados para proteger PostgreSQL. No es la inbox,&#10;outbox, base de ventas ni único registro de permisos, dinero o trabajos; se&#10;despliega en una instancia separada de Redis de trabajos y no implica Redis en&#10;cada sucursal. Las versiones inmutables evitan mezclar publicaciones y&#10;PostgreSQL resuelve la versión autorizada.&#10;&#10;AUTORIDAD · Country-api lee y escribe entradas identificadas por país, entidad y&#10;versión. PostgreSQL conserva la autoridad y el estado durable.&#10;&#10;CONTINUIDAD · Un miss, expiración o caída permite consultar PostgreSQL con&#10;límites de carga y espera. La ausencia de caché no es condición del commit; la&#10;capacidad del origen sigue siendo necesaria." parent="group-notes-3248-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="800.969727" height="495" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-12-bg" value="" parent="group-notes-3248-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="576.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-12-title" value="Programación de trabajos" parent="group-notes-3248-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="286.26709" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-12-body" value="Componente · BullMQ · librería Node.js&#10;&#10;Librería elegida para country-api, no una octava aplicación. Usa Redis de trabajos&#10;de país para scheduling, reintentos y concurrencia técnica. Configuración IANA,&#10;ventanas y checkpoints de ejecuciones esperadas permanecen en PostgreSQL;&#10;un scheduler por sí solo no prueba que una ventana se haya ejecutado. El&#10;consumidor realiza tareas breves y registra solicitudes durables para ERP. Relay&#10;y reconciliación cubren el hueco entre commit y encolado; handlers idempotentes&#10;validan identidad, versión y ámbito. Implementación pendiente.&#10;&#10;AUTORIDAD · Componente interno de country-api; ejecuta fuera de HTTP.&#10;PostgreSQL gobierna calendario, ámbito, solicitud e identidad estable; el trabajo&#10;pesado pertenece a erp-worker.&#10;&#10;CONTINUIDAD · El relay reintenta después del commit. Tras pérdida de Redis,&#10;reconstruye programaciones y pendientes desde PostgreSQL sin crear otra&#10;solicitud equivalente." parent="group-notes-3248-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="799.80957" height="467.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-13-bg" value="" parent="group-notes-3248-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="846.208301" height="576.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-13-title" value="Redis · trabajos de país" parent="group-notes-3248-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="264.025879" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3248-13-body" value="Contenedor de datos · Redis dedicado · BullMQ&#10;&#10;Dependencia obligatoria de la arquitectura elegida, aún no implementada. Red&#10;privada, autenticación y TLS según despliegue; sin conexión desde sucursales ni&#10;desde la red ERP. Persistencia Redis y política noeviction para proteger jobs,&#10;capacidad y retención acotadas. El relay encola después del commit PostgreSQL&#10;y la reconciliación reconstruye pendientes por identidad estable. Perder Redis no&#10;autoriza repetir efectos; BullMQ no ofrece exactamente una vez sobre sistemas&#10;externos.&#10;&#10;AUTORIDAD · Instancia exclusiva del dominio país; separada del Redis de&#10;caché. PostgreSQL conserva calendario, solicitudes, outbox y resultados de&#10;negocio.&#10;&#10;CONTINUIDAD · Si falla, se detiene la programación y ejecución de jobs del país.&#10;Los pendientes durables se conservan en PostgreSQL; no revierte ventas&#10;confirmadas ni habilita ACK sin commit." parent="group-notes-3248-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="798.477539" height="467.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5823.25" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5889.25" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. device-agent: C#/.NET Windows propuesto, aún no implementado. F02/F05: puesto dedicado con SQLite técnico. F06: red y estación compartida homologada; sin autoridad de ventas. Backend, datos e integración: diseño por implementar. Nx&#10;organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
