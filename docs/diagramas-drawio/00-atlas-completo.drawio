            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step-25-note" value="El job ejecuta dentro de erp-worker con concurrencia acotada; consulta/reclama la operación durable al comenzar, no después de esperar con lease en una cola larga. Los pendientes se reconstruyen mediante country-api HTTPS." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5479.5" width="2037.851562" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-26-label" value="27  Solicita trabajo identificado · HTTPS saliente" parent="step-26" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="472.011719" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-26" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3791" y="5585" as="sourcePoint" />
            <mxPoint x="3082" y="5585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-26-note" value="erp-worker inicia la conexión desde la red autorizada del ERP. Presenta identidad y ámbito; country-api conserva la autoridad del registro durable. No hay SQL remoto ni llamada entrante obligatoria al worker." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5643" width="1839.541016" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-27-label" value="28  Reclama trabajo e intento&#10;con lease · PostgreSQL" parent="step-27" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="287.396484" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-27" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3082" y="5776" as="sourcePoint" />
            <mxPoint x="3436" y="5776" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-27-note" value="Selecciona una operación confirmada y conserva país, destino, versión de contrato, intento y dueño/vencimiento del lease. Expirar el lease no detiene una llamada ERP ya iniciada ni autoriza repetir un efecto incierto." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5834" width="1915.576172" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-28-label" value="29  Devuelve trabajo, destino y referencia · HTTPS" parent="step-28" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="497.674805" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-28" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3082" y="5939.5" as="sourcePoint" />
            <mxPoint x="3791" y="5939.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-28-note" value="El worker usa ese contexto en cada reintento y durante un cambio de ERP. Un pendiente conserva destino y versión; no se redirige silenciosamente." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5997.5" width="1318.173828" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-29-label" value="30  Fachada y ACL traducen el contrato POS" parent="step-29" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="441.47168" height="27.5" as="geometry" relative="1">
            <mxPoint x="-178" y="-66" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-29" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
