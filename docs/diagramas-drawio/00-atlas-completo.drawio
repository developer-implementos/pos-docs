        <mxCell id="sender_countryApi" value="" parent="1" edge="1" source="sender" target="countryApi" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#48638C;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;exitX=0.610926;exitY=1.00372;exitPerimeter=0;entryX=1.012054;entryY=0.130742;entryPerimeter=0;">
