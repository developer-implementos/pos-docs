            <mxPoint x="951" y="1172" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-2-note" value="Asigna identidades estables antes del efecto externo y guarda importe, moneda, destino y contexto suficiente para recuperar el intento." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1230" width="1198.515625" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-3-label" value="04  Ejecuta el intento autorizado · API habilitada" parent="step-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
