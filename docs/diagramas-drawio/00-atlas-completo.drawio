        </mxCell>
        <mxCell id="J8bkwmSVAenXKDIxg4XN7" value="Datos operativos de país&#10;«Contenedor de datos»&#10;PostgreSQL&#10;Conserva versiones inmutables,&#10;manifiestos y deltas con un&#10;corte consistente." parent="countryDb" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
