        </mxCell>
        <mxCell id="WsEOUvE4bpdRgfLJ4I2H0" value="Fuentes de maestros y precios&#10;«Sistema externo»&#10;Interfaces por confirmar&#10;Entrega catálogo, impuestos,&#10;precios y promociones&#10;aprobados por su propietario." parent="masters" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
