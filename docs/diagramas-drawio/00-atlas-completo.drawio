            <mxPoint x="1307" y="1347.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-3-note" value="Usa identidad de sucursal y país, contrato y cursor durable. Una carga completa puede ser programada o solicitada como recuperación manual controlada." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1405.5" width="1376.318359" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-4-label" value="05  Lee la publicación y su corte&#10;consistente · SQL" parent="step-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="314.305664" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-4" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1306" y="1538.5" as="sourcePoint" />
            <mxPoint x="952" y="1538.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-4-note" value="Selecciona la cobertura autorizada para esa sucursal y entrega una versión identificable, con manifiesto y deltas compatibles." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1596.5" width="1112.851562" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-5-label" value="06  Devuelve manifiesto, deltas&#10;o chunks · HTTPS" parent="step-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="305.722656" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-5" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
