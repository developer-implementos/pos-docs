            <mxPoint x="2371" y="2974.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-12-note" value="Un único agente autorizado opera el equipo físico. Las capacidades y drivers requieren homologación; este flujo de impresión no habilita un terminal de pago." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3032.5" width="1398.652344" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-13-label" value="14  Devuelve evidencia técnica de ejecución · driver/SDK" parent="step-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="558.851562" height="27.5" as="geometry" relative="1">
