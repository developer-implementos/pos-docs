        </mxCell>
        <mxCell id="ortUViLf0E6tEA42EaX_o" value="Publicador de maestros ·&#10;proceso por asignar&#10;«Contenedor»&#10;Proceso de publicación ·&#10;composición pendiente&#10;Proceso propuesto por asignar:&#10;prepara y publica versiones; no&#10;ejecuta la integración ERP." parent="countryWorker" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
