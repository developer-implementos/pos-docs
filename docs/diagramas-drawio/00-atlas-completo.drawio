        <mxCell id="life-syncWorker" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#A8B8D0;strokeWidth=1;dashed=1;dashPattern=6 4;edgeStyle=none;rounded=0;startArrow=none;endArrow=none;endSize=10;">
