        <mxCell id="step-24-label" value="25  Consulta estado local e&#10;integración pendiente · HTTPS&#10;LAN" parent="step-24" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
