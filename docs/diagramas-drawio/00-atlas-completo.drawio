        <mxCell id="step-24-note" value="Consulta la venta local y distingue confirmación, entrega a país y resultado ERP. Las interacciones siguientes no forman parte de su transacción local." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5251.5" width="1331.494141" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-25-label" value="26  BullMQ activa consumidor técnico · Redis red&#10;ERP" parent="step-25" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="481.754883" height="55" as="geometry" relative="1">
