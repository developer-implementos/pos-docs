            <mxPoint x="2016" y="2084" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-7-note" value="Guarda inbox recibida, staging y cursor de recepción para reanudar. No cambia la versión activa ni el cursor aplicado." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2142" width="1042.783203" height="25" as="geometry" />
