        </mxCell>
        <mxCell id="legend-desc" value="Flecha: iniciador → destino; texto: propósito y protocolo. Borde discontinuo: límite nombrado. Todo el contenido es editable." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=19;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="330" width="1039.266602" height="23.75" as="geometry" />
        </mxCell>
        <mxCell id="reading-title" value="Contratos que gobiernan esta vista" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3000.593311" width="496.3125" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3065-0-bg" value="" parent="group-notes-3065-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1731.392578" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3065-0-title" value="Frontera de continuidad" parent="group-notes-3065-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="264.0625" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3065-0-body" value="Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen nuevos comandos dependientes; el puesto no se convierte en&#10;escritor de emergencia. Redis de país y la telemetría externa no son dependencias de la venta local." parent="group-notes-3065-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1673.439453" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-3065-1-bg" value="" parent="group-notes-3065-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1731.392578" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3065-1-title" value="Red autorizada del ERP" parent="group-notes-3065-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="268.212891" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3065-1-body" value="erp-worker inicia HTTPS autenticado hacia country-api para obtener trabajo y reportar resultados. El acceso al ERP permanece en su red autorizada; no se expone SQL ni&#10;se exige conexión entrante desde país. Protocolo, alojamiento y credenciales se homologan por destino." parent="group-notes-3065-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1668.003906" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-3065-2-bg" value="" parent="group-notes-3065-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1731.392578" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3065-2-title" value="Recuperación y operación" parent="group-notes-3065-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="290.454102" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3065-2-body" value="Backups fuera de la instancia y ensayos de restore. RPO/RTO, retención, dimensionamiento y alta disponibilidad deben validarse. Excluir al escritor antiguo antes de&#10;recuperar; réplica no reemplaza backup. Logs, métricas y trazas correlacionan operación e intento." parent="group-notes-3065-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1610.962891" height="55" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3287.843311" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-0-bg" value="" parent="group-notes-3363-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-0-title" value="pos-desktop" parent="group-notes-3363-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="136.193848" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-0-body" value="Contenedor · Angular + Tauri&#10;&#10;pos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio; hardware, SDK y&#10;distribución requieren homologación. Su registro técnico de periféricos no lo convierte en autoridad de ventas.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes." parent="group-notes-3363-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1227.756836" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-1-bg" value="" parent="group-notes-3363-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-1-title" value="pos-mobile" parent="group-notes-3363-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="122.277832" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-1-body" value="Contenedor · Angular + Capacitor&#10;&#10;pos-mobile tiene arranque y bundle propios, compuestos con client-shell. Los adaptadores actuales son mock. Instalación, ciclo&#10;de vida, almacenamiento y capacidades nativas requieren pruebas Android/iOS; no hay acceso SQL ni permisos implícitos por&#10;empaquetar la interfaz.&#10;&#10;AUTORIDAD · Comparte interfaz y contratos; no otra autoridad de ventas.&#10;&#10;CONTINUIDAD · Requiere conexión autorizada al backend de sucursal. El móvil no incorpora autonomía sin LAN." parent="group-notes-3363-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1243.698242" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-2-bg" value="" parent="group-notes-3363-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-2-title" value="Puente de periféricos" parent="group-notes-3363-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="236.254883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-2-body" value="Contenedor condicional · Proceso nativo según SDK&#10;&#10;El cliente transporta el comando autorizado por backend al agente; no inventa importe, permiso ni otro intento. Puede requerir&#10;.NET u otro runtime por contrato del proveedor. Se representa como límite por homologar, no como SDK aprobado.&#10;&#10;AUTORIDAD · Ejecuta identidad y autorización emitidas por backend; registro técnico de evidencia, sin base de ventas.&#10;&#10;CONTINUIDAD · Una caída de LAN tras un cobro exige recuperar evidencia; no autoriza otro cobro." parent="group-notes-3363-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1227.842773" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-3-bg" value="" parent="group-notes-3363-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-3-title" value="branch-api" parent="group-notes-3363-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="118.127441" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-3-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/branch-api compone los contextos operativos: sales/returns, cash/collections, pricing/catalog, payments/devices, fiscal,&#10;reporting y administration. sync aporta el contrato outbox que se confirma con negocio. El transporte pertenece a&#10;branch-sync-worker y la ACL ERP a erp-worker. Bibliotecas no equivalen a microservicios; las capacidades de negocio aún&#10;requieren implementación.&#10;&#10;AUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos internos, un proceso.&#10;&#10;CONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del escritor autorizado." parent="group-notes-3363-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1213.061523" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-4-bg" value="" parent="group-notes-3363-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-4-title" value="Datos de sucursal" parent="group-notes-3363-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-4-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Ventas, caja, pagos y evidencia fiscal son locales. Inbox, outbox, cursores y staging tienen restricciones y transacciones.&#10;Catálogo, precios y promociones son réplicas de lectura autorizadas, no maestros independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API escribe negocio; worker escribe su esquema técnico&#10;y publica espejos por un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica respaldo, alta disponibilidad ni recuperación automática." parent="group-notes-3363-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1237.05957" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-5-bg" value="" parent="group-notes-3363-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-5-title" value="branch-sync-worker" parent="group-notes-3363-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="219.506836" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-5-body" value="Contenedor · NestJS / Node.js · sin servidor HTTP&#10;&#10;apps/branch-sync-worker compone libs/backend/sync con pricing/catalog para preparar y activar versiones. Entrega outbox por&#10;HTTPS con identidad y cursor; confirma acuses durables. El proceso supervisado sigue activo aunque el cliente se cierre.&#10;Descarga, staging, validación y activación conservan límites transaccionales.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita reintentos y trabajo en curso." parent="group-notes-3363-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1239.970703" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-6-bg" value="" parent="group-notes-3363-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-6-title" value="country-api" parent="group-notes-3363-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="123.669434" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-6-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único commit&#10;antes del ACK de aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS saliente iniciado por ese worker. Sirve&#10;publicaciones preparadas por un publicador separado; no ejecuta la ACL ni carga masiva pesada en un endpoint. La caché&#10;opcional acelera lecturas reconstruibles, con PostgreSQL como fuente durable.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización." parent="group-notes-3363-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1244.847656" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-7-bg" value="" parent="group-notes-3363-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-7-title" value="Publicador de maestros · proceso por asignar" parent="group-notes-3363-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="505.810547" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-7-body" value="Contenedor · Proceso de publicación · composición pendiente&#10;&#10;Obtiene datos de la fuente autorizada por país, prepara candidatas aisladas, valida cobertura y publica versión, manifiesto y&#10;evento en PostgreSQL de país. Es una capacidad propuesta pendiente de asignación a una aplicación; no se crea&#10;implícitamente una séptima app ni se introduce este trabajo pesado dentro de country-api. No recibe ventas para delegarlas al&#10;ERP.&#10;&#10;AUTORIDAD · Escritor de versiones, manifiestos y feed de maestros autorizados. Aplicación ejecutable y operación por&#10;asignar; no es el ejecutor ERP.&#10;&#10;CONTINUIDAD · Una carga incompleta no sustituye la publicación vigente. Las sucursales continúan según vigencia y&#10;políticas." parent="group-notes-3363-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1231.505859" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-8-bg" value="" parent="group-notes-3363-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-8-title" value="Datos operativos de país" parent="group-notes-3363-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-8-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención, backups y deduplicación deben cubrir el horizonte de replay y&#10;restauración. ACK de aplicación local no equivale a contabilización ERP.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox, outbox, versiones y resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo concurrente offline de saldos globales." parent="group-notes-3363-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1226.59668" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-9-bg" value="" parent="group-notes-3363-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-9-title" value="Redis · caché de país (opcional)" parent="group-notes-3363-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="358.520508" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-9-body" value="Contenedor de datos · Redis · datos reconstruibles&#10;&#10;Ampliación opcional sujeta a medición, capacidad y operación. La API comprueba identidad, ámbito y autorización antes de&#10;leer. Las claves incluyen país, entidad legal, versión y alcance de permisos cuando afecte al resultado; un prefijo no sustituye&#10;autorización. TTL y vigencia comercial son independientes. El fallback limita concurrencia, esperas y llenados para proteger&#10;PostgreSQL. No es la inbox, outbox, base de ventas ni único registro de permisos, dinero o trabajos; no implica BullMQ ni&#10;Redis en cada sucursal. Las versiones inmutables evitan mezclar publicaciones y PostgreSQL resuelve la versión autorizada.&#10;&#10;AUTORIDAD · Country-api lee y escribe entradas identificadas por país, entidad y versión. PostgreSQL conserva la autoridad y&#10;el estado durable.&#10;&#10;CONTINUIDAD · Un miss, expiración o caída permite consultar PostgreSQL con límites de carga y espera. La ausencia de&#10;caché no es condición del commit; la capacidad del origen sigue siendo necesaria." parent="group-notes-3363-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1241.979492" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-10-bg" value="" parent="group-notes-3363-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-10-title" value="erp-worker" parent="group-notes-3363-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="119.470215" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-10-body" value="Contenedor · NestJS / Node.js · libs/backend/erp&#10;&#10;apps/erp-worker se ejecuta en la red autorizada del ERP e inicia HTTPS autenticado hacia country-api para reclamar trabajo,&#10;renovar su lease y registrar resultados. Mantiene destino, versión de contrato e identidad de intento. Fachada, ACL y&#10;adaptadores son componentes de libs/backend/erp, no servicios HTTP separados obligatorios. Chile: AX; Perú: custom;&#10;España: Gira, con interfaces por homologar. No accede por SQL remoto a PostgreSQL de país.&#10;&#10;AUTORIDAD · Proceso ejecutable con fachada, ACL y adaptadores internos. Country-api conserva trabajo, destinos, intentos y&#10;resultados durables.&#10;&#10;CONTINUIDAD · Si país o ERP no responde, conserva identidad y resultado incierto. Consulta o concilia antes de repetir un&#10;efecto." parent="group-notes-3363-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1242.022461" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-11-bg" value="" parent="group-notes-3363-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-11-title" value="ERP del país" parent="group-notes-3363-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-11-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú son antecedentes; versión, interfaces y capacidades&#10;deben confirmarse. No se afirma que exista el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no revierte una venta local confirmada." parent="group-notes-3363-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1205.724609" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-12-bg" value="" parent="group-notes-3363-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-12-title" value="Proveedor de pagos" parent="group-notes-3363-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-12-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Pago, venta, documento fiscal e integración ERP tienen estados distintos. No repetir un cargo incierto ni cambiar de proveedor&#10;para resolverlo automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout puede dejar resultado desconocido." parent="group-notes-3363-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1235.136719" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-13-bg" value="" parent="group-notes-3363-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-13-title" value="Proveedor fiscal" parent="group-notes-3363-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="179.248047" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-13-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Emisión, aceptación y transmisión se modelan por separado. No se inventa un proveedor común ni una capacidad de consulta&#10;o idempotencia no acreditada.&#10;&#10;AUTORIDAD · Autoridad y validez tributaria según régimen y proveedor.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se promete universalmente." parent="group-notes-3363-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1233.955078" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-14-bg" value="" parent="group-notes-3363-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-14-title" value="Respaldo y recuperación" parent="group-notes-3363-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-14-body" value="Infraestructura · Backups PostgreSQL / herramienta por definir&#10;&#10;Backups externos a la instancia, pruebas de restore y exclusión del escritor anterior. Una réplica no sustituye un backup; alta&#10;disponibilidad requiere diseño y ensayos separados.&#10;&#10;AUTORIDAD · Operaciones define retención, RPO/RTO y reconstrucción de evidencia.&#10;&#10;CONTINUIDAD · No es un segundo escritor activo ni garantiza continuidad inmediata." parent="group-notes-3363-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1216.77832" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-15-bg" value="" parent="group-notes-3363-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1292.544434" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-15-title" value="Observabilidad operativa (opcional)" parent="group-notes-3363-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="393.273926" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3363-15-body" value="Sistema externo · Recolector de logs / Sentry opt-in&#10;&#10;Pino produce logs estructurados y correlacionados en los procesos. Un destino de recolección y Sentry sólo se habilitan con&#10;configuración aprobada y datos sensibles filtrados. La telemetría ayuda a diagnosticar; no reemplaza auditoría transaccional,&#10;inbox/outbox, backups ni conciliación financiera.&#10;&#10;AUTORIDAD · Operación administra acceso, retención y datos permitidos. La auditoría de negocio permanece en PostgreSQL.&#10;&#10;CONTINUIDAD · La indisponibilidad de telemetría no confirma ni revierte operaciones; buffers y descarte tienen límites." parent="group-notes-3363-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1242.000977" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5140.843311" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5206.843311" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Angular + Tauri (escritorio), Angular + Capacitor (móvil) y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5275.843311" width="1643.80957" height="67.5" as="geometry" />
        </mxCell>
