        <mxCell id="step-0-note" value="La programación durable identifica país, cobertura, zona horaria y ventana. Relay y reconciliación reconstruyen trabajos si falla Redis; no se depende sólo del historial del scheduler." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
