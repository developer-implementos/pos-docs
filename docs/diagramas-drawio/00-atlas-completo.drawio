        <mxCell id="step-16-note" value="La venta y su documento mantienen sus identidades. Reimpresión es una operación explícita y autorizada con auditoría y referencia al trabajo anterior." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3741.5" width="1339.6875" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-17-label" value="18  Lee outbox confirmada y reclama lote acotado · PostgreSQL" parent="step-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
