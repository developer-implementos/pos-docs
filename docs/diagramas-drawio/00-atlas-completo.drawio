        <mxCell id="client_branchApi" value="" parent="1" edge="1" source="client" target="branchApi" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#48638C;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;exitX=0.437187;exitY=1.002671;exitPerimeter=0;entryX=1.011893;entryY=0.248494;entryPerimeter=0;">
