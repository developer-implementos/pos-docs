          </mxGeometry>
        </mxCell>
        <mxCell id="step-0-note" value="Con commandId estable, contexto de caja y referencia de cotización. Un reintento conserva la identidad del comando." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="823" width="1046.171875" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-1-label" value="02  Lee y valida turno, permisos,&#10;precios y capacidad · SQL" parent="step-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="317.947266" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
