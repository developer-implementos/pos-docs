        <mxCell id="step-29-note" value="Son componentes TypeScript internos de libs/backend/erp. Traducción y adaptador respetan las capacidades verificadas de AX, custom o Gira; no son tres servicios HTTP obligatorios." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6198" width="1631.210938" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-30-label" value="31  Envía operación o consulta&#10;resultado · contrato homologado" parent="step-30" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="316.754883" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
