            <mxPoint x="951" y="956" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-1-note" value="Antes de iniciar el pago valida importes, versión de la cotización, vigencia, política offline, espacio, reloj y recursos fiscales. Si la política exige recalcular, se confirma el importe revisado antes de crear el intento; fijar una versión no extiende su vigencia. El cliente no decide la autorización ni el importe final. Un pago iniciado o incierto conserva su importe e&#10;identidad mientras se resuelve." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1014" width="3147.958984" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step-2-label" value="03  Persiste intención de venta y&#10;pago · commit SQL" parent="step-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="317.96875" height="55" as="geometry" relative="1">
