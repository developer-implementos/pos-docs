        <mxCell id="step-1-note" value="MasterDataSourcePort valida el contrato de fuente y prepara una candidata. Claims, identidad y presupuesto separados de los comandos financieros. La publicación en país pertenece a country-api." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1023.5" width="1755.498047" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-2-label" value="03  Claim, upload y finalize · HTTPS saliente" parent="step-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="436.519531" height="27.5" as="geometry" relative="1">
