        <mxCell id="step-22-note" value="Identifica eventos aplicados, duplicados equivalentes y rechazos. No declara pago liquidado, validez fiscal ni documento contabilizado en ERP." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4869.5" width="1265.976562" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-23-label" value="24  Persiste acuse y avance de entrega · PostgreSQL" parent="step-23" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="525.851562" height="27.5" as="geometry" relative="1">
            <mxPoint x="-869.5" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-23" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
