        <mxCell id="notes-2942-0-title" value="ACK local, resultado externo separado" parent="group-notes-2942-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="428.027344" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2942-0-body" value="country-api confirma inbox, efecto/proyección y outbox en una transacción&#10;antes del ACK. El trabajo ERP es durable; su aceptación, ejecución y&#10;conciliación conservan estados propios. El ACK de país no acredita el&#10;registro en el ERP." parent="group-notes-2942-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="723.958984" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-2942-1-bg" value="" parent="group-notes-2942-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2942-1-title" value="Caché opcional y reconstruible" parent="group-notes-2942-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.85791" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2942-1-body" value="Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad.&#10;Claves por país, entidad, versión y alcance de acceso; TTL e invalidación&#10;explícitos. Ante fallos, timeout corto y fallback limitado evitan saturar la&#10;base. Ventas, saldos y mensajes pendientes no dependen de esta caché." parent="group-notes-2942-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="717.954102" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-2942-2-bg" value="" parent="group-notes-2942-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2942-2-title" value="Responsabilidad de publicación" parent="group-notes-2942-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="351.635742" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2942-2-body" value="country-api ofrece publicaciones versionadas y consulta de cursores. El&#10;proceso que importa y construye snapshots/deltas de maestros sigue por&#10;asignar; no es una séptima app existente. La base actual no implementa&#10;persistencia, caché ni estos protocolos." parent="group-notes-2942-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="714.162109" height="110" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3220.316017" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-0-bg" value="" parent="group-notes-3295-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-0-title" value="branch-sync-worker" parent="group-notes-3295-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="219.506836" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-0-body" value="Contenedor · NestJS / Node.js · sin servidor HTTP&#10;&#10;apps/branch-sync-worker compone libs/backend/sync con pricing/catalog&#10;para preparar y activar versiones. Entrega outbox por HTTPS con&#10;identidad y cursor; confirma acuses durables. El proceso supervisado&#10;sigue activo aunque el cliente se cierre. Descarga, staging, validación y&#10;activación conservan límites transaccionales.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones&#10;de maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al recuperar&#10;WAN; limita reintentos y trabajo en curso." parent="group-notes-3295-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="712.916016" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-1-bg" value="" parent="group-notes-3295-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-1-title" value="erp-worker" parent="group-notes-3295-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="119.470215" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-1-body" value="Contenedor · NestJS / Node.js · libs/backend/erp&#10;&#10;apps/erp-worker se ejecuta en la red autorizada del ERP e inicia HTTPS&#10;autenticado hacia country-api para reclamar trabajo, renovar su lease y&#10;registrar resultados. Mantiene destino, versión de contrato e identidad de&#10;intento. Fachada, ACL y adaptadores son componentes de&#10;libs/backend/erp, no servicios HTTP separados obligatorios. Chile: AX;&#10;Perú: custom; España: Gira, con interfaces por homologar. No accede por&#10;SQL remoto a PostgreSQL de país.&#10;&#10;AUTORIDAD · Proceso ejecutable con fachada, ACL y adaptadores&#10;internos. Country-api conserva trabajo, destinos, intentos y resultados&#10;durables.&#10;&#10;CONTINUIDAD · Si país o ERP no responde, conserva identidad y&#10;resultado incierto. Consulta o concilia antes de repetir un efecto." parent="group-notes-3295-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="721.488281" height="440" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-2-bg" value="" parent="group-notes-3295-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-2-title" value="Entrada y autorización" parent="group-notes-3295-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="248.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-2-body" value="Componente · administration + sync · NestJS&#10;&#10;Controllers y guards de country-api validan identidad, país, entidad,&#10;sucursal y versión de contrato. Componen administration y sync; un token&#10;no habilita acceso a otros países ni a SQL.&#10;&#10;AUTORIDAD · Autentica sucursal o worker; propaga identidad y límites de&#10;país/entidad.&#10;&#10;CONTINUIDAD · Rechaza contratos o capacidades no autorizadas; no&#10;confunde recepción con aplicación." parent="group-notes-3295-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="724.689453" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-3-bg" value="" parent="group-notes-3295-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-3-title" value="Recepción de operaciones" parent="group-notes-3295-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="296.032715" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-3-body" value="Componente · libs/backend/sync&#10;&#10;Verifica orden, identidad y contrato; usa restricciones y una transacción&#10;para confirmar inbox, efecto/proyección local y outbox. El ACK certifica ese&#10;commit, no contabilización ERP, liquidación de pago ni aceptación fiscal.&#10;&#10;AUTORIDAD · Inbox, proyección operativa y outbox se confirman juntos&#10;antes del ACK.&#10;&#10;CONTINUIDAD · Un duplicado equivalente conserva resultado; igual ID&#10;con otro contenido es conflicto." parent="group-notes-3295-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="732.456055" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-4-bg" value="" parent="group-notes-3295-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-4-title" value="Trabajo y resultados ERP" parent="group-notes-3295-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="283.92334" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-4-body" value="Componente · sync + erp · contratos públicos propuestos&#10;&#10;Composición objetivo con contratos y casos de uso públicos de sync y erp:&#10;atiende solicitudes HTTPS salientes de erp-worker, reclama trabajo&#10;mediante transiciones condicionales y un lease limitado, preservando&#10;destino y versión. Registra resultados e incertidumbre con la identidad&#10;original. La ACL y los adaptadores de proveedor se ejecutan sólo en&#10;erp-worker; esta vista no afirma que estos imports estén implementados en&#10;la base actual.&#10;&#10;AUTORIDAD · Country-api conserva intentos, lease, destino, versión y&#10;referencias durables.&#10;&#10;CONTINUIDAD · Lease vencido no demuestra que una llamada externa se&#10;haya detenido; resultado incierto exige consulta/conciliación." parent="group-notes-3295-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="733.669922" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-5-bg" value="" parent="group-notes-3295-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-5-title" value="Publicaciones y consultas" parent="group-notes-3295-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="286.26709" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-5-body" value="Componente · catalog + pricing + reporting&#10;&#10;Expone manifiestos, deltas, chunks y consultas de estado por ámbito.&#10;PostgreSQL identifica la versión autorizada y su watermark.&#10;Catalog/pricing/reporting conservan sus contratos; country-api no&#10;construye cargas masivas dentro de la solicitud HTTP.&#10;&#10;AUTORIDAD · Lee publicaciones completas y autorizadas; el publicador&#10;pesado vive fuera de este proceso.&#10;&#10;CONTINUIDAD · Sólo sirve versiones compatibles y vigentes; una caché&#10;no cambia su autoridad." parent="group-notes-3295-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="711.605469" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-6-bg" value="" parent="group-notes-3295-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-6-title" value="Puerto de caché opcional" parent="group-notes-3295-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="282.141113" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-6-body" value="Componente · Adaptador TypeScript / cache-aside&#10;&#10;Consulta Redis sólo cuando está habilitado y después de comprobar&#10;autorización, país, entidad y alcance de permisos. Comprueba versión y&#10;vigencia; TTL controla retención/frescura técnica, no autoriza una versión&#10;comercial vencida. Reconstruye entradas desde PostgreSQL con límites&#10;de concurrencia, espera y llenados para evitar saturar el origen. Una clave&#10;o prefijo no es una frontera de seguridad. No contiene leases, outbox ni&#10;resultados financieros únicos.&#10;&#10;AUTORIDAD · Claves por país, entidad y versión; PostgreSQL conserva la&#10;verdad durable.&#10;&#10;CONTINUIDAD · Miss, expiración o fallo permite leer PostgreSQL con&#10;carga y espera limitadas; la caché no es condición del commit." parent="group-notes-3295-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="730.791016" height="412.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-7-bg" value="" parent="group-notes-3295-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-7-title" value="Persistencia de país" parent="group-notes-3295-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.12207" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-7-body" value="Componente · Repositorios TypeScript / SQL&#10;&#10;Composición objetivo de persistencia para sync y los contratos públicos de&#10;erp: coordina inbox, proyección y outbox; conserva trabajo ERP, leases,&#10;intentos y resultados mediante transiciones condicionales. Las respuestas&#10;HTTP y la caché no reemplazan el registro durable. La llamada ERP y sus&#10;adaptadores quedan fuera de esta transacción y del proceso country-api.&#10;&#10;AUTORIDAD · Transacciones y restricciones por país/entidad; no otro&#10;escritor libre de ventas de sucursal.&#10;&#10;CONTINUIDAD · Un commit fallido no produce ACK de aplicación ni&#10;resultado definitivo." parent="group-notes-3295-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="730.049805" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-8-bg" value="" parent="group-notes-3295-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="521.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-8-title" value="Base técnica compartida" parent="group-notes-3295-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="273.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-8-body" value="Componente · shared/backend · composición objetivo&#10;&#10;Composición de bootstrap, config, http/worker, health y observability. Pino&#10;registra diagnóstico estructurado; Sentry es opt-in y requiere filtrado. El&#10;objetivo organizacional es libs/shared/backend; la evidencia del producto&#10;identifica la base actualmente implementada. No se presume un proyecto&#10;Nx por subcarpeta.&#10;&#10;AUTORIDAD · Mecanismos de proceso: configuración validada, errores y&#10;correlación. No contiene reglas monetarias ni auditoría de negocio.&#10;&#10;CONTINUIDAD · Falla cerrada ante configuración inválida. La ausencia de&#10;telemetría no altera el resultado de negocio." parent="group-notes-3295-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="728.792969" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-9-bg" value="" parent="group-notes-3295-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-9-title" value="Datos operativos de país" parent="group-notes-3295-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-9-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención, backups y&#10;deduplicación deben cubrir el horizonte de replay y restauración. ACK de&#10;aplicación local no equivale a contabilización ERP.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox, outbox,&#10;versiones y resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo&#10;concurrente offline de saldos globales." parent="group-notes-3295-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="723.948242" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-10-bg" value="" parent="group-notes-3295-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.883594" height="604.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-10-title" value="Redis · caché de país (opcional)" parent="group-notes-3295-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="358.520508" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3295-10-body" value="Contenedor de datos · Redis · datos reconstruibles&#10;&#10;Ampliación opcional sujeta a medición, capacidad y operación. La API&#10;comprueba identidad, ámbito y autorización antes de leer. Las claves&#10;incluyen país, entidad legal, versión y alcance de permisos cuando afecte&#10;al resultado; un prefijo no sustituye autorización. TTL y vigencia comercial&#10;son independientes. El fallback limita concurrencia, esperas y llenados&#10;para proteger PostgreSQL. No es la inbox, outbox, base de ventas ni único&#10;registro de permisos, dinero o trabajos; no implica BullMQ ni Redis en&#10;cada sucursal. Las versiones inmutables evitan mezclar publicaciones y&#10;PostgreSQL resuelve la versión autorizada.&#10;&#10;AUTORIDAD · Country-api lee y escribe entradas identificadas por país,&#10;entidad y versión. PostgreSQL conserva la autoridad y el estado durable.&#10;&#10;CONTINUIDAD · Un miss, expiración o caída permite consultar&#10;PostgreSQL con límites de carga y espera. La ausencia de caché no es&#10;condición del commit; la capacidad del origen sigue siendo necesaria." parent="group-notes-3295-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="731.338867" height="495" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5623.316017" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5689.316017" width="1681.240234" height="25" as="geometry" />
