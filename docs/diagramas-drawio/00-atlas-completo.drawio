        <mxCell id="step-0-label" value="01  Solicita confirmar venta ·&#10;HTTPS sobre LAN" parent="step-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="278.78125" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-0" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="242" y="765" as="sourcePoint" />
            <mxPoint x="596" y="765" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-0-note" value="Con commandId estable, contexto de caja y referencia de cotización. Un reintento conserva la identidad del comando." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="823" width="1046.171875" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-1-label" value="02  Lee y valida turno, permisos,&#10;precios y capacidad ·&#10;PostgreSQL" parent="step-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="317.947266" height="82.5" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-97.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-1" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="983.5" as="sourcePoint" />
            <mxPoint x="951" y="983.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-1-note" value="Antes de iniciar el pago valida importes, versión de la cotización, vigencia, política offline, espacio, reloj y recursos fiscales. Si la política exige recalcular, se confirma el importe revisado antes de crear el intento; fijar una versión no extiende su vigencia. El cliente no decide la autorización ni el importe final. Un pago iniciado o incierto conserva su importe e identidad mientras se resuelve." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1041.5" width="3430.332031" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-2-label" value="03  Persiste intención de venta y&#10;pago · PostgreSQL" parent="step-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="317.96875" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-2" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="1174.5" as="sourcePoint" />
            <mxPoint x="951" y="1174.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-2-note" value="Confirma intención e identidades estables en una transacción antes de llamar al proveedor. Guarda importe, moneda, destino y contexto suficiente para recuperar el intento; el efecto externo sólo comienza después de ese commit." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1232.5" width="2037.841797" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-3-label" value="04  Ejecuta el intento autorizado · API habilitada" parent="step-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="469.637695" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-3" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="1338" as="sourcePoint" />
            <mxPoint x="1306" y="1338" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-3-note" value="Usa la referencia original; idempotencia y consulta dependen de capacidades disponibles y homologadas. La llamada ocurre sin mantener una transacción SQL abierta." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1396" width="1490.908203" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-4-label" value="05  Devuelve resultado conocido y referencia · API" parent="step-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="495.268555" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-4" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1306" y="1501.5" as="sourcePoint" />
            <mxPoint x="597" y="1501.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-4-note" value="La continuación mostrada requiere un resultado suficiente para confirmar según política. Rechazo o respuesta desconocida siguen su estado y recuperación propios." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1559.5" width="1465.322266" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-5-label" value="06  Confirma venta + caja +&#10;auditoría + outbox · PostgreSQL" parent="step-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="316.131836" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-5" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="1692.5" as="sourcePoint" />
            <mxPoint x="951" y="1692.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-5-note" value="Revalida invariantes y deduplicación; confirma venta, caja, auditoría y outbox en una misma transacción. Incluye partidas, impuestos, referencias de pago y la evidencia fiscal que deba ser simultánea. El commit no incluye al proveedor externo ni al ERP." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1750.5" width="2241.953125" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-6-label" value="07  Confirma operación y&#10;documento permitido · HTTPS" parent="step-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="297.107422" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-6" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="596" y="1883.5" as="sourcePoint" />
            <mxPoint x="242" y="1883.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-6-note" value="Solo después del commit local. Muestra estados de pago, fiscalidad e integración; la entrega a país puede permanecer pendiente sin negar la venta ya confirmada." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1941.5" width="1448.662109" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-7-label" value="08  Solicita imprimir el&#10;documento existente ·&#10;HTTPS/LAN" parent="step-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="216.455078" height="82.5" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-97.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-7" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="242" y="2102" as="sourcePoint" />
            <mxPoint x="596" y="2102" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-7-note" value="Rama de impresión independiente de sincronización. Escritorio y móvil usan el mismo contrato del backend; pos-desktop no actúa como relé ni debe permanecer abierto." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2160" width="1504.140625" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-8-label" value="09  Autoriza y registra trabajo&#10;con jobId y hash · PostgreSQL" parent="step-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="299.610352" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-8" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="2293" as="sourcePoint" />
            <mxPoint x="951" y="2293" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-8-note" value="Valida usuario, sucursal, capacidad, dispositivo y agente dueño. El trabajo referencia el documento ya emitido; una impresión o reimpresión no genera otra venta ni documento fiscal." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2351" width="1609.443359" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-9-label" value="10  Obtiene trabajos de su equipo · HTTPS/LAN saliente" parent="step-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="552.75" height="27.5" as="geometry" relative="1">
            <mxPoint x="-514.5" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-9" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1661" y="2456.5" as="sourcePoint" />
            <mxPoint x="597" y="2456.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-9-note" value="Servicio autónomo C#/.NET Windows propuesto. Autentica agente y equipo; sólo obtiene trabajo autorizado para sus capacidades. No se exige conexión entrante al agente." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2514.5" width="1530.947266" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-10-label" value="11  Entrega trabajo autorizado e identidad estable · HTTPS" parent="step-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="576.823242" height="27.5" as="geometry" relative="1">
            <mxPoint x="-514.5" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-10" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="2620" as="sourcePoint" />
            <mxPoint x="1661" y="2620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-10-note" value="Respuesta a la solicitud del agente. Mantiene jobId, hash, destino y autorización; un lease vencido no acredita que el efecto físico no se ejecutó." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2678" width="1279.707031" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-11-label" value="12  Persiste recepción y&#10;deduplicación · SQLite" parent="step-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="234.78125" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-11" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1662" y="2811" as="sourcePoint" />
            <mxPoint x="2016" y="2811" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-11-note" value="Antes de ejecutar registra jobId, hash e intento. Mismo jobId y mismo hash recuperan estado; mismo jobId con distinto hash es conflicto. El journal no es una base de ventas." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2869" width="1537.519531" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-12-label" value="13  Ejecuta impresión autorizada · driver/SDK homologado" parent="step-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="573.525391" height="27.5" as="geometry" relative="1">
