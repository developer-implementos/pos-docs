        <mxCell id="notes-1360-0-title" value="Límites de autoridad" parent="group-notes-1360-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="226.525879" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1360-0-body" value="Sucursal conserva la venta original. País consolida&#10;una proyección. Precio, efecto financiero del pago,&#10;documento fiscal y contabilización ERP tienen&#10;autoridades y estados diferentes." parent="group-notes-1360-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="496.493164" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-1360-1-bg" value="" parent="group-notes-1360-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1360-1-title" value="Continuidad autorizada" parent="group-notes-1360-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="257.128906" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1360-1-body" value="Perfil inicial: caída de WAN con LAN, backend y&#10;PostgreSQL de sucursal disponibles. Vigencia de&#10;precios, permisos, límites y capacidades de&#10;pago/fiscalidad determinan qué puede continuar." parent="group-notes-1360-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="481.443359" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-1360-2-bg" value="" parent="group-notes-1360-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1360-2-title" value="Chile y evolución multinacional" parent="group-notes-1360-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.845703" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1360-2-body" value="Antecedentes: Chile Dynamics AX on-premise;&#10;España Gira; Perú sistema custom. Interfaces por&#10;validar. No se asigna stock al POS ni se declara un&#10;ERP futuro ya aprobado." parent="group-notes-1360-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="498.931641" height="110" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1638.490033" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-0-bg" value="" parent="group-notes-1713-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-0-title" value="Cajero" parent="group-notes-1713-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="73.64502" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-0-body" value="Persona · Operación humana&#10;&#10;Usa el cliente del puesto. Abrir o cerrar sesión de&#10;usuario no equivale a abrir o cerrar el turno de caja.&#10;&#10;AUTORIDAD · Ejecuta operaciones con permisos; no&#10;administra la base.&#10;&#10;CONTINUIDAD · Acceso local y operaciones&#10;habilitadas según vigencia, permisos y política offline." parent="group-notes-1713-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="523.004883" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-1-bg" value="" parent="group-notes-1713-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-1-title" value="Supervisor de sucursal" parent="group-notes-1713-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="254.284668" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-1-body" value="Persona · Operación humana&#10;&#10;Consulta resultados, autoriza acciones permitidas y&#10;resuelve incidencias con evidencia.&#10;&#10;AUTORIDAD · Responsable operativo; los comandos&#10;mantienen autorización y auditoría.&#10;&#10;CONTINUIDAD · Solo facultades previamente&#10;habilitadas; sin inventar autorización central." parent="group-notes-1713-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="521.71582" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-2-bg" value="" parent="group-notes-1713-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-2-title" value="Operación de plataforma" parent="group-notes-1713-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="275.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-2-body" value="Persona · Soporte autorizado&#10;&#10;Programa cargas y ventanas, supervisa atrasos,&#10;coordina restauraciones y conciliaciones.&#10;&#10;AUTORIDAD · Administra configuración y reintentos&#10;auditados; no corrige dinero con SQL libre.&#10;&#10;CONTINUIDAD · Consulta evidencia local; la&#10;plataforma de país puede estar inaccesible sin WAN." parent="group-notes-1713-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="516.452148" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-3-bg" value="" parent="group-notes-1713-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-3-title" value="POS corporativo" parent="group-notes-1713-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="183.410645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-3-body" value="Sistema de software · Plataforma de caja&#10;&#10;Sistema objetivo común para Chile, Perú y España.&#10;Clientes Angular + Tauri y Angular + Capacitor&#10;aceptados como dirección; backend, datos y&#10;topología son recomendaciones por validar.&#10;&#10;AUTORIDAD · La venta nace en sucursal; país&#10;mantiene la proyección consolidada.&#10;&#10;CONTINUIDAD · Perfil inicial: WAN caída con LAN y&#10;escritor de sucursal disponibles." parent="group-notes-1713-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="513.852539" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-4-bg" value="" parent="group-notes-1713-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-4-title" value="ERP del país" parent="group-notes-1713-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-4-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y&#10;custom en Perú son antecedentes; versión, interfaces&#10;y capacidades deben confirmarse. No se afirma que&#10;exista el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de&#10;cada país; no la base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración&#10;pendiente; no revierte una venta local confirmada." parent="group-notes-1713-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="528.225586" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-5-bg" value="" parent="group-notes-1713-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-5-title" value="Fuentes de maestros y precios" parent="group-notes-1713-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-5-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben&#10;tener responsable, contrato, versión y vigencia. La&#10;fuente de precios no se sustituye por una tabla&#10;editada libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente:&#10;no se asigna al ERP por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local&#10;vigente dentro de la política autorizada." parent="group-notes-1713-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="515.625" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-6-bg" value="" parent="group-notes-1713-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-6-title" value="Proveedor de pagos" parent="group-notes-1713-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-6-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Pago, venta, documento fiscal e integración ERP&#10;tienen estados distintos. No repetir un cargo incierto&#10;ni cambiar de proveedor para resolverlo&#10;automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto&#10;financiero; POS registra intento, referencia y&#10;resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por&#10;homologar. Un timeout puede dejar resultado&#10;desconocido." parent="group-notes-1713-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="507.503906" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-7-bg" value="" parent="group-notes-1713-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="574.666667" height="494.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-7-title" value="Proveedor fiscal" parent="group-notes-1713-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="179.248047" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1713-7-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Emisión, aceptación y transmisión se modelan por&#10;separado. No se inventa un proveedor común ni una&#10;capacidad de consulta o idempotencia no acreditada.&#10;&#10;AUTORIDAD · Autoridad y validez tributaria según&#10;régimen y proveedor.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y&#10;material fiscal válidos; no se promete universalmente." parent="group-notes-1713-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="523.348633" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3138.240033" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3204.240033" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Angular + Tauri (escritorio), Angular + Capacitor (móvil) y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3273.240033" width="1643.80957" height="67.5" as="geometry" />
        </mxCell>
