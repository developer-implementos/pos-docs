        <mxCell id="step-30-note" value="Ejecuta la capacidad permitida con identidad estable. No mantiene una transacción SQL de país abierta mientras espera al ERP." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6389" width="1141.425781" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-31-label" value="32  Devuelve resultado o&#10;referencia · protocolo ERP" parent="step-31" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="259.230469" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-31" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="4146" y="6522" as="sourcePoint" />
            <mxPoint x="3792" y="6522" as="targetPoint" />
          </mxGeometry>
