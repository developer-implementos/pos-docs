        <mxCell id="step-3-note" value="Tras validar corte, cobertura e integridad, country-api confirma versión, manifiesto y evento outbox en una misma transacción. Los paquetes siguen inmutables y una carga parcial nunca sustituye la versión activa." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
