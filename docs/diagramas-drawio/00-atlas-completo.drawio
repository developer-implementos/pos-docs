        <mxCell id="step-12" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2016" y="3036.5" as="sourcePoint" />
            <mxPoint x="1662" y="3036.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-12-note" value="Identifica eventos aplicados, duplicados equivalentes y rechazos. No declara pago liquidado, validez fiscal ni documento contabilizado en ERP." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3094.5" width="1265.976562" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-13-label" value="14  Persiste acuse y avance de entrega · commit SQL" parent="step-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="527.033203" height="27.5" as="geometry" relative="1">
