            <mxPoint x="597" y="956" as="sourcePoint" />
            <mxPoint x="951" y="956" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-1-note" value="Antes de iniciar el pago valida importes, versión de la cotización, vigencia, política offline, espacio, reloj y recursos fiscales. Si la política exige recalcular, se confirma el importe revisado antes de crear el intento; fijar una versión no extiende su vigencia. El cliente no decide la autorización ni el importe final. Un pago iniciado o incierto conserva su importe e&#10;identidad mientras se resuelve." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1014" width="3147.958984" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step-2-label" value="03  Persiste intención de venta y&#10;pago · commit SQL" parent="step-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="317.96875" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-2" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="1172" as="sourcePoint" />
            <mxPoint x="951" y="1172" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-2-note" value="Asigna identidades estables antes del efecto externo y guarda importe, moneda, destino y contexto suficiente para recuperar el intento." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1230" width="1198.515625" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-3-label" value="04  Ejecuta el intento autorizado · API habilitada" parent="step-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="469.637695" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-3" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="1335.5" as="sourcePoint" />
            <mxPoint x="1306" y="1335.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-3-note" value="Usa la referencia original; idempotencia y consulta dependen de capacidades disponibles y homologadas. La llamada ocurre sin mantener una transacción SQL abierta." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1393.5" width="1490.908203" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-4-label" value="05  Devuelve resultado conocido y referencia · API" parent="step-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="495.268555" height="27.5" as="geometry" relative="1">
