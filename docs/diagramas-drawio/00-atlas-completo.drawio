        </mxCell>
        <mxCell id="notes-2869-0-bg" value="" parent="group-notes-2869-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="960.790234" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2869-0-title" value="ACK local, resultado externo separado" parent="group-notes-2869-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="428.027344" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2869-0-body" value="country-api confirma inbox, efecto/proyección y outbox en una transacción antes del ACK. El&#10;trabajo ERP es durable; su aceptación, ejecución y conciliación conservan estados propios.&#10;El ACK de país no acredita el registro en el ERP." parent="group-notes-2869-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="902.494141" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2869-1-bg" value="" parent="group-notes-2869-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="960.790234" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2869-1-title" value="Caché opcional y reconstruible" parent="group-notes-2869-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.85791" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2869-1-body" value="Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad. Claves por país,&#10;entidad, versión y alcance de acceso; TTL e invalidación explícitos. Ante fallos, timeout corto&#10;y fallback limitado evitan saturar la base. Ventas, saldos y mensajes pendientes no dependen&#10;de esta caché." parent="group-notes-2869-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="911.120117" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-2869-2-bg" value="" parent="group-notes-2869-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="960.790234" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2869-2-title" value="Responsabilidad de publicación" parent="group-notes-2869-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="351.635742" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2869-2-body" value="country-api ofrece publicaciones versionadas y consulta de cursores. El proceso que importa&#10;y construye snapshots/deltas de maestros sigue por asignar; no es una séptima app&#10;existente. La base actual no implementa persistencia, caché ni estos protocolos." parent="group-notes-2869-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="904.921875" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3147.45" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-0-bg" value="" parent="group-notes-3222-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="659.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-0-title" value="branch-sync-worker" parent="group-notes-3222-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="219.506836" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-0-body" value="Contenedor · NestJS / Node.js · sin servidor HTTP&#10;&#10;apps/branch-sync-worker compone libs/backend/sync con&#10;pricing/catalog para preparar y activar versiones. Entrega outbox por&#10;HTTPS con identidad y cursor; confirma acuses durables. El&#10;proceso supervisado sigue activo aunque el cliente se cierre.&#10;Descarga, staging, validación y activación conservan límites&#10;transaccionales.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y&#10;versiones de maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al&#10;recuperar WAN; limita reintentos y trabajo en curso." parent="group-notes-3222-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="668.916016" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-1-bg" value="" parent="group-notes-3222-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="659.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-1-title" value="erp-worker" parent="group-notes-3222-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="119.470215" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-1-body" value="Contenedor · NestJS / Node.js · libs/backend/erp&#10;&#10;apps/erp-worker se ejecuta en la red autorizada del ERP e inicia&#10;HTTPS autenticado hacia country-api para reclamar trabajo, renovar&#10;su lease y registrar resultados. Mantiene destino, versión de&#10;contrato e identidad de intento. Fachada, ACL y adaptadores son&#10;componentes de libs/backend/erp, no servicios HTTP separados&#10;obligatorios. Chile: AX; Perú: custom; España: Gira, con interfaces&#10;por homologar. No accede por SQL remoto a PostgreSQL de país.&#10;La preparación de maestros usa una identidad y presupuesto&#10;propios, conexión saliente a country-api y contrato de fuente&#10;homologado; no ejecuta SQL WAN.&#10;&#10;AUTORIDAD · Proceso con fachada, ACL y adaptadores internos.&#10;Prepara maestros por MasterDataSourcePort con identidad y&#10;presupuesto aislados; country-api conserva publicaciones y&#10;resultados durables.&#10;&#10;CONTINUIDAD · Si país o ERP no responde, conserva identidad y&#10;resultado incierto. Consulta o concilia antes de repetir un efecto." parent="group-notes-3222-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="667.65918" height="550" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-2-bg" value="" parent="group-notes-3222-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="659.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-2-title" value="Entrada y autorización" parent="group-notes-3222-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="248.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-2-body" value="Componente · administration + sync · NestJS&#10;&#10;Controllers y guards de country-api validan identidad, país, entidad,&#10;sucursal y versión de contrato. Componen administration y sync; un&#10;token no habilita acceso a otros países ni a SQL.&#10;&#10;AUTORIDAD · Autentica sucursal o worker; propaga identidad y&#10;límites de país/entidad.&#10;&#10;CONTINUIDAD · Rechaza contratos o capacidades no autorizadas;&#10;no confunde recepción con aplicación." parent="group-notes-3222-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="660.322266" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-3-bg" value="" parent="group-notes-3222-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="659.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-3-title" value="Recepción de operaciones" parent="group-notes-3222-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="296.032715" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-3-body" value="Componente · libs/backend/sync&#10;&#10;Verifica orden, identidad y contrato; usa restricciones y una&#10;transacción para confirmar inbox, efecto/proyección local y outbox.&#10;El ACK certifica ese commit, no contabilización ERP, liquidación de&#10;pago ni aceptación fiscal.&#10;&#10;AUTORIDAD · Inbox, proyección operativa y outbox se confirman&#10;juntos antes del ACK.&#10;&#10;CONTINUIDAD · Un duplicado equivalente conserva resultado; igual&#10;ID con otro contenido es conflicto." parent="group-notes-3222-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="670.097656" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-4-bg" value="" parent="group-notes-3222-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-4-title" value="Trabajo y resultados ERP" parent="group-notes-3222-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="283.92334" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-4-body" value="Componente · sync + erp · contratos públicos propuestos&#10;&#10;Composición objetivo con contratos y casos de uso públicos de sync&#10;y erp: atiende solicitudes HTTPS salientes de erp-worker, reclama&#10;trabajo mediante transiciones condicionales y un lease limitado,&#10;preservando destino y versión. Registra resultados e incertidumbre&#10;con la identidad original. La ACL y los adaptadores de proveedor se&#10;ejecutan sólo en erp-worker; esta vista no afirma que estos imports&#10;estén implementados en la base actual.&#10;&#10;AUTORIDAD · Country-api conserva intentos, lease, destino,&#10;versión y referencias durables.&#10;&#10;CONTINUIDAD · Lease vencido no demuestra que una llamada&#10;externa se haya detenido; resultado incierto exige&#10;consulta/conciliación." parent="group-notes-3222-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="668.916016" height="440" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-5-bg" value="" parent="group-notes-3222-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-5-title" value="Publicaciones y consultas" parent="group-notes-3222-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="286.26709" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-5-body" value="Componente · catalog + pricing + reporting&#10;&#10;Expone manifiestos, deltas, chunks y consultas de estado por&#10;ámbito. PostgreSQL identifica la versión autorizada y su watermark.&#10;Catalog/pricing/reporting conservan sus contratos; country-api no&#10;construye cargas masivas dentro de la solicitud HTTP.&#10;&#10;AUTORIDAD · Lee publicaciones completas y autorizadas; la&#10;extracción y preparación pesada se ejecutan en erp-worker.&#10;&#10;CONTINUIDAD · Sólo sirve versiones compatibles y vigentes; una&#10;caché no cambia su autoridad." parent="group-notes-3222-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="661.525391" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-6-bg" value="" parent="group-notes-3222-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-6-title" value="Publicación de maestros" parent="group-notes-3222-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="272.363281" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-6-body" value="Componente · catalog / pricing / sync · TypeScript&#10;&#10;Componente propuesto dentro de country-api. Recibe porciones&#10;idempotentes y finalización desde erp-worker por HTTPS, valida&#10;cobertura, corte e integridad y confirma versión, manifiesto y evento.&#10;La preparación pesada permanece en el adaptador de fuente del&#10;worker; no ocurre dentro de una petición.&#10;&#10;AUTORIDAD · country-api conserva la autoridad de candidata,&#10;versión, manifiesto, paquetes y publicación en país.&#10;&#10;CONTINUIDAD · Una carga incompleta no sustituye la publicación&#10;vigente. Las sucursales continúan según vigencia y políticas." parent="group-notes-3222-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="667.65918" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-7-bg" value="" parent="group-notes-3222-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="549.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-7-title" value="Puerto de caché opcional" parent="group-notes-3222-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="282.141113" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-7-body" value="Componente · Adaptador TypeScript / cache-aside&#10;&#10;Consulta Redis sólo cuando está habilitado y después de comprobar&#10;autorización, país, entidad y alcance de permisos. Comprueba&#10;versión y vigencia; TTL controla retención/frescura técnica, no&#10;autoriza una versión comercial vencida. Reconstruye entradas&#10;desde PostgreSQL con límites de concurrencia, espera y llenados&#10;para evitar saturar el origen. Una clave o prefijo no es una frontera&#10;de seguridad. No contiene leases, outbox ni resultados financieros&#10;únicos.&#10;&#10;AUTORIDAD · Claves por país, entidad y versión; PostgreSQL&#10;conserva la verdad durable.&#10;&#10;CONTINUIDAD · Miss, expiración o fallo permite leer PostgreSQL&#10;con carga y espera limitadas; la caché no es condición del commit." parent="group-notes-3222-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="670.194336" height="440" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-8-bg" value="" parent="group-notes-3222-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="686.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-8-title" value="Persistencia de país" parent="group-notes-3222-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.12207" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-8-body" value="Componente · Repositorios TypeScript / SQL&#10;&#10;Composición objetivo de persistencia para sync y los contratos&#10;públicos de erp: coordina inbox, proyección y outbox; conserva&#10;trabajo ERP, leases, intentos y resultados mediante transiciones&#10;condicionales. Las respuestas HTTP y la caché no reemplazan el&#10;registro durable. La llamada ERP y sus adaptadores quedan fuera&#10;de esta transacción y del proceso country-api.&#10;&#10;AUTORIDAD · Transacciones y restricciones por país/entidad; no&#10;otro escritor libre de ventas de sucursal.&#10;&#10;CONTINUIDAD · Un commit fallido no produce ACK de aplicación ni&#10;resultado definitivo." parent="group-notes-3222-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="666.359375" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-9-bg" value="" parent="group-notes-3222-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="686.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-9-title" value="Base técnica compartida" parent="group-notes-3222-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="273.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-9-body" value="Componente · shared/backend · composición objetivo&#10;&#10;Composición de bootstrap, config, http/worker, health y observability.&#10;Pino registra diagnóstico estructurado; Sentry es opt-in y requiere&#10;filtrado. El objetivo organizacional es libs/shared/backend; la&#10;evidencia del producto identifica la base actualmente implementada.&#10;No se presume un proyecto Nx por subcarpeta.&#10;&#10;AUTORIDAD · Mecanismos de proceso: configuración validada,&#10;errores y correlación. No contiene reglas monetarias ni auditoría de&#10;negocio.&#10;&#10;CONTINUIDAD · Falla cerrada ante configuración inválida. La&#10;ausencia de telemetría no altera el resultado de negocio." parent="group-notes-3222-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="668.49707" height="385" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-10-bg" value="" parent="group-notes-3222-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="686.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-10-title" value="Datos operativos de país" parent="group-notes-3222-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-10-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención,&#10;backups y deduplicación deben cubrir el horizonte de replay y&#10;restauración. ACK de aplicación local no equivale a contabilización&#10;ERP.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox,&#10;outbox, versiones y resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo&#10;concurrente offline de saldos globales." parent="group-notes-3222-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="660.268555" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-11-bg" value="" parent="group-notes-3222-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="714.592676" height="686.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-11-title" value="Redis · caché de país (opcional)" parent="group-notes-3222-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="358.520508" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3222-11-body" value="Contenedor de datos · Redis · datos reconstruibles&#10;&#10;Ampliación opcional sujeta a medición, capacidad y operación. La&#10;API comprueba identidad, ámbito y autorización antes de leer. Las&#10;claves incluyen país, entidad legal, versión y alcance de permisos&#10;cuando afecte al resultado; un prefijo no sustituye autorización. TTL&#10;y vigencia comercial son independientes. El fallback limita&#10;concurrencia, esperas y llenados para proteger PostgreSQL. No es&#10;la inbox, outbox, base de ventas ni único registro de permisos,&#10;dinero o trabajos; no implica BullMQ ni Redis en cada sucursal. Las&#10;versiones inmutables evitan mezclar publicaciones y PostgreSQL&#10;resuelve la versión autorizada.&#10;&#10;AUTORIDAD · Country-api lee y escribe entradas identificadas por&#10;país, entidad y versión. PostgreSQL conserva la autoridad y el&#10;estado durable.&#10;&#10;CONTINUIDAD · Un miss, expiración o caída permite consultar&#10;PostgreSQL con límites de carga y espera. La ausencia de caché no&#10;es condición del commit; la capacidad del origen sigue siendo&#10;necesaria." parent="group-notes-3222-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="670.172852" height="577.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5224.7" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5290.7" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Angular + Tauri (escritorio), Angular + Capacitor (móvil) y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5359.7" width="1643.80957" height="67.5" as="geometry" />
        </mxCell>
