        <mxCell id="erpExecution_erpFacade" value="" parent="1" edge="1" source="erpExecution" target="erpFacade" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#48638C;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;exitX=1.001322;exitY=0.904304;exitPerimeter=0;entryX=0.498837;entryY=-0.03296;entryPerimeter=0;">
