        <mxCell id="step-14-note" value="Si se corta la LAN conserva estado técnico y reanuda el reporte al reconectar. La pérdida o restauración del journal exige reconciliar antes de volver a ejecutar." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3387" width="1410.810547" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-15-label" value="16  Reporta evidencia con jobId original · HTTPS/LAN saliente" parent="step-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="608.985352" height="27.5" as="geometry" relative="1">
