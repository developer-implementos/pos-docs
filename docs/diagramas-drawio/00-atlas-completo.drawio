          </mxGeometry>
        </mxCell>
        <mxCell id="step-15-note" value="Reintenta la entrega de la evidencia, no el efecto físico. El backend comprueba identidad, hash, dispositivo y transición de estado; no interpreta el spool como prueba física." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3550.5" width="1525.371094" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-16-label" value="17  Conserva estado del trabajo&#10;y trazabilidad · PostgreSQL" parent="step-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="311.867188" height="55" as="geometry" relative="1">
