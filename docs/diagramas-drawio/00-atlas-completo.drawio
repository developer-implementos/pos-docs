        <mxCell id="erpAdapter_countryEntry" value="" parent="1" edge="1" source="erpAdapter" target="countryEntry" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#48638C;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;exitX=0.498845;exitY=1.003109;exitPerimeter=0;entryX=0.875019;entryY=-0.017602;entryPerimeter=0;">
