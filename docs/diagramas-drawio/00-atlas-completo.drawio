            <mxPoint x="1662" y="3138" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-13-note" value="La aceptación del spooler indica recepción técnica y no confirma salida física. Ante resultado incierto conserva la identidad y requiere consulta o intervención; no reimprime automáticamente." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3196" width="1684.257812" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-14-label" value="15  Conserva intento y evidencia&#10;antes de reportar · SQLite" parent="step-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="319.193359" height="55" as="geometry" relative="1">
