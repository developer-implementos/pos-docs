        <mxCell id="notes-2868-0-body" value="Los bloques interiores llaman código TypeScript. No hay HTTP ni bases separadas entre módulos. UI valida experiencia; el backend valida permisos,&#10;integridad, turno y capacidades antes de mutar negocio." parent="group-notes-2868-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1455.201172" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-2868-1-bg" value="" parent="group-notes-2868-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1572.263281" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2868-1-title" value="Transacción y efectos externos" parent="group-notes-2868-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="345.068359" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2868-1-body" value="Intención de pago durable antes de invocar el proveedor; resultado y confirmación local después. Venta + auditoría + outbox se confirman juntas. Venta,&#10;pago, fiscalidad y ERP conservan estados separados y recuperación explícita." parent="group-notes-2868-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1483.506836" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-2868-2-bg" value="" parent="group-notes-2868-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1572.263281" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2868-2-title" value="Precios y caja son dominios diferentes" parent="group-notes-2868-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="426.599121" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2868-2-body" value="La cotización fija versión inmutable y revalida vigencia antes de cobrar. Turno de caja no equivale a sesión de acceso. Devoluciones y compensaciones son&#10;nuevas operaciones auditables; no reescritura de historia." parent="group-notes-2868-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1519.289062" height="55" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3090.785645" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-0-bg" value="" parent="group-notes-3166-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-0-title" value="pos-desktop" parent="group-notes-3166-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="136.193848" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-0-body" value="Contenedor · Angular (frontend) · Tauri (shell nativa)&#10;&#10;apps/pos-desktop entrega la aplicación completa: la shell nativa Tauri aloja el frontend Angular. Tiene arranque,&#10;configuración nativa y build propios. Comparte con pos-mobile libs/client-shell: raíz, configuración, rutas, guards y&#10;layout Angular; esta biblioteca no es la shell nativa ni un proceso adicional. Hardware, SDK y distribución requieren&#10;homologación. Su registro técnico de periféricos no lo convierte en autoridad de ventas.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes." parent="group-notes-3166-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1122.633789" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-1-bg" value="" parent="group-notes-3166-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-1-title" value="pos-mobile" parent="group-notes-3166-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="122.277832" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-1-body" value="Contenedor · Angular (frontend) · Capacitor (shell nativa)&#10;&#10;apps/pos-mobile entrega la aplicación completa: la shell nativa Capacitor aloja el frontend Angular. Tiene arranque,&#10;configuración nativa y build propios. Comparte con pos-desktop libs/client-shell: raíz, configuración, rutas, guards y&#10;layout Angular; esta biblioteca no es la shell nativa ni un proceso adicional. Los adaptadores actuales son mock.&#10;Instalación, ciclo de vida, almacenamiento y capacidades nativas requieren pruebas Android/iOS; no hay acceso&#10;SQL ni permisos implícitos por empaquetar la interfaz.&#10;&#10;AUTORIDAD · Comparte interfaz y contratos; no otra autoridad de ventas.&#10;&#10;CONTINUIDAD · Requiere conexión autorizada al backend de sucursal. El móvil no incorpora autonomía sin LAN." parent="group-notes-3166-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1120.635742" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-2-bg" value="" parent="group-notes-3166-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-2-title" value="API de comandos" parent="group-notes-3166-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="197.338867" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-2-body" value="Componente · Controllers NestJS / Fastify&#10;&#10;Autentica el puesto, valida esquema, propaga commandId y contexto de usuario/sucursal, aplica límites y entrega&#10;un resultado inequívoco o pendiente.&#10;&#10;AUTORIDAD · Contrato del backend; no escribe tablas por fuera de los casos de uso.&#10;&#10;CONTINUIDAD · API local por LAN; rechaza comandos cuando falta una capacidad requerida." parent="group-notes-3166-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1107.959961" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-3-bg" value="" parent="group-notes-3166-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-3-title" value="Acceso y administración" parent="group-notes-3166-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="269.555664" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-3-body" value="Componente · libs/backend/administration&#10;&#10;Compone autorización y configuración operativa por usuario, sucursal y país. La identidad de usuario y puesto se&#10;comprueba en servidor; el menú no es frontera de autorización. Las reglas offline, revocación y aprobaciones&#10;requieren implementación y acuerdo.&#10;&#10;AUTORIDAD · Permisos y evidencia de sesión según política local autorizada.&#10;&#10;CONTINUIDAD · La vigencia offline y revocación requieren política expresa; no acceso indefinido." parent="group-notes-3166-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1105.542969" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-4-bg" value="" parent="group-notes-3166-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-4-title" value="Ventas y devoluciones" parent="group-notes-3166-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="248.779297" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-4-body" value="Componente · libs/backend/sales + returns&#10;&#10;Fija versión de precios al preparar la venta, registra intención y resultado de pagos y documentos; compensaciones&#10;y devoluciones son nuevas operaciones auditables.&#10;&#10;AUTORIDAD · Escritor de ventas y devoluciones; conserva referencias, versiones y estados.&#10;&#10;CONTINUIDAD · Permite solo operaciones soportadas por datos, límites y política vigentes." parent="group-notes-3166-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1126.286133" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-5-bg" value="" parent="group-notes-3166-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-5-title" value="Catálogo, precios y ofertas" parent="group-notes-3166-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="297.375488" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-5-body" value="Componente · libs/backend/pricing + catalog&#10;&#10;Lee una versión completa validada e inmutable. Los deltas construyen una nueva candidata aislada a partir de la&#10;versión base; nunca parchean la activa. La cotización conserva versión, origen y reglas para explicar su cálculo;&#10;fijarla no prolonga su vigencia. Antes de iniciar el pago se revalida y, si la política exige recalcular, se confirma el&#10;importe revisado. Una actualización no altera el importe, identidad ni referencia de un pago iniciado o incierto.&#10;&#10;AUTORIDAD · Lector del espejo PostgreSQL; no redefine el maestro corporativo.&#10;&#10;CONTINUIDAD · No depende de una consulta de precio remoto para las ventas offline autorizadas." parent="group-notes-3166-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1100.719727" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-6-bg" value="" parent="group-notes-3166-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-6-title" value="Caja, cobranzas y anticipos" parent="group-notes-3166-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="305.712891" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-6-body" value="Componente · libs/backend/cash + collections&#10;&#10;Los módulos cash y collections conservan límites distintos dentro del mismo proceso. Gestionan apertura/cierre y&#10;movimientos de caja, además de cobranzas y anticipos habilitados. Turno de caja, sesión de acceso, saldo, abono&#10;y depósito no son equivalentes. Cada efecto conserva identidad, autorización y auditoría; no se consume crédito&#10;global offline sin política explícita.&#10;&#10;AUTORIDAD · Libro de movimientos y turnos de sucursal, con autorización y auditoría.&#10;&#10;CONTINUIDAD · Opera localmente; excepciones y límites requieren una política aprobada." parent="group-notes-3166-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1116.951172" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-7-bg" value="" parent="group-notes-3166-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-7-title" value="Pagos y dispositivos" parent="group-notes-3166-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="226.501465" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-7-body" value="Componente · libs/backend/payments + devices&#10;&#10;Payments conserva intentos y estados financieros; devices coordina capacidades y evidencia del dispositivo. No&#10;mantiene SQL abierto al esperar al proveedor. Persiste intención y resultado en momentos separados. Para SDK&#10;local, el cliente transporta al puente el comando original autorizado por backend y devuelve evidencia; no inventa&#10;importe, permiso ni otro intento.&#10;&#10;AUTORIDAD · Conserva identidad de intento y referencia del proveedor; no inventa resultado.&#10;&#10;CONTINUIDAD · Si el proveedor no responde: pendiente/desconocido, consulta o resolución operativa." parent="group-notes-3166-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1103.147461" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-8-bg" value="" parent="group-notes-3166-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-8-title" value="Fiscalidad y adaptadores" parent="group-notes-3166-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="277.941895" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-8-body" value="Componente · libs/backend/fiscal&#10;&#10;Separa confirmación de venta de validez fiscal. Un timeout fiscal mantiene la referencia original y la incertidumbre&#10;hasta consultar o conciliar.&#10;&#10;AUTORIDAD · Conserva identidad del documento y estados de emisión/aceptación/transmisión.&#10;&#10;CONTINUIDAD · Solo modalidades legal y técnicamente habilitadas; falta de capacidad bloquea esa acción." parent="group-notes-3166-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1109.109375" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-9-bg" value="" parent="group-notes-3166-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-9-title" value="Reportes operativos" parent="group-notes-3166-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="223.730469" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-9-body" value="Componente · libs/backend/reporting&#10;&#10;Consultas de ventas, turnos, pagos y pendientes respetan ámbito y permisos. Una proyección consultable no&#10;constituye otra autoridad para editar la operación.&#10;&#10;AUTORIDAD · Sólo lectura/proyecciones autorizadas; no corrige dinero desde un reporte.&#10;&#10;CONTINUIDAD · Los reportes locales reflejan la información disponible y su estado de sincronización." parent="group-notes-3166-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1065.173828" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-10-bg" value="" parent="group-notes-3166-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-10-title" value="Persistencia transaccional" parent="group-notes-3166-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="290.41748" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-10-body" value="Componente · Repositorios + contrato outbox (sync)&#10;&#10;Confirma negocio, auditoría y contrato outbox de libs/backend/sync en la misma transacción de PostgreSQL de&#10;sucursal. Cada módulo conserva propiedad de sus datos. No engloba llamadas a proveedores ni ERP. Los logs de&#10;Pino no sustituyen la auditoría persistida en este commit.&#10;&#10;AUTORIDAD · Un commit sobre PostgreSQL de sucursal; restricciones e idempotencia de comandos.&#10;&#10;CONTINUIDAD · La operación no se confirma si el commit falla. Falta de disco exige política de bloqueo." parent="group-notes-3166-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1117.391602" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-11-bg" value="" parent="group-notes-3166-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-11-title" value="Base técnica compartida" parent="group-notes-3166-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="273.754883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-11-body" value="Componente · shared/backend · composición objetivo&#10;&#10;Composición de bootstrap, config, http/worker, health y observability. Pino registra diagnóstico estructurado; Sentry&#10;es opt-in y requiere filtrado. El objetivo organizacional es libs/shared/backend; la evidencia del producto identifica la&#10;base actualmente implementada. No se presume un proyecto Nx por subcarpeta.&#10;&#10;AUTORIDAD · Mecanismos de proceso: configuración validada, errores y correlación. No contiene reglas&#10;monetarias ni auditoría de negocio.&#10;&#10;CONTINUIDAD · Falla cerrada ante configuración inválida. La ausencia de telemetría no altera el resultado de&#10;negocio." parent="group-notes-3166-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1125.104492" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-12-bg" value="" parent="group-notes-3166-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-12-title" value="Datos de sucursal" parent="group-notes-3166-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-12-body" value="Contenedor de datos · PostgreSQL&#10;&#10;branch-api y branch-sync-worker acceden al mismo PostgreSQL de la sucursal con responsabilidades y permisos&#10;distintos. Ventas, caja, pagos y evidencia fiscal se conservan aquí; inbox, outbox, cursores y staging tienen&#10;restricciones y transacciones según cada operación. Las llamadas de red quedan fuera de esas transacciones.&#10;Catálogo, precios y promociones son réplicas de lectura autorizadas, no maestros independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API escribe negocio; worker escribe su&#10;esquema técnico y publica espejos por un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica respaldo, alta disponibilidad ni recuperación&#10;automática." parent="group-notes-3166-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1109.066406" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-13-bg" value="" parent="group-notes-3166-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-13-title" value="Proveedor de pagos" parent="group-notes-3166-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-13-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Autoriza o informa el resultado del pago. Transbank con terminal local en Chile y Niubiz en Perú proceden de las&#10;fuentes revisadas. Mercado Pago Point es un ejemplo presencial ilustrativo, sin adopción ni integración&#10;acreditadas; Webpay Plus es un ejemplo de pago online de Transbank, distinto de su terminal de tienda. En&#10;España se informan BBVA/Redsys con TPV portátiles sin conexión a Gira y conciliación contable; no se presume&#10;una API o SDK ya integrado. Cada ruta y capacidad requiere homologación. Pago, venta, documento fiscal e&#10;integración ERP tienen estados distintos. No repetir un cargo incierto ni cambiar de proveedor para resolverlo&#10;automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout puede dejar resultado desconocido." parent="group-notes-3166-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1102.599609" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-14-bg" value="" parent="group-notes-3166-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1173.197461" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-14-title" value="Proveedor de facturación" parent="group-notes-3166-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="279.333496" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3166-14-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Acepta/Ingydev aparecen en el código legacy chileno y EFACT en las fuentes de Perú. Gira se informa como&#10;solución de España; su modalidad fiscal, interfaces y capacidades deben confirmarse. Estos ejemplos no&#10;seleccionan un proveedor corporativo ni acreditan adaptadores homologados para POS Platform. SII y SUNAT son&#10;autoridades tributarias, no estos proveedores de software; en España corresponde la autoridad del régimen y&#10;territorio aplicables. Emisión, aceptación y transmisión se modelan por separado. No se inventa un proveedor&#10;común ni una capacidad de consulta o idempotencia no acreditada.&#10;&#10;AUTORIDAD · La solución prepara, emite o transmite documentos por cuenta del contribuyente según su contrato.&#10;La autoridad tributaria es distinta: SII en Chile, SUNAT en Perú y la autoridad aplicable en España.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se promete universalmente." parent="group-notes-3166-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1120.979492" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4971.285645" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5037.285645" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. Backend, datos e integración: diseño por implementar. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5106.285645" width="2113.040039" height="67.5" as="geometry" />
        </mxCell>
