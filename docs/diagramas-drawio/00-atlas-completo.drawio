            <mxPoint x="597" y="1501.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-4-note" value="La continuación mostrada requiere un resultado suficiente para confirmar según política. Rechazo o respuesta desconocida siguen su estado y recuperación propios." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1559.5" width="1465.322266" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-5-label" value="06  Confirma venta + caja +&#10;auditoría + outbox · PostgreSQL" parent="step-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="316.131836" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-5" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="1692.5" as="sourcePoint" />
            <mxPoint x="951" y="1692.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-5-note" value="Revalida invariantes y deduplicación; confirma venta, caja, auditoría y outbox en una misma transacción. Incluye partidas, impuestos, referencias de pago y la evidencia fiscal que deba ser simultánea. El commit no incluye al proveedor externo ni al ERP." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1750.5" width="2241.953125" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-6-label" value="07  Confirma operación y&#10;documento permitido · HTTPS" parent="step-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="297.107422" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-6" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="596" y="1883.5" as="sourcePoint" />
            <mxPoint x="242" y="1883.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-6-note" value="Solo después del commit local. Muestra estados de pago, fiscalidad e integración; la entrega a país puede permanecer pendiente sin negar la venta ya confirmada." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1941.5" width="1448.662109" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-7-label" value="08  Solicita imprimir el&#10;documento existente ·&#10;HTTPS/LAN" parent="step-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="216.455078" height="82.5" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-97.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-7" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="242" y="2102" as="sourcePoint" />
            <mxPoint x="596" y="2102" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-7-note" value="F02/F05: pos-desktop solicita imprimir en su puesto asignado. El agente ejecuta el trabajo sin usar el cliente como relé ni exigir su ventana abierta. La impresión compartida y el acceso móvil se incorporan en F06 tras homologación." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2160" width="2053.300781" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-8-label" value="09  Autoriza y registra trabajo&#10;con jobId y hash · PostgreSQL" parent="step-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="299.610352" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-8" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="2293" as="sourcePoint" />
            <mxPoint x="951" y="2293" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-8-note" value="Valida usuario, sucursal, capacidad, dispositivo y agente dueño. El trabajo referencia el documento ya emitido; una impresión o reimpresión no genera otra venta ni documento fiscal." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2351" width="1609.443359" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-9-label" value="10  Obtiene trabajos de su equipo · HTTPS/LAN saliente" parent="step-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="552.75" height="27.5" as="geometry" relative="1">
            <mxPoint x="-514.5" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-9" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1661" y="2456.5" as="sourcePoint" />
            <mxPoint x="597" y="2456.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-9-note" value="F02/F05: agente C#/.NET en el mismo puesto Windows que pos-desktop, con lifecycle independiente. Autentica agente y puesto; sólo obtiene sus trabajos asignados. Inicia HTTPS LAN hacia branch-api; no expone una API entrante para los clientes." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2514.5" width="2213.515625" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-10-label" value="11  Entrega trabajo autorizado e identidad estable · HTTPS" parent="step-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="576.823242" height="27.5" as="geometry" relative="1">
            <mxPoint x="-514.5" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-10" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="2620" as="sourcePoint" />
            <mxPoint x="1661" y="2620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-10-note" value="Respuesta a la solicitud del agente. Mantiene jobId, hash, destino y autorización; un lease vencido no acredita que el efecto físico no se ejecutó." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2678" width="1279.707031" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-11-label" value="12  Persiste recepción y&#10;deduplicación · SQLite" parent="step-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="234.78125" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-11" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1662" y="2811" as="sourcePoint" />
            <mxPoint x="2016" y="2811" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-11-note" value="Antes de ejecutar registra jobId, hash e intento. Mismo jobId y mismo hash recuperan estado; mismo jobId con distinto hash es conflicto. El journal no es una base de ventas." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2869" width="1537.519531" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-12-label" value="13  Ejecuta impresión autorizada · driver/SDK homologado" parent="step-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="573.525391" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-12" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1662" y="2974.5" as="sourcePoint" />
            <mxPoint x="2371" y="2974.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-12-note" value="Un único agente autorizado opera el equipo físico. Las capacidades y drivers requieren homologación; este flujo de impresión no habilita un terminal de pago." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3032.5" width="1398.652344" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-13-label" value="14  Devuelve evidencia técnica de ejecución · driver/SDK" parent="step-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="558.851562" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-13" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2371" y="3138" as="sourcePoint" />
            <mxPoint x="1662" y="3138" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-13-note" value="La aceptación del spooler indica recepción técnica y no confirma salida física. Ante resultado incierto conserva la identidad y requiere consulta o intervención; no reimprime automáticamente." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3196" width="1684.257812" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-14-label" value="15  Conserva intento y evidencia&#10;antes de reportar · SQLite" parent="step-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="319.193359" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-14" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1662" y="3329" as="sourcePoint" />
            <mxPoint x="2016" y="3329" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-14-note" value="Si se corta la LAN conserva estado técnico y reanuda el reporte al reconectar. La pérdida o restauración del journal exige reconciliar antes de volver a ejecutar." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3387" width="1410.810547" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-15-label" value="16  Reporta evidencia con jobId original · HTTPS/LAN saliente" parent="step-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="608.985352" height="27.5" as="geometry" relative="1">
            <mxPoint x="-514.5" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-15" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1661" y="3492.5" as="sourcePoint" />
            <mxPoint x="597" y="3492.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-15-note" value="Reintenta la entrega de la evidencia, no el efecto físico. El backend comprueba identidad, hash, dispositivo y transición de estado; no interpreta el spool como prueba física." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3550.5" width="1525.371094" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-16-label" value="17  Conserva estado del trabajo&#10;y trazabilidad · PostgreSQL" parent="step-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="311.867188" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-16" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="3683.5" as="sourcePoint" />
            <mxPoint x="951" y="3683.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-16-note" value="La venta y su documento mantienen sus identidades. Reimpresión es una operación explícita y autorizada con auditoría y referencia al trabajo anterior." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3741.5" width="1339.6875" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-17-label" value="18  Lee outbox confirmada y reclama lote acotado · PostgreSQL" parent="step-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="627.354492" height="27.5" as="geometry" relative="1">
            <mxPoint x="-869.5" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-17" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2726" y="3847" as="sourcePoint" />
            <mxPoint x="952" y="3847" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-17-note" value="El claim o lease técnico es recuperable. No mantiene una transacción abierta durante el envío ni altera libremente las ventas." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3905" width="1110.625" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-18-label" value="19  Envía lote con eventId y&#10;secuencia · HTTPS autenticado" parent="step-18" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="310.599609" height="55" as="geometry" relative="1">
