        <mxCell id="group-notes-3249-4" value="" parent="1" vertex="1" style="group;html=0;container=1;collapsible=0;recursiveResize=0;">
          <mxGeometry x="64" y="3932.1" width="714.592676" height="549.25" as="geometry" />
