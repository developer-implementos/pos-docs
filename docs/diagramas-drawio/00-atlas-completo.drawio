        <mxCell id="step-4-note" value="Usa identidad de sucursal y país, contrato y cursor durable. Una carga completa puede ser programada o solicitada como recuperación manual controlada." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1569" width="1376.318359" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-5-label" value="06  Lee la publicación y su corte&#10;consistente · SQL" parent="step-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="314.305664" height="55" as="geometry" relative="1">
