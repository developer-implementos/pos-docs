            <mxPoint x="1306" y="1129" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-2-note" value="Entrega porciones idempotentes y pide finalización; una respuesta perdida conserva identidad. No abre SQL remoto ni decide la publicación en país." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1187" width="1319.707031" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-3-label" value="04  Versión, manifiesto y outbox&#10;· PostgreSQL" parent="step-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
