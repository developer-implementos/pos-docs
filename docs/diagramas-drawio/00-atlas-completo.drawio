        </mxCell>
        <mxCell id="notes-3094-0-bg" value="" parent="group-notes-3094-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="2000.344922" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-0-title" value="Frontera de continuidad" parent="group-notes-3094-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="264.0625" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-0-body" value="Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen nuevos comandos dependientes; el puesto no se convierte en escritor de emergencia.&#10;Redis de país y la telemetría externa no son dependencias de la venta local." parent="group-notes-3094-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1909.43457" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-1-bg" value="" parent="group-notes-3094-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="2000.344922" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-1-title" value="Red autorizada del ERP" parent="group-notes-3094-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="268.212891" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-1-body" value="erp-worker inicia HTTPS autenticado hacia country-api para obtener trabajo y reportar resultados. El acceso al ERP permanece en su red autorizada; no se expone SQL ni se exige conexión entrante&#10;desde país. Protocolo, alojamiento y credenciales se homologan por destino." parent="group-notes-3094-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1937.074219" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-2-bg" value="" parent="group-notes-3094-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="2000.344922" height="164.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-2-title" value="Recuperación y operación" parent="group-notes-3094-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="290.454102" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3094-2-body" value="Backups fuera de la instancia y ensayos de restore. RPO/RTO, retención, dimensionamiento y alta disponibilidad deben validarse. Excluir al escritor antiguo antes de recuperar; réplica no reemplaza&#10;backup. Logs, métricas y trazas correlacionan operación e intento." parent="group-notes-3094-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1927.674805" height="55" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3316.85" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-0-bg" value="" parent="group-notes-3392-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-0-title" value="pos-desktop" parent="group-notes-3392-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="136.193848" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-0-body" value="Contenedor · Angular (frontend) · Tauri (shell nativa)&#10;&#10;apps/pos-desktop entrega la aplicación completa: la shell nativa Tauri aloja el frontend Angular. Tiene arranque, configuración nativa y build propios.&#10;Comparte con pos-mobile libs/client-shell: raíz, configuración, rutas, guards y layout Angular; esta biblioteca no es la shell nativa ni un proceso&#10;adicional. Solicita capacidades de dispositivos a branch-api; no transporta trabajos a device-agent ni necesita mantenerse abierto para que éste&#10;opere. Distribución e integración nativa requieren homologación; no posee autoridad de ventas.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes." parent="group-notes-3392-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1442.289062" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-1-bg" value="" parent="group-notes-3392-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-1-title" value="pos-mobile" parent="group-notes-3392-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="122.277832" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-1-body" value="Contenedor · Angular (frontend) · Capacitor (shell nativa)&#10;&#10;apps/pos-mobile entrega la aplicación completa: la shell nativa Capacitor aloja el frontend Angular. Tiene arranque, configuración nativa y build&#10;propios. Comparte con pos-desktop libs/client-shell: raíz, configuración, rutas, guards y layout Angular; esta biblioteca no es la shell nativa ni un&#10;proceso adicional. Los adaptadores actuales son mock. Instalación, ciclo de vida, almacenamiento y capacidades nativas requieren pruebas&#10;Android/iOS; no hay acceso SQL ni permisos implícitos por empaquetar la interfaz. Solicita impresión y capacidades autorizadas a branch-api;&#10;device-agent las ejecuta en el equipo conectado al hardware, sin depender de pos-desktop.&#10;&#10;AUTORIDAD · Comparte interfaz y contratos; no otra autoridad de ventas.&#10;&#10;CONTINUIDAD · Requiere conexión autorizada al backend de sucursal. El móvil no incorpora autonomía sin LAN." parent="group-notes-3392-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1400.201172" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-2-bg" value="" parent="group-notes-3392-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-2-title" value="device-agent" parent="group-notes-3392-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="143.151855" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-2-body" value="Contenedor · C# / .NET · Windows&#10;&#10;Aplicación objetivo apps/device-agent, aún no implementada. Servicio autónomo en el equipo Windows conectado al hardware; funciona sin&#10;pos-desktop abierto. Inicia HTTPS LAN autenticado hacia branch-api para obtener trabajos y reportar evidencia. Cada trabajo conserva jobId, hash&#10;del contenido, destino y autorización. SQLite registra deduplicación e intentos técnicos; una aceptación del spooler no acredita impresión física.&#10;SDK, drivers y hardware requieren homologación. Pagos por SDK local son una capacidad futura independiente: migrar impresión no acredita&#10;cobros.&#10;&#10;AUTORIDAD · Un único agente autorizado por equipo físico; branch-api conserva permisos, documentos y estado de negocio. El agente no cobra ni&#10;emite documentos por decisión propia.&#10;&#10;CONTINUIDAD · Sin LAN no obtiene trabajos nuevos. Conserva evidencia del trabajo en curso para reanudar su reporte; un resultado incierto no&#10;autoriza repetir el efecto." parent="group-notes-3392-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1447.520508" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-3-bg" value="" parent="group-notes-3392-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-3-title" value="Journal técnico de dispositivos" parent="group-notes-3392-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="339.074707" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-3-body" value="Contenedor de datos · SQLite&#10;&#10;Persistencia técnica propuesta. Registra recepción durable, identidad de agente y equipo, hash del contenido, intento y evidencia del driver/spooler.&#10;Mismo jobId con distinto hash es conflicto. Guarda evidencia antes de reportarla; no interpreta spool accepted como impresión física. Restore o&#10;pérdida del journal exige reconciliar antes de repetir efectos; un lease vencido no prueba que el hardware no actuó.&#10;&#10;AUTORIDAD · Privado de device-agent en su equipo. No contiene ventas, caja, precios ni autoridad financiera.&#10;&#10;CONTINUIDAD · Conserva jobId, hash y estados técnicos durante cortes de LAN; al reconectar reporta con la misma identidad." parent="group-notes-3392-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1440.699219" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-4-bg" value="" parent="group-notes-3392-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-4-title" value="branch-api" parent="group-notes-3392-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="118.127441" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-4-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/branch-api compone los contextos operativos: sales/returns, cash/collections, pricing/catalog, payments/devices, fiscal, reporting y&#10;administration. sync aporta el contrato outbox que se confirma con negocio. El transporte pertenece a branch-sync-worker y la ACL ERP a&#10;erp-worker. Bibliotecas no equivalen a microservicios; las capacidades de negocio aún requieren implementación. devices autoriza y conserva&#10;trabajos, auditoría y observaciones de periféricos en PostgreSQL de sucursal. Recibe evidencia de device-agent por conexiones iniciadas por el&#10;agente; los clientes no actúan como relé. Registrar o imprimir un trabajo conserva la referencia del documento y no modifica la confirmación de la&#10;venta.&#10;&#10;AUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos internos, un proceso.&#10;&#10;CONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del escritor autorizado." parent="group-notes-3392-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1418.495117" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-5-bg" value="" parent="group-notes-3392-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-5-title" value="Datos de sucursal" parent="group-notes-3392-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-5-body" value="Contenedor de datos · PostgreSQL&#10;&#10;branch-api y branch-sync-worker acceden al mismo PostgreSQL de la sucursal con responsabilidades y permisos distintos. Ventas, caja, pagos y&#10;evidencia fiscal se conservan aquí. devices es propietario de los trabajos autorizados, su auditoría y las observaciones de periféricos recibidas del&#10;agente; estos registros conservan identidad y referencia al documento, sin formar parte de la misma transacción de confirmación de venta. El&#10;journal SQLite privado del agente sólo registra ejecución técnica. Inbox, outbox, cursores y staging tienen restricciones y transacciones según cada&#10;operación. Las llamadas de red quedan fuera de esas transacciones. Catálogo, precios y promociones son réplicas de lectura autorizadas, no&#10;maestros independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API escribe negocio; worker escribe su esquema técnico y publica espejos por&#10;un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica respaldo, alta disponibilidad ni recuperación automática." parent="group-notes-3392-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1449.851562" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-6-bg" value="" parent="group-notes-3392-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-6-title" value="branch-sync-worker" parent="group-notes-3392-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="219.506836" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-6-body" value="Contenedor · NestJS / Node.js · sin servidor HTTP&#10;&#10;apps/branch-sync-worker compone libs/backend/sync con pricing/catalog para preparar y activar versiones. Entrega outbox por HTTPS con&#10;identidad y cursor; confirma acuses durables. El proceso supervisado sigue activo aunque el cliente se cierre. Descarga, staging, validación y&#10;activación conservan límites transaccionales.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita reintentos y trabajo en curso." parent="group-notes-3392-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1379.404297" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-7-bg" value="" parent="group-notes-3392-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-7-title" value="country-api" parent="group-notes-3392-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="123.669434" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-7-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;apps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único commit antes del ACK de&#10;aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS saliente iniciado por ese worker. Valida, publica y sirve versiones preparadas&#10;mediante MasterDataSourcePort en erp-worker; no ejecuta la ACL ni carga masiva pesada en un endpoint. La caché opcional acelera lecturas&#10;reconstruibles, con PostgreSQL como fuente durable.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación. Conserva autoridad de versiones,&#10;manifiestos y publicación de maestros.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización." parent="group-notes-3392-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1448.65918" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-8-bg" value="" parent="group-notes-3392-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-8-title" value="Datos operativos de país" parent="group-notes-3392-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-8-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención, backups y deduplicación deben cubrir el horizonte de replay y restauración. ACK de&#10;aplicación local no equivale a contabilización ERP.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox, outbox, versiones y resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo concurrente offline de saldos globales." parent="group-notes-3392-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1441.816406" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-9-bg" value="" parent="group-notes-3392-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-9-title" value="Redis · caché de país (opcional)" parent="group-notes-3392-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="358.520508" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-9-body" value="Contenedor de datos · Redis · datos reconstruibles&#10;&#10;Ampliación opcional sujeta a medición, capacidad y operación. La API comprueba identidad, ámbito y autorización antes de leer. Las claves&#10;incluyen país, entidad legal, versión y alcance de permisos cuando afecte al resultado; un prefijo no sustituye autorización. TTL y vigencia comercial&#10;son independientes. El fallback limita concurrencia, esperas y llenados para proteger PostgreSQL. No es la inbox, outbox, base de ventas ni único&#10;registro de permisos, dinero o trabajos; no implica BullMQ ni Redis en cada sucursal. Las versiones inmutables evitan mezclar publicaciones y&#10;PostgreSQL resuelve la versión autorizada.&#10;&#10;AUTORIDAD · Country-api lee y escribe entradas identificadas por país, entidad y versión. PostgreSQL conserva la autoridad y el estado durable.&#10;&#10;CONTINUIDAD · Un miss, expiración o caída permite consultar PostgreSQL con límites de carga y espera. La ausencia de caché no es condición&#10;del commit; la capacidad del origen sigue siendo necesaria." parent="group-notes-3392-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1444.233398" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-10-bg" value="" parent="group-notes-3392-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-10-title" value="erp-worker" parent="group-notes-3392-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="119.470215" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-10-body" value="Contenedor · NestJS / Node.js · libs/backend/erp&#10;&#10;apps/erp-worker se ejecuta en la red autorizada del ERP e inicia HTTPS autenticado hacia country-api para reclamar trabajo, renovar su lease y&#10;registrar resultados. Mantiene destino, versión de contrato e identidad de intento. Fachada, ACL y adaptadores son componentes de&#10;libs/backend/erp, no servicios HTTP separados obligatorios. Chile: AX; Perú: custom; España: Gira, con interfaces por homologar. No accede por&#10;SQL remoto a PostgreSQL de país. La preparación de maestros usa una identidad y presupuesto propios, conexión saliente a country-api y contrato&#10;de fuente homologado; no ejecuta SQL WAN.&#10;&#10;AUTORIDAD · Proceso con fachada, ACL y adaptadores internos. Prepara maestros por MasterDataSourcePort con identidad y presupuesto&#10;aislados; country-api conserva publicaciones y resultados durables.&#10;&#10;CONTINUIDAD · Si país o ERP no responde, conserva identidad y resultado incierto. Consulta o concilia antes de repetir un efecto." parent="group-notes-3392-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1447.97168" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-11-bg" value="" parent="group-notes-3392-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-11-title" value="ERP del país" parent="group-notes-3392-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-11-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú son antecedentes; versión, interfaces y capacidades deben confirmarse. No&#10;se afirma que exista el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no revierte una venta local confirmada." parent="group-notes-3392-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1434.393555" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-12-bg" value="" parent="group-notes-3392-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-12-title" value="Proveedor de pagos" parent="group-notes-3392-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-12-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Autoriza o informa el resultado del pago. Transbank con terminal local en Chile y Niubiz en Perú proceden de las fuentes revisadas. Mercado Pago&#10;Point es un ejemplo presencial ilustrativo, sin adopción ni integración acreditadas; Webpay Plus es un ejemplo de pago online de Transbank, distinto&#10;de su terminal de tienda. En España se informan BBVA/Redsys con TPV portátiles sin conexión a Gira y conciliación contable; no se presume una&#10;API o SDK ya integrado. Cada ruta y capacidad requiere homologación. Pago, venta, documento fiscal e integración ERP tienen estados distintos.&#10;No repetir un cargo incierto ni cambiar de proveedor para resolverlo automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout puede dejar resultado desconocido." parent="group-notes-3392-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1447.982422" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-13-bg" value="" parent="group-notes-3392-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-13-title" value="Proveedor de facturación" parent="group-notes-3392-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="279.333496" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-13-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Acepta/Ingydev aparecen en el código legacy chileno y EFACT en las fuentes de Perú. Gira se informa como solución de España; su modalidad&#10;fiscal, interfaces y capacidades deben confirmarse. Estos ejemplos no seleccionan un proveedor corporativo ni acreditan adaptadores homologados&#10;para POS Platform. SII y SUNAT son autoridades tributarias, no estos proveedores de software; en España corresponde la autoridad del régimen y&#10;territorio aplicables. Emisión, aceptación y transmisión se modelan por separado. No se inventa un proveedor común ni una capacidad de consulta o&#10;idempotencia no acreditada.&#10;&#10;AUTORIDAD · La solución prepara, emite o transmite documentos por cuenta del contribuyente según su contrato. La autoridad tributaria es&#10;distinta: SII en Chile, SUNAT en Perú y la autoridad aplicable en España.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se promete universalmente." parent="group-notes-3392-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1449.164062" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-14-bg" value="" parent="group-notes-3392-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-14-title" value="Respaldo y recuperación" parent="group-notes-3392-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-14-body" value="Infraestructura · Backups PostgreSQL / herramienta por definir&#10;&#10;Backups externos a la instancia, pruebas de restore y exclusión del escritor anterior. Una réplica no sustituye un backup; alta disponibilidad requiere&#10;diseño y ensayos separados.&#10;&#10;AUTORIDAD · Operaciones define retención, RPO/RTO y reconstrucción de evidencia.&#10;&#10;CONTINUIDAD · No es un segundo escritor activo ni garantiza continuidad inmediata." parent="group-notes-3392-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1443.041016" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-15-bg" value="" parent="group-notes-3392-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-15-title" value="Observabilidad operativa (opcional)" parent="group-notes-3392-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="393.273926" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-15-body" value="Sistema externo · Recolector de logs / Sentry opt-in&#10;&#10;Pino produce logs estructurados y correlacionados en los procesos. Un destino de recolección y Sentry sólo se habilitan con configuración aprobada&#10;y datos sensibles filtrados. La telemetría ayuda a diagnosticar; no reemplaza auditoría transaccional, inbox/outbox, backups ni conciliación&#10;financiera.&#10;&#10;AUTORIDAD · Operación administra acceso, retención y datos permitidos. La auditoría de negocio permanece en PostgreSQL.&#10;&#10;CONTINUIDAD · La indisponibilidad de telemetría no confirma ni revierte operaciones; buffers y descarte tienen límites." parent="group-notes-3392-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1447.960938" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-16-bg" value="" parent="group-notes-3392-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-16-title" value="Fuentes de maestros y precios" parent="group-notes-3392-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-16-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener responsable, contrato, versión y vigencia. La fuente de precios no se sustituye por una&#10;tabla editada libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la política autorizada." parent="group-notes-3392-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1406.37793" height="220" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-17-bg" value="" parent="group-notes-3392-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1494.258691" height="356.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-17-title" value="Periféricos físicos" parent="group-notes-3392-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="195.88623" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3392-17-body" value="Hardware externo · Driver / SDK homologado&#10;&#10;Hardware de sucursal conectado al equipo que ejecuta device-agent. La impresión conserva referencia de documento y trabajo; el spooler sólo&#10;informa recepción técnica. Reimpresión es una operación autorizada explícita. Lectores y demás capacidades requieren contratos y homologación&#10;propios. El SDK de un terminal de pago no se presume habilitado por migrar impresión.&#10;&#10;AUTORIDAD · Un único device-agent autorizado opera cada equipo físico. La aplicación solicita capacidades a branch-api.&#10;&#10;CONTINUIDAD · La capacidad depende del equipo, driver y estado físico. Un timeout puede dejar resultado incierto." parent="group-notes-3392-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1428.356445" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5715.6" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5781.6" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. device-agent: C#/.NET Windows propuesto, aún no implementado; journal técnico SQLite, sin autoridad de ventas. Backend, datos e integración: diseño por implementar. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5850.6" width="3033.553711" height="67.5" as="geometry" />
        </mxCell>
