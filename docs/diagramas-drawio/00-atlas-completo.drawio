          </mxGeometry>
        </mxCell>
        <mxCell id="step-3-note" value="Tras validar corte, cobertura e integridad, country-api confirma publicación y evento. Los paquetes siguen inmutables y una carga parcial nunca sustituye la versión activa." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1378" width="1510.078125" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-4-label" value="05  Solicita deltas o snapshot ·&#10;HTTPS autenticado" parent="step-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="299.621094" height="55" as="geometry" relative="1">
