        <mxCell id="step-3-note" value="El consumidor obtiene capacidad antes del claim. Concurrencia, reintentos y preparación masiva tienen presupuesto propio; el estado durable se consulta por HTTPS, sin Redis o SQL WAN." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1442.5" width="1684.589844" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-4-label" value="05  Reclama solicitud y corte autorizado · HTTPS saliente" parent="step-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="563.685547" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-4" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="1548" as="sourcePoint" />
            <mxPoint x="1306" y="1548" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-4-note" value="Al comenzar la ejecución obtiene trabajo, identidad y lease de publicación. Una reentrega consulta su estado original; la espera en Redis no extiende un lease de negocio." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1606" width="1513.212891" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-5-label" value="06  Obtiene cambios o carga&#10;completa autorizada" parent="step-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="281.273438" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-5" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="596" y="1739" as="sourcePoint" />
            <mxPoint x="242" y="1739" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-5-note" value="Interfaz por confirmar; el contrato identifica origen, cobertura, versión y vigencia. La secuencia no presupone CDC ni un broker." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1797" width="1127.265625" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-6-label" value="07  Prepara porciones con corte consistente" parent="step-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="430.47168" height="27.5" as="geometry" relative="1">
            <mxPoint x="-178" y="-66" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-6" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="596" y="1902.5" as="sourcePoint" />
            <mxPoint x="597" y="1950.5" as="targetPoint" />
            <Array as="points">
              <mxPoint x="806.5" y="1902.5" />
              <mxPoint x="806.5" y="1950.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step-6-note" value="MasterDataSourcePort valida el contrato de fuente y prepara una candidata. Claims, identidad y presupuesto separados de los comandos financieros. La publicación en país pertenece a country-api." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1997.5" width="1755.498047" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-7-label" value="08  Claim, upload y finalize · HTTPS saliente" parent="step-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="436.519531" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-7" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="2103" as="sourcePoint" />
            <mxPoint x="1306" y="2103" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-7-note" value="Entrega porciones idempotentes y pide finalización; una respuesta perdida conserva identidad. No abre SQL remoto ni decide la publicación en país." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2161" width="1319.707031" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-8-label" value="09  Versión, manifiesto y outbox&#10;· PostgreSQL" parent="step-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="311.845703" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-8" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1306" y="2294" as="sourcePoint" />
            <mxPoint x="952" y="2294" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-8-note" value="Tras validar corte, cobertura e integridad, country-api confirma versión, manifiesto y evento outbox en una misma transacción. Los paquetes siguen inmutables y una carga parcial nunca sustituye la versión activa." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2352" width="1881.357422" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-9-label" value="10  Solicita deltas o snapshot ·&#10;HTTPS autenticado" parent="step-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="299.621094" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-9" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1661" y="2485" as="sourcePoint" />
            <mxPoint x="1307" y="2485" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-9-note" value="Usa identidad de sucursal y país, contrato y cursor durable. Una carga completa puede ser programada o solicitada como recuperación manual controlada." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2543" width="1376.318359" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-10-label" value="11  Lee la publicación y su corte&#10;consistente · PostgreSQL" parent="step-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="312.672852" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-10" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1306" y="2676" as="sourcePoint" />
            <mxPoint x="952" y="2676" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-10-note" value="Selecciona la cobertura autorizada para esa sucursal y entrega una versión identificable, con manifiesto y deltas compatibles." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2734" width="1112.851562" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-11-label" value="12  Devuelve manifiesto, deltas&#10;o chunks · HTTPS" parent="step-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="305.722656" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-11" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1307" y="2867" as="sourcePoint" />
            <mxPoint x="1661" y="2867" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-11-note" value="La respuesta permite verificar versión, esquema, cobertura, watermark y checksum. Recibir bytes no significa haber aplicado los datos." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2925" width="1198.330078" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-12-label" value="13  Persiste recepción y staging&#10;· PostgreSQL" parent="step-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="311.834961" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-12" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1662" y="3058" as="sourcePoint" />
            <mxPoint x="2016" y="3058" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-12-note" value="Guarda inbox recibida, staging y cursor de recepción en transacciones cortas para reanudar. No cambia la versión activa ni el cursor aplicado." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3116" width="1259.560547" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-13-label" value="14  Prepara candidata aislada y reproduce deltas posteriores" parent="step-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="594.365234" height="27.5" as="geometry" relative="1">
            <mxPoint x="-178" y="-66" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-13" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1661" y="3221.5" as="sourcePoint" />
            <mxPoint x="1662" y="3269.5" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1871.5" y="3221.5" />
              <mxPoint x="1871.5" y="3269.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step-13-note" value="Los deltas incluyen altas, cambios y bajas explícitas (tombstones). Parten de una base conocida; el snapshot recupera deltas posteriores a su watermark. Nunca se parchea la versión activa en servicio." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3316.5" width="1787.607422" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-14-label" value="15  Valida la candidata completa antes de publicarla" parent="step-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="507.149414" height="27.5" as="geometry" relative="1">
            <mxPoint x="-178" y="-66" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-14" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1661" y="3422" as="sourcePoint" />
            <mxPoint x="1662" y="3470" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1871.5" y="3422" />
              <mxPoint x="1871.5" y="3470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step-14-note" value="Comprueba checksum, cobertura, referencias, orden, compatibilidad y vigencia. Descarga y validación pesada ocurren fuera de la transacción final; la candidata validada queda identificada e inmutable." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3517" width="1784.375" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-15-label" value="16  Activa versión + inbox&#10;aplicada + cursor aplicado ·&#10;PostgreSQL" parent="step-15" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="269.650391" height="82.5" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-97.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-15" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1662" y="3677.5" as="sourcePoint" />
            <mxPoint x="2016" y="3677.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-15-note" value="Un commit corto revalida base y checkpoint; un snapshot atrasado no hace retroceder el puntero ni el cursor aplicado. Activa efecto y checkpoint juntos; conserva versiones todavía referenciadas." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3735.5" width="1729.833984" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-16-label" value="17  Solicita cotización · HTTPS&#10;sobre LAN" parent="step-16" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="303.219727" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-16" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2726" y="3868.5" as="sourcePoint" />
            <mxPoint x="2372" y="3868.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-16-note" value="Envía artículos, cantidades y contexto autorizado; no consulta directamente el SQL ni recalcula precios con autoridad propia." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3926.5" width="1107.304688" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-17-label" value="18  Lee la versión vigente y fija&#10;su referencia · PostgreSQL" parent="step-17" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="302.070312" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-17" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2371" y="4059.5" as="sourcePoint" />
            <mxPoint x="2017" y="4059.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-17-note" value="Verifica cobertura, vigencia y política. La cotización conserva versión, origen y reglas para explicar el cálculo; fijar la versión no extiende su vigencia. Antes de iniciar el pago se revalida y, si corresponde recalcular según la política acordada, se confirma el importe revisado." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4117.5" width="2413.105469" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-18-label" value="19  Devuelve importes y versión&#10;de la cotización · HTTPS" parent="step-18" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="313.027344" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-18" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2372" y="4250.5" as="sourcePoint" />
            <mxPoint x="2726" y="4250.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-18-note" value="Las nuevas cotizaciones usan la versión activa autorizada. Una cotización abierta conserva trazabilidad, pero puede requerir recálculo y confirmación antes del pago. Una actualización no cambia importe, identidad ni referencia de un pago iniciado o incierto." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4308.5" width="2280.224609" height="25" as="geometry" />
        </mxCell>
        <mxCell id="dynamic-note" value="Secuencia objetivo elegida, aún no implementada. BullMQ usa Redis de trabajos separado en país y red ERP; PostgreSQL conserva solicitudes y versiones. El espejo de sucursal sólo es lectura autorizada." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=24;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4401.5" width="2191.886719" height="30" as="geometry" />
        </mxCell>
        <mxCell id="notes-title" value="Condiciones, fallos y recuperación" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4501.5" width="487.375" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-0-bg" value="" parent="group-notes-4572-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="930.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-0-title" value="Recibido y aplicado son estados distintos" parent="group-notes-4572-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="457.214355" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-0-body" value="La inbox y el cursor de recepción permiten reanudar una descarga. Solo el commit de&#10;activación confirma inbox aplicada, efecto y cursor aplicado. Deltas y snapshots atraviesan&#10;el mismo control de publicación; deduplicar no autoriza a activar." parent="group-notes-4572-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="885.349609" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-1-bg" value="" parent="group-notes-4572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="930.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-1-title" value="Huecos, incompatibilidad o carga incompleta" parent="group-notes-4572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="496.105957" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-1-body" value="Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se&#10;reutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla&#10;parcial de versiones." parent="group-notes-4572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="867.087891" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-2-bg" value="" parent="group-notes-4572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="930.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-2-title" value="Frescura y vigencia son límites distintos" parent="group-notes-4572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="441.833496" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-2-body" value="El TTL de frescura y la vigencia comercial se validan por separado; ambos deben&#10;cumplirse. Una carga fallida conserva la versión previa solo mientras siga autorizada.&#10;Redescargar la misma versión no reinicia plazos. Sin datos válidos se bloquea la&#10;operación afectada." parent="group-notes-4572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="831.509766" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-3-bg" value="" parent="group-notes-4572-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="930.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-3-title" value="Reconciliación programada y recuperación manual" parent="group-notes-4572-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="562.805176" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-3-body" value="La frecuencia de carga completa es configurable. Ambas rutas usan manifiesto, corte&#10;consistente, retención de deltas, staging, validación y activación atómica. La reconciliación&#10;detecta divergencias sin convertir una sucursal en autora del maestro." parent="group-notes-4572-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="882.943359" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-4-bg" value="" parent="group-notes-4572-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="930.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-4-title" value="WAN caída; LAN y servidor disponibles" parent="group-notes-4572-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="435.36377" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-4-body" value="La sucursal cotiza sobre su espejo autorizado mientras datos, permisos y capacidades&#10;sigan vigentes. Si cae la LAN o el backend se detienen los comandos dependientes; no&#10;aparece otra base ni otro escritor en cada terminal." parent="group-notes-4572-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="853.681641" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-5-bg" value="" parent="group-notes-4572-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="930.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-5-title" value="Replay, bajas y restauración" parent="group-notes-4572-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="313.586426" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-5-body" value="La entrega puede repetirse y se deduplica. Tombstones, versiones referenciadas y&#10;evidencia se retienen durante el horizonte de replay y recuperación para no resucitar&#10;bajas. Un restore puede retroceder datos y cursores: se concilia con origen antes de&#10;declarar convergencia." parent="group-notes-4572-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="826.71875" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-6-bg" value="" parent="group-notes-4572-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="930.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-6-title" value="Responsabilidades de publicación" parent="group-notes-4572-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="378.039551" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-6-body" value="erp-worker prepara mediante MasterDataSourcePort en la red autorizada del origen;&#10;country-api conserva versiones y confirma su publicación en país. Fuente, interfaz y&#10;acceso se homologan por país; la preparación tiene identidad, claims y presupuesto&#10;aislados del trabajo financiero." parent="group-notes-4572-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="822.991211" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-7-bg" value="" parent="group-notes-4572-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="930.666667" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-7-title" value="Redis de trabajos no es la autoridad comercial" parent="group-notes-4572-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="514.172363" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-4572-7-body" value="BullMQ es obligatorio en país y red ERP, cada uno con su propia instancia Redis. Una&#10;caída detiene jobs; solicitudes y versiones permanecen en PostgreSQL y permiten&#10;reconstrucción. La sucursal sigue con PostgreSQL y HTTPS, sin Redis obligatorio." parent="group-notes-4572-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="839.738281" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5331.25" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5397.25" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md  ·  docs/extensibilidad-proveedores-dispositivos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. F01: operación local persistida. F02: host .NET/SQLite y protocolo en revisión; drivers físicos pendientes. F05: piloto por puesto. F06: red y estación compartida por&#10;homologar, sin autoridad de ventas. Sincronización e integración siguen propuestas. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5466.25" width="2783.34668" height="90" as="geometry" />
        </mxCell>
        <mxCell id="AfY974m2KshVgeGWKB2K1" value="Fuentes de maestros y precios&#10;«Sistema externo»&#10;Interfaces por confirmar&#10;Entrega catálogo, impuestos,&#10;precios y promociones&#10;aprobados por su propietario." parent="masters" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="21.935059" y="32.55" width="287.129883" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="42tswg7HnGwWdGyw2zsoY" value="erp-worker&#10;«Contenedor»&#10;NestJS / Node.js · BullMQ&#10;Prepara datos autorizados y&#10;sube porciones mediante&#10;HTTPS saliente; no activa&#10;versiones ni usa SQL WAN." parent="erpAdapter" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="34.173096" y="20.475" width="262.653809" height="169.05" as="geometry" />
        </mxCell>
        <mxCell id="N2jDxNkaaczdpw42RF_Vs" value="Datos operativos de país&#10;«Contenedor de datos»&#10;PostgreSQL&#10;Conserva versiones inmutables,&#10;manifiestos y deltas con un&#10;corte consistente." parent="countryDb" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="16.095459" y="32.55" width="298.809082" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="L_Jr--MpHbnOZ8Cej3kNb" value="country-api&#10;«Contenedor»&#10;NestJS + Fastify / Node.js ·&#10;BullMQ&#10;Autentica sucursales y sirve&#10;publicaciones por contrato y&#10;cursor." parent="countryApi" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="34.757568" y="20.475" width="261.484863" height="169.05" as="geometry" />
        </mxCell>
        <mxCell id="IioUnadbqs20BV8qHeRyr" value="branch-sync-worker&#10;«Contenedor»&#10;NestJS / Node.js · sin servidor&#10;HTTP&#10;Recibe, prepara y valida&#10;candidatas antes de activar un&#10;espejo local." parent="syncWorker" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="23.073242" y="20.475" width="284.853516" height="169.05" as="geometry" />
        </mxCell>
        <mxCell id="scssYKuRIbFiFHJcgd8YT" value="Datos de sucursal&#10;«Contenedor de datos»&#10;PostgreSQL&#10;Guarda staging, inbox, cursores&#10;y versiones de lectura en la&#10;base compartida." parent="branchDb" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="16.669678" y="32.55" width="297.660645" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="ADpsRezlS1O9Iueqy748Z" value="branch-api&#10;«Contenedor»&#10;NestJS + Fastify / Node.js&#10;Cotiza y confirma operaciones&#10;con datos y políticas vigentes." parent="branchApi" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="24.267822" y="44.625" width="282.464355" height="120.75" as="geometry" />
        </mxCell>
        <mxCell id="PrfE9AOZljhDyLoH3fRwC" value="pos-desktop&#10;«Contenedor»&#10;Angular (frontend) ·&#10;Tauri (shell nativa)&#10;Solicita una cotización por LAN&#10;y presenta su versión y&#10;resultado." parent="client" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="20.171387" y="20.475" width="290.657227" height="169.05" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c4-7" name="Flujo de venta">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4564" pageHeight="8142" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="group-notes-7198-0" value="" parent="1" vertex="1" style="group;html=0;container=1;collapsible=0;recursiveResize=0;">
          <mxGeometry x="64" y="7197.5" width="1404" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="group-notes-7198-1" value="" parent="1" vertex="1" style="group;html=0;container=1;collapsible=0;recursiveResize=0;">
          <mxGeometry x="1492" y="7197.5" width="1404" height="191.75" as="geometry" />
