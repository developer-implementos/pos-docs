        </mxCell>
        <mxCell id="step-20-label" value="21  Aplica inbox + efecto local +&#10;outbox · PostgreSQL" parent="step-20" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="310.642578" height="55" as="geometry" relative="1">
