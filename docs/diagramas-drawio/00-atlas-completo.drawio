        <mxCell id="step-1-note" value="Combina datos autorizados y verifica integridad y compatibilidad. Un cambio parcial no se declara publicación completa." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1023.5" width="1065.009766" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-2-label" value="03  Publica versión, manifiesto y&#10;outbox · transacción SQL" parent="step-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="315.487305" height="55" as="geometry" relative="1">
