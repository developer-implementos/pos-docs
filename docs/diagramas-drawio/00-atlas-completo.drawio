        <mxCell id="notes-1572-0-title" value="Límites de autoridad" parent="group-notes-1572-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="226.525879" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-0-body" value="Sucursal conserva la venta original. País consolida una&#10;proyección. Precio, efecto financiero del pago, documento&#10;fiscal y contabilización ERP tienen autoridades y estados&#10;diferentes." parent="group-notes-1572-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="566.231445" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-1-bg" value="" parent="group-notes-1572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-1-title" value="Continuidad autorizada" parent="group-notes-1572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="257.128906" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-1-body" value="Perfil inicial: caída de WAN con LAN, backend y&#10;PostgreSQL de sucursal disponibles. Vigencia de precios,&#10;permisos, límites y capacidades de pago/fiscalidad&#10;determinan qué puede continuar." parent="group-notes-1572-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="564.587891" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-2-bg" value="" parent="group-notes-1572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-2-title" value="Chile y evolución multinacional" parent="group-notes-1572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.845703" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1572-2-body" value="Antecedentes: Chile Dynamics AX on-premise; España&#10;Gira; Perú sistema custom. Interfaces por validar. No se&#10;asigna stock al POS ni se declara un ERP futuro ya&#10;aprobado." parent="group-notes-1572-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="545.327148" height="110" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1850.490033" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-0-bg" value="" parent="group-notes-1925-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-0-title" value="Cajero" parent="group-notes-1925-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="73.64502" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-0-body" value="Persona · Operación humana&#10;&#10;Usa el cliente del puesto. Abrir o cerrar sesión de usuario&#10;no equivale a abrir o cerrar el turno de caja.&#10;&#10;AUTORIDAD · Ejecuta operaciones con permisos; no&#10;administra la base.&#10;&#10;CONTINUIDAD · Acceso local y operaciones habilitadas&#10;según vigencia, permisos y política offline." parent="group-notes-1925-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="558.84082" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-1-bg" value="" parent="group-notes-1925-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-1-title" value="Supervisor de sucursal" parent="group-notes-1925-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="254.284668" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-1-body" value="Persona · Operación humana&#10;&#10;Consulta resultados, autoriza acciones permitidas y&#10;resuelve incidencias con evidencia.&#10;&#10;AUTORIDAD · Responsable operativo; los comandos&#10;mantienen autorización y auditoría.&#10;&#10;CONTINUIDAD · Solo facultades previamente habilitadas;&#10;sin inventar autorización central." parent="group-notes-1925-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="567.348633" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-2-bg" value="" parent="group-notes-1925-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="384.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-2-title" value="Operación de plataforma" parent="group-notes-1925-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="275.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-2-body" value="Persona · Soporte autorizado&#10;&#10;Programa cargas y ventanas, supervisa atrasos, coordina&#10;restauraciones y conciliaciones.&#10;&#10;AUTORIDAD · Administra configuración y reintentos&#10;auditados; no corrige dinero con SQL libre.&#10;&#10;CONTINUIDAD · Consulta evidencia local; la plataforma&#10;de país puede estar inaccesible sin WAN." parent="group-notes-1925-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="562.503906" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-3-bg" value="" parent="group-notes-1925-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-3-title" value="POS corporativo" parent="group-notes-1925-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="183.410645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-3-body" value="Sistema de software · Plataforma de caja&#10;&#10;Sistema objetivo común para Chile, Perú y España.&#10;Clientes Angular + Tauri y Angular + Capacitor aceptados&#10;como dirección; backend, datos y topología son&#10;recomendaciones por validar.&#10;&#10;AUTORIDAD · La venta nace en sucursal; país mantiene&#10;la proyección consolidada.&#10;&#10;CONTINUIDAD · Perfil inicial: WAN caída con LAN y&#10;escritor de sucursal disponibles." parent="group-notes-1925-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="560.097656" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-4-bg" value="" parent="group-notes-1925-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-4-title" value="ERP del país" parent="group-notes-1925-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-4-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y&#10;custom en Perú son antecedentes; versión, interfaces y&#10;capacidades deben confirmarse. No se afirma que exista&#10;el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de&#10;cada país; no la base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración&#10;pendiente; no revierte una venta local confirmada." parent="group-notes-1925-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="555.188477" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-5-bg" value="" parent="group-notes-1925-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-5-title" value="Fuentes de maestros y precios" parent="group-notes-1925-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-5-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener&#10;responsable, contrato, versión y vigencia. La fuente de&#10;precios no se sustituye por una tabla editada libremente&#10;en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no&#10;se asigna al ERP por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente&#10;dentro de la política autorizada." parent="group-notes-1925-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="560.355469" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-6-bg" value="" parent="group-notes-1925-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="714.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-6-title" value="Proveedor de pagos" parent="group-notes-1925-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-6-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Autoriza o informa el resultado del pago. Transbank con&#10;terminal local en Chile y Niubiz en Perú proceden de las&#10;fuentes revisadas. Mercado Pago Point es un ejemplo&#10;presencial ilustrativo, sin adopción ni integración&#10;acreditadas; Webpay Plus es un ejemplo de pago online&#10;de Transbank, distinto de su terminal de tienda. En&#10;España se informan BBVA/Redsys con TPV portátiles sin&#10;conexión a Gira y conciliación contable; no se presume&#10;una API o SDK ya integrado. Cada ruta y capacidad&#10;requiere homologación. Pago, venta, documento fiscal e&#10;integración ERP tienen estados distintos. No repetir un&#10;cargo incierto ni cambiar de proveedor para resolverlo&#10;automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero;&#10;POS registra intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por&#10;homologar. Un timeout puede dejar resultado&#10;desconocido." parent="group-notes-1925-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="566.961914" height="605" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-7-bg" value="" parent="group-notes-1925-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="616.970703" height="714.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-7-title" value="Proveedor de facturación" parent="group-notes-1925-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="279.333496" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-1925-7-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Acepta/Ingydev aparecen en el código legacy chileno y&#10;EFACT en las fuentes de Perú. Gira se informa como&#10;solución de España; su modalidad fiscal, interfaces y&#10;capacidades deben confirmarse. Estos ejemplos no&#10;seleccionan un proveedor corporativo ni acreditan&#10;adaptadores homologados para POS Platform. SII y&#10;SUNAT son autoridades tributarias, no estos proveedores&#10;de software; en España corresponde la autoridad del&#10;régimen y territorio aplicables. Emisión, aceptación y&#10;transmisión se modelan por separado. No se inventa un&#10;proveedor común ni una capacidad de consulta o&#10;idempotencia no acreditada.&#10;&#10;AUTORIDAD · La solución prepara, emite o transmite&#10;documentos por cuenta del contribuyente según su&#10;contrato. La autoridad tributaria es distinta: SII en Chile,&#10;SUNAT en Perú y la autoridad aplicable en España.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material&#10;fiscal válidos; no se promete universalmente." parent="group-notes-1925-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="562.106445" height="605" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3570.240033" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3636.240033" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Angular + Tauri (escritorio), Angular + Capacitor (móvil) y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3705.240033" width="1643.80957" height="67.5" as="geometry" />
        </mxCell>
