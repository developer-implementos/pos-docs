        <mxCell id="step-1-note" value="Librería dentro de country-api, fuera de la petición HTTP; usa Redis exclusivo de trabajos, separado de la caché. El jobId estable no reemplaza restricciones transaccionales de negocio." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
