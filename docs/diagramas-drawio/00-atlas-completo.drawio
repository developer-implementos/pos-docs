        <mxCell id="gFwg_HfNMAAcbBLPkxL04" value="erp-worker&#10;«Contenedor»&#10;NestJS / Node.js ·&#10;libs/backend/erp&#10;Consume trabajo; traduce y&#10;concilia con ERP." parent="erpAdapter" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
