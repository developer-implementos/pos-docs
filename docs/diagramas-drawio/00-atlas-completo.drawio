        </mxCell>
        <mxCell id="step-18-label" value="19  Envía lote con eventId y&#10;secuencia · HTTPS autenticado" parent="step-18" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="310.599609" height="55" as="geometry" relative="1">
