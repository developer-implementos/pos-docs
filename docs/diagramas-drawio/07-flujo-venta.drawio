          <mxGeometry relative="1" as="geometry">
            <mxPoint x="4146" y="6522" as="sourcePoint" />
            <mxPoint x="3792" y="6522" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-31-note" value="La respuesta puede confirmar, rechazar o dejar resultado incierto. Un timeout conserva el intento; se consulta o concilia cuando la capacidad exista, sin fabricar otro cargo/documento." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6580" width="1622.021484" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-32-label" value="33  Reporta resultado con identidad original · HTTPS saliente" parent="step-32" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="599.220703" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-32" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3791" y="6685.5" as="sourcePoint" />
            <mxPoint x="3082" y="6685.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-32-note" value="Reentregar o consultar el resultado es independiente de reenviar la operación al ERP. Se preservan referencia, destino, versión y evidencia técnica." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6743.5" width="1311.523438" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-33-label" value="34  Persiste resultado y estado&#10;de integración · PostgreSQL" parent="step-33" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="302.05957" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-33" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3082" y="6876.5" as="sourcePoint" />
            <mxPoint x="3436" y="6876.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-33-note" value="El resultado se registra con transiciones condicionales y deduplicación. ACK de aplicación de la venta, resultado ERP y contabilización definitiva siguen siendo hitos distintos." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="6934.5" width="1540.878906" height="25" as="geometry" />
        </mxCell>
        <mxCell id="dynamic-note" value="Secuencia objetivo recomendada. Cada flecha es una interacción, no una transacción distribuida. Impresión y sincronización son ramas independientes de la venta confirmada; imprimir no bloquea la entrega a país ni crea otra venta." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=24;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="7027.5" width="2472.105469" height="30" as="geometry" />
        </mxCell>
        <mxCell id="notes-title" value="Condiciones, fallos y recuperación" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="7127.5" width="487.375" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-0-bg" value="" parent="group-notes-7198-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1404" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-0-title" value="Pago desconocido o aprobado sin commit local" parent="group-notes-7198-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="523.925781" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-0-body" value="Un timeout conserva el intento y su incertidumbre: consulta o conciliación según capacidad, sin recargar ni cambiar automáticamente de&#10;proveedor. Si el pago se aprobó y falla el commit local, se recuperan intención y evidencia; una reversa o intervención controlada conserva&#10;el intento original." parent="group-notes-7198-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1353.773438" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-1-bg" value="" parent="group-notes-7198-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1404" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-1-title" value="Pago por SDK: capacidad futura independiente" parent="group-notes-7198-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="522.595215" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-1-body" value="La venta ilustrada usa una API desde backend. Si se homologa un SDK local, device-agent obtiene el trabajo autorizado directamente de&#10;branch-api y reporta evidencia con la misma identidad e importe. El cliente no transporta el comando al agente. Migrar impresión no&#10;habilita pagos; no se ejecutan API y SDK para el mismo intento." parent="group-notes-7198-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1337.97168" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-2-bg" value="" parent="group-notes-7198-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1404" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-2-title" value="Fiscalidad e impresión tienen su propio resultado" parent="group-notes-7198-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="543.359375" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-2-body" value="Sólo se emiten documentos permitidos por la modalidad nacional habilitada. device-agent imprime una referencia existente; aceptación del&#10;spooler no acredita impresión física. Un resultado incierto conserva evidencia; reimprimir requiere una operación explícita autorizada, sin&#10;nueva venta, cargo ni emisión fiscal." parent="group-notes-7198-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1353.78418" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-3-bg" value="" parent="group-notes-7198-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1404" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-3-title" value="Caída WAN frente a caída LAN" parent="group-notes-7198-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="346.459961" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-3-body" value="Sin WAN la outbox permanece durable y se permiten solo operaciones soportadas por datos, autenticación, pago y fiscalidad vigentes. Sin&#10;LAN, backend o escritor autorizado se detiene el comando dependiente. Ninguna terminal crea por ello una base o autoridad alternativa." parent="group-notes-7198-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1352.967773" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-4-bg" value="" parent="group-notes-7198-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1404" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-4-title" value="ACK perdido, replay y restore" parent="group-notes-7198-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="327.929688" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-4-body" value="Un ACK perdido provoca reentrega del mismo eventId; país deduplica en la transacción del efecto. Un hueco o conflicto queda pendiente&#10;para resolver. La retención y conciliación cubren restauraciones que retrocedan inbox, datos o cursores; no se promete exactly-once&#10;universal." parent="group-notes-7198-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1337.950195" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-5-bg" value="" parent="group-notes-7198-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1404" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-5-title" value="ERP posterior no es el ACK de país" parent="group-notes-7198-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="397.424316" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-5-body" value="erp-worker reclama trabajo mediante HTTPS saliente a country-api y ejecuta fachada, ACL y adaptadores dentro del mismo proceso.&#10;Country-api conserva intentos y resultados en PostgreSQL; no existe acceso SQL WAN desde el worker. Una respuesta incierta requiere&#10;consulta o conciliación antes de repetir efectos." parent="group-notes-7198-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1335.748047" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-6-bg" value="" parent="group-notes-7198-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1404" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-6-title" value="Reintento técnico y efecto financiero" parent="group-notes-7198-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="403.015137" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-7198-6-body" value="BullMQ + Redis de trabajos es la tecnología elegida dentro de erp-worker. Un job stalled puede entregarse otra vez: debe consultar estado&#10;e identidad durables. PostgreSQL, restricciones y reconciliación protegen el negocio; un efecto ERP incierto no se reenvía&#10;automáticamente. Las colas no participan del commit de venta en sucursal." parent="group-notes-7198-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1351.979492" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="7874.75" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="7940.75" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md  ·  docs/extensibilidad-proveedores-dispositivos.md&#10;Aplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. F01: operación local persistida. F02: host .NET/SQLite y protocolo en revisión; drivers físicos pendientes. F05: piloto por puesto. F06: red y estación compartida por homologar, sin autoridad de ventas. Sincronización e integración siguen propuestas. Nx organiza código y CI." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="8009.75" width="3661.866211" height="67.5" as="geometry" />
        </mxCell>
        <mxCell id="9zA8r-wcObZhf3jqq1Muj" value="pos-desktop&#10;«Contenedor»&#10;Angular (frontend) ·&#10;Tauri (shell nativa)&#10;Envía comandos identificados y&#10;presenta el resultado durable al&#10;operador." parent="client" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="17.833496" y="20.475" width="295.333008" height="169.05" as="geometry" />
        </mxCell>
        <mxCell id="j4VRAxIxoC2TwCNY0I-1y" value="branch-api&#10;«Contenedor»&#10;NestJS + Fastify / Node.js&#10;Autoriza la operación y coordina&#10;negocio, pago y evidencia local." parent="branchApi" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="15.495605" y="44.625" width="300.008789" height="120.75" as="geometry" />
        </mxCell>
        <mxCell id="iCaNi2iMvlj7NHkftwg2b" value="Datos de sucursal&#10;«Contenedor de datos»&#10;PostgreSQL&#10;Custodia intención, venta, caja,&#10;auditoría y outbox en un&#10;primario compartido." parent="branchDb" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="19.57666" y="32.55" width="291.84668" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="v2Fvgu620XkUKNAqYMfgg" value="Proveedor de pagos&#10;«Sistema externo»&#10;API / SDK según proveedor&#10;Informa resultado y referencia;&#10;la consulta posterior está sujeta&#10;a homologación." parent="payments" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="17.833496" y="32.55" width="295.333008" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="zjqOaqgyLHg7Yrnxev5hK" value="device-agent&#10;«Contenedor»&#10;C# / .NET · Windows&#10;F02: ejecuta periféricos del&#10;puesto Windows." parent="device" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="39.43335" y="44.625" width="252.133301" height="120.75" as="geometry" />
        </mxCell>
        <mxCell id="yvGdvw_W9M6gfpvRecvEV" value="Journal técnico de dispositivos&#10;«Contenedor de datos»&#10;SQLite&#10;Guarda trabajos, deduplicación&#10;y evidencia." parent="deviceJournal" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="20.156006" y="44.625" width="290.687988" height="120.75" as="geometry" />
        </mxCell>
        <mxCell id="o0oHJCFXrAtnUX4-5KcY1" value="Periféricos del puesto&#10;«Hardware externo»&#10;USB / serie · driver / SDK&#10;F02: impresoras y lectores&#10;locales del puesto." parent="peripherals" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="41.791748" y="44.625" width="247.416504" height="120.75" as="geometry" />
        </mxCell>
        <mxCell id="vtWzL_tCmyWmv_IO96Z1D" value="branch-sync-worker&#10;«Contenedor»&#10;NestJS / Node.js · sin servidor&#10;HTTP&#10;Entrega outbox confirmada y&#10;conserva identidad durante&#10;reintentos." parent="syncWorker" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
