          </mxGeometry>
        </mxCell>
        <mxCell id="step-27-note" value="Selecciona una operación confirmada y conserva país, destino, versión de contrato, intento y dueño/vencimiento del lease. Expirar el lease no detiene una llamada ERP ya iniciada ni autoriza repetir un efecto incierto." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5834" width="1915.576172" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-28-label" value="29  Devuelve trabajo, destino y referencia · HTTPS" parent="step-28" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="497.674805" height="27.5" as="geometry" relative="1">
