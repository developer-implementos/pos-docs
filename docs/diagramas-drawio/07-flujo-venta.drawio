        <mxCell id="step-24-note" value="Consulta la venta local y distingue confirmación, entrega a país y resultado ERP. Las interacciones siguientes no forman parte de su transacción local." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
