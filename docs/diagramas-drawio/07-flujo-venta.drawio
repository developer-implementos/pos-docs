          <mxGeometry x="64" y="5997.5" width="1318.173828" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-29-label" value="30  Fachada y ACL traducen el contrato POS" parent="step-29" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
