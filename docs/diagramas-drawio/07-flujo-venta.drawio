        <mxCell id="step-20-note" value="Confirma inbox, efecto o proyección requerida y outbox en una misma transacción, junto con el trabajo posterior y la deduplicación. Un duplicado ya aplicado conserva su resultado; igual ID con contenido distinto es conflicto, no éxito." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4487.5" width="2063.408203" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-21-label" value="22  Confirma commit y resultado&#10;durable · PostgreSQL" parent="step-21" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="316.668945" height="55" as="geometry" relative="1">
