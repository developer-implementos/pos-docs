        <mxCell id="step-4-note" value="La continuación mostrada requiere un resultado suficiente para confirmar según política. Rechazo o respuesta desconocida siguen su estado y recuperación propios." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1584.5" width="1465.322266" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-5-label" value="06  Confirma venta + caja +&#10;auditoría + outbox · PostgreSQL" parent="step-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
