        </mxCell>
        <mxCell id="step-22-label" value="23  Devuelve ACK de aplicación&#10;por evento · HTTPS" parent="step-22" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
