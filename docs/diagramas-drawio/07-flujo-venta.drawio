        <mxCell id="step-5-note" value="Revalida invariantes y deduplicación; persiste partidas, impuestos, referencias de pago y evidencia fiscal que deba ser simultánea. El commit no incluye al proveedor externo ni al ERP." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1750.5" width="1628.291016" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-6-label" value="07  Confirma operación y&#10;documento permitido · HTTPS" parent="step-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="297.107422" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-6" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="596" y="1883.5" as="sourcePoint" />
            <mxPoint x="242" y="1883.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-6-note" value="Solo después del commit local. Muestra estados de pago, fiscalidad e integración; la entrega a país puede permanecer pendiente sin negar la venta ya confirmada." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1941.5" width="1448.662109" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-7-label" value="08  Lee outbox confirmada y reclama lote acotado · SQL" parent="step-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="551.536133" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-7" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1661" y="2047" as="sourcePoint" />
            <mxPoint x="952" y="2047" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-7-note" value="El claim o lease técnico es recuperable. No mantiene una transacción abierta durante el envío ni altera libremente las ventas." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2105" width="1110.625" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-8-label" value="09  Envía lote con eventId y&#10;secuencia · HTTPS autenticado" parent="step-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="310.599609" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-8" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1662" y="2238" as="sourcePoint" />
            <mxPoint x="2016" y="2238" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-8-note" value="Incluye país, sucursal, versión de contrato e identidad estable del evento. La entrega es al menos una vez; un reintento no fabrica otra venta." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2296" width="1250.78125" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-9-label" value="10  Valida emisor, contrato, orden e identidad" parent="step-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="441.095703" height="27.5" as="geometry" relative="1">
            <mxPoint x="-178" y="-66" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-9" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2016" y="2401.5" as="sourcePoint" />
            <mxPoint x="2017" y="2449.5" as="targetPoint" />
            <Array as="points">
              <mxPoint x="2226.5" y="2401.5" />
              <mxPoint x="2226.5" y="2449.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step-9-note" value="Autentica el ámbito y comprueba el contrato. La decisión definitiva de deduplicación y sus restricciones se aplica dentro del commit siguiente." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2496.5" width="1252.900391" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-10-label" value="11  Aplica inbox + efecto local +&#10;outbox · una transacción SQL" parent="step-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="309.009766" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-10" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2017" y="2629.5" as="sourcePoint" />
            <mxPoint x="2371" y="2629.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-10-note" value="Registra la proyección requerida y el trabajo posterior junto con la deduplicación. Un duplicado ya aplicado conserva su resultado; igual ID con contenido distinto es conflicto, no éxito." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2687.5" width="1616.503906" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-11-label" value="12  Confirma commit y resultado&#10;durable · SQL" parent="step-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="316.668945" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-11" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2371" y="2820.5" as="sourcePoint" />
            <mxPoint x="2017" y="2820.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-11-note" value="Solo este resultado permite afirmar aplicación local en país. Guardar únicamente recepción no basta para emitir el ACK de aplicación." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2878.5" width="1187.294922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-12-label" value="13  Devuelve ACK de aplicación&#10;por evento · HTTPS" parent="step-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="314.294922" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-12" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2016" y="3011.5" as="sourcePoint" />
            <mxPoint x="1662" y="3011.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-12-note" value="Identifica eventos aplicados, duplicados equivalentes y rechazos. No declara pago liquidado, validez fiscal ni documento contabilizado en ERP." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3069.5" width="1265.976562" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-13-label" value="14  Persiste acuse y avance de entrega · commit SQL" parent="step-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="527.033203" height="27.5" as="geometry" relative="1">
            <mxPoint x="-337" y="-42.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-13" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1661" y="3175" as="sourcePoint" />
            <mxPoint x="952" y="3175" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-13-note" value="Actualiza estados técnicos y checkpoint de eventos realmente acusados. Mantiene pendientes no confirmados y evidencia durante el horizonte de retención y recuperación." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3233" width="1526.474609" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-14-label" value="15  Consulta estado local e&#10;integración pendiente · HTTPS&#10;LAN" parent="step-14" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="302.048828" height="82.5" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-97.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-14" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="242" y="3393.5" as="sourcePoint" />
            <mxPoint x="596" y="3393.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-14-note" value="La consulta distingue venta confirmada, entrega a país e integración ERP. El avance posterior de workers y adaptador ERP usa la outbox de país, fuera del alcance de esta secuencia." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3451.5" width="1625.068359" height="25" as="geometry" />
        </mxCell>
        <mxCell id="dynamic-note" value="Secuencia objetivo recomendada con resultado de pago conocido. Cada flecha representa una interacción; no una transacción distribuida. Venta, pago, fiscalidad, entrega a país y contabilización ERP conservan estados separados." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=24;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3544.5" width="2460.246094" height="30" as="geometry" />
        </mxCell>
        <mxCell id="notes-title" value="Condiciones, fallos y recuperación" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3644.5" width="487.375" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-0-bg" value="" parent="group-notes-3715-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="812.333333" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-0-title" value="Pago desconocido o aprobado sin commit local" parent="group-notes-3715-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="523.925781" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-0-body" value="Un timeout conserva el intento y su incertidumbre: consulta o conciliación&#10;según capacidad, sin recargar ni cambiar automáticamente de proveedor. Si el&#10;pago se aprobó y falla el commit local, se recuperan intención y evidencia; una&#10;reversa o intervención controlada conserva el intento original." parent="group-notes-3715-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="768.001953" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-1-bg" value="" parent="group-notes-3715-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="812.333333" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-1-title" value="SDK local es una ruta condicional" parent="group-notes-3715-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="373.828125" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-1-body" value="La vista muestra una API ejecutada desde backend. Si el proveedor exige&#10;SDK local homologado, el cliente transporta al puente de periféricos el&#10;comando original autorizado por backend y retorna evidencia. No inventa&#10;importe o permiso, ni ejecuta ambas rutas para un mismo intento." parent="group-notes-3715-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="721.563477" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-2-bg" value="" parent="group-notes-3715-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="812.333333" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-2-title" value="Fiscalidad e impresión tienen su propio resultado" parent="group-notes-3715-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="543.359375" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-2-body" value="Solo se confirman operaciones y documentos permitidos por la modalidad&#10;nacional habilitada. Las llamadas fiscales conservan referencia, estado y&#10;recuperación fuera de una transacción distribuida. Un fallo de impresión&#10;permite reimprimir el mismo documento; no genera otra venta ni otro cargo." parent="group-notes-3715-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="736.097656" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-3-bg" value="" parent="group-notes-3715-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="812.333333" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-3-title" value="Caída WAN frente a caída LAN" parent="group-notes-3715-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="346.459961" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-3-body" value="Sin WAN la outbox permanece durable y se permiten solo operaciones&#10;soportadas por datos, autenticación, pago y fiscalidad vigentes. Sin LAN,&#10;backend o escritor autorizado se detiene el comando dependiente. Ninguna&#10;terminal crea por ello una base o autoridad alternativa." parent="group-notes-3715-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="737.504883" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-4-bg" value="" parent="group-notes-3715-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="812.333333" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-4-title" value="ACK perdido, replay y restore" parent="group-notes-3715-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="327.929688" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-4-body" value="Un ACK perdido provoca reentrega del mismo eventId; país deduplica en la&#10;transacción del efecto. Un hueco o conflicto queda pendiente para resolver. La&#10;retención y conciliación cubren restauraciones que retrocedan inbox, datos o&#10;cursores; no se promete exactly-once universal." parent="group-notes-3715-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="765.617188" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-5-bg" value="" parent="group-notes-3715-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="812.333333" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-5-title" value="ERP posterior no es el ACK de país" parent="group-notes-3715-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="397.424316" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3715-5-body" value="Workers de país consumen outbox ya confirmada y usan el adaptador&#10;ERP/ACL con destino y referencia persistidos. Registro, rechazo,&#10;contabilización y conciliación tienen estados propios. La caída del ERP deja&#10;integración pendiente; país no se convierte en segundo autor de la venta local." parent="group-notes-3715-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="768.087891" height="110" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4231" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4297" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md  ·  docs/extensibilidad-proveedores-dispositivos.md&#10;Angular + Tauri (escritorio), Angular + Capacitor (móvil) y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4366" width="1643.80957" height="67.5" as="geometry" />
        </mxCell>
        <mxCell id="ul7n381w6YYrg7l9X3QLW" value="Cliente de escritorio&#10;«Contenedor»&#10;Angular + Tauri&#10;Envía comandos identificados y&#10;presenta el resultado durable al&#10;operador." parent="client" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="17.833496" y="32.55" width="295.333008" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="2paJh1wgM95opfVvGgHpI" value="Backend de sucursal&#10;«Contenedor»&#10;NestJS + Fastify / Node.js&#10;Autoriza la operación y coordina&#10;negocio, pago y evidencia local." parent="branchApi" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="15.495605" y="44.625" width="300.008789" height="120.75" as="geometry" />
        </mxCell>
        <mxCell id="HV1LdkYfGgx0D_Qu7_WMe" value="Datos de sucursal&#10;«Contenedor de datos»&#10;PostgreSQL&#10;Custodia intención, venta, caja,&#10;auditoría y outbox en un&#10;primario compartido." parent="branchDb" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="19.57666" y="32.55" width="291.84668" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="IrA0FxnHTCe1FJcMPhWR0" value="Proveedor de pagos&#10;«Sistema externo»&#10;API / SDK según proveedor&#10;Informa resultado y referencia;&#10;la consulta posterior está sujeta&#10;a homologación." parent="payments" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="17.833496" y="32.55" width="295.333008" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="jl899NIifi3BPKYR4_NrT" value="Sincronizador de sucursal&#10;«Contenedor»&#10;Worker TypeScript / Node.js&#10;Entrega outbox confirmada y&#10;conserva identidad durante&#10;reintentos." parent="syncWorker" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="31.255859" y="32.55" width="268.488281" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="Li1UqMxtyYAE_eR45N7cy" value="API de país&#10;«Contenedor»&#10;NestJS + Fastify / Node.js&#10;Valida el contrato y confirma&#10;inbox, efecto local y outbox&#10;antes de acusar aplicación." parent="countryApi" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
          <mxGeometry x="33.798828" y="32.55" width="263.402344" height="144.9" as="geometry" />
        </mxCell>
        <mxCell id="A8MY5q9N-_7jpVL07tn1O" value="Datos operativos de país&#10;«Contenedor de datos»&#10;PostgreSQL&#10;Guarda proyección de la venta,&#10;deduplicación y trabajo posterior&#10;de integración." parent="countryDb" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=18.9;align=center;verticalAlign=middle;">
