        <mxCell id="step-25-note" value="El job ejecuta dentro de erp-worker con concurrencia acotada; consulta/reclama la operación durable al comenzar, no después de esperar con lease en una cola larga. Los pendientes se reconstruyen mediante country-api HTTPS." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5479.5" width="2037.851562" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-26-label" value="27  Solicita trabajo identificado · HTTPS saliente" parent="step-26" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="472.011719" height="27.5" as="geometry" relative="1">
