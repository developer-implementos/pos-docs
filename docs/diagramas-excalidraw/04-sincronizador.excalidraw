      "index": "aM",
      "roundness": null,
      "seed": 1450395786,
      "version": 2,
      "versionNonce": 820428822,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364560739,
      "link": null,
      "locked": false,
      "text": "Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una candidata\ncompleta aislada; snapshot incorpora cambios posteriores al corte H, incluyendo\nbajas. Toda candidata pasa por validación antes de activar.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una candidata\ncompleta aislada; snapshot incorpora cambios posteriores al corte H, incluyendo\nbajas. Toda candidata pasa por validación antes de activar.",
      "autoResize": true,
      "lineHeight": 1.25
    },
