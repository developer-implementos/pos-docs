    {
      "id": "notes-3439-6-body",
      "type": "text",
      "x": 1415.7713867187497,
      "y": 4004.1856445312496,
      "width": 594.34375,
      "height": 412.5,
      "angle": 0,
      "strokeColor": "#182842",
