      "seed": 1606945430,
      "version": 2,
      "versionNonce": 2118852298,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364560739,
      "link": null,
      "locked": false,
      "text": "Calendario y zona horaria IANA, ventanas, límites, backoff y jitter son configuración\nexplícita. Carga masiva programada o manual utiliza el mismo pipeline auditado.\nUna ejecución manual no salta validaciones.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Calendario y zona horaria IANA, ventanas, límites, backoff y jitter son configuración\nexplícita. Carga masiva programada o manual utiliza el mismo pipeline auditado.\nUna ejecución manual no salta validaciones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
