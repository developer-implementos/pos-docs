    {
      "id": "notes-2910-0-body",
      "type": "text",
      "x": 86,
      "y": 2984.63564453125,
      "width": 723.9482421875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
