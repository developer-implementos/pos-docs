    {
      "id": "notes-3413-6-body",
      "type": "text",
      "x": 1415.7713867187497,
      "y": 3977.7856445312495,
      "width": 594.34375,
      "height": 412.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
