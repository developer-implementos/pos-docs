    {
      "id": "notes-3086-1-body",
      "type": "text",
      "x": 972.5142578124997,
      "y": 3160.1856445312496,
      "width": 794.8896484375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
