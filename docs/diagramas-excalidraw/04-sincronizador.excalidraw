    {
      "id": "notes-3033-1-body",
      "type": "text",
      "x": 972.5142578124997,
      "y": 3107.38564453125,
      "width": 794.8896484375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3033-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 856547551,
      "version": 2,
      "versionNonce": 239365393,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292666313,
      "link": null,
      "locked": false,
      "text": "Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una candidata\ncompleta aislada; snapshot incorpora cambios posteriores al corte H, incluyendo\nbajas. Toda candidata pasa por validación antes de activar.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una candidata\ncompleta aislada; snapshot incorpora cambios posteriores al corte H, incluyendo\nbajas. Toda candidata pasa por validación antes de activar.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
