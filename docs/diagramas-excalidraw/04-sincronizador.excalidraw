    {
      "id": "notes-2557-1-body",
      "type": "text",
      "x": 893.8658203125,
      "y": 2631.38564453125,
      "width": 694.67578125,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2557-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1433655911,
      "version": 2,
      "versionNonce": 947653641,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603451414,
      "link": null,
      "locked": false,
      "text": "Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una\ncandidata completa aislada; snapshot incorpora cambios posteriores al\ncorte H, incluyendo bajas. Toda candidata pasa por validación antes de\nactivar.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una\ncandidata completa aislada; snapshot incorpora cambios posteriores al\ncorte H, incluyendo bajas. Toda candidata pasa por validación antes de\nactivar.",
      "autoResize": true,
      "lineHeight": 1.25
