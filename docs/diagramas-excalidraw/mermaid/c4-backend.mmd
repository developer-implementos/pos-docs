flowchart TB
    accTitle: C3 · Backend de sucursal — Dentro del monolito modular
    accDescr: Un solo contenedor: backend de sucursal NestJS + Fastify. Los bloques interiores son componentes del mismo proceso. Las llamadas internas son TypeScript; no se propone HTTP ni una base independiente entre módulos. Efectos externos tienen estados y recuperación separados.
    subgraph backendScope["Backend de sucursal · UN proceso<br/>Contenedor NestJS + Fastify"]
        direction TB
        entry["API de comandos<br/>«Componente»<br/>Controllers NestJS / Fastify<br/>Valida entrada e identidad del comando."]:::pos
        access["Acceso y permisos<br/>«Componente»<br/>Guards + servicios TypeScript<br/>Autoriza usuario, perfil y sucursal."]:::pos
        sales["Ventas y devoluciones<br/>«Componente»<br/>Módulo NestJS / TypeScript<br/>Coordina el ciclo de la operación."]:::pos
        pricing["Precios y ofertas<br/>«Componente»<br/>Motor TypeScript local<br/>Cotiza sobre una versión vigente."]:::pos
        cash["Turnos y caja<br/>«Componente»<br/>Módulo NestJS / TypeScript<br/>Controla apertura, movimientos y cierre."]:::pos
        payPort["Pagos y adaptadores<br/>«Componente»<br/>Puertos + TypeScript<br/>Gestiona intentos y evidencia de pago."]:::pos
        fiscalPort["Fiscalidad y adaptadores<br/>«Componente»<br/>Puertos + TypeScript<br/>Aplica modalidad fiscal por país."]:::pos
        unitOfWork["Persistencia transaccional<br/>«Componente»<br/>Repositorios TypeScript / SQL<br/>Confirma negocio, auditoría y outbox."]:::pos
    end
    mobileClient["Cliente móvil<br/>«Contenedor»<br/>Angular + Capacitor<br/>Presenta operaciones en Android/iOS."]:::pos
    client["Cliente de escritorio<br/>«Contenedor»<br/>Angular + Tauri<br/>Presenta caja y comandos del operador."]:::pos
    branchDb[("Datos de sucursal<br/>«Contenedor de datos»<br/>PostgreSQL<br/>Guarda negocio, outbox y espejo local.")]:::store
    payments["Proveedor de pagos<br/>«Sistema externo»<br/>API / SDK según proveedor<br/>Autoriza o informa el resultado del pago."]:::external
    fiscal["Proveedor fiscal<br/>«Sistema externo»<br/>Contrato por país y modalidad<br/>Emite o transmite documentos fiscales."]:::external
    legend["Leyenda · notación C4<br/>Verde: POS · Azul/cilindro: datos<br/>Gris: externo · Persona: rol humano<br/>Borde discontinuo: límite indicado<br/>Flecha: propósito y protocolo<br/>Contenedor: aplicación o almacén<br/>Componente: módulo de UN proceso"]:::key
