flowchart TB
    accTitle: Complemento · Despliegue — Sucursal, país y red autorizada del ERP
    accDescr: Perfil WAN: puestos y móviles usan el servidor de sucursal por LAN. País y red del ERP son entornos independientes, conectados mediante contratos autenticados. erp-worker inicia la conexión hacia country-api; no accede por SQL WAN a su base. Redis sólo aparece como caché opcional de país. Infraestructura, recuperación y capacidad deben homologarse.
    subgraph terminalNode["Puestos POS x N · Windows por homologar"]
        direction TB
        client["pos-desktop<br/>«Contenedor · instancia»<br/>Angular + Tauri<br/>Presenta caja y comandos del operador."]:::pos
        device["Puente de periféricos<br/>«Contenedor condicional · instancia»<br/>Proceso nativo según SDK<br/>Ejecuta capacidades del puesto."]:::pos
    end
    subgraph mobileNode["Dispositivos móviles · Android/iOS por homologar"]
        direction TB
        mobileClient["pos-mobile<br/>«Contenedor · instancia»<br/>Angular + Capacitor<br/>Presenta operaciones en Android/iOS."]:::pos
    end
    subgraph serverNode["Servidor de sucursal · entorno por homologar"]
        direction TB
        branchApi["branch-api<br/>«Contenedor · instancia»<br/>NestJS + Fastify / Node.js<br/>Valida y confirma la operación local."]:::pos
        syncWorker["branch-sync-worker<br/>«Contenedor · instancia»<br/>NestJS / Node.js · sin servidor HTTP<br/>Entrega eventos y actualiza espejos."]:::pos
        branchDb[("Datos de sucursal<br/>«Contenedor de datos · instancia»<br/>PostgreSQL<br/>Guarda negocio, outbox y espejo local.")]:::store
    end
    subgraph countryNode["Plataforma de país · alojamiento por decidir"]
        direction TB
        countryApi["country-api<br/>«Contenedor · instancia»<br/>NestJS + Fastify / Node.js<br/>Recibe operaciones y sirve trabajo y versiones."]:::pos
        countryWorker["Publicador de maestros · proceso por asignar<br/>«Contenedor · instancia»<br/>Proceso de publicación · composición pendiente<br/>Prepara publicaciones comerciales versionadas."]:::pos
        countryDb[("Datos operativos de país<br/>«Contenedor de datos · instancia»<br/>PostgreSQL<br/>Consolida y conserva entrega durable.")]:::store
        countryCache[("Redis · caché de país (opcional)<br/>«Contenedor de datos · instancia»<br/>Redis · datos reconstruibles<br/>Acelera consultas; no confirma operaciones.")]:::store
    end
    subgraph erpNode["Red autorizada del ERP · entorno por país"]
        direction TB
        erpAdapter["erp-worker<br/>«Contenedor · instancia»<br/>NestJS / Node.js · libs/backend/erp<br/>Consume trabajo; traduce y concilia con ERP."]:::pos
        erp["ERP del país<br/>«Sistema externo»<br/>CL: AX · ES: Gira · PE: custom<br/>Recibe y concilia documentos financieros."]:::external
    end
    payments["Proveedor de pagos<br/>«Sistema externo»<br/>API / SDK según proveedor<br/>Autoriza o informa el resultado del pago."]:::external
    fiscal["Proveedor fiscal<br/>«Sistema externo»<br/>Contrato por país y modalidad<br/>Emite o transmite documentos fiscales."]:::external
    backup["Respaldo y recuperación<br/>«Infraestructura»<br/>Backups PostgreSQL / herramienta por definir<br/>Conserva y ensaya restauraciones."]:::infra
    observability["Observabilidad operativa (opcional)<br/>«Sistema externo»<br/>Recolector de logs / Sentry opt-in<br/>Recibe diagnóstico y correlación técnica."]:::external
    legend["Leyenda · notación C4<br/>Azul: POS · Violeta: datos<br/>Gris: externo · Ámbar: infraestructura<br/>Borde: sistema, proceso o nodo indicado<br/>Flecha: iniciador, propósito y protocolo<br/>Opcional / por asignar: condición explícita<br/>Contenedor no equivale a Docker"]:::key
