flowchart TB
    accTitle: Complemento · Despliegue — Sucursal, país y red autorizada del ERP
    accDescr: F02/F05: pos-desktop, device-agent, journal SQLite y hardware local comparten el puesto Windows. Backend y PostgreSQL viven en el servidor de sucursal. Red, estación compartida y acceso móvil a periféricos son expansión F06. Siete apps objetivo; seis tienen base técnica. device-agent y SQLite: propuesta pendiente. F02: puesto Windows dedicado; F05: piloto del mismo perfil. F06: red y estación compartida por homologar; no agrega otra app. PostgreSQL conserva el negocio.
    subgraph terminalNode["Puesto Windows x N · perfil dedicado F02 / piloto F05"]
        direction TB
        client["pos-desktop<br/>«Contenedor»<br/>Angular (frontend) ·<br/>Tauri (shell nativa)<br/>Aplicación completa para caja y comandos."]:::pos
        device["device-agent<br/>«Contenedor»<br/>C# / .NET · Windows<br/>F02: ejecuta periféricos del puesto Windows."]:::pos
        deviceJournal["Journal técnico de dispositivos<br/>«Contenedor de datos»<br/>SQLite<br/>Guarda trabajos, deduplicación y evidencia."]:::store
        peripherals["Periféricos del puesto<br/>«Hardware externo»<br/>USB / serie · driver / SDK<br/>F02: impresoras y lectores locales del puesto."]:::external
    end
    subgraph mobileNode["F06 · dispositivos móviles · Android/iOS por homologar"]
        direction TB
        mobileClient["pos-mobile<br/>«Contenedor»<br/>Angular (frontend) ·<br/>Capacitor (shell nativa)<br/>Aplicación completa para Android/iOS."]:::pos
    end
    subgraph serverNode["Servidor de sucursal · entorno por homologar"]
        direction TB
        branchApi["branch-api<br/>«Contenedor»<br/>NestJS + Fastify / Node.js<br/>Valida y confirma la operación local."]:::pos
        syncWorker["branch-sync-worker<br/>«Contenedor»<br/>NestJS / Node.js · sin servidor HTTP<br/>Entrega eventos y actualiza espejos."]:::pos
        branchDb["Datos de sucursal<br/>«Contenedor de datos»<br/>PostgreSQL<br/>Guarda negocio, outbox y espejo local."]:::store
    end
    subgraph countryNode["Plataforma de país · alojamiento por decidir"]
        direction TB
        countryApi["country-api<br/>«Contenedor»<br/>NestJS + Fastify / Node.js<br/>Recibe operaciones y sirve trabajo y versiones."]:::pos
        countryDb["Datos operativos de país<br/>«Contenedor de datos»<br/>PostgreSQL<br/>Consolida y conserva entrega durable."]:::store
        countryCache["Redis · caché de país (opcional)<br/>«Contenedor de datos»<br/>Redis · datos reconstruibles<br/>Acelera consultas; no confirma operaciones."]:::store
    end
    subgraph erpNode["Red autorizada del ERP · entorno por país"]
        direction TB
        erpAdapter["erp-worker<br/>«Contenedor»<br/>NestJS / Node.js · libs/backend/erp<br/>Integra ERP y prepara maestros por contrato."]:::pos
        erp["ERP del país<br/>«Sistema externo»<br/>CL: AX · ES: Gira · PE: custom<br/>Recibe y concilia documentos financieros."]:::external
    end
        payments["Proveedor de pagos<br/>«Sistema externo»<br/>API / SDK según proveedor<br/>Ej.: Transbank POS · Niubiz · Mercado Pago Point."]:::external
        fiscal["Proveedor de facturación<br/>«Sistema externo»<br/>Contrato por país y modalidad<br/>Ej.: Acepta / Ingydev (CL) · EFACT (PE)."]:::external
        backup["Respaldo y recuperación<br/>«Infraestructura»<br/>Backups PostgreSQL / herramienta por definir<br/>Conserva y ensaya restauraciones."]:::pos
        observability["Observabilidad operativa (opcional)<br/>«Sistema externo»<br/>Recolector de logs / Sentry opt-in<br/>Recibe diagnóstico y correlación técnica."]:::external
        masters["Fuentes de maestros y precios<br/>«Sistema externo»<br/>Interfaces por confirmar<br/>Publica datos y reglas autorizados."]:::external
    networkPeripherals["Periféricos de red · F06<br/>«Hardware externo»<br/>TCP/IP · driver / SDK homologado<br/>Expansión: impresoras de recibos y etiquetas."]:::external
        legend["Leyenda<br/>«Clave de lectura»<br/>Notación C4<br/>Azul: POS. Violeta: datos. Gris: externo."]:::key
