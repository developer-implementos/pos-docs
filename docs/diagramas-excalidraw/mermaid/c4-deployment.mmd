flowchart TB
    accTitle: Complemento · Despliegue — Dónde corre cada pieza
    accDescr: Entorno objetivo de referencia: una tienda y una plataforma por país. No describe servidores o proveedores cloud ya contratados. Varias cajas comparten servidor y PostgreSQL de sucursal. Sin WAN puede continuar la operación autorizada; sin LAN o escritor, no se crea otra autoridad en cada puesto.
    subgraph terminalNode["Puestos POS x N · Nodo<br/>Windows por homologar"]
        direction TB
        client["Cliente de escritorio<br/>«Instancia de contenedor»<br/>Angular + Tauri<br/>Presenta caja y comandos del operador."]:::pos
        device["Puente de periféricos<br/>«Instancia de contenedor condicional»<br/>Proceso nativo según SDK<br/>Ejecuta capacidades del puesto."]:::pos
    end
    subgraph mobileNode["Dispositivos móviles · Nodo<br/>Android/iOS por homologar"]
        mobileClient["Cliente móvil<br/>«Instancia de contenedor»<br/>Angular + Capacitor<br/>Presenta operaciones en Android/iOS."]:::pos
    end
    subgraph serverNode["Servidor de sucursal · Nodo<br/>Entorno de ejecución por homologar"]
        direction TB
        branchApi["Backend de sucursal<br/>«Instancia de contenedor»<br/>NestJS + Fastify / Node.js<br/>Valida y confirma la operación local."]:::pos
        syncWorker["Sincronizador de sucursal<br/>«Instancia de contenedor»<br/>Worker TypeScript / Node.js<br/>Entrega eventos y actualiza espejos."]:::pos
        branchDb[("Datos de sucursal<br/>«Instancia de contenedor de datos»<br/>PostgreSQL<br/>Guarda negocio, outbox y espejo local.")]:::store
    end
    subgraph countryNode["Plataforma de país · Nodo<br/>Alojamiento por decidir"]
        direction TB
        countryApi["API de país<br/>«Instancia de contenedor»<br/>NestJS + Fastify / Node.js<br/>Aplica lotes y sirve publicaciones."]:::pos
        countryWorker["Workers de país<br/>«Instancia de contenedor»<br/>Workers NestJS / Node.js<br/>Publica versiones e integra pendientes."]:::pos
        erpAdapter["Adaptador ERP / ACL<br/>«Instancia de contenedor»<br/>Proceso TypeScript / Node.js<br/>Traduce contratos y concilia resultados."]:::pos
        countryDb[("Datos operativos de país<br/>«Instancia de contenedor de datos»<br/>PostgreSQL<br/>Consolida y conserva entrega durable.")]:::store
    end
    erp["ERP del país<br/>«Sistema externo»<br/>CL: AX · ES: Gira · PE: custom<br/>Recibe y concilia documentos financieros."]:::external
    payments["Proveedor de pagos<br/>«Sistema externo»<br/>API / SDK según proveedor<br/>Autoriza o informa el resultado del pago."]:::external
    fiscal["Proveedor fiscal<br/>«Sistema externo»<br/>Contrato por país y modalidad<br/>Emite o transmite documentos fiscales."]:::external
    backup["Respaldo y recuperación<br/>«Infraestructura»<br/>Backups PostgreSQL / herramienta por definir<br/>Conserva y ensaya restauraciones."]:::infra
    legend["Leyenda · notación C4<br/>Verde: POS · Azul/cilindro: datos<br/>Gris: externo · Persona: rol humano<br/>Borde discontinuo: límite indicado<br/>Flecha: propósito y protocolo<br/>Contenedor: aplicación o almacén<br/>Componente: módulo de UN proceso"]:::key
    client -->|"Comandos autenticados · HTTPS/LAN"| branchApi
    mobileClient -->|"Comandos autenticados · HTTPS/LAN"| branchApi
    client -->|"Comando autorizado por backend · IPC/loopback por homologar"| device
    branchApi -->|"Negocio + outbox · SQL local"| branchDb
    syncWorker -->|"Pendientes, cursores y espejo · SQL local"| branchDb
    syncWorker -->|"Lotes, deltas y snapshots · HTTPS/WAN"| countryApi
    countryApi -->|"Commit inbox + efecto + outbox antes de ACK · SQL"| countryDb
    countryWorker -->|"Outbox confirmada / publicaciones · SQL"| countryDb
    countryWorker -->|"Contrato canónico · HTTPS interno"| erpAdapter
    erpAdapter -->|"Traducción por país · interfaz ERP por validar"| erp
    erpAdapter -->|"Resultados y referencias · SQL"| countryDb
    device -->|"Terminal/pago · SDK o API homologado"| payments
    branchApi -->|"Emisión/transmisión · modalidad por homologar"| fiscal
    branchDb -->|"Copia y evidencia de restore · mecanismo por definir"| backup
    countryDb -->|"Copia y retención por país · mecanismo por definir"| backup
