flowchart TB
    accTitle: C3 · branch-sync-worker — Entrega durable y activación local
    accDescr: apps/branch-sync-worker compone sync con las reglas de catálogo/precios. PostgreSQL de sucursal y country-api están fuera del proceso. Deltas y cargas completas comparten validación. Snapshot + watermark + staging + checksum + activación atómica; las ventas abiertas mantienen su versión.
    subgraph syncScope["apps/branch-sync-worker · UN proceso supervisado"]
        direction TB
        schedule["Planificador y supervisor<br/>«Componente»<br/>Worker TypeScript<br/>Admite trabajos con límites y ventanas."]:::pos
        sender["Emisor de outbox<br/>«Componente»<br/>Worker TypeScript / HTTPS<br/>Envía lotes con identidad estable."]:::pos
        receiver["Receptor de deltas y acuses<br/>«Componente»<br/>Worker TypeScript / HTTPS<br/>Valida contratos y cursores de entrega."]:::pos
        dedup["Inbox y deduplicación<br/>«Componente»<br/>Transacciones SQL / TypeScript<br/>Deduplica y prepara una candidata."]:::pos
        snapshot["Carga de snapshot<br/>«Componente»<br/>Descarga HTTPS / TypeScript<br/>Prepara una versión fuera de servicio."]:::pos
        validation["Validador de publicación<br/>«Componente»<br/>Reglas TypeScript / SQL<br/>Revisa integridad, cobertura y vigencia."]:::pos
        activation["Activación de versión<br/>«Componente»<br/>Transacción SQL / TypeScript<br/>Cambia atómicamente la versión activa."]:::pos
    end
    branchDb[("Datos de sucursal<br/>«Contenedor de datos»<br/>PostgreSQL<br/>Guarda negocio, outbox y espejo local.")]:::store
        countryApi["country-api<br/>«Contenedor»<br/>NestJS + Fastify / Node.js ·<br/>BullMQ<br/>Recibe operaciones y sirve trabajo y versiones."]:::pos
    legend["Leyenda · notación C4<br/>Azul: POS · Violeta: datos<br/>Gris: externo · Ámbar: infraestructura<br/>Borde: sistema, proceso o nodo indicado<br/>Flecha: iniciador, propósito y protocolo<br/>Opcional / por asignar: condición explícita<br/>Contenedor no equivale a Docker"]:::key
