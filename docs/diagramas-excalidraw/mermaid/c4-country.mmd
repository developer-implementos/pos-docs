flowchart TB
    accTitle: C3 · country-api — Recepción, trabajo y consultas de país
    accDescr: Un proceso HTTP apps/country-api. Recibe operaciones, ofrece trabajo al ERP y sirve publicaciones; no ejecuta la ACL ni construye cargas masivas dentro de una petición. ACK sólo después del commit de inbox + efecto + outbox. Redis acelera lecturas opcionales con fallback SQL; no contiene el único estado de recepción, trabajo o resultados.
    subgraph countryScope["apps/country-api · UN proceso NestJS + Fastify"]
        direction TB
        countryEntry["Entrada y autorización<br/>«Componente»<br/>administration + sync · NestJS<br/>Valida emisor, ámbito y contrato HTTP."]:::pos
        countryInbox["Recepción de operaciones<br/>«Componente»<br/>libs/backend/sync<br/>Deduplica y aplica el efecto local pactado."]:::pos
        countryJobs["Trabajo y resultados ERP<br/>«Componente»<br/>sync + erp · contratos públicos propuestos<br/>Asigna trabajo y registra su resultado."]:::pos
        countryPublications["Publicaciones y consultas<br/>«Componente»<br/>catalog + pricing + reporting<br/>Sirve versiones y estado operativo."]:::pos
        countryCachePort["Puerto de caché opcional<br/>«Componente»<br/>Adaptador TypeScript / cache-aside<br/>Acelera lecturas reconstruibles."]:::pos
        countryUow["Persistencia de país<br/>«Componente»<br/>Repositorios TypeScript / SQL<br/>Confirma estado y trabajo en PostgreSQL."]:::pos
        technicalBase["Base técnica compartida<br/>«Componente»<br/>shared/backend · composición objetivo<br/>Configuración, salud, Pino y Sentry opt-in."]:::pos
    end
    syncWorker["branch-sync-worker<br/>«Contenedor»<br/>NestJS / Node.js · sin servidor HTTP<br/>Entrega eventos y actualiza espejos."]:::pos
    erpAdapter["erp-worker<br/>«Contenedor»<br/>NestJS / Node.js · libs/backend/erp<br/>Consume trabajo; traduce y concilia con ERP."]:::pos
    countryDb[("Datos operativos de país<br/>«Contenedor de datos»<br/>PostgreSQL<br/>Consolida y conserva entrega durable.")]:::store
    countryCache[("Redis · caché de país (opcional)<br/>«Contenedor de datos»<br/>Redis · datos reconstruibles<br/>Acelera consultas; no confirma operaciones.")]:::store
    legend["Leyenda · notación C4<br/>Azul: POS · Violeta: datos<br/>Gris: externo · Ámbar: infraestructura<br/>Borde: sistema, proceso o nodo indicado<br/>Flecha: iniciador, propósito y protocolo<br/>Opcional / por asignar: condición explícita<br/>Contenedor no equivale a Docker"]:::key
