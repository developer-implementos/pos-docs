        countryInbox["Recepción de operaciones<br/>«Componente»<br/>libs/backend/sync<br/>Deduplica y aplica el efecto local pactado."]:::pos
        countryJobs["Trabajo y resultados ERP<br/>«Componente»<br/>sync + erp · contratos públicos propuestos<br/>Asigna trabajo y registra su resultado."]:::pos
