    },
    {
      "id": "notes-1713-7-body",
      "type": "text",
      "x": 684.6666666666666,
      "y": 2659.2400329589846,
      "width": 523.3486328125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-1713-7"
      ],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 1087185703,
      "version": 2,
      "versionNonce": 162061191,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603449676,
      "link": null,
      "locked": false,
      "text": "Sistema externo · Contrato por país y modalidad\n\nEmisión, aceptación y transmisión se modelan por\nseparado. No se inventa un proveedor común ni una\ncapacidad de consulta o idempotencia no acreditada.\n\nAUTORIDAD · Autoridad y validez tributaria según\nrégimen y proveedor.\n\nCONTINUIDAD · Emitir offline exige modalidad y\nmaterial fiscal válidos; no se promete universalmente.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sistema externo · Contrato por país y modalidad\n\nEmisión, aceptación y transmisión se modelan por\nseparado. No se inventa un proveedor común ni una\ncapacidad de consulta o idempotencia no acreditada.\n\nAUTORIDAD · Autoridad y validez tributaria según\nrégimen y proveedor.\n\nCONTINUIDAD · Emitir offline exige modalidad y\nmaterial fiscal válidos; no se promete universalmente.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "footer",
      "type": "text",
      "x": 64,
      "y": 3138.2400329589846,
      "width": 1424.169921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 1483163337,
      "version": 2,
      "versionNonce": 1720304745,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603449676,
      "link": null,
      "locked": false,
      "text": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "glossary",
      "type": "text",
      "x": 64,
      "y": 3204.2400329589846,
      "width": 1681.240234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 967583303,
      "version": 2,
      "versionNonce": 1932645031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603449676,
      "link": null,
      "locked": false,
      "text": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "autoResize": true,
      "lineHeight": 1.25
    },
