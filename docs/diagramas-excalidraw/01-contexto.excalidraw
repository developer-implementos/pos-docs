    },
    {
      "id": "notes-1925-6-body",
      "type": "text",
      "x": 86,
      "y": 2871.2400329589846,
      "width": 566.9619140625,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-1925-6"
      ],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 1420688587,
      "version": 2,
      "versionNonce": 168475563,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788053427,
      "link": null,
      "locked": false,
      "text": "Sistema externo · API / SDK según proveedor\n\nPago, venta, documento fiscal e integración ERP tienen\nestados distintos. No repetir un cargo incierto ni cambiar\nde proveedor para resolverlo automáticamente.\n\nAUTORIDAD · El proveedor mantiene el efecto financiero;\nPOS registra intento, referencia y resultado.\n\nCONTINUIDAD · Disponibilidad y modo offline por\nhomologar. Un timeout puede dejar resultado\ndesconocido.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sistema externo · API / SDK según proveedor\n\nPago, venta, documento fiscal e integración ERP tienen\nestados distintos. No repetir un cargo incierto ni cambiar\nde proveedor para resolverlo automáticamente.\n\nAUTORIDAD · El proveedor mantiene el efecto financiero;\nPOS registra intento, referencia y resultado.\n\nCONTINUIDAD · Disponibilidad y modo offline por\nhomologar. Un timeout puede dejar resultado\ndesconocido.",
      "autoResize": true,
      "lineHeight": 1.25
    },
