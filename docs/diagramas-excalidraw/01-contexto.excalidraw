    },
    {
      "id": "notes-1713-6-body",
      "type": "text",
      "x": 86,
      "y": 2659.2400329589846,
      "width": 507.50390625,
      "height": 385,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-1713-6"
      ],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 424424713,
      "version": 2,
      "versionNonce": 1528011433,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603449676,
      "link": null,
      "locked": false,
      "text": "Sistema externo · API / SDK según proveedor\n\nPago, venta, documento fiscal e integración ERP\ntienen estados distintos. No repetir un cargo incierto\nni cambiar de proveedor para resolverlo\nautomáticamente.\n\nAUTORIDAD · El proveedor mantiene el efecto\nfinanciero; POS registra intento, referencia y\nresultado.\n\nCONTINUIDAD · Disponibilidad y modo offline por\nhomologar. Un timeout puede dejar resultado\ndesconocido.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sistema externo · API / SDK según proveedor\n\nPago, venta, documento fiscal e integración ERP\ntienen estados distintos. No repetir un cargo incierto\nni cambiar de proveedor para resolverlo\nautomáticamente.\n\nAUTORIDAD · El proveedor mantiene el efecto\nfinanciero; POS registra intento, referencia y\nresultado.\n\nCONTINUIDAD · Disponibilidad y modo offline por\nhomologar. Un timeout puede dejar resultado\ndesconocido.",
      "autoResize": true,
      "lineHeight": 1.25
    },
