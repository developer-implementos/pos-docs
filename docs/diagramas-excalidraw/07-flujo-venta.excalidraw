      "updated": 1793500366923,
      "link": null,
      "locked": false,
      "text": "ERP posterior no es el ACK de país",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ERP posterior no es el ACK de país",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-7198-5-body",
      "type": "text",
      "x": 2942,
      "y": 7487.5,
      "width": 1335.748046875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-7198-5"
      ],
      "frameId": null,
      "index": "b1b",
      "roundness": null,
      "seed": 304424636,
      "version": 2,
      "versionNonce": 246091964,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793500366923,
      "link": null,
      "locked": false,
      "text": "erp-worker reclama trabajo mediante HTTPS saliente a country-api y ejecuta fachada, ACL y adaptadores dentro del mismo proceso.\nCountry-api conserva intentos y resultados en PostgreSQL; no existe acceso SQL WAN desde el worker. Una respuesta incierta requiere\nconsulta o conciliación antes de repetir efectos.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "erp-worker reclama trabajo mediante HTTPS saliente a country-api y ejecuta fachada, ACL y adaptadores dentro del mismo proceso.\nCountry-api conserva intentos y resultados en PostgreSQL; no existe acceso SQL WAN desde el worker. Una respuesta incierta requiere\nconsulta o conciliación antes de repetir efectos.",
      "autoResize": true,
      "lineHeight": 1.25
    },
