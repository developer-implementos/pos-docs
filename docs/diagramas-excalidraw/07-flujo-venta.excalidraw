      "text": "Pago desconocido o aprobado sin commit local",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pago desconocido o aprobado sin commit local",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-7198-0-body",
      "type": "text",
      "x": 86,
      "y": 7271.75,
      "width": 1353.7734375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-7198-0"
      ],
      "frameId": null,
      "index": "b1M",
      "roundness": null,
      "seed": 371992022,
      "version": 2,
      "versionNonce": 1574858454,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364561665,
      "link": null,
      "locked": false,
      "text": "Un timeout conserva el intento y su incertidumbre: consulta o conciliación según capacidad, sin recargar ni cambiar automáticamente de\nproveedor. Si el pago se aprobó y falla el commit local, se recuperan intención y evidencia; una reversa o intervención controlada conserva\nel intento original.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un timeout conserva el intento y su incertidumbre: consulta o conciliación según capacidad, sin recargar ni cambiar automáticamente de\nproveedor. Si el pago se aprobó y falla el commit local, se recuperan intención y evidencia; una reversa o intervención controlada conserva\nel intento original.",
      "autoResize": true,
      "lineHeight": 1.25
    },
