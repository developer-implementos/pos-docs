      "isDeleted": false,
      "boundElements": [],
      "updated": 1793632582903,
      "link": null,
      "locked": false,
      "text": "Caída WAN frente a caída LAN",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caída WAN frente a caída LAN",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-7198-3-body",
      "type": "text",
      "x": 86,
      "y": 7487.5,
      "width": 1352.9677734375,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-7198-3"
      ],
      "frameId": null,
      "index": "b1V",
      "roundness": null,
      "seed": 1396144886,
      "version": 2,
      "versionNonce": 1573843958,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793632582903,
      "link": null,
      "locked": false,
      "text": "Sin WAN la outbox permanece durable y se permiten solo operaciones soportadas por datos, autenticación, pago y fiscalidad vigentes. Sin\nLAN, backend o escritor autorizado se detiene el comando dependiente. Ninguna terminal crea por ello una base o autoridad alternativa.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sin WAN la outbox permanece durable y se permiten solo operaciones soportadas por datos, autenticación, pago y fiscalidad vigentes. Sin\nLAN, backend o escritor autorizado se detiene el comando dependiente. Ninguna terminal crea por ello una base o autoridad alternativa.",
      "autoResize": true,
      "lineHeight": 1.25
    },
