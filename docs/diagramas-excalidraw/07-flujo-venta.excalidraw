    },
    {
      "id": "notes-5195-2-title",
      "type": "text",
      "x": 2232,
      "y": 5216.5,
      "width": 543.359375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-5195-2"
      ],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 1085220771,
      "version": 2,
      "versionNonce": 1087145987,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793302316040,
      "link": null,
      "locked": false,
      "text": "Fiscalidad e impresión tienen su propio resultado",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fiscalidad e impresión tienen su propio resultado",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-5195-2-body",
      "type": "text",
      "x": 2232,
      "y": 5268.75,
      "width": 1002.7724609375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-5195-2"
      ],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 1123211277,
      "version": 2,
      "versionNonce": 1713515949,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793302316040,
      "link": null,
      "locked": false,
      "text": "Solo se confirman operaciones y documentos permitidos por la modalidad nacional habilitada. Las\nllamadas fiscales conservan referencia, estado y recuperación fuera de una transacción distribuida. Un\nfallo de impresión permite reimprimir el mismo documento; no genera otra venta ni otro cargo.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solo se confirman operaciones y documentos permitidos por la modalidad nacional habilitada. Las\nllamadas fiscales conservan referencia, estado y recuperación fuera de una transacción distribuida. Un\nfallo de impresión permite reimprimir el mismo documento; no genera otra venta ni otro cargo.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-5195-3-bg",
      "type": "rectangle",
