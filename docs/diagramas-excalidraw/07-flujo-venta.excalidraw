      "updated": 1792603452677,
      "link": null,
      "locked": false,
      "text": "API de país\n«Contenedor»\nNestJS + Fastify / Node.js\nValida el contrato y confirma\ninbox, efecto local y outbox\nantes de acusar aplicación.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "countryApi",
      "originalText": "API de país\n«Contenedor»\nNestJS + Fastify / Node.js\nValida el contrato y confirma\ninbox, efecto local y outbox\nantes de acusar aplicación.",
      "autoResize": true,
      "lineHeight": 1.15
