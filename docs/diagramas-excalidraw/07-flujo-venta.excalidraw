      "locked": false,
      "text": "Pago por SDK: capacidad futura independiente",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pago por SDK: capacidad futura independiente",
