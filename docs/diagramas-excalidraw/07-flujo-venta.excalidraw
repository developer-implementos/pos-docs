      "versionNonce": 1892136906,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310660385,
      "link": null,
      "locked": false,
      "text": "El resultado se registra con transiciones condicionales y deduplicación. ACK de aplicación de la venta, resultado ERP y contabilización definitiva siguen siendo hitos distintos.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El resultado se registra con transiciones condicionales y deduplicación. ACK de aplicación de la venta, resultado ERP y contabilización definitiva siguen siendo hitos distintos.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dynamic-note",
      "type": "text",
      "x": 64,
      "y": 6799.5,
      "width": 2472.10546875,
      "height": 30,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1F",
      "roundness": null,
      "seed": 1263771798,
      "version": 2,
      "versionNonce": 713556438,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310660385,
      "link": null,
      "locked": false,
      "text": "Secuencia objetivo recomendada. Cada flecha es una interacción, no una transacción distribuida. Impresión y sincronización son ramas independientes de la venta confirmada; imprimir no bloquea la entrega a país ni crea otra venta.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Secuencia objetivo recomendada. Cada flecha es una interacción, no una transacción distribuida. Impresión y sincronización son ramas independientes de la venta confirmada; imprimir no bloquea la entrega a país ni crea otra venta.",
      "autoResize": true,
      "lineHeight": 1.25
    },
