      "updated": 1792603452676,
      "link": null,
      "locked": false,
      "text": "Cliente de escritorio\n«Contenedor»\nAngular + Tauri\nEnvía comandos identificados y\npresenta el resultado durable al\noperador.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "client",
      "originalText": "Cliente de escritorio\n«Contenedor»\nAngular + Tauri\nEnvía comandos identificados y\npresenta el resultado durable al\noperador.",
      "autoResize": true,
      "lineHeight": 1.15
    },
