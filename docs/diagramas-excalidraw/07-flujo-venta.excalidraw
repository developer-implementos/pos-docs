      "seed": 780587847,
      "version": 2,
      "versionNonce": 694110311,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603452673,
      "link": null,
      "locked": false,
      "text": "SDK local es una ruta condicional",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SDK local es una ruta condicional",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3715-1-body",
      "type": "text",
      "x": 922.3333333333334,
      "y": 3788.75,
      "width": 721.5634765625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3715-1"
      ],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 7874729,
      "version": 2,
      "versionNonce": 358946185,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603452673,
      "link": null,
      "locked": false,
      "text": "La vista muestra una API ejecutada desde backend. Si el proveedor exige\nSDK local homologado, el cliente transporta al puente de periféricos el\ncomando original autorizado por backend y retorna evidencia. No inventa\nimporte o permiso, ni ejecuta ambas rutas para un mismo intento.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La vista muestra una API ejecutada desde backend. Si el proveedor exige\nSDK local homologado, el cliente transporta al puente de periféricos el\ncomando original autorizado por backend y retorna evidencia. No inventa\nimporte o permiso, ni ejecuta ambas rutas para un mismo intento.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3715-2-bg",
      "type": "rectangle",
      "x": 1736.6666666666667,
      "y": 3714.5,
      "width": 812.3333333333334,
      "height": 219.25,
      "angle": 0,
      "strokeColor": "#CCD7E8",
      "backgroundColor": "#F7F9FD",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3715-2"
