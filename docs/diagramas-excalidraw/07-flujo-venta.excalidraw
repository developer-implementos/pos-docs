    },
    {
      "id": "notes-3715-1-title",
      "type": "text",
      "x": 922.3333333333334,
      "y": 3736.5,
      "width": 373.828125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
