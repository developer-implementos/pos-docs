      "type": "text",
      "x": 86,
      "y": 5268.75,
      "width": 963.6923828125,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-5195-0"
      ],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 2320677,
      "version": 2,
      "versionNonce": 1022902725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788056399,
      "link": null,
      "locked": false,
      "text": "Un timeout conserva el intento y su incertidumbre: consulta o conciliación según capacidad, sin\nrecargar ni cambiar automáticamente de proveedor. Si el pago se aprobó y falla el commit local, se\nrecuperan intención y evidencia; una reversa o intervención controlada conserva el intento original.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un timeout conserva el intento y su incertidumbre: consulta o conciliación según capacidad, sin\nrecargar ni cambiar automáticamente de proveedor. Si el pago se aprobó y falla el commit local, se\nrecuperan intención y evidencia; una reversa o intervención controlada conserva el intento original.",
      "autoResize": true,
      "lineHeight": 1.25
    },
