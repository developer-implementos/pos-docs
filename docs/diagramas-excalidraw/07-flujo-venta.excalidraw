    {
      "id": "notes-6970-5-title",
      "type": "text",
      "x": 2942,
      "y": 7207.25,
      "width": 397.42431640625,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
