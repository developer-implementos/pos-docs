    {
      "id": "notes-7198-2-title",
      "type": "text",
      "x": 2942,
      "y": 7219.5,
      "width": 543.359375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-7198-2"
      ],
      "frameId": null,
      "index": "b1R",
      "roundness": null,
      "seed": 596946954,
      "version": 2,
      "versionNonce": 1191294730,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364561665,
      "link": null,
      "locked": false,
      "text": "Fiscalidad e impresión tienen su propio resultado",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fiscalidad e impresión tienen su propio resultado",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-7198-2-body",
      "type": "text",
      "x": 2942,
      "y": 7271.75,
      "width": 1353.7841796875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-7198-2"
      ],
      "frameId": null,
      "index": "b1S",
      "roundness": null,
      "seed": 290827670,
      "version": 2,
      "versionNonce": 1818269334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364561665,
      "link": null,
      "locked": false,
      "text": "Sólo se emiten documentos permitidos por la modalidad nacional habilitada. device-agent imprime una referencia existente; aceptación del\nspooler no acredita impresión física. Un resultado incierto conserva evidencia; reimprimir requiere una operación explícita autorizada, sin\nnueva venta, cargo ni emisión fiscal.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sólo se emiten documentos permitidos por la modalidad nacional habilitada. device-agent imprime una referencia existente; aceptación del\nspooler no acredita impresión física. Un resultado incierto conserva evidencia; reimprimir requiere una operación explícita autorizada, sin\nnueva venta, cargo ni emisión fiscal.",
      "autoResize": true,
      "lineHeight": 1.25
    },
