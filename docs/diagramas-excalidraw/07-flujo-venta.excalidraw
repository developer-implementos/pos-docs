      "updated": 1793364561665,
      "link": null,
      "locked": false,
      "text": "Reentregar o consultar el resultado es independiente de reenviar la operación al ERP. Se preservan referencia, destino, versión y evidencia técnica.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reentregar o consultar el resultado es independiente de reenviar la operación al ERP. Se preservan referencia, destino, versión y evidencia técnica.",
      "autoResize": true,
      "lineHeight": 1.25
    },
