      "locked": false
    },
    {
      "id": "notes-6970-2-title",
      "type": "text",
      "x": 2942,
      "y": 6991.5,
      "width": 543.359375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
