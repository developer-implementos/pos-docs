    {
      "id": "notes-5195-2-title",
      "type": "text",
      "x": 2232,
      "y": 5216.5,
      "width": 543.359375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
