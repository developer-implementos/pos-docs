      "boundElements": [],
      "updated": 1793500366923,
      "link": null,
      "locked": false,
      "text": "Valida usuario, sucursal, capacidad, dispositivo y agente dueño. El trabajo referencia el documento ya emitido; una impresión o reimpresión no genera otra venta ni documento fiscal.",
      "fontSize": 20,
