      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288407572,
      "link": null,
      "locked": false,
      "text": "Secuencia objetivo recomendada. Cada flecha es una interacción, no una transacción distribuida. Venta, pago, fiscalidad, entrega a país y resultado ERP conservan identidades y estados separados.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Secuencia objetivo recomendada. Cada flecha es una interacción, no una transacción distribuida. Venta, pago, fiscalidad, entrega a país y resultado ERP conservan identidades y estados separados.",
      "autoResize": true,
      "lineHeight": 1.25
    },
