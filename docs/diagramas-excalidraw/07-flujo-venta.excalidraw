    {
      "id": "step-1-note",
      "type": "text",
      "x": 64,
      "y": 1014,
      "width": 3147.958984375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
