    },
    {
      "id": "notes-3392-15-body",
      "type": "text",
      "x": 4640.776074218749,
      "y": 4910.85,
      "width": 1447.9609375,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
