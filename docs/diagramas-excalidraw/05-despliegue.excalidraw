      "text": "Puesto inicial y expansión F06",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Puesto inicial y expansión F06",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3067-1-body",
      "type": "text",
      "x": 2402.7802734375,
      "y": 3141.4500000000003,
      "width": 2230.5078125,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3067-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1028938966,
      "version": 2,
      "versionNonce": 1986520522,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310658556,
      "link": null,
      "locked": false,
      "text": "F02: pos-desktop y device-agent son procesos independientes en el mismo puesto Windows; SQLite técnico y periféricos USB/serie permanecen allí. F05 valida ese perfil. La línea discontinua representa F06: impresoras de red y\nestación compartida certificada con la misma aplicación. Ubicación de la instancia, permisos, concurrencia y acceso móvil se homologan antes de habilitarla; el servidor no es su ubicación predeterminada.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "F02: pos-desktop y device-agent son procesos independientes en el mismo puesto Windows; SQLite técnico y periféricos USB/serie permanecen allí. F05 valida ese perfil. La línea discontinua representa F06: impresoras de red y\nestación compartida certificada con la misma aplicación. Ubicación de la instancia, permisos, concurrencia y acceso móvil se homologan antes de habilitarla; el servidor no es su ubicación predeterminada.",
      "autoResize": true,
      "lineHeight": 1.25
    },
