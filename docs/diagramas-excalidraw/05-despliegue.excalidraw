    {
      "id": "notes-3041-0-body",
      "type": "text",
      "x": 86,
      "y": 3115.05,
      "width": 1782.2578125,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
