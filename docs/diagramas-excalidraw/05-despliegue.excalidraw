    {
      "id": "notes-3365-2-body",
      "type": "text",
      "x": 2881.07890625,
      "y": 3439.7000000000003,
      "width": 1302.4150390625,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
