    {
      "id": "notes-3363-9-title",
      "type": "text",
      "x": 1402.5444335937502,
      "y": 4256.343310546876,
      "width": 358.5205078125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
