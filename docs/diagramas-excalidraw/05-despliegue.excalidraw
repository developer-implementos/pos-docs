    {
      "id": "notes-3365-0-body",
      "type": "text",
      "x": 86,
      "y": 3439.7000000000003,
      "width": 1321.912109375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
