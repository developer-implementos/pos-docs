    {
      "id": "notes-2808-13-body",
      "type": "text",
      "x": 991.7936035156249,
      "y": 4216.5044921875,
      "width": 820.5419921875,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
