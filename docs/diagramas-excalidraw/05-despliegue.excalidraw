    {
      "id": "notes-3313-0-body",
      "type": "text",
      "x": 86,
      "y": 3386.9000000000005,
      "width": 1227.7568359375,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3313-0"
      ],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 2004514917,
      "version": 2,
      "versionNonce": 913012741,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788054810,
      "link": null,
      "locked": false,
      "text": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio; hardware, SDK y\ndistribución requieren homologación. Su registro técnico de periféricos no lo convierte en autoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio; hardware, SDK y\ndistribución requieren homologación. Su registro técnico de periféricos no lo convierte en autoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
