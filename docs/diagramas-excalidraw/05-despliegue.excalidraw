    {
      "id": "notes-3094-0-body",
      "type": "text",
      "x": 86,
      "y": 3167.85,
      "width": 1909.4345703125,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
