    {
      "id": "notes-3065-1-body",
      "type": "text",
      "x": 1841.3925781250002,
      "y": 3138.8433105468753,
      "width": 1668.00390625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3065-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1251972196,
      "version": 2,
      "versionNonce": 1768463588,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682523458,
      "link": null,
      "locked": false,
      "text": "erp-worker inicia HTTPS autenticado hacia country-api para obtener trabajo y reportar resultados. El acceso al ERP permanece en su red autorizada; no se expone SQL ni\nse exige conexión entrante desde país. Protocolo, alojamiento y credenciales se homologan por destino.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "erp-worker inicia HTTPS autenticado hacia country-api para obtener trabajo y reportar resultados. El acceso al ERP permanece en su red autorizada; no se expone SQL ni\nse exige conexión entrante desde país. Protocolo, alojamiento y credenciales se homologan por destino.",
      "autoResize": true,
      "lineHeight": 1.25
    },
