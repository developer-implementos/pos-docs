    {
      "id": "notes-2808-3-body",
      "type": "text",
      "x": 2803.3808105468747,
      "y": 2881.7544921874996,
      "width": 836.3974609375,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2808-3"
      ],
      "frameId": null,
      "index": "ac",
