    {
      "id": "notes-3014-0-body",
      "type": "text",
      "x": 86,
      "y": 3088.6500000000005,
      "width": 1782.2578125,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3014-0"
      ],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 603087334,
      "version": 2,
      "versionNonce": 1723500710,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288406820,
      "link": null,
      "locked": false,
      "text": "Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen nuevos comandos dependientes; el puesto no se convierte en escritor de\nemergencia. Redis de país y la telemetría externa no son dependencias de la venta local.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen nuevos comandos dependientes; el puesto no se convierte en escritor de\nemergencia. Redis de país y la telemetría externa no son dependencias de la venta local.",
      "autoResize": true,
      "lineHeight": 1.25
    },
