    {
      "id": "notes-3392-17-body",
      "type": "text",
      "x": 1604.25869140625,
      "y": 5374.1,
      "width": 1428.3564453125,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
