    {
      "id": "notes-2808-11-body",
      "type": "text",
      "x": 2803.3808105468747,
      "y": 3780.7544921874996,
      "width": 823.0234375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
