    {
      "id": "notes-3065-0-body",
      "type": "text",
      "x": 86,
      "y": 3138.8433105468753,
      "width": 1673.439453125,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3065-0"
      ],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 269048540,
      "version": 2,
      "versionNonce": 1112865372,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682523458,
      "link": null,
      "locked": false,
      "text": "Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen nuevos comandos dependientes; el puesto no se convierte en\nescritor de emergencia. Redis de país y la telemetría externa no son dependencias de la venta local.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen nuevos comandos dependientes; el puesto no se convierte en\nescritor de emergencia. Redis de país y la telemetría externa no son dependencias de la venta local.",
      "autoResize": true,
      "lineHeight": 1.25
    },
