    },
    {
      "id": "notes-3313-6-body",
      "type": "text",
      "x": 2870.79541015625,
      "y": 3767.6500000000005,
      "width": 1314.607421875,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3313-6"
      ],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 540298949,
      "version": 2,
      "versionNonce": 816233061,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788054810,
      "link": null,
      "locked": false,
      "text": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único commit antes\ndel ACK de aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS saliente iniciado por ese worker. Valida, publica y\nsirve versiones preparadas mediante MasterDataSourcePort en erp-worker; no ejecuta la ACL ni carga masiva pesada en un endpoint.\nLa caché opcional acelera lecturas reconstruibles, con PostgreSQL como fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación. Conserva autoridad\nde versiones, manifiestos y publicación de maestros.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único commit antes\ndel ACK de aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS saliente iniciado por ese worker. Valida, publica y\nsirve versiones preparadas mediante MasterDataSourcePort en erp-worker; no ejecuta la ACL ni carga masiva pesada en un endpoint.\nLa caché opcional acelera lecturas reconstruibles, con PostgreSQL como fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación. Conserva autoridad\nde versiones, manifiestos y publicación de maestros.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización.",
      "autoResize": true,
      "lineHeight": 1.25
    },
