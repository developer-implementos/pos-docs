    {
      "id": "notes-3014-1-body",
      "type": "text",
      "x": 1942.5302734375,
      "y": 3088.6500000000005,
      "width": 1756.0576171875,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
