    {
      "id": "notes-3094-0-body",
      "type": "text",
      "x": 86,
      "y": 3167.85,
      "width": 2528.173828125,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
