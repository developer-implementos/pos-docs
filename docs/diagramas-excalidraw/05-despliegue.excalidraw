    {
      "id": "notes-2808-6-title",
      "type": "text",
      "x": 1897.5872070312498,
      "y": 3265.2544921874996,
      "width": 129.248046875,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
