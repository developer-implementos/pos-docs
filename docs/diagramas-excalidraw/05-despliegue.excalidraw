      ],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 347213323,
      "version": 2,
      "versionNonce": 2080448587,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793307991417,
      "link": null,
      "locked": false,
      "text": "Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen nuevos comandos dependientes; el puesto no se convierte en escritor de emergencia.\nRedis de país y la telemetría externa no son dependencias de la venta local.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen nuevos comandos dependientes; el puesto no se convierte en escritor de emergencia.\nRedis de país y la telemetría externa no son dependencias de la venta local.",
      "autoResize": true,
      "lineHeight": 1.25
    },
