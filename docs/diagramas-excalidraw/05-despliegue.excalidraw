    },
    {
      "id": "notes-3313-15-body",
      "type": "text",
      "x": 4279.424755859374,
      "y": 4694.150000000001,
      "width": 1325.650390625,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3313-15"
      ],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 1166984122,
      "version": 2,
      "versionNonce": 667463930,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288406820,
      "link": null,
      "locked": false,
      "text": "Sistema externo · Interfaces por confirmar\n\nCatálogo, impuestos, precios y promociones deben tener responsable, contrato, versión y vigencia. La fuente de precios no se sustituye\npor una tabla editada libremente en cada caja.\n\nAUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP por defecto.\n\nCONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la política autorizada.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sistema externo · Interfaces por confirmar\n\nCatálogo, impuestos, precios y promociones deben tener responsable, contrato, versión y vigencia. La fuente de precios no se sustituye\npor una tabla editada libremente en cada caja.\n\nAUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP por defecto.\n\nCONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la política autorizada.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "footer",
      "type": "text",
      "x": 64,
      "y": 5118.150000000001,
      "width": 1424.169921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 846982374,
      "version": 2,
      "versionNonce": 454194086,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288406820,
      "link": null,
      "locked": false,
      "text": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "glossary",
      "type": "text",
      "x": 64,
      "y": 5184.150000000001,
      "width": 1681.240234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 892484730,
      "version": 2,
      "versionNonce": 742162874,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288406820,
      "link": null,
      "locked": false,
      "text": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "autoResize": true,
      "lineHeight": 1.25
    },
