    {
      "id": "notes-3365-3-body",
      "type": "text",
      "x": 4278.618359374999,
      "y": 3439.7000000000003,
      "width": 1323.115234375,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
