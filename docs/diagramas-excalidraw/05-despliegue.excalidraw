    {
      "id": "notes-3067-1-title",
      "type": "text",
      "x": 2402.7802734375,
      "y": 3089.2000000000003,
      "width": 337.6953125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
