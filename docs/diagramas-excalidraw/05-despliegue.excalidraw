    {
      "id": "notes-2808-0-body",
      "type": "text",
      "x": 86,
      "y": 2881.7544921874996,
      "width": 827.8896484375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2808-0"
      ],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 1352844615,
      "version": 2,
      "versionNonce": 934972871,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603451969,
      "link": null,
      "locked": false,
      "text": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja\nel bundle de escritorio; hardware, SDK y distribución requieren homologación. Su\nregistro técnico de periféricos no lo convierte en autoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen\nnuevos comandos dependientes.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja\nel bundle de escritorio; hardware, SDK y distribución requieren homologación. Su\nregistro técnico de periféricos no lo convierte en autoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen\nnuevos comandos dependientes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
