    },
    {
      "id": "notes-3363-3-body",
      "type": "text",
      "x": 4035.633300781251,
      "y": 3437.0933105468753,
      "width": 1213.0615234375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3363-3"
      ],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 1614409828,
      "version": 2,
      "versionNonce": 1460828388,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682523458,
      "link": null,
      "locked": false,
      "text": "Contenedor · NestJS + Fastify / Node.js\n\napps/branch-api compone los contextos operativos: sales/returns, cash/collections, pricing/catalog, payments/devices, fiscal,\nreporting y administration. sync aporta el contrato outbox que se confirma con negocio. El transporte pertenece a\nbranch-sync-worker y la ACL ERP a erp-worker. Bibliotecas no equivalen a microservicios; las capacidades de negocio aún\nrequieren implementación.\n\nAUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos internos, un proceso.\n\nCONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del escritor autorizado.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · NestJS + Fastify / Node.js\n\napps/branch-api compone los contextos operativos: sales/returns, cash/collections, pricing/catalog, payments/devices, fiscal,\nreporting y administration. sync aporta el contrato outbox que se confirma con negocio. El transporte pertenece a\nbranch-sync-worker y la ACL ERP a erp-worker. Bibliotecas no equivalen a microservicios; las capacidades de negocio aún\nrequieren implementación.\n\nAUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos internos, un proceso.\n\nCONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del escritor autorizado.",
      "autoResize": true,
      "lineHeight": 1.25
    },
