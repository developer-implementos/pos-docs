    {
      "id": "notes-3094-1-body",
      "type": "text",
      "x": 2110.344921875,
      "y": 3167.85,
      "width": 1937.07421875,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3094-1"
      ],
      "frameId": null,
      "index": "aM",
