    {
      "id": "notes-3365-7-body",
      "type": "text",
      "x": 5298.755615234375,
      "y": 3902.9500000000003,
      "width": 1612.48828125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3365-7"
      ],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 747638358,
      "version": 2,
      "versionNonce": 1804934218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310658556,
      "link": null,
      "locked": false,
      "text": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único commit antes del ACK de aplicación. Expone\ntrabajo y resultados al erp-worker mediante HTTPS saliente iniciado por ese worker. Valida, publica y sirve versiones preparadas mediante MasterDataSourcePort en\nerp-worker; no ejecuta la ACL ni carga masiva pesada en un endpoint. La caché opcional acelera lecturas reconstruibles, con PostgreSQL como fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación. Conserva autoridad de versiones, manifiestos y\npublicación de maestros.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único commit antes del ACK de aplicación. Expone\ntrabajo y resultados al erp-worker mediante HTTPS saliente iniciado por ese worker. Valida, publica y sirve versiones preparadas mediante MasterDataSourcePort en\nerp-worker; no ejecuta la ACL ni carga masiva pesada en un endpoint. La caché opcional acelera lecturas reconstruibles, con PostgreSQL como fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación. Conserva autoridad de versiones, manifiestos y\npublicación de maestros.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización.",
      "autoResize": true,
      "lineHeight": 1.25
    },
