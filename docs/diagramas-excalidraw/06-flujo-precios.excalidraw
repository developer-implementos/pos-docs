      "link": null,
      "locked": false,
      "text": "Huecos, incompatibilidad o carga incompleta",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Huecos, incompatibilidad o carga incompleta",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3434-1-body",
      "type": "text",
      "x": 1040.6666666666665,
      "y": 3508.25,
      "width": 867.087890625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3434-1"
      ],
      "frameId": null,
      "index": "b0G",
      "roundness": null,
      "seed": 1212918313,
      "version": 2,
      "versionNonce": 567764297,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603452442,
      "link": null,
      "locked": false,
      "text": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
