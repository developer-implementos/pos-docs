    {
      "id": "notes-4572-7-title",
      "type": "text",
      "x": 1040.6666666666665,
      "y": 5080,
      "width": 514.17236328125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
