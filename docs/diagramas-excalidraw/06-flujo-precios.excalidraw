    {
      "id": "notes-4572-6-body",
      "type": "text",
      "x": 86,
      "y": 5132.25,
      "width": 822.9912109375,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-4572-6"
      ],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 1329812362,
      "version": 2,
      "versionNonce": 363225546,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364561525,
      "link": null,
      "locked": false,
      "text": "erp-worker prepara mediante MasterDataSourcePort en la red autorizada del origen;\ncountry-api conserva versiones y confirma su publicación en país. Fuente, interfaz y\nacceso se homologan por país; la preparación tiene identidad, claims y presupuesto\naislados del trabajo financiero.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "erp-worker prepara mediante MasterDataSourcePort en la red autorizada del origen;\ncountry-api conserva versiones y confirma su publicación en país. Fuente, interfaz y\nacceso se homologan por país; la preparación tiene identidad, claims y presupuesto\naislados del trabajo financiero.",
      "autoResize": true,
      "lineHeight": 1.25
    },
