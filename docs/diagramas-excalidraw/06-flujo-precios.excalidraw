      "index": "b0L",
      "roundness": null,
      "seed": 1938719883,
      "version": 2,
      "versionNonce": 1942862795,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793307992533,
      "link": null,
      "locked": false,
      "text": "Frescura y vigencia son límites distintos",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frescura y vigencia son límites distintos",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3598-2-body",
      "type": "text",
      "x": 1995.3333333333333,
      "y": 3671.75,
      "width": 831.509765625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3598-2"
      ],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 905059749,
      "version": 2,
      "versionNonce": 1171585637,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793307992533,
      "link": null,
      "locked": false,
      "text": "El TTL de frescura y la vigencia comercial se validan por separado; ambos deben\ncumplirse. Una carga fallida conserva la versión previa solo mientras siga autorizada.\nRedescargar la misma versión no reinicia plazos. Sin datos válidos se bloquea la\noperación afectada.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El TTL de frescura y la vigencia comercial se validan por separado; ambos deben\ncumplirse. Una carga fallida conserva la versión previa solo mientras siga autorizada.\nRedescargar la misma versión no reinicia plazos. Sin datos válidos se bloquea la\noperación afectada.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3598-3-bg",
