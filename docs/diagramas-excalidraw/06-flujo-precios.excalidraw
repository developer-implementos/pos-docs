      "index": "b08",
      "roundness": null,
      "seed": 1896138409,
      "version": 2,
      "versionNonce": 824119753,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603452442,
      "link": null,
      "locked": false,
      "text": "Las nuevas operaciones usan la versión activa; una venta abierta conserva la versión fijada. Un cambio de política exige resolución explícita, no una sustitución silenciosa.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Las nuevas operaciones usan la versión activa; una venta abierta conserva la versión fijada. Un cambio de política exige resolución explícita, no una sustitución silenciosa.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dynamic-note",
      "type": "text",
      "x": 64,
      "y": 3264,
      "width": 2268.0234375,
      "height": 30,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 596579431,
      "version": 2,
      "versionNonce": 1097501511,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603452442,
      "link": null,
      "locked": false,
      "text": "Secuencia objetivo recomendada, no implementación acreditada. El propietario de cada dato y su contrato se confirman por país. El espejo de sucursal es de lectura y no se convierte en un maestro independiente.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Secuencia objetivo recomendada, no implementación acreditada. El propietario de cada dato y su contrato se confirman por país. El espejo de sucursal es de lectura y no se convierte en un maestro independiente.",
      "autoResize": true,
      "lineHeight": 1.25
    },
