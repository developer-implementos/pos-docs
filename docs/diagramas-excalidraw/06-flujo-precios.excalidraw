      "text": "WAN caída; LAN y servidor disponibles",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WAN caída; LAN y servidor disponibles",
      "autoResize": true,
