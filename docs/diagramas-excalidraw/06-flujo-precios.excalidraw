      "link": null,
      "locked": false,
      "text": "Replay, bajas y restauración",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Replay, bajas y restauración",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3598-5-body",
      "type": "text",
      "x": 1995.3333333333333,
      "y": 3915,
      "width": 826.71875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3598-5"
      ],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1276333483,
      "version": 2,
      "versionNonce": 833092843,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793307992533,
      "link": null,
      "locked": false,
      "text": "La entrega puede repetirse y se deduplica. Tombstones, versiones referenciadas y\nevidencia se retienen durante el horizonte de replay y recuperación para no resucitar\nbajas. Un restore puede retroceder datos y cursores: se concilia con origen antes de\ndeclarar convergencia.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La entrega puede repetirse y se deduplica. Tombstones, versiones referenciadas y\nevidencia se retienen durante el horizonte de replay y recuperación para no resucitar\nbajas. Un restore puede retroceder datos y cursores: se concilia con origen antes de\ndeclarar convergencia.",
      "autoResize": true,
      "lineHeight": 1.25
    },
