      "updated": 1793364561525,
      "link": null,
      "locked": false,
      "text": "La programación durable identifica país, cobertura, zona horaria y ventana. Relay y reconciliación reconstruyen trabajos si falla Redis; no se depende sólo del historial del scheduler.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La programación durable identifica país, cobertura, zona horaria y ventana. Relay y reconciliación reconstruyen trabajos si falla Redis; no se depende sólo del historial del scheduler.",
      "autoResize": true,
      "lineHeight": 1.25
    },
