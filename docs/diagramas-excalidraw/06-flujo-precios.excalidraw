    },
    {
      "id": "notes-3434-0-body",
      "type": "text",
      "x": 86,
      "y": 3508.25,
      "width": 885.349609375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3434-0"
      ],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 1769372892,
      "version": 2,
      "versionNonce": 130840292,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682524544,
      "link": null,
      "locked": false,
      "text": "La inbox y el cursor de recepción permiten reanudar una descarga. Solo el commit de\nactivación confirma inbox aplicada, efecto y cursor aplicado. Deltas y snapshots atraviesan\nel mismo control de publicación; deduplicar no autoriza a activar.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La inbox y el cursor de recepción permiten reanudar una descarga. Solo el commit de\nactivación confirma inbox aplicada, efecto y cursor aplicado. Deltas y snapshots atraviesan\nel mismo control de publicación; deduplicar no autoriza a activar.",
      "autoResize": true,
      "lineHeight": 1.25
    },
