      "width": 930.6666666666666,
      "height": 219.25,
      "angle": 0,
      "strokeColor": "#CCD7E8",
      "backgroundColor": "#F7F9FD",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
