    },
    {
      "id": "notes-3598-4-body",
      "type": "text",
      "x": 1040.6666666666665,
      "y": 3915,
      "width": 853.681640625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3598-4"
      ],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 319346442,
      "version": 2,
      "versionNonce": 1520181386,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310660081,
      "link": null,
      "locked": false,
      "text": "La sucursal cotiza sobre su espejo autorizado mientras datos, permisos y capacidades\nsigan vigentes. Si cae la LAN o el backend se detienen los comandos dependientes; no\naparece otra base ni otro escritor en cada terminal.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La sucursal cotiza sobre su espejo autorizado mientras datos, permisos y capacidades\nsigan vigentes. Si cae la LAN o el backend se detienen los comandos dependientes; no\naparece otra base ni otro escritor en cada terminal.",
      "autoResize": true,
      "lineHeight": 1.25
    },
