    {
      "id": "notes-3598-2-title",
      "type": "text",
      "x": 1995.3333333333333,
      "y": 3619.5,
      "width": 441.83349609375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
