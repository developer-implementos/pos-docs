      "link": null,
      "locked": false,
      "text": "Reconciliación programada y recuperación manual",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reconciliación programada y recuperación manual",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-4572-3-body",
      "type": "text",
      "x": 86,
      "y": 4889,
      "width": 882.943359375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-4572-3"
      ],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 1049012182,
      "version": 2,
      "versionNonce": 514012566,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364561525,
      "link": null,
      "locked": false,
      "text": "La frecuencia de carga completa es configurable. Ambas rutas usan manifiesto, corte\nconsistente, retención de deltas, staging, validación y activación atómica. La reconciliación\ndetecta divergencias sin convertir una sucursal en autora del maestro.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La frecuencia de carga completa es configurable. Ambas rutas usan manifiesto, corte\nconsistente, retención de deltas, staging, validación y activación atómica. La reconciliación\ndetecta divergencias sin convertir una sucursal en autora del maestro.",
      "autoResize": true,
      "lineHeight": 1.25
    },
