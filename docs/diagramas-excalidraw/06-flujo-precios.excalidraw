      "index": "b0L",
      "roundness": null,
      "seed": 510914966,
      "version": 2,
      "versionNonce": 1896824854,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310660081,
      "link": null,
      "locked": false,
      "text": "Frescura y vigencia son límites distintos",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frescura y vigencia son límites distintos",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3598-2-body",
      "type": "text",
      "x": 1995.3333333333333,
      "y": 3671.75,
      "width": 831.509765625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3598-2"
      ],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 674110154,
      "version": 2,
      "versionNonce": 1519711306,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310660081,
      "link": null,
      "locked": false,
      "text": "El TTL de frescura y la vigencia comercial se validan por separado; ambos deben\ncumplirse. Una carga fallida conserva la versión previa solo mientras siga autorizada.\nRedescargar la misma versión no reinicia plazos. Sin datos válidos se bloquea la\noperación afectada.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El TTL de frescura y la vigencia comercial se validan por separado; ambos deben\ncumplirse. Una carga fallida conserva la versión previa solo mientras siga autorizada.\nRedescargar la misma versión no reinicia plazos. Sin datos válidos se bloquea la\noperación afectada.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3598-3-bg",
      "type": "rectangle",
      "x": 64,
      "y": 3840.75,
      "width": 930.6666666666666,
      "height": 219.25,
      "angle": 0,
      "strokeColor": "#CCD7E8",
      "backgroundColor": "#F7F9FD",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3598-3"
      ],
