    {
      "id": "step-12-note",
      "type": "text",
      "x": 64,
      "y": 3171,
      "width": 1515.322265625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
