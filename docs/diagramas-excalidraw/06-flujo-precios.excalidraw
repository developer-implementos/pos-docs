      "isDeleted": false,
      "boundElements": [],
      "updated": 1793307992533,
      "link": null,
      "locked": false,
      "text": "Huecos, incompatibilidad o carga incompleta",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Huecos, incompatibilidad o carga incompleta",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3598-1-body",
      "type": "text",
      "x": 1040.6666666666665,
      "y": 3671.75,
      "width": 867.087890625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3598-1"
      ],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 981483,
      "version": 2,
      "versionNonce": 464787755,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793307992533,
      "link": null,
      "locked": false,
      "text": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
