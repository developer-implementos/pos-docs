    {
      "id": "notes-3385-1-body",
      "type": "text",
      "x": 886.857421875,
      "y": 3459.4500000000003,
      "width": 728.921875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3385-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1932975211,
      "version": 2,
      "versionNonce": 451687525,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793307992286,
      "link": null,
      "locked": false,
      "text": "Son componentes dentro de apps/erp-worker y libs/backend/erp. La\nfachada expresa capacidades POS; la ACL traduce identidades, unidades,\nestados y errores; cada adaptador resuelve el protocolo AX, custom o Gira\nque se homologue.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Son componentes dentro de apps/erp-worker y libs/backend/erp. La\nfachada expresa capacidades POS; la ACL traduce identidades, unidades,\nestados y errores; cada adaptador resuelve el protocolo AX, custom o Gira\nque se homologue.",
      "autoResize": true,
      "lineHeight": 1.25
    },
