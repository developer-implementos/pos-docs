    {
      "id": "notes-3738-6-body",
      "type": "text",
      "x": 86,
      "y": 4876.700000000001,
      "width": 700.26171875,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
