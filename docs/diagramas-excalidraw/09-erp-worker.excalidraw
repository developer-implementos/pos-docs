    {
      "id": "notes-3738-5-body",
      "type": "text",
      "x": 1687.71484375,
      "y": 4385.950000000001,
      "width": 732.48828125,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
