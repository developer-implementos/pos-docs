    {
      "id": "notes-4142-8-body",
      "type": "text",
      "x": 86,
      "y": 5417.4,
      "width": 700.21875,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
