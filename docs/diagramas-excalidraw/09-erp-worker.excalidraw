      "originalText": "Fachada, ACL y adaptador",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3788-1-body",
      "type": "text",
      "x": 1110.406640625,
      "y": 3862.65,
      "width": 901.3447265625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3788-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 98753674,
      "version": 2,
      "versionNonce": 1406264214,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364561391,
      "link": null,
      "locked": false,
      "text": "Son componentes dentro de apps/erp-worker y libs/backend/erp. La fachada expresa\ncapacidades POS; la ACL traduce identidades, unidades, estados y errores; cada adaptador\nresuelve el protocolo AX, custom o Gira que se homologue.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Son componentes dentro de apps/erp-worker y libs/backend/erp. La fachada expresa\ncapacidades POS; la ACL traduce identidades, unidades, estados y errores; cada adaptador\nresuelve el protocolo AX, custom o Gira que se homologue.",
      "autoResize": true,
      "lineHeight": 1.25
    },
