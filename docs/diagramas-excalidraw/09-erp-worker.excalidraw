    {
      "id": "notes-3738-8-body",
      "type": "text",
      "x": 1687.71484375,
      "y": 4876.700000000001,
      "width": 728.79296875,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
