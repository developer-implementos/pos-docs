    {
      "id": "notes-3738-0-body",
      "type": "text",
      "x": 86,
      "y": 3812.7000000000003,
      "width": 731.306640625,
      "height": 440,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3738-0"
      ],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 984602225,
      "version": 2,
      "versionNonce": 1570701567,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292666756,
      "link": null,
      "locked": false,
      "text": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma\ninbox, proyección operativa y outbox en un único commit antes del ACK de\naplicación. Expone trabajo y resultados al erp-worker mediante HTTPS\nsaliente iniciado por ese worker. Valida, publica y sirve versiones\npreparadas mediante MasterDataSourcePort en erp-worker; no ejecuta la\nACL ni carga masiva pesada en un endpoint. La caché opcional acelera\nlecturas reconstruibles, con PostgreSQL como fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y\noutbox juntos antes del ACK de aplicación. Conserva autoridad de\nversiones, manifiestos y publicación de maestros.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída\ngenera atraso de sincronización.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma\ninbox, proyección operativa y outbox en un único commit antes del ACK de\naplicación. Expone trabajo y resultados al erp-worker mediante HTTPS\nsaliente iniciado por ese worker. Valida, publica y sirve versiones\npreparadas mediante MasterDataSourcePort en erp-worker; no ejecuta la\nACL ni carga masiva pesada en un endpoint. La caché opcional acelera\nlecturas reconstruibles, con PostgreSQL como fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y\noutbox juntos antes del ACK de aplicación. Conserva autoridad de\nversiones, manifiestos y publicación de maestros.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída\ngenera atraso de sincronización.",
      "autoResize": true,
      "lineHeight": 1.25
    },
