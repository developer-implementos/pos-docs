    {
      "id": "notes-4142-5-body",
      "type": "text",
      "x": 854.30498046875,
      "y": 4954.15,
      "width": 698.2314453125,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
