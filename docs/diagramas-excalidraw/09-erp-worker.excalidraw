    },
    {
      "id": "notes-4142-10-body",
      "type": "text",
      "x": 1622.6099609375,
      "y": 5417.4,
      "width": 688.509765625,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-4142-10"
      ],
      "frameId": null,
      "index": "ax",
      "roundness": null,
      "seed": 1613680534,
      "version": 2,
      "versionNonce": 522013258,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364561391,
      "link": null,
      "locked": false,
      "text": "Sistema externo · Interfaces por confirmar\n\nCatálogo, impuestos, precios y promociones deben tener responsable,\ncontrato, versión y vigencia. La fuente de precios no se sustituye por\nuna tabla editada libremente en cada caja.\n\nAUTORIDAD · Propietario por dato y país pendiente: no se asigna al\nERP por defecto.\n\nCONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la\npolítica autorizada.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sistema externo · Interfaces por confirmar\n\nCatálogo, impuestos, precios y promociones deben tener responsable,\ncontrato, versión y vigencia. La fuente de precios no se sustituye por\nuna tabla editada libremente en cada caja.\n\nAUTORIDAD · Propietario por dato y país pendiente: no se asigna al\nERP por defecto.\n\nCONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la\npolítica autorizada.",
      "autoResize": true,
      "lineHeight": 1.25
    },
