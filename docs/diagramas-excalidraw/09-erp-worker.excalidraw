      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 1315501654,
      "version": 2,
      "versionNonce": 145792906,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364561391,
      "link": null,
      "locked": false,
      "text": "Persistir identidad de operación y evidencia antes de reintentar. Si el ERP pudo aplicar, consultar\no conciliar; no repetir a ciegas ni prometer exactly-once. country-api conserva trabajo y\nresultados; el worker no abre SQL hacia la base de país.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Persistir identidad de operación y evidencia antes de reintentar. Si el ERP pudo aplicar, consultar\no conciliar; no repetir a ciegas ni prometer exactly-once. country-api conserva trabajo y\nresultados; el worker no abre SQL hacia la base de país.",
      "autoResize": true,
      "lineHeight": 1.25
    },
