    {
      "id": "notes-3385-2-body",
      "type": "text",
      "x": 1687.71484375,
      "y": 3459.4500000000003,
      "width": 720.2421875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
