      ],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 549647141,
      "version": 2,
      "versionNonce": 1310206731,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793307992286,
      "link": null,
      "locked": false,
      "text": "Persistir identidad de operación y evidencia antes de reintentar. Si el ERP\npudo aplicar, consultar o conciliar; no repetir a ciegas ni prometer\nexactly-once. country-api conserva trabajo y resultados; el worker no abre\nSQL hacia la base de país.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Persistir identidad de operación y evidencia antes de reintentar. Si el ERP\npudo aplicar, consultar o conciliar; no repetir a ciegas ni prometer\nexactly-once. country-api conserva trabajo y resultados; el worker no abre\nSQL hacia la base de país.",
      "autoResize": true,
      "lineHeight": 1.25
    },
