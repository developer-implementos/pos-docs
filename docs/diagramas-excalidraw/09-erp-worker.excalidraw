    {
      "id": "notes-3385-2-body",
      "type": "text",
      "x": 1386.205078125,
      "y": 3459.4500000000003,
      "width": 578.4130859375,
      "height": 137.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3385-2"
      ],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 356678492,
      "version": 2,
      "versionNonce": 138295908,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682524296,
      "link": null,
      "locked": false,
      "text": "Persistir identidad de operación y evidencia antes de\nreintentar. Si el ERP pudo aplicar, consultar o conciliar; no\nrepetir a ciegas ni prometer exactly-once. country-api\nconserva trabajo y resultados; el worker no abre SQL hacia\nla base de país.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Persistir identidad de operación y evidencia antes de\nreintentar. Si el ERP pudo aplicar, consultar o conciliar; no\nrepetir a ciegas ni prometer exactly-once. country-api\nconserva trabajo y resultados; el worker no abre SQL hacia\nla base de país.",
      "autoResize": true,
      "lineHeight": 1.25
    },
