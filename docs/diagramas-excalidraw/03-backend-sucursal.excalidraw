    {
      "id": "notes-3569-15-title",
      "type": "text",
      "x": 3277.291894531243,
      "y": 5228.23564453125,
      "width": 279.33349609375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
