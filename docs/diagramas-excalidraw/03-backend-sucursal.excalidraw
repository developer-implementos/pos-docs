      "link": null,
      "locked": false,
      "text": "Pagos y dispositivos",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pagos y dispositivos",
      "autoResize": true,
