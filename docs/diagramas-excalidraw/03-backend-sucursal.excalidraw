      "isDeleted": false,
      "boundElements": [],
      "updated": 1793302315205,
      "link": null,
      "locked": false,
      "text": "La cotización fija versión inmutable y revalida vigencia antes de cobrar. Turno de caja no equivale a sesión de acceso. Devoluciones y compensaciones son\nnuevas operaciones auditables; no reescritura de historia.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La cotización fija versión inmutable y revalida vigencia antes de cobrar. Turno de caja no equivale a sesión de acceso. Devoluciones y compensaciones son\nnuevas operaciones auditables; no reescritura de historia.",
      "autoResize": true,
      "lineHeight": 1.25
    },
