    },
    {
      "id": "notes-2868-2-body",
      "type": "text",
      "x": 3278.5265624999997,
      "y": 2941.78564453125,
      "width": 1519.2890625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
