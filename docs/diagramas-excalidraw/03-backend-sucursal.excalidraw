    {
      "id": "notes-3166-1-body",
      "type": "text",
      "x": 1283.1974609375,
      "y": 3240.03564453125,
      "width": 1120.6357421875,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
