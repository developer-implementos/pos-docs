    {
      "id": "notes-2841-2-body",
      "type": "text",
      "x": 3275.2882812499997,
      "y": 2915.38564453125,
      "width": 1519.2890625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
