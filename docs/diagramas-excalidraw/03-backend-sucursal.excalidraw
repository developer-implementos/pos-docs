    {
      "id": "notes-2881-2-body",
      "type": "text",
      "x": 1717.2718750000001,
      "y": 2955.38564453125,
      "width": 693.4296875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
