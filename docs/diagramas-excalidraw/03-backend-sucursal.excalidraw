    {
      "id": "notes-3234-0-body",
      "type": "text",
      "x": 86,
      "y": 3308.63564453125,
      "width": 747.2158203125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3234-0"
      ],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 285136009,
      "version": 2,
      "versionNonce": 36782791,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603450802,
      "link": null,
      "locked": false,
      "text": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile.\nTauri aloja el bundle de escritorio; hardware, SDK y distribución requieren\nhomologación. Su registro técnico de periféricos no lo convierte en autoridad\nde ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se\ndetienen nuevos comandos dependientes.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile.\nTauri aloja el bundle de escritorio; hardware, SDK y distribución requieren\nhomologación. Su registro técnico de periféricos no lo convierte en autoridad\nde ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se\ndetienen nuevos comandos dependientes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
