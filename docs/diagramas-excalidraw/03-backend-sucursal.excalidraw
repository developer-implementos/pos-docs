    {
      "id": "notes-3139-0-body",
      "type": "text",
      "x": 86,
      "y": 3213.63564453125,
      "width": 1109.517578125,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3139-0"
      ],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 67336890,
      "version": 2,
      "versionNonce": 894410278,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288406466,
      "link": null,
      "locked": false,
      "text": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio;\nhardware, SDK y distribución requieren homologación. Su registro técnico de periféricos no lo convierte en\nautoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio;\nhardware, SDK y distribución requieren homologación. Su registro técnico de periféricos no lo convierte en\nautoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
