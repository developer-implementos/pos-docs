    {
      "id": "notes-3166-3-body",
      "type": "text",
      "x": 3677.5923828124996,
      "y": 3240.03564453125,
      "width": 1105.54296875,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
