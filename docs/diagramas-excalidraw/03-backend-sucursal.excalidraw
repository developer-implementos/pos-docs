      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 1173893833,
      "version": 2,
      "versionNonce": 302938247,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603450802,
      "link": null,
      "locked": false,
      "text": "La cotización fija versión inmutable y revalida vigencia antes de cobrar.\nTurno de caja no equivale a sesión de acceso. Devoluciones y\ncompensaciones son nuevas operaciones auditables; no reescritura de\nhistoria.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La cotización fija versión inmutable y revalida vigencia antes de cobrar.\nTurno de caja no equivale a sesión de acceso. Devoluciones y\ncompensaciones son nuevas operaciones auditables; no reescritura de\nhistoria.",
      "autoResize": true,
      "lineHeight": 1.25
    },
