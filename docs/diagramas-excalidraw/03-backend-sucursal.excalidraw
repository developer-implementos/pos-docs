    {
      "id": "notes-3569-3-body",
      "type": "text",
      "x": 3277.291894531243,
      "y": 3643.23564453125,
      "width": 940.4462890625,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
