      "text": "Caja, cobranzas y anticipos",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caja, cobranzas y anticipos",
      "autoResize": true,
