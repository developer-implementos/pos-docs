    {
      "id": "notes-3139-11-body",
      "type": "text",
      "x": 3670.6973632812496,
      "y": 4002.63564453125,
      "width": 1125.1044921875,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
