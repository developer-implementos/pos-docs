    },
    {
      "id": "03-notes-2881-1-body",
      "type": "text",
      "x": 8915.984765624999,
      "y": 2955.38564453125,
      "width": 739.8896484375,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "03-notes-2881-1"
      ],
      "frameId": "03-frame",
      "index": "b0SH8",
      "roundness": null,
      "seed": 116199431,
      "version": 3,
      "versionNonce": 1062429161,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603461217,
      "link": null,
      "locked": false,
      "text": "Intención de pago durable antes de invocar el proveedor; resultado y\nconfirmación local después. Venta + auditoría + outbox se confirman juntas.\nVenta, pago, fiscalidad y ERP conservan estados separados y recuperación\nexplícita.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Intención de pago durable antes de invocar el proveedor; resultado y\nconfirmación local después. Venta + auditoría + outbox se confirman juntas.\nVenta, pago, fiscalidad y ERP conservan estados separados y recuperación\nexplícita.",
      "autoResize": true,
      "lineHeight": 1.25
    },
