    {
      "id": "07-notes-5195-1-title",
      "type": "text",
      "x": 1159,
      "y": 16284.83564453125,
      "width": 373.828125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-5195-1"
      ],
      "frameId": "07-frame",
      "index": "b0l",
      "roundness": null,
      "seed": 1398038495,
      "version": 2,
      "versionNonce": 313472959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292666926,
      "link": null,
      "locked": false,
      "text": "SDK local es una ruta condicional",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SDK local es una ruta condicional",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-5195-1-body",
      "type": "text",
      "x": 1159,
      "y": 16337.08564453125,
      "width": 980.826171875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-5195-1"
      ],
      "frameId": "07-frame",
      "index": "b0m",
      "roundness": null,
      "seed": 42553745,
      "version": 2,
      "versionNonce": 483420081,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292666926,
      "link": null,
      "locked": false,
      "text": "La vista muestra una API ejecutada desde backend. Si el proveedor exige SDK local homologado, el\ncliente transporta al puente de periféricos el comando original autorizado por backend y retorna\nevidencia. No inventa importe o permiso, ni ejecuta ambas rutas para un mismo intento.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La vista muestra una API ejecutada desde backend. Si el proveedor exige SDK local homologado, el\ncliente transporta al puente de periféricos el comando original autorizado por backend y retorna\nevidencia. No inventa importe o permiso, ni ejecuta ambas rutas para un mismo intento.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-5195-2-bg",
