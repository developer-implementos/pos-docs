    {
      "id": "05-notes-3392-16-body",
      "type": "text",
      "x": 7033.574023437508,
      "y": 10972.88564453125,
      "width": 1406.3779296875,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
