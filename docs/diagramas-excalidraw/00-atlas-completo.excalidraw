    {
      "id": "02-notes-2351-10-title",
      "type": "text",
      "x": 8000.86513671875,
      "y": 3244.725678998418,
      "width": 358.5205078125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
