    {
      "id": "03-notes-3166-3-body",
      "type": "text",
      "x": 15637.251757812499,
      "y": 3240.03564453125,
      "width": 1105.54296875,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
