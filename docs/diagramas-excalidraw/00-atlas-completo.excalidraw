    {
      "id": "08-notes-2922-2-body",
      "type": "text",
      "x": 10688.3349609375,
      "y": 15181.38564453125,
      "width": 1062.6923828125,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
