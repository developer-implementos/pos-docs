    {
      "id": "09-notes-3738-9-body",
      "type": "text",
      "x": 12034.315625,
      "y": 16486.2712890625,
      "width": 729.99609375,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
