      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "Huecos, incompatibilidad o carga incompleta",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Huecos, incompatibilidad o carga incompleta",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "06-notes-4572-1-body",
      "type": "text",
      "x": 17604.225651041666,
      "y": 10327.03564453125,
      "width": 867.087890625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-4572-1"
      ],
      "frameId": "06-frame",
      "index": "b0wnV",
      "roundness": null,
      "seed": 1272903702,
      "version": 3,
      "versionNonce": 1267540106,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
