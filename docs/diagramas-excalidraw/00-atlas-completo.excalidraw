    },
    {
      "id": "09-notes-3738-10-body",
      "type": "text",
      "x": 12846.516796875,
      "y": 16435.78564453125,
      "width": 721.080078125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "09-notes-3738-10"
      ],
      "frameId": "09-frame",
      "index": "b4K",
      "roundness": null,
      "seed": 549605009,
      "version": 3,
      "versionNonce": 1935688753,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292672272,
      "link": null,
      "locked": false,
      "text": "Sistema externo · Interfaces por confirmar\n\nCatálogo, impuestos, precios y promociones deben tener responsable,\ncontrato, versión y vigencia. La fuente de precios no se sustituye por una\ntabla editada libremente en cada caja.\n\nAUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP\npor defecto.\n\nCONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la\npolítica autorizada.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sistema externo · Interfaces por confirmar\n\nCatálogo, impuestos, precios y promociones deben tener responsable,\ncontrato, versión y vigencia. La fuente de precios no se sustituye por una\ntabla editada libremente en cada caja.\n\nAUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP\npor defecto.\n\nCONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la\npolítica autorizada.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "09-footer",
      "type": "text",
      "x": 12023.659375,
      "y": 16832.28564453125,
      "width": 1424.169921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "09-frame",
      "index": "b4L",
      "roundness": null,
      "seed": 2117885695,
      "version": 3,
      "versionNonce": 618271583,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292672272,
      "link": null,
      "locked": false,
      "text": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "09-glossary",
      "type": "text",
      "x": 12023.659375,
      "y": 16898.28564453125,
      "width": 1681.240234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "09-frame",
      "index": "b4M",
      "roundness": null,
      "seed": 1501320305,
      "version": 3,
      "versionNonce": 1007326737,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292672272,
      "link": null,
      "locked": false,
      "text": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "09-sources",
      "type": "text",
      "x": 12023.659375,
      "y": 16967.28564453125,
      "width": 2113.0400390625,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "09-frame",
      "index": "b4N",
      "roundness": null,
      "seed": 1249257247,
      "version": 3,
      "versionNonce": 1344163711,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292672272,
      "link": null,
      "locked": false,
      "text": "FUENTES DEL REPOSITORIO\ndocs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md\nAplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. Backend, datos e integración: diseño por implementar. Nx organiza código y CI.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FUENTES DEL REPOSITORIO\ndocs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md\nAplicaciones completas: frontend Angular alojado por las shells nativas Tauri (escritorio) y Capacitor (móvil). libs/client-shell compone Angular: raíz, configuración, rutas, guards y layout. Backend, datos e integración: diseño por implementar. Nx organiza código y CI.",
      "autoResize": true,
      "lineHeight": 1.25
    },
