      "link": null,
      "locked": false,
      "text": "Huecos, incompatibilidad o carga incompleta",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Huecos, incompatibilidad o carga incompleta",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "06-notes-3598-1-body",
      "type": "text",
      "x": 13000.326041666665,
      "y": 9105.53564453125,
      "width": 867.087890625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-3598-1"
      ],
      "frameId": "06-frame",
      "index": "b0Xr",
      "roundness": null,
      "seed": 197403679,
      "version": 3,
      "versionNonce": 1418936159,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292672272,
      "link": null,
      "locked": false,
      "text": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
