    {
      "id": "03-notes-2841-0-body",
      "type": "text",
      "x": 12036.466015625,
      "y": 2915.38564453125,
      "width": 1455.201171875,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "03-notes-2841-0"
      ],
      "frameId": "03-frame",
      "index": "b0SXl",
      "roundness": null,
      "seed": 1232279290,
      "version": 3,
      "versionNonce": 837454330,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288412717,
      "link": null,
      "locked": false,
      "text": "Los bloques interiores llaman código TypeScript. No hay HTTP ni bases separadas entre módulos. UI valida experiencia; el backend valida permisos,\nintegridad, turno y capacidades antes de mutar negocio.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Los bloques interiores llaman código TypeScript. No hay HTTP ni bases separadas entre módulos. UI valida experiencia; el backend valida permisos,\nintegridad, turno y capacidades antes de mutar negocio.",
      "autoResize": true,
      "lineHeight": 1.25
    },
