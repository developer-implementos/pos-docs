      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788065189,
      "link": null,
      "locked": false,
      "text": "Precios y caja son dominios diferentes",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Precios y caja son dominios diferentes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-notes-2841-2-body",
      "type": "text",
      "x": 15182.469921875,
      "y": 2915.38564453125,
      "width": 1519.2890625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "03-notes-2841-2"
      ],
      "frameId": "03-frame",
      "index": "b0SZ",
      "roundness": null,
      "seed": 1963456875,
      "version": 3,
      "versionNonce": 1387105259,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788065189,
      "link": null,
      "locked": false,
      "text": "La cotización fija versión inmutable y revalida vigencia antes de cobrar. Turno de caja no equivale a sesión de acceso. Devoluciones y compensaciones son\nnuevas operaciones auditables; no reescritura de historia.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La cotización fija versión inmutable y revalida vigencia antes de cobrar. Turno de caja no equivale a sesión de acceso. Devoluciones y compensaciones son\nnuevas operaciones auditables; no reescritura de historia.",
      "autoResize": true,
      "lineHeight": 1.25
    },
