    {
      "id": "08-notes-3249-10-body",
      "type": "text",
      "x": 8510.759375000009,
      "y": 16356.48564453125,
      "width": 660.2685546875,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
