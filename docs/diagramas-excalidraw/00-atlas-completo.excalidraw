    {
      "id": "08-notes-3249-2-body",
      "type": "text",
      "x": 8510.759375000009,
      "y": 15099.98564453125,
      "width": 660.322265625,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
