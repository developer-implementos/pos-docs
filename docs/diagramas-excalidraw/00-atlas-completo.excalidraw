    {
      "id": "03-notes-3139-10-body",
      "type": "text",
      "x": 13778.321679687502,
      "y": 4002.63564453125,
      "width": 1117.3916015625,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
