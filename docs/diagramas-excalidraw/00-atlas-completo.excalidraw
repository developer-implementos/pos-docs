    {
      "id": "07-step-1-note",
      "type": "text",
      "x": 64,
      "y": 13226.63564453125,
      "width": 3430.33203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
