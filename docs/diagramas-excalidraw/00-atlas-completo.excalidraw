    {
      "id": "07-notes-5195-0-title",
      "type": "text",
      "x": 86,
      "y": 16062.5212890625,
      "width": 523.92578125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
