    {
      "id": "04-notes-2557-2-body",
      "type": "text",
      "x": 1701.731640625,
      "y": 8597.0212890625,
      "width": 734.9375,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
