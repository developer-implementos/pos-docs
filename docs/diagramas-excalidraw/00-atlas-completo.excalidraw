      "updated": 1793308002235,
      "link": null,
      "locked": false,
      "text": "Caché opcional y reconstruible",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caché opcional y reconstruible",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "08-notes-2896-1-body",
      "type": "text",
      "x": 8018.364257812508,
      "y": 14746.73564453125,
      "width": 911.1201171875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "08-notes-2896-1"
      ],
      "frameId": "08-frame",
      "index": "b2B",
      "roundness": null,
      "seed": 1490577669,
      "version": 3,
      "versionNonce": 414367365,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793308002235,
      "link": null,
      "locked": false,
      "text": "Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad. Claves por país,\nentidad, versión y alcance de acceso; TTL e invalidación explícitos. Ante fallos, timeout corto\ny fallback limitado evitan saturar la base. Ventas, saldos y mensajes pendientes no dependen\nde esta caché.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad. Claves por país,\nentidad, versión y alcance de acceso; TTL e invalidación explícitos. Ante fallos, timeout corto\ny fallback limitado evitan saturar la base. Ventas, saldos y mensajes pendientes no dependen\nde esta caché.",
      "autoResize": true,
      "lineHeight": 1.25
    },
