    {
      "id": "05-notes-3313-7-body",
      "type": "text",
      "x": 10216.783935546875,
      "y": 9037.53564453125,
      "width": 1226.5966796875,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
