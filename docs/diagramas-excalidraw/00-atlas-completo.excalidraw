    {
      "id": "02-notes-2677-1-body",
      "type": "text",
      "x": 5174.2146484375,
      "y": 2751.6958984375,
      "width": 1004.82421875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
