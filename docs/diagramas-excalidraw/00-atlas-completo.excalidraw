    {
      "id": "03-notes-2868-1-body",
      "type": "text",
      "x": 18265.184374999997,
      "y": 2941.78564453125,
      "width": 1544.6728515625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "03-notes-2868-1"
      ],
      "frameId": "03-frame",
      "index": "b0iK4",
      "roundness": null,
      "seed": 854358486,
      "version": 3,
      "versionNonce": 1751418838,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "Intención de pago durable antes de invocar el proveedor; resultado y confirmación local después. Venta + auditoría + outbox se confirman juntas. Venta, pago,\nfiscalidad y ERP conservan estados separados y recuperación explícita.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Intención de pago durable antes de invocar el proveedor; resultado y confirmación local después. Venta + auditoría + outbox se confirman juntas. Venta, pago,\nfiscalidad y ERP conservan estados separados y recuperación explícita.",
      "autoResize": true,
      "lineHeight": 1.25
    },
