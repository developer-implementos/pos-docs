    {
      "id": "02-notes-2531-0-body",
      "type": "text",
      "x": 7912.553515625,
      "y": 2605.7,
      "width": 990.5263671875,
      "height": 192.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
