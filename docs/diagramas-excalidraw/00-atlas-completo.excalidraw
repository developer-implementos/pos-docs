    {
      "id": "02-notes-2375-0-body",
      "type": "text",
      "x": 8367.7794921875,
      "y": 2449.6000000000004,
      "width": 990.5263671875,
      "height": 192.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
