    },
    {
      "id": "09-notes-3385-0-body",
      "type": "text",
      "x": 11386.355468750002,
      "y": 14332.678955078127,
      "width": 575.953125,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "09-notes-3385-0"
      ],
      "frameId": "09-frame",
      "index": "b3V",
      "roundness": null,
      "seed": 1535016412,
      "version": 3,
      "versionNonce": 1998161380,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682534461,
      "link": null,
      "locked": false,
      "text": "erp-worker solicita trabajo a country-api mediante conexión\nsaliente. El claim con lease, los intentos y el destino\npersistido impiden reasignaciones silenciosas. Un lease\nvencido no demuestra que un efecto externo haya fallado.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "erp-worker solicita trabajo a country-api mediante conexión\nsaliente. El claim con lease, los intentos y el destino\npersistido impiden reasignaciones silenciosas. Un lease\nvencido no demuestra que un efecto externo haya fallado.",
      "autoResize": true,
      "lineHeight": 1.25
    },
