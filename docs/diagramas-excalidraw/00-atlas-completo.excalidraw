    {
      "id": "05-notes-3313-2-title",
      "type": "text",
      "x": 8824.38623046875,
      "y": 8604.53564453125,
      "width": 236.2548828125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
