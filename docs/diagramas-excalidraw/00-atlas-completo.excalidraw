      "updated": 1793302321889,
      "link": null,
      "locked": false,
      "text": "Recibido y aplicado son estados distintos",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recibido y aplicado son estados distintos",
      "autoResize": true,
