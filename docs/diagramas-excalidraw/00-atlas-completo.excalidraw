    {
      "id": "02-notes-2531-14-body",
      "type": "text",
      "x": 11633.8302734375,
      "y": 3940.45,
      "width": 1766.7353515625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
