    {
      "id": "05-notes-3392-1-body",
      "type": "text",
      "x": 10342.224365234375,
      "y": 9147.38564453125,
      "width": 1902.0439453125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
