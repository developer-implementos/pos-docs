    {
      "id": "08-notes-2896-0-body",
      "type": "text",
      "x": 7912.553515625,
      "y": 14692.835644531251,
      "width": 902.494140625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
