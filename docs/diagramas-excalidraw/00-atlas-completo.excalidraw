    {
      "id": "04-notes-2557-1-body",
      "type": "text",
      "x": 893.8658203125,
      "y": 8597.0212890625,
      "width": 694.67578125,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
