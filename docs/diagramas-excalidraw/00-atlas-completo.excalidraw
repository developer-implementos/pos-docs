    {
      "id": "08-notes-2869-1-body",
      "type": "text",
      "x": 7046.0232421875,
      "y": 13876.48564453125,
      "width": 911.1201171875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
