      "text": "API de comandos",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API de comandos",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-notes-3166-3-body",
      "type": "text",
      "x": 19374.26416015625,
      "y": 3240.03564453125,
      "width": 1138.54296875,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "03-notes-3166-3"
      ],
