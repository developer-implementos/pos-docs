        "07-notes-5195-1"
      ],
      "frameId": "07-frame",
      "index": "b0l",
      "roundness": null,
      "seed": 1820654725,
      "version": 2,
      "versionNonce": 913686821,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788056399,
      "link": null,
      "locked": false,
      "text": "SDK local es una ruta condicional",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SDK local es una ruta condicional",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-5195-1-body",
      "type": "text",
      "x": 1159,
      "y": 16114.7712890625,
      "width": 980.826171875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-5195-1"
      ],
      "frameId": "07-frame",
      "index": "b0m",
      "roundness": null,
      "seed": 1203419723,
      "version": 2,
      "versionNonce": 1704857515,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788056399,
      "link": null,
      "locked": false,
      "text": "La vista muestra una API ejecutada desde backend. Si el proveedor exige SDK local homologado, el\ncliente transporta al puente de periféricos el comando original autorizado por backend y retorna\nevidencia. No inventa importe o permiso, ni ejecuta ambas rutas para un mismo intento.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La vista muestra una API ejecutada desde backend. Si el proveedor exige SDK local homologado, el\ncliente transporta al puente de periféricos el comando original autorizado por backend y retorna\nevidencia. No inventa importe o permiso, ni ejecuta ambas rutas para un mismo intento.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-5195-2-bg",
      "type": "rectangle",
      "x": 2210,
