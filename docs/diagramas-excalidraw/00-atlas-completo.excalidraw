      "text": "Precios y caja son dominios diferentes",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Precios y caja son dominios diferentes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-notes-2868-2-body",
      "type": "text",
      "x": 15226.842187499999,
      "y": 2941.78564453125,
      "width": 1519.2890625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
