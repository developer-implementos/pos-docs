    {
      "id": "09-notes-3385-2-body",
      "type": "text",
      "x": 15582.862890625016,
      "y": 15236.335644531251,
      "width": 720.2421875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
