    {
      "id": "02-notes-2233-1-body",
      "type": "text",
      "x": 7812.850976562499,
      "y": 2307.45,
      "width": 1612.9609375,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "02-notes-2233-1"
      ],
      "frameId": "02-frame",
      "index": "b0S4V",
      "roundness": null,
      "seed": 592735309,
      "version": 3,
      "versionNonce": 370597645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793302321889,
      "link": null,
      "locked": false,
      "text": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un ACK no\ncertifica contabilización ERP, aceptación fiscal ni liquidación del pago.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un ACK no\ncertifica contabilización ERP, aceptación fiscal ni liquidación del pago.",
      "autoResize": true,
      "lineHeight": 1.25
    },
