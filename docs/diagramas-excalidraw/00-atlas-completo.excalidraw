      "text": "Receptor de deltas y acuses",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Receptor de deltas y acuses",
      "autoResize": true,
