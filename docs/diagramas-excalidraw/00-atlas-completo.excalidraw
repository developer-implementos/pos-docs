    {
      "id": "05-notes-3339-3-body",
      "type": "text",
      "x": 10262.701953124999,
      "y": 8847.08564453125,
      "width": 1330.4521484375,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
