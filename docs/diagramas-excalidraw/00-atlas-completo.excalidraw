    {
      "id": "03-notes-3166-14-body",
      "type": "text",
      "x": 14428.710546875,
      "y": 4519.78564453125,
      "width": 1120.9794921875,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
