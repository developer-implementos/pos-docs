    {
      "id": "03-notes-3139-14-body",
      "type": "text",
      "x": 14426.2642578125,
      "y": 4438.38564453125,
      "width": 1120.9794921875,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
