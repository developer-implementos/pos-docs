    {
      "id": "09-notes-3738-1-body",
      "type": "text",
      "x": 12846.516796875,
      "y": 14881.03564453125,
      "width": 730.0712890625,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
