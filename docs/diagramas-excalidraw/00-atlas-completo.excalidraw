      "type": "text",
      "x": 4093.1744140624996,
      "y": 3568.1958984375,
      "width": 732.48828125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
