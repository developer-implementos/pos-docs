    {
      "id": "03-notes-2868-0-body",
      "type": "text",
      "x": 16649.558984375,
      "y": 2941.78564453125,
      "width": 1455.201171875,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "03-notes-2868-0"
