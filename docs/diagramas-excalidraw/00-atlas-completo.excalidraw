    {
      "id": "03-notes-3166-11-body",
      "type": "text",
      "x": 15625.908007812499,
      "y": 4084.03564453125,
      "width": 1125.1044921875,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
