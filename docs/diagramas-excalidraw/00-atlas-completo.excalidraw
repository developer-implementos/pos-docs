    {
      "id": "08-notes-2869-0-body",
      "type": "text",
      "x": 6065.8296875,
      "y": 14011.78564453125,
      "width": 902.494140625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "08-notes-2869-0"
      ],
      "frameId": "08-frame",
      "index": "b1V",
      "roundness": null,
      "seed": 2132647999,
      "version": 3,
      "versionNonce": 945698911,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793292672272,
      "link": null,
      "locked": false,
      "text": "country-api confirma inbox, efecto/proyección y outbox en una transacción antes del ACK. El\ntrabajo ERP es durable; su aceptación, ejecución y conciliación conservan estados propios.\nEl ACK de país no acredita el registro en el ERP.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "country-api confirma inbox, efecto/proyección y outbox en una transacción antes del ACK. El\ntrabajo ERP es durable; su aceptación, ejecución y conciliación conservan estados propios.\nEl ACK de país no acredita el registro en el ERP.",
      "autoResize": true,
      "lineHeight": 1.25
    },
