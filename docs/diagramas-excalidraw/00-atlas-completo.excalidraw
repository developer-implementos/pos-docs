    {
      "id": "01-notes-1925-6-body",
      "type": "text",
      "x": 86,
      "y": 2871.2400329589846,
      "width": 566.9619140625,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
