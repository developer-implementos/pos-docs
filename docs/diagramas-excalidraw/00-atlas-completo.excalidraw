    {
      "id": "08-notes-3222-6-body",
      "type": "text",
      "x": 7538.418359374999,
      "y": 14912.98564453125,
      "width": 667.6591796875,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
