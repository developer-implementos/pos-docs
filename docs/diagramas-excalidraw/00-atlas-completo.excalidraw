    },
    {
      "id": "03-notes-3234-12-title",
      "type": "text",
      "x": 8100.348828124999,
      "y": 5081.88564453125,
      "width": 179.248046875,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
