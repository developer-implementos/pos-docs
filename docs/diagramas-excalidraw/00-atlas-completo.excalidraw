      "text": "Pago desconocido o aprobado sin commit local",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pago desconocido o aprobado sin commit local",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-6970-0-body",
      "type": "text",
      "x": 86,
      "y": 18820.63564453125,
      "width": 1353.7734375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-6970-0"
      ],
