      ],
      "frameId": "05-frame",
      "index": "b0Te",
      "roundness": null,
      "seed": 1437333797,
      "version": 3,
      "versionNonce": 1396972811,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788065189,
      "link": null,
      "locked": false,
      "text": "Sistema externo · Contrato por país y modalidad\n\nEmisión, aceptación y transmisión se modelan por separado. No se inventa un proveedor común ni una capacidad de consulta o\nidempotencia no acreditada.\n\nAUTORIDAD · Autoridad y validez tributaria según régimen y proveedor.\n\nCONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se promete universalmente.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sistema externo · Contrato por país y modalidad\n\nEmisión, aceptación y transmisión se modelan por separado. No se inventa un proveedor común ni una capacidad de consulta o\nidempotencia no acreditada.\n\nAUTORIDAD · Autoridad y validez tributaria según régimen y proveedor.\n\nCONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se promete universalmente.",
      "autoResize": true,
      "lineHeight": 1.25
    },
