      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Precios y caja son dominios diferentes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-notes-2868-2-body",
      "type": "text",
      "x": 17212.398828125017,
      "y": 2941.78564453125,
      "width": 1519.2890625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
