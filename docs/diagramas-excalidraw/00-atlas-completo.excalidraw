    {
      "id": "09-notes-3738-4-body",
      "type": "text",
      "x": 12846.516796875,
      "y": 15454.28564453125,
      "width": 726.3974609375,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
