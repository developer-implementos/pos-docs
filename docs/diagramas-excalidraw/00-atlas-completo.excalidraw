    {
      "id": "02-notes-2207-1-body",
      "type": "text",
      "x": 7818.522851562499,
      "y": 2281.05,
      "width": 1612.9609375,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
