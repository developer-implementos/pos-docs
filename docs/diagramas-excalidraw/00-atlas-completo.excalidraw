    {
      "id": "05-notes-3363-5-body",
      "type": "text",
      "x": 7052.722167968751,
      "y": 9115.228955078126,
      "width": 1239.970703125,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
