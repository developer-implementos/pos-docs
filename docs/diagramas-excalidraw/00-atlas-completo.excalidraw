    },
    {
      "id": "06-notes-3434-1-body",
      "type": "text",
      "x": 12341.022135416668,
      "y": 8778.13564453125,
      "width": 867.087890625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-3434-1"
      ],
      "frameId": "06-frame",
      "index": "b0Xp",
      "roundness": null,
      "seed": 1360908900,
      "version": 3,
      "versionNonce": 2098249956,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682534460,
      "link": null,
      "locked": false,
      "text": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bloquean la nueva publicación. Se conserva evidencia, se solicita replay o snapshot y se\nreutiliza staging válido cuando proceda. No se salta un hueco ni se publica una mezcla\nparcial de versiones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
