    },
    {
      "id": "02-notes-2531-14-body",
      "type": "text",
      "x": 10315.361035156262,
      "y": 3967.95,
      "width": 1553.8896484375,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
