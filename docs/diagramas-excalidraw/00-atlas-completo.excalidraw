      "updated": 1792682534460,
      "link": null,
      "locked": false,
      "text": "Reconciliación programada y recuperación manual",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reconciliación programada y recuperación manual",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "06-notes-3434-3-body",
      "type": "text",
      "x": 11386.355468750002,
      "y": 9021.38564453125,
      "width": 882.943359375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-3434-3"
      ],
      "frameId": "06-frame",
      "index": "b0Xt",
      "roundness": null,
      "seed": 1814084836,
      "version": 3,
      "versionNonce": 685521764,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682534460,
      "link": null,
      "locked": false,
      "text": "La frecuencia de carga completa es configurable. Ambas rutas usan manifiesto, corte\nconsistente, retención de deltas, staging, validación y activación atómica. La reconciliación\ndetecta divergencias sin convertir una sucursal en autora del maestro.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La frecuencia de carga completa es configurable. Ambas rutas usan manifiesto, corte\nconsistente, retención de deltas, staging, validación y activación atómica. La reconciliación\ndetecta divergencias sin convertir una sucursal en autora del maestro.",
      "autoResize": true,
      "lineHeight": 1.25
    },
