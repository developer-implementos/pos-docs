    {
      "id": "05-notes-3065-2-body",
      "type": "text",
      "x": 9246.962890625002,
      "y": 8408.728955078126,
      "width": 1610.962890625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
