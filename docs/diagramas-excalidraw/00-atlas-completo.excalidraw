    {
      "id": "03-notes-3166-13-body",
      "type": "text",
      "x": 13242.856835937499,
      "y": 4519.78564453125,
      "width": 1102.599609375,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
