    {
      "id": "05-notes-3365-12-body",
      "type": "text",
      "x": 7912.553515625,
      "y": 10455.73564453125,
      "width": 1638.7744140625,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
