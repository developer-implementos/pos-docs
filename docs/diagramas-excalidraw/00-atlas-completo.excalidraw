    },
    {
      "id": "09-notes-3738-6-body",
      "type": "text",
      "x": 12045.659375,
      "y": 15945.03564453125,
      "width": 700.26171875,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
