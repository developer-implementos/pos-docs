    {
      "id": "02-notes-3031-14-body",
      "type": "text",
      "x": 5714.734765624999,
      "y": 4522.1958984375,
      "width": 734.9482421875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
