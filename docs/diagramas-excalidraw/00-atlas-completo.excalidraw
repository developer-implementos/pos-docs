    },
    {
      "id": "08-notes-2896-2-body",
      "type": "text",
      "x": 9003.154492187508,
      "y": 14746.73564453125,
      "width": 842.5849609375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "08-notes-2896-2"
      ],
      "frameId": "08-frame",
      "index": "b2E",
      "roundness": null,
      "seed": 1181443179,
      "version": 3,
      "versionNonce": 806278891,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793308002235,
      "link": null,
      "locked": false,
      "text": "country-api conserva la autoridad de publicación; erp-worker prepara snapshots/deltas\nmediante MasterDataSourcePort en la red autorizada del origen. La base actual no\nimplementa persistencia, caché ni estos protocolos.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "country-api conserva la autoridad de publicación; erp-worker prepara snapshots/deltas\nmediante MasterDataSourcePort en la red autorizada del origen. La base actual no\nimplementa persistencia, caché ni estos protocolos.",
      "autoResize": true,
      "lineHeight": 1.25
    },
