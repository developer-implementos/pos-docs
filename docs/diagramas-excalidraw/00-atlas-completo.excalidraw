    {
      "id": "05-notes-3392-12-body",
      "type": "text",
      "x": 7033.574023437508,
      "y": 10509.63564453125,
      "width": 1447.982421875,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
