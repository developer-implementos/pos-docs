    {
      "id": "08-notes-2942-0-body",
      "type": "text",
      "x": 5736.177734375001,
      "y": 13889.54497221131,
      "width": 723.958984375,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "08-notes-2942-0"
      ],
      "frameId": "08-frame",
      "index": "b1V",
      "roundness": null,
      "seed": 1053282788,
      "version": 3,
      "versionNonce": 563444964,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682534460,
      "link": null,
      "locked": false,
      "text": "country-api confirma inbox, efecto/proyección y outbox en una transacción\nantes del ACK. El trabajo ERP es durable; su aceptación, ejecución y\nconciliación conservan estados propios. El ACK de país no acredita el\nregistro en el ERP.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "country-api confirma inbox, efecto/proyección y outbox en una transacción\nantes del ACK. El trabajo ERP es durable; su aceptación, ejecución y\nconciliación conservan estados propios. El ACK de país no acredita el\nregistro en el ERP.",
      "autoResize": true,
      "lineHeight": 1.25
    },
