    {
      "id": "09-notes-3738-10-body",
      "type": "text",
      "x": 12837.3234375,
      "y": 16300.48564453125,
      "width": 721.080078125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
