      "text": "Inbox y deduplicación",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inbox y deduplicación",
      "autoResize": true,
