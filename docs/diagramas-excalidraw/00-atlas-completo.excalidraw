    {
      "id": "07-notes-5195-1-title",
      "type": "text",
      "x": 1159,
      "y": 16062.5212890625,
      "width": 373.828125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
