    {
      "id": "03-notes-3139-2-body",
      "type": "text",
      "x": 14385.1478515625,
      "y": 3213.63564453125,
      "width": 1107.9599609375,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
