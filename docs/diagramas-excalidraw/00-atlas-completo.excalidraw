    {
      "id": "02-notes-2050-1-body",
      "type": "text",
      "x": 10481.461132812503,
      "y": 2123.8500000000004,
      "width": 2012.44140625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "02-notes-2050-1"
      ],
      "frameId": "02-frame",
      "index": "b0i28",
      "roundness": null,
      "seed": 650733334,
      "version": 3,
      "versionNonce": 679734614,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un ACK no certifica contabilización ERP, aceptación\nfiscal ni liquidación del pago.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un ACK no certifica contabilización ERP, aceptación\nfiscal ni liquidación del pago.",
      "autoResize": true,
      "lineHeight": 1.25
    },
