    },
    {
      "id": "06-notes-3598-1-body",
      "type": "text",
      "x": 12991.132682291665,
      "y": 9024.13564453125,
      "width": 867.087890625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
