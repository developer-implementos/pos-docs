    {
      "id": "09-notes-3385-1-body",
      "type": "text",
      "x": 12835.173046875,
      "y": 14578.2712890625,
      "width": 728.921875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "09-notes-3385-1"
      ],
      "frameId": "09-frame",
      "index": "b3j",
      "roundness": null,
      "seed": 571967885,
      "version": 3,
      "versionNonce": 1545121965,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793302321889,
      "link": null,
      "locked": false,
      "text": "Son componentes dentro de apps/erp-worker y libs/backend/erp. La\nfachada expresa capacidades POS; la ACL traduce identidades, unidades,\nestados y errores; cada adaptador resuelve el protocolo AX, custom o Gira\nque se homologue.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Son componentes dentro de apps/erp-worker y libs/backend/erp. La\nfachada expresa capacidades POS; la ACL traduce identidades, unidades,\nestados y errores; cada adaptador resuelve el protocolo AX, custom o Gira\nque se homologue.",
      "autoResize": true,
      "lineHeight": 1.25
    },
