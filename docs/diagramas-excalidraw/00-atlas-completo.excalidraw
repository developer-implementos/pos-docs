    {
      "id": "07-notes-3715-0-title",
      "type": "text",
      "x": 86,
      "y": 14777.64013671875,
      "width": 523.92578125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
