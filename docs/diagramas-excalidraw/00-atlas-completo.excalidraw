    {
      "id": "03-notes-3166-8-body",
      "type": "text",
      "x": 12034.315625,
      "y": 4084.03564453125,
      "width": 1109.109375,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
