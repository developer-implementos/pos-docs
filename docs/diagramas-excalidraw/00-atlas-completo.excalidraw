    {
      "id": "03-notes-3234-0-body",
      "type": "text",
      "x": 8100.348828124999,
      "y": 3308.63564453125,
      "width": 747.2158203125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
