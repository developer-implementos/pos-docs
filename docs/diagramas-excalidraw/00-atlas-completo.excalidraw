    {
      "id": "05-notes-3365-11-body",
      "type": "text",
      "x": 10252.776171874999,
      "y": 9717.48564453125,
      "width": 1310.6005859375,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
