      "link": null,
      "locked": false,
      "text": "WAN caída; LAN y servidor disponibles",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WAN caída; LAN y servidor disponibles",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "06-notes-4572-4-body",
      "type": "text",
      "x": 17604.225651041666,
      "y": 10570.28564453125,
      "width": 853.681640625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-4572-4"
      ],
      "frameId": "06-frame",
      "index": "b0ws",
      "roundness": null,
      "seed": 2132756298,
      "version": 3,
      "versionNonce": 1031555606,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "La sucursal cotiza sobre su espejo autorizado mientras datos, permisos y capacidades\nsigan vigentes. Si cae la LAN o el backend se detienen los comandos dependientes; no\naparece otra base ni otro escritor en cada terminal.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La sucursal cotiza sobre su espejo autorizado mientras datos, permisos y capacidades\nsigan vigentes. Si cae la LAN o el backend se detienen los comandos dependientes; no\naparece otra base ni otro escritor en cada terminal.",
      "autoResize": true,
      "lineHeight": 1.25
    },
