    {
      "id": "04-notes-3033-1-body",
      "type": "text",
      "x": 972.5142578124997,
      "y": 8459.7712890625,
      "width": 794.8896484375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "04-notes-3033-1"
      ],
      "frameId": "04-frame",
      "index": "b0T5",
      "roundness": null,
      "seed": 1369180646,
      "version": 3,
      "versionNonce": 856983994,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288412717,
      "link": null,
      "locked": false,
      "text": "Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una candidata\ncompleta aislada; snapshot incorpora cambios posteriores al corte H, incluyendo\nbajas. Toda candidata pasa por validación antes de activar.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inbox y cursor recibidos permiten reanudar descarga. Deltas crean una candidata\ncompleta aislada; snapshot incorpora cambios posteriores al corte H, incluyendo\nbajas. Toda candidata pasa por validación antes de activar.",
      "autoResize": true,
      "lineHeight": 1.25
    },
