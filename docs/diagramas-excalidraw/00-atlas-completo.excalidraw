      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "Reconciliación programada y recuperación manual",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reconciliación programada y recuperación manual",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "06-notes-4572-3-body",
      "type": "text",
      "x": 16649.558984375,
      "y": 10570.28564453125,
      "width": 882.943359375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-4572-3"
      ],
      "frameId": "06-frame",
      "index": "b0wqV",
      "roundness": null,
      "seed": 1049012182,
      "version": 3,
      "versionNonce": 152614090,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "La frecuencia de carga completa es configurable. Ambas rutas usan manifiesto, corte\nconsistente, retención de deltas, staging, validación y activación atómica. La reconciliación\ndetecta divergencias sin convertir una sucursal en autora del maestro.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La frecuencia de carga completa es configurable. Ambas rutas usan manifiesto, corte\nconsistente, retención de deltas, staging, validación y activación atómica. La reconciliación\ndetecta divergencias sin convertir una sucursal en autora del maestro.",
      "autoResize": true,
      "lineHeight": 1.25
    },
