    {
      "id": "09-notes-3738-7-body",
      "type": "text",
      "x": 12835.173046875,
      "y": 15995.5212890625,
      "width": 711.755859375,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
