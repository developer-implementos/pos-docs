    {
      "id": "08-notes-3222-10-body",
      "type": "text",
      "x": 7543.015039062499,
      "y": 15621.53564453125,
      "width": 660.2685546875,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
