    {
      "id": "05-notes-3339-8-title",
      "type": "text",
      "x": 6065.8296875,
      "y": 9638.83564453125,
      "width": 358.5205078125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
