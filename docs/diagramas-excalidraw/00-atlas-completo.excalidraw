    {
      "id": "03-notes-3139-8-body",
      "type": "text",
      "x": 11993.181640625,
      "y": 4002.63564453125,
      "width": 1109.109375,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
