    {
      "id": "03-notes-3139-14-body",
      "type": "text",
      "x": 13778.321679687502,
      "y": 4438.38564453125,
      "width": 1115.318359375,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
