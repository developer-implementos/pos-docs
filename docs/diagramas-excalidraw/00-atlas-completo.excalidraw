    {
      "id": "02-notes-2531-13-body",
      "type": "text",
      "x": 8674.467529296886,
      "y": 3967.95,
      "width": 1538.4853515625,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
