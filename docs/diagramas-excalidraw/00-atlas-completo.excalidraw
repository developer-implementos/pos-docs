      "versionNonce": 2115624284,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682534460,
      "link": null,
      "locked": false,
      "text": "El resultado se registra con transiciones condicionales y deduplicación. ACK de aplicación de la venta, resultado ERP y contabilización definitiva siguen siendo hitos distintos.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El resultado se registra con transiciones condicionales y deduplicación. ACK de aplicación de la venta, resultado ERP y contabilización definitiva siguen siendo hitos distintos.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-dynamic-note",
      "type": "text",
      "x": 64,
      "y": 15897.728955078126,
      "width": 2113.3359375,
      "height": 30,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "07-frame",
      "index": "b0gzG",
      "roundness": null,
      "seed": 479606364,
      "version": 3,
      "versionNonce": 1862415972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682534460,
      "link": null,
      "locked": false,
      "text": "Secuencia objetivo recomendada. Cada flecha es una interacción, no una transacción distribuida. Venta, pago, fiscalidad, entrega a país y resultado ERP conservan identidades y estados separados.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Secuencia objetivo recomendada. Cada flecha es una interacción, no una transacción distribuida. Venta, pago, fiscalidad, entrega a país y resultado ERP conservan identidades y estados separados.",
      "autoResize": true,
      "lineHeight": 1.25
    },
