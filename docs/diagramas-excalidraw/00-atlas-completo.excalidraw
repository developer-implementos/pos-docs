    {
      "id": "04-notes-3086-0-body",
      "type": "text",
      "x": 86,
      "y": 8841.4712890625,
      "width": 812.7861328125,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
