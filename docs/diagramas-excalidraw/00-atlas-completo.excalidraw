      "text": "Ventas y devoluciones",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ventas y devoluciones",
      "autoResize": true,
