    {
      "id": "04-notes-3033-0-body",
      "type": "text",
      "x": 86,
      "y": 8459.7712890625,
      "width": 812.7861328125,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "04-notes-3033-0"
      ],
      "frameId": "04-frame",
      "index": "b0T4G",
      "roundness": null,
      "seed": 1498949114,
      "version": 3,
      "versionNonce": 928770150,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288412717,
      "link": null,
      "locked": false,
      "text": "Calendario y zona horaria IANA, ventanas, límites, backoff y jitter son configuración\nexplícita. Carga masiva programada o manual utiliza el mismo pipeline auditado.\nUna ejecución manual no salta validaciones.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Calendario y zona horaria IANA, ventanas, límites, backoff y jitter son configuración\nexplícita. Carga masiva programada o manual utiliza el mismo pipeline auditado.\nUna ejecución manual no salta validaciones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
