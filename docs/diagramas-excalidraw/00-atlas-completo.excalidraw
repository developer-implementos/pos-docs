    {
      "id": "06-step-13-note",
      "type": "text",
      "x": 13959.148046875016,
      "y": 8933.28564453125,
      "width": 2280.224609375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
