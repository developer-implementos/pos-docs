    {
      "id": "03-notes-3166-3-body",
      "type": "text",
      "x": 15625.908007812499,
      "y": 3240.03564453125,
      "width": 1105.54296875,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
