    {
      "id": "02-notes-2233-1-body",
      "type": "text",
      "x": 10393.4046875,
      "y": 2307.45,
      "width": 2298.6240234375,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "02-notes-2233-1"
      ],
      "frameId": "02-frame",
      "index": "b0i28",
      "roundness": null,
      "seed": 1642234954,
      "version": 3,
      "versionNonce": 70817802,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310674047,
      "link": null,
      "locked": false,
      "text": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un ACK no certifica contabilización ERP, aceptación fiscal ni liquidación del pago.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un ACK no certifica contabilización ERP, aceptación fiscal ni liquidación del pago.",
      "autoResize": true,
      "lineHeight": 1.25
    },
