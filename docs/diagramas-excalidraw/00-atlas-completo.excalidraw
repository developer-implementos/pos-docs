    {
      "id": "07-step-1-note",
      "type": "text",
      "x": 64,
      "y": 12082.33564453125,
      "width": 3147.958984375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
