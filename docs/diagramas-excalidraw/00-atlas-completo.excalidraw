    {
      "id": "03-notes-2881-0-body",
      "type": "text",
      "x": 8100.348828124999,
      "y": 2955.38564453125,
      "width": 700.6806640625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "03-notes-2881-0"
      ],
      "frameId": "03-frame",
      "index": "b0SGt",
      "roundness": null,
      "seed": 219270697,
      "version": 3,
      "versionNonce": 2106923751,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603461217,
      "link": null,
      "locked": false,
      "text": "Los bloques interiores llaman código TypeScript. No hay HTTP ni bases\nseparadas entre módulos. UI valida experiencia; el backend valida\npermisos, integridad, turno y capacidades antes de mutar negocio.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Los bloques interiores llaman código TypeScript. No hay HTTP ni bases\nseparadas entre módulos. UI valida experiencia; el backend valida\npermisos, integridad, turno y capacidades antes de mutar negocio.",
      "autoResize": true,
      "lineHeight": 1.25
    },
