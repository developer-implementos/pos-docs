      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603461217,
      "link": null,
      "locked": false,
      "text": "Precios y caja son dominios diferentes",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Precios y caja son dominios diferentes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-notes-2881-2-body",
      "type": "text",
      "x": 9731.620703125,
      "y": 2955.38564453125,
      "width": 693.4296875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "03-notes-2881-2"
      ],
      "frameId": "03-frame",
      "index": "b0SHO",
      "roundness": null,
      "seed": 1173893833,
      "version": 3,
      "versionNonce": 85233735,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603461217,
      "link": null,
      "locked": false,
      "text": "La cotización fija versión inmutable y revalida vigencia antes de cobrar.\nTurno de caja no equivale a sesión de acceso. Devoluciones y\ncompensaciones son nuevas operaciones auditables; no reescritura de\nhistoria.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La cotización fija versión inmutable y revalida vigencia antes de cobrar.\nTurno de caja no equivale a sesión de acceso. Devoluciones y\ncompensaciones son nuevas operaciones auditables; no reescritura de\nhistoria.",
      "autoResize": true,
      "lineHeight": 1.25
    },
