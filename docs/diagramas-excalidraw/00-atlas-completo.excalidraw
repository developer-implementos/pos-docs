    {
      "id": "07-notes-6970-5-title",
      "type": "text",
      "x": 2942,
      "y": 18984.13564453125,
      "width": 397.42431640625,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
