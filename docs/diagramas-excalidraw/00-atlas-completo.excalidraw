    {
      "id": "09-notes-3738-7-body",
      "type": "text",
      "x": 12837.3234375,
      "y": 15809.73564453125,
      "width": 711.755859375,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
