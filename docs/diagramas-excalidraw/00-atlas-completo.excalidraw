    {
      "id": "01-notes-1898-8-body",
      "type": "text",
      "x": 1529.4706054687501,
      "y": 2926.2400329589846,
      "width": 650.6220703125,
      "height": 385,
      "angle": 0,
      "strokeColor": "#182842",
