    {
      "id": "05-notes-3339-9-title",
      "type": "text",
      "x": 7464.787109375,
      "y": 9638.83564453125,
      "width": 119.47021484375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
