    },
    {
      "id": "06-notes-3434-1-body",
      "type": "text",
      "x": 9055.015494791665,
      "y": 9473.88564453125,
      "width": 867.087890625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-3434-1"
