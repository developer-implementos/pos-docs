    },
    {
      "id": "09-notes-3385-1-body",
      "type": "text",
      "x": 12036.458007812502,
      "y": 14332.678955078127,
      "width": 577.2529296875,
      "height": 137.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "09-notes-3385-1"
      ],
      "frameId": "09-frame",
      "index": "b3Y",
      "roundness": null,
      "seed": 1290305892,
      "version": 3,
      "versionNonce": 2083884764,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682534461,
      "link": null,
      "locked": false,
      "text": "Son componentes dentro de apps/erp-worker y\nlibs/backend/erp. La fachada expresa capacidades POS; la\nACL traduce identidades, unidades, estados y errores;\ncada adaptador resuelve el protocolo AX, custom o Gira\nque se homologue.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Son componentes dentro de apps/erp-worker y\nlibs/backend/erp. La fachada expresa capacidades POS; la\nACL traduce identidades, unidades, estados y errores;\ncada adaptador resuelve el protocolo AX, custom o Gira\nque se homologue.",
      "autoResize": true,
      "lineHeight": 1.25
    },
