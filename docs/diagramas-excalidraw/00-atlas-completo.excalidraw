    {
      "id": "02-notes-1997-1-body",
      "type": "text",
      "x": 7693.719726562499,
      "y": 2071.05,
      "width": 1531.0302734375,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "02-notes-1997-1"
      ],
      "frameId": "02-frame",
      "index": "b0S4V",
      "roundness": null,
      "seed": 478864870,
      "version": 3,
      "versionNonce": 749297766,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288412717,
      "link": null,
      "locked": false,
      "text": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un\nACK no certifica contabilización ERP, aceptación fiscal ni liquidación del pago.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un\nACK no certifica contabilización ERP, aceptación fiscal ni liquidación del pago.",
      "autoResize": true,
      "lineHeight": 1.25
    },
