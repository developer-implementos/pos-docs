    {
      "id": "09-notes-3385-0-body",
      "type": "text",
      "x": 12036.466015625,
      "y": 14392.48564453125,
      "width": 730.060546875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "09-notes-3385-0"
      ],
      "frameId": "09-frame",
      "index": "b3g",
      "roundness": null,
      "seed": 2027248762,
      "version": 3,
      "versionNonce": 1082697402,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288412718,
      "link": null,
      "locked": false,
      "text": "erp-worker solicita trabajo a country-api mediante conexión saliente. El\nclaim con lease, los intentos y el destino persistido impiden reasignaciones\nsilenciosas. Un lease vencido no demuestra que un efecto externo haya\nfallado.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "erp-worker solicita trabajo a country-api mediante conexión saliente. El\nclaim con lease, los intentos y el destino persistido impiden reasignaciones\nsilenciosas. Un lease vencido no demuestra que un efecto externo haya\nfallado.",
      "autoResize": true,
      "lineHeight": 1.25
    },
