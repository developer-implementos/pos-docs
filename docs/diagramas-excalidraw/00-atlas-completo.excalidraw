    {
      "id": "03-notes-3166-11-body",
      "type": "text",
      "x": 17616.305175781265,
      "y": 4166.53564453125,
      "width": 1117.3916015625,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
