      "text": "Respaldo y recuperación",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Respaldo y recuperación",
      "autoResize": true,
