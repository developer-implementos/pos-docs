    {
      "id": "08-notes-2869-0-body",
      "type": "text",
      "x": 6061.2330078125,
      "y": 13876.48564453125,
      "width": 902.494140625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
