      "link": null,
      "locked": false,
      "text": "Publicación atómica, sin bloqueo prolongado",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Publicación atómica, sin bloqueo prolongado",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-notes-3060-2-body",
      "type": "text",
      "x": 1859.0285156249995,
      "y": 8732.5712890625,
      "width": 817.4697265625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "04-notes-3060-2"
      ],
      "frameId": "04-frame",
      "index": "b0b5G",
      "roundness": null,
      "seed": 288170533,
      "version": 3,
      "versionNonce": 1225235595,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793308002235,
      "link": null,
      "locked": false,
      "text": "Descarga, checksum, referencias, cobertura, compatibilidad y vigencia se validan\nfuera del commit final. Una transacción corta cambia inbox aplicada + puntero\nactivo + cursor aplicado. Impedir regresión por snapshots lentos y retener versiones\nreferenciadas.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Descarga, checksum, referencias, cobertura, compatibilidad y vigencia se validan\nfuera del commit final. Una transacción corta cambia inbox aplicada + puntero\nactivo + cursor aplicado. Impedir regresión por snapshots lentos y retener versiones\nreferenciadas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
