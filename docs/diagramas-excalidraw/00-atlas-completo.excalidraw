    {
      "id": "03-notes-3139-14-title",
      "type": "text",
      "x": 14385.1478515625,
      "y": 4386.13564453125,
      "width": 179.248046875,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
