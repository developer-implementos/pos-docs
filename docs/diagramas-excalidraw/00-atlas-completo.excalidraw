    {
      "id": "09-notes-3738-8-body",
      "type": "text",
      "x": 13647.37421875,
      "y": 15945.03564453125,
      "width": 728.79296875,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
