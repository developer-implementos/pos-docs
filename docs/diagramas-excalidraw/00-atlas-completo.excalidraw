      "text": "Caché opcional y reconstruible",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caché opcional y reconstruible",
      "autoResize": true,
