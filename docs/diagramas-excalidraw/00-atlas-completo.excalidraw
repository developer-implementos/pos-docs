      "type": "text",
      "x": 16950.82607421875,
      "y": 4221.53564453125,
      "width": 1109.109375,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
