    {
      "id": "01-notes-1925-7-body",
      "type": "text",
      "x": 726.970703125,
      "y": 2871.2400329589846,
      "width": 560.763671875,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
