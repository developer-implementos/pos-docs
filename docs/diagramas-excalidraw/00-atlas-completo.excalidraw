      "locked": false,
      "text": "Caché y capacidades condicionales",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caché y capacidades condicionales",
      "autoResize": true,
