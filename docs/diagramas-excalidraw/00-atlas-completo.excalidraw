    {
      "id": "08-notes-2869-2-body",
      "type": "text",
      "x": 8035.41015625,
      "y": 14011.78564453125,
      "width": 904.921875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
