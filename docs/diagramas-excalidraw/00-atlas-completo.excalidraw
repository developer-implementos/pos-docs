    {
      "id": "07-notes-5195-1-title",
      "type": "text",
      "x": 1159,
      "y": 16335.3212890625,
      "width": 373.828125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
