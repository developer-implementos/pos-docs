    {
      "id": "08-notes-3222-11-title",
      "type": "text",
      "x": 8277.01103515625,
      "y": 15433.98564453125,
      "width": 358.5205078125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
