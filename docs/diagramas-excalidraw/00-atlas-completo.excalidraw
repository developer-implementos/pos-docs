      "updated": 1793288412717,
      "link": null,
      "locked": false,
      "text": "Reconciliación programada y recuperación manual",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reconciliación programada y recuperación manual",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "06-notes-3598-3-body",
      "type": "text",
      "x": 12036.466015625,
      "y": 9267.38564453125,
      "width": 882.943359375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-3598-3"
      ],
      "frameId": "06-frame",
      "index": "b0Xv",
      "roundness": null,
      "seed": 1459085350,
      "version": 3,
      "versionNonce": 1439982758,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793288412717,
      "link": null,
      "locked": false,
      "text": "La frecuencia de carga completa es configurable. Ambas rutas usan manifiesto, corte\nconsistente, retención de deltas, staging, validación y activación atómica. La reconciliación\ndetecta divergencias sin convertir una sucursal en autora del maestro.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La frecuencia de carga completa es configurable. Ambas rutas usan manifiesto, corte\nconsistente, retención de deltas, staging, validación y activación atómica. La reconciliación\ndetecta divergencias sin convertir una sucursal en autora del maestro.",
      "autoResize": true,
      "lineHeight": 1.25
    },
