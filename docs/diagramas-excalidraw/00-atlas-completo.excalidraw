    {
      "id": "07-notes-3715-3-title",
      "type": "text",
      "x": 86,
      "y": 15020.89013671875,
      "width": 346.4599609375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
