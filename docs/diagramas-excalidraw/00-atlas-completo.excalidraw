      "version": 3,
      "versionNonce": 103895269,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793308002235,
      "link": null,
      "locked": false,
      "text": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-glossary",
      "type": "text",
      "x": 64,
      "y": 11052.3212890625,
      "width": 1681.240234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "04-frame",
      "index": "b0bBV",
      "roundness": null,
      "seed": 1082595525,
      "version": 3,
      "versionNonce": 754211819,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793308002235,
      "link": null,
      "locked": false,
      "text": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-sources",
      "type": "text",
      "x": 64,
      "y": 11121.3212890625,
      "width": 2635.3564453125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
