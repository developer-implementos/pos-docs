    {
      "id": "05-notes-3041-1-body",
      "type": "text",
      "x": 7931.10625,
      "y": 8548.83564453125,
      "width": 1756.0576171875,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
