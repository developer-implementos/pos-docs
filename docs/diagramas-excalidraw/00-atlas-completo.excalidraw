    {
      "id": "06-step-2-note",
      "type": "text",
      "x": 8078.348828124999,
      "y": 7180.13564453125,
      "width": 1973.28125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "06-frame",
