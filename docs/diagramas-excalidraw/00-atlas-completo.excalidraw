    {
      "id": "02-notes-2531-17-title",
      "type": "text",
      "x": 9773.19189453125,
      "y": 4323.95,
      "width": 261.21826171875,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
