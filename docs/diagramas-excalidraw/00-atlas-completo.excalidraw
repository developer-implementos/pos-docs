    {
      "id": "07-notes-5195-3-title",
      "type": "text",
      "x": 86,
      "y": 16365.28564453125,
      "width": 346.4599609375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
