    {
      "id": "05-notes-3363-9-title",
      "type": "text",
      "x": 7052.722167968751,
      "y": 9526.228955078126,
      "width": 358.5205078125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
