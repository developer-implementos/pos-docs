    {
      "id": "07-notes-5195-5-title",
      "type": "text",
      "x": 2232,
      "y": 16365.28564453125,
      "width": 397.42431640625,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
