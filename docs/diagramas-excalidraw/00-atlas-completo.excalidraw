      "seed": 845840037,
      "version": 3,
      "versionNonce": 777545317,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788065189,
      "link": null,
      "locked": false,
      "text": "Frescura y vigencia son límites distintos",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frescura y vigencia son límites distintos",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "06-notes-3598-2-body",
      "type": "text",
      "x": 13902.514973958334,
      "y": 8941.63564453125,
      "width": 831.509765625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-3598-2"
      ],
      "frameId": "06-frame",
      "index": "b0Xt",
      "roundness": null,
      "seed": 1585310251,
      "version": 3,
      "versionNonce": 1318280811,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788065189,
      "link": null,
      "locked": false,
      "text": "El TTL de frescura y la vigencia comercial se validan por separado; ambos deben\ncumplirse. Una carga fallida conserva la versión previa solo mientras siga autorizada.\nRedescargar la misma versión no reinicia plazos. Sin datos válidos se bloquea la\noperación afectada.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El TTL de frescura y la vigencia comercial se validan por separado; ambos deben\ncumplirse. Una carga fallida conserva la versión previa solo mientras siga autorizada.\nRedescargar la misma versión no reinicia plazos. Sin datos válidos se bloquea la\noperación afectada.",
      "autoResize": true,
      "lineHeight": 1.25
    },
