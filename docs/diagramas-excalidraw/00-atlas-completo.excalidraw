    {
      "id": "08-notes-2942-1-body",
      "type": "text",
      "x": 6538.0613281250035,
      "y": 13889.54497221131,
      "width": 717.9541015625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
