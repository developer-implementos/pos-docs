    {
      "id": "02-notes-2351-9-body",
      "type": "text",
      "x": 6868.521435546876,
      "y": 3296.975678998418,
      "width": 1057.353515625,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
