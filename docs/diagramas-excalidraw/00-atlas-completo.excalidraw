      "text": "Entrega durable y ACK de aplicación",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Entrega durable y ACK de aplicación",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "02-notes-2053-1-body",
      "type": "text",
      "x": 7245.969335937501,
      "y": 2127.225678998418,
      "width": 1383.0673828125,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "02-notes-2053-1"
      ],
      "frameId": "02-frame",
      "index": "b0S4V",
      "roundness": null,
      "seed": 1969522532,
      "version": 3,
      "versionNonce": 2054803676,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682534459,
      "link": null,
      "locked": false,
      "text": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta\nresultados. Un ACK no certifica contabilización ERP, aceptación fiscal ni liquidación del pago.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta\nresultados. Un ACK no certifica contabilización ERP, aceptación fiscal ni liquidación del pago.",
      "autoResize": true,
      "lineHeight": 1.25
    },
