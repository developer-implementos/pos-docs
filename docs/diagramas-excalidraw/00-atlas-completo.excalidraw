    {
      "id": "08-notes-3222-4-body",
      "type": "text",
      "x": 6061.2330078125,
      "y": 14912.98564453125,
      "width": 668.916015625,
      "height": 440,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
