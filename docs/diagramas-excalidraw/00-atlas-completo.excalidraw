    {
      "id": "02-notes-2050-0-body",
      "type": "text",
      "x": 8367.7794921875,
      "y": 2123.8500000000004,
      "width": 1963.7041015625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "02-notes-2050-0"
      ],
      "frameId": "02-frame",
      "index": "b0i1t",
      "roundness": null,
      "seed": 999860170,
      "version": 3,
      "versionNonce": 634459530,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "Siete aplicaciones objetivo tienen nombre en apps/: seis cuentan con base técnica o scaffold; device-agent es propuesta aún no implementada. PostgreSQL de sucursal conserva negocio y espejo; país\nconserva integración. SQLite es el journal técnico privado del agente.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Siete aplicaciones objetivo tienen nombre en apps/: seis cuentan con base técnica o scaffold; device-agent es propuesta aún no implementada. PostgreSQL de sucursal conserva negocio y espejo; país\nconserva integración. SQLite es el journal técnico privado del agente.",
      "autoResize": true,
      "lineHeight": 1.25
    },
