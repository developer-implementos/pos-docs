      "text": "Resultado incierto y conciliación",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Resultado incierto y conciliación",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "09-notes-3385-2-body",
      "type": "text",
      "x": 12686.560546875002,
      "y": 14332.678955078127,
      "width": 578.4130859375,
      "height": 137.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "09-notes-3385-2"
      ],
      "frameId": "09-frame",
      "index": "b3b",
      "roundness": null,
      "seed": 356678492,
      "version": 3,
      "versionNonce": 1165959268,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682534461,
      "link": null,
      "locked": false,
      "text": "Persistir identidad de operación y evidencia antes de\nreintentar. Si el ERP pudo aplicar, consultar o conciliar; no\nrepetir a ciegas ni prometer exactly-once. country-api\nconserva trabajo y resultados; el worker no abre SQL hacia\nla base de país.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Persistir identidad de operación y evidencia antes de\nreintentar. Si el ERP pudo aplicar, consultar o conciliar; no\nrepetir a ciegas ni prometer exactly-once. country-api\nconserva trabajo y resultados; el worker no abre SQL hacia\nla base de país.",
      "autoResize": true,
      "lineHeight": 1.25
    },
