    {
      "id": "07-notes-3715-5-title",
      "type": "text",
      "x": 1758.6666666666667,
      "y": 15020.89013671875,
      "width": 397.42431640625,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-3715-5"
      ],
      "frameId": "07-frame",
      "index": "b0dv",
