    {
      "id": "02-notes-2295-8-body",
      "type": "text",
      "x": 6039.5908203125,
      "y": 3240.8,
      "width": 1143.4521484375,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
