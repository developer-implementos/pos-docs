    {
      "id": "02-notes-1997-0-body",
      "type": "text",
      "x": 6039.5908203125,
      "y": 2071.05,
      "width": 1506.6025390625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
