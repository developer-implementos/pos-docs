    {
      "id": "08-notes-3295-5-body",
      "type": "text",
      "x": 7339.944921875007,
      "y": 14816.04497221131,
      "width": 711.60546875,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
