      "y": 10274.78564453125,
      "width": 441.83349609375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-4572-2"
      ],
      "frameId": "06-frame",
      "index": "b0woV",
      "roundness": null,
      "seed": 1421051222,
      "version": 3,
      "versionNonce": 2062319434,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "Frescura y vigencia son límites distintos",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frescura y vigencia son límites distintos",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "06-notes-4572-2-body",
      "type": "text",
      "x": 18558.89231770833,
      "y": 10327.03564453125,
      "width": 831.509765625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "06-notes-4572-2"
      ],
      "frameId": "06-frame",
      "index": "b0wp",
      "roundness": null,
      "seed": 640852746,
      "version": 3,
      "versionNonce": 1469411926,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364567474,
      "link": null,
      "locked": false,
      "text": "El TTL de frescura y la vigencia comercial se validan por separado; ambos deben\ncumplirse. Una carga fallida conserva la versión previa solo mientras siga autorizada.\nRedescargar la misma versión no reinicia plazos. Sin datos válidos se bloquea la\noperación afectada.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El TTL de frescura y la vigencia comercial se validan por separado; ambos deben\ncumplirse. Una carga fallida conserva la versión previa solo mientras siga autorizada.\nRedescargar la misma versión no reinicia plazos. Sin datos válidos se bloquea la\noperación afectada.",
      "autoResize": true,
      "lineHeight": 1.25
    },
