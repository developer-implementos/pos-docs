    {
      "id": "03-notes-3166-2-body",
      "type": "text",
      "x": 14428.710546875,
      "y": 3240.03564453125,
      "width": 1107.9599609375,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
