      "link": null,
      "locked": false,
      "text": "Aplicaciones, procesos y propiedad",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aplicaciones, procesos y propiedad",
