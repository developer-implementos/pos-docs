      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310674048,
      "link": null,
      "locked": false,
      "text": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-glossary",
      "type": "text",
      "x": 15717.10703125,
      "y": 5284.78564453125,
      "width": 1681.240234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "03-frame",
      "index": "b0iOG",
      "roundness": null,
      "seed": 1344089866,
      "version": 3,
      "versionNonce": 1071744458,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793310674048,
      "link": null,
      "locked": false,
      "text": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-sources",
      "type": "text",
      "x": 15717.10703125,
      "y": 5353.78564453125,
      "width": 3583.8896484375,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "03-frame",
      "index": "b0iOK",
