      "text": "Redis · trabajos de país",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis · trabajos de país",
      "autoResize": true,
