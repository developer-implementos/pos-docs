    {
      "id": "05-notes-3067-1-body",
      "type": "text",
      "x": 7923.54375,
      "y": 8575.23564453125,
      "width": 1756.0576171875,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
