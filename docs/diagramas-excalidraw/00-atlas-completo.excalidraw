    {
      "id": "08-notes-3222-2-body",
      "type": "text",
      "x": 7543.015039062499,
      "y": 14365.03564453125,
      "width": 660.322265625,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
