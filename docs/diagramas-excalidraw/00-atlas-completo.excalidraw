    {
      "id": "05-notes-3392-9-body",
      "type": "text",
      "x": 10342.224365234375,
      "y": 10046.38564453125,
      "width": 1875.9619140625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
