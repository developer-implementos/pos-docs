      "id": "notes-3295-4-body",
      "type": "text",
      "x": 887.8835937500029,
      "y": 3942.816017133184,
      "width": 733.669921875,
      "height": 412.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
