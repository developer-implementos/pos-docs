    {
      "id": "notes-3248-8-body",
      "type": "text",
      "x": 86,
      "y": 4633.5,
      "width": 791.18359375,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3248-8"
