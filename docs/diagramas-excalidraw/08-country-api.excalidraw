    {
      "id": "notes-2922-1-body",
      "type": "text",
      "x": 1246.277734375,
      "y": 2996.25,
      "width": 1067.5263671875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2922-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1619995670,
      "version": 2,
      "versionNonce": 1165859094,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364561211,
      "link": null,
      "locked": false,
      "text": "Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad. Claves por país, entidad, versión y\nalcance de acceso; TTL e invalidación explícitos. Ante fallos, timeout corto y fallback limitado evitan saturar la\nbase. Ventas, saldos y mensajes pendientes no dependen de esta caché.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad. Claves por país, entidad, versión y\nalcance de acceso; TTL e invalidación explícitos. Ante fallos, timeout corto y fallback limitado evitan saturar la\nbase. Ventas, saldos y mensajes pendientes no dependen de esta caché.",
      "autoResize": true,
      "lineHeight": 1.25
    },
