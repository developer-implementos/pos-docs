      "seed": 443131501,
      "version": 2,
      "versionNonce": 1930747085,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793302315679,
      "link": null,
      "locked": false,
      "text": "country-api confirma inbox, efecto/proyección y outbox en una transacción antes del ACK. El\ntrabajo ERP es durable; su aceptación, ejecución y conciliación conservan estados propios.\nEl ACK de país no acredita el registro en el ERP.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "country-api confirma inbox, efecto/proyección y outbox en una transacción antes del ACK. El\ntrabajo ERP es durable; su aceptación, ejecución y conciliación conservan estados propios.\nEl ACK de país no acredita el registro en el ERP.",
      "autoResize": true,
      "lineHeight": 1.25
    },
