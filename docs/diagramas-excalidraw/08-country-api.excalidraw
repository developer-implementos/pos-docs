    {
      "id": "notes-3295-9-body",
      "type": "text",
      "x": 86,
      "y": 5034.316017133184,
      "width": 723.9482421875,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
