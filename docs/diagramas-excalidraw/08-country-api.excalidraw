      "seed": 1053282788,
      "version": 2,
      "versionNonce": 604297692,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682523901,
      "link": null,
      "locked": false,
      "text": "country-api confirma inbox, efecto/proyección y outbox en una transacción\nantes del ACK. El trabajo ERP es durable; su aceptación, ejecución y\nconciliación conservan estados propios. El ACK de país no acredita el\nregistro en el ERP.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "country-api confirma inbox, efecto/proyección y outbox en una transacción\nantes del ACK. El trabajo ERP es durable; su aceptación, ejecución y\nconciliación conservan estados propios. El ACK de país no acredita el\nregistro en el ERP.",
      "autoResize": true,
      "lineHeight": 1.25
    },
