    {
      "id": "notes-3248-5-body",
      "type": "text",
      "x": 956.2083007812499,
      "y": 4087.75,
      "width": 742.1884765625,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
