    },
    {
      "id": "notes-2896-1-body",
      "type": "text",
      "x": 1070.7902343750002,
      "y": 2969.85,
      "width": 911.1201171875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2896-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 2065673859,
      "version": 2,
      "versionNonce": 479500835,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793302315679,
      "link": null,
      "locked": false,
      "text": "Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad. Claves por país,\nentidad, versión y alcance de acceso; TTL e invalidación explícitos. Ante fallos, timeout corto\ny fallback limitado evitan saturar la base. Ventas, saldos y mensajes pendientes no dependen\nde esta caché.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad. Claves por país,\nentidad, versión y alcance de acceso; TTL e invalidación explícitos. Ante fallos, timeout corto\ny fallback limitado evitan saturar la base. Ventas, saldos y mensajes pendientes no dependen\nde esta caché.",
      "autoResize": true,
      "lineHeight": 1.25
    },
