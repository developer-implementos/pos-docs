    {
      "id": "notes-2942-1-body",
      "type": "text",
      "x": 887.8835937500029,
      "y": 3016.316017133184,
      "width": 717.9541015625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2942-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1890812636,
      "version": 2,
      "versionNonce": 171533668,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682523901,
      "link": null,
      "locked": false,
      "text": "Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad.\nClaves por país, entidad, versión y alcance de acceso; TTL e invalidación\nexplícitos. Ante fallos, timeout corto y fallback limitado evitan saturar la\nbase. Ventas, saldos y mensajes pendientes no dependen de esta caché.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis sirve lecturas de country-api; PostgreSQL conserva la autoridad.\nClaves por país, entidad, versión y alcance de acceso; TTL e invalidación\nexplícitos. Ante fallos, timeout corto y fallback limitado evitan saturar la\nbase. Ventas, saldos y mensajes pendientes no dependen de esta caché.",
      "autoResize": true,
      "lineHeight": 1.25
    },
