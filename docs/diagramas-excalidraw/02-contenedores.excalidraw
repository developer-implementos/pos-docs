    {
      "id": "notes-3031-1-body",
      "type": "text",
      "x": 896.78017578125,
      "y": 3104.9458984375,
      "width": 721.4990234375,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
