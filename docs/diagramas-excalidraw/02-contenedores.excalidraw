      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 1274451292,
      "version": 2,
      "versionNonce": 261817564,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682522578,
      "link": null,
      "locked": false,
      "text": "Redis de país es opcional y reconstruible para country-api; no reemplaza PostgreSQL ni el espejo local. El puente de periféricos depende del SDK\nhomologado y ejecuta comandos autorizados. Ninguna de estas piezas crea otra autoridad de ventas.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis de país es opcional y reconstruible para country-api; no reemplaza PostgreSQL ni el espejo local. El puente de periféricos depende del SDK\nhomologado y ejecuta comandos autorizados. Ninguna de estas piezas crea otra autoridad de ventas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
