    {
      "id": "notes-2375-7-body",
      "type": "text",
      "x": 4841.783691406256,
      "y": 2967.8500000000004,
      "width": 1478.4365234375,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2375-7"
      ],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 1712990358,
      "version": 2,
      "versionNonce": 1212185814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364560279,
      "link": null,
      "locked": false,
      "text": "Contenedor · NestJS / Node.js · sin servidor HTTP\n\napps/branch-sync-worker compone libs/backend/sync con pricing/catalog para preparar y activar versiones. Entrega outbox por HTTPS con identidad y\ncursor; confirma acuses durables. El proceso supervisado sigue activo aunque el cliente se cierre. Descarga, staging, validación y activación conservan\nlímites transaccionales. No requiere Redis ni BullMQ por sucursal: el control de pendientes, calendario, cursores y activación utiliza PostgreSQL local y\nHTTPS.\n\nAUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de maestros, nunca venta libremente.\n\nCONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita reintentos y trabajo en curso.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · NestJS / Node.js · sin servidor HTTP\n\napps/branch-sync-worker compone libs/backend/sync con pricing/catalog para preparar y activar versiones. Entrega outbox por HTTPS con identidad y\ncursor; confirma acuses durables. El proceso supervisado sigue activo aunque el cliente se cierre. Descarga, staging, validación y activación conservan\nlímites transaccionales. No requiere Redis ni BullMQ por sucursal: el control de pendientes, calendario, cursores y activación utiliza PostgreSQL local y\nHTTPS.\n\nAUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de maestros, nunca venta libremente.\n\nCONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita reintentos y trabajo en curso.",
      "autoResize": true,
      "lineHeight": 1.25
    },
