    },
    {
      "id": "notes-2351-2-body",
      "type": "text",
      "x": 2350.6874023437495,
      "y": 2425.475678998418,
      "width": 1057.7294921875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2351-2"
      ],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 367115228,
      "version": 2,
      "versionNonce": 122714972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682522578,
      "link": null,
      "locked": false,
      "text": "Contenedor · Angular + Capacitor\n\npos-mobile tiene arranque y bundle propios, compuestos con client-shell. Los adaptadores actuales son\nmock. Instalación, ciclo de vida, almacenamiento y capacidades nativas requieren pruebas Android/iOS; no\nhay acceso SQL ni permisos implícitos por empaquetar la interfaz.\n\nAUTORIDAD · Comparte interfaz y contratos; no otra autoridad de ventas.\n\nCONTINUIDAD · Requiere conexión autorizada al backend de sucursal. El móvil no incorpora autonomía sin\nLAN.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · Angular + Capacitor\n\npos-mobile tiene arranque y bundle propios, compuestos con client-shell. Los adaptadores actuales son\nmock. Instalación, ciclo de vida, almacenamiento y capacidades nativas requieren pruebas Android/iOS; no\nhay acceso SQL ni permisos implícitos por empaquetar la interfaz.\n\nAUTORIDAD · Comparte interfaz y contratos; no otra autoridad de ventas.\n\nCONTINUIDAD · Requiere conexión autorizada al backend de sucursal. El móvil no incorpora autonomía sin\nLAN.",
      "autoResize": true,
      "lineHeight": 1.25
    },
