    {
      "id": "notes-3031-2-body",
      "type": "text",
      "x": 1707.5603515625,
      "y": 3104.9458984375,
      "width": 730.103515625,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
