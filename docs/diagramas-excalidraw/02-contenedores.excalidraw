    {
      "id": "notes-2531-9-title",
      "type": "text",
      "x": 1400.5198730468749,
      "y": 3424.95,
      "width": 358.5205078125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
