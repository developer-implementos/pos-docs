      "text": "Proveedor de pagos",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proveedor de pagos",
      "autoResize": true,
