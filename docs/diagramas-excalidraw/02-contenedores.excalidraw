      "groupIds": [
        "notes-3031-1"
      ],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1108674215,
      "version": 2,
      "versionNonce": 1173113257,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603450200,
      "link": null,
      "locked": false,
      "text": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile.\nTauri aloja el bundle de escritorio; hardware, SDK y distribución requieren\nhomologación. Su registro técnico de periféricos no lo convierte en\nautoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se\ndetienen nuevos comandos dependientes.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile.\nTauri aloja el bundle de escritorio; hardware, SDK y distribución requieren\nhomologación. Su registro técnico de periféricos no lo convierte en\nautoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se\ndetienen nuevos comandos dependientes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
