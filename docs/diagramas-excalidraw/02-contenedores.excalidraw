    {
      "id": "notes-2677-1-body",
      "type": "text",
      "x": 1167.040234375,
      "y": 2751.6958984375,
      "width": 1004.82421875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2677-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 857197319,
      "version": 2,
      "versionNonce": 733804361,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603450200,
      "link": null,
      "locked": false,
      "text": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. Workers procesan\ndespués la outbox confirmada. Un ACK no certifica contabilización ERP, aceptación fiscal ni liquidación\ndel pago.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. Workers procesan\ndespués la outbox confirmada. Un ACK no certifica contabilización ERP, aceptación fiscal ni liquidación\ndel pago.",
      "autoResize": true,
      "lineHeight": 1.25
    },
