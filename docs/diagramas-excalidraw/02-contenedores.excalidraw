    },
    {
      "id": "notes-2233-2-body",
      "type": "text",
      "x": 4461.716015625006,
      "y": 2307.45,
      "width": 2113.1494140625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
