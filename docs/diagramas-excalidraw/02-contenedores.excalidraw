    {
      "id": "notes-2050-2-body",
      "type": "text",
      "x": 4313.3632812500055,
      "y": 2123.8500000000004,
      "width": 2028.404296875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
