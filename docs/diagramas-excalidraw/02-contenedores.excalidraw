    },
    {
      "id": "notes-2531-12-body",
      "type": "text",
      "x": 86,
      "y": 3995.45,
      "width": 1232.7197265625,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
