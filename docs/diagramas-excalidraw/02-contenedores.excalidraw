      "boundElements": [],
      "updated": 1793307989747,
      "link": null,
      "locked": false,
      "text": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un ACK no certifica contabilización ERP, aceptación fiscal ni\nliquidación del pago.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. erp-worker obtiene el trabajo por HTTPS saliente y reporta resultados. Un ACK no certifica contabilización ERP, aceptación fiscal ni\nliquidación del pago.",
      "autoResize": true,
      "lineHeight": 1.25
    },
