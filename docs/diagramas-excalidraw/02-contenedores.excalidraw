      "isDeleted": false,
      "boundElements": [],
      "updated": 1792603450200,
      "link": null,
      "locked": false,
      "text": "No se sostiene SQL abierto esperando un proveedor. Un pago incierto se consulta o concilia con su\nidentidad original. El puente es condicional según SDK y transporta autorización emitida por backend;\nno incorpora otra base de ventas.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No se sostiene SQL abierto esperando un proveedor. Un pago incierto se consulta o concilia con su\nidentidad original. El puente es condicional según SDK y transporta autorización emitida por backend;\nno incorpora otra base de ventas.",
      "autoResize": true,
      "lineHeight": 1.25
    },
