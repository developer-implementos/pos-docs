    },
    {
      "id": "notes-2295-1-body",
      "type": "text",
      "x": 1311.4490234374978,
      "y": 2369.3,
      "width": 1136.072265625,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2295-1"
      ],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1307493989,
      "version": 2,
      "versionNonce": 1258270603,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788053759,
      "link": null,
      "locked": false,
      "text": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio;\nhardware, SDK y distribución requieren homologación. Su registro técnico de periféricos no lo convierte en autoridad\nde ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio;\nhardware, SDK y distribución requieren homologación. Su registro técnico de periféricos no lo convierte en autoridad\nde ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos dependientes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
