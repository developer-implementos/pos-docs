    },
    {
      "id": "notes-2351-7-body",
      "type": "text",
      "x": 3483.031103515624,
      "y": 2833.725678998418,
      "width": 1062.7138671875,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2351-7"
      ],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 2006648932,
      "version": 2,
      "versionNonce": 1690210532,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682522578,
      "link": null,
      "locked": false,
      "text": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en\nun único commit antes del ACK de aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS\nsaliente iniciado por ese worker. Sirve publicaciones preparadas por un publicador separado; no ejecuta la\nACL ni carga masiva pesada en un endpoint. La caché opcional acelera lecturas reconstruibles, con\nPostgreSQL como fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de\naplicación.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en\nun único commit antes del ACK de aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS\nsaliente iniciado por ese worker. Sirve publicaciones preparadas por un publicador separado; no ejecuta la\nACL ni carga masiva pesada en un endpoint. La caché opcional acelera lecturas reconstruibles, con\nPostgreSQL como fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de\naplicación.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización.",
      "autoResize": true,
      "lineHeight": 1.25
    },
