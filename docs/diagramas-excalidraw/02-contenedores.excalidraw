    {
      "id": "notes-2375-19-title",
      "type": "text",
      "x": 4841.783691406256,
      "y": 4387.85,
      "width": 261.21826171875,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2375-19"
      ],
      "frameId": null,
      "index": "b0N",
