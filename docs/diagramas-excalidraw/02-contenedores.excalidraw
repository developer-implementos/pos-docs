    },
    {
      "id": "notes-2295-7-body",
      "type": "text",
      "x": 3762.347070312493,
      "y": 2777.55,
      "width": 1152.72265625,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2295-7"
      ],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 1359011013,
      "version": 2,
      "versionNonce": 970877739,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792788053759,
      "link": null,
      "locked": false,
      "text": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único\ncommit antes del ACK de aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS saliente iniciado por\nese worker. Valida, publica y sirve versiones preparadas mediante MasterDataSourcePort en erp-worker; no ejecuta la\nACL ni carga masiva pesada en un endpoint. La caché opcional acelera lecturas reconstruibles, con PostgreSQL\ncomo fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación.\nConserva autoridad de versiones, manifiestos y publicación de maestros.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · NestJS + Fastify / Node.js\n\napps/country-api autentica el ámbito país/entidad/sucursal. Confirma inbox, proyección operativa y outbox en un único\ncommit antes del ACK de aplicación. Expone trabajo y resultados al erp-worker mediante HTTPS saliente iniciado por\nese worker. Valida, publica y sirve versiones preparadas mediante MasterDataSourcePort en erp-worker; no ejecuta la\nACL ni carga masiva pesada en un endpoint. La caché opcional acelera lecturas reconstruibles, con PostgreSQL\ncomo fuente durable.\n\nAUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos antes del ACK de aplicación.\nConserva autoridad de versiones, manifiestos y publicación de maestros.\n\nCONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera atraso de sincronización.",
      "autoResize": true,
      "lineHeight": 1.25
    },
