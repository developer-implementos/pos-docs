    {
      "id": "notes-2295-9-title",
      "type": "text",
      "x": 1311.4490234374978,
      "y": 3188.55,
      "width": 358.5205078125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
