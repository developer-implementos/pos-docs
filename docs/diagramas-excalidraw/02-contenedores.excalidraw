    {
      "id": "notes-2531-9-body",
      "type": "text",
      "x": 1946.63837890625,
      "y": 3504.7,
      "width": 1734.1220703125,
      "height": 220,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
