    {
      "id": "notes-2053-2-body",
      "type": "text",
      "x": 3105.5832031249993,
      "y": 2127.225678998418,
      "width": 1428.388671875,
      "height": 55,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
