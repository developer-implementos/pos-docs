    {
      "id": "notes-2505-9-title",
      "type": "text",
      "x": 1400.5198730468749,
      "y": 3398.55,
      "width": 358.5205078125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
