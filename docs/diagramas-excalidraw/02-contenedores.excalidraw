    {
      "id": "notes-2351-1-body",
      "type": "text",
      "x": 1218.3437011718747,
      "y": 2425.475678998418,
      "width": 1055.35546875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2351-1"
      ],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1462724836,
      "version": 2,
      "versionNonce": 926581092,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682522578,
      "link": null,
      "locked": false,
      "text": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio;\nhardware, SDK y distribución requieren homologación. Su registro técnico de periféricos no lo convierte en\nautoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos\ndependientes.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · Angular + Tauri\n\npos-desktop tiene arranque propio y comparte client-shell con pos-mobile. Tauri aloja el bundle de escritorio;\nhardware, SDK y distribución requieren homologación. Su registro técnico de periféricos no lo convierte en\nautoridad de ventas.\n\nAUTORIDAD · No posee otra base de ventas ni credenciales SQL.\n\nCONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen nuevos comandos\ndependientes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
