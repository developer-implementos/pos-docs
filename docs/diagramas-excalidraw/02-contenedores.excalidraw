    },
    {
      "id": "notes-2375-5-body",
      "type": "text",
      "x": 1671.261230468752,
      "y": 2967.8500000000004,
      "width": 1505.3994140625,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2375-5"
      ],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 1246675158,
      "version": 2,
      "versionNonce": 1788390678,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793364560279,
      "link": null,
      "locked": false,
      "text": "Contenedor · NestJS + Fastify / Node.js\n\napps/branch-api compone los contextos operativos: sales/returns, cash/collections, pricing/catalog, payments/devices, fiscal, reporting y administration.\nsync aporta el contrato outbox que se confirma con negocio. El transporte pertenece a branch-sync-worker y la ACL ERP a erp-worker. Bibliotecas no\nequivalen a microservicios; las capacidades de negocio aún requieren implementación. devices autoriza y conserva trabajos, auditoría y observaciones de\nperiféricos en PostgreSQL de sucursal. Recibe evidencia de device-agent por conexiones iniciadas por el agente; los clientes no actúan como relé.\nRegistrar o imprimir un trabajo conserva la referencia del documento y no modifica la confirmación de la venta.\n\nAUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos internos, un proceso.\n\nCONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del escritor autorizado.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · NestJS + Fastify / Node.js\n\napps/branch-api compone los contextos operativos: sales/returns, cash/collections, pricing/catalog, payments/devices, fiscal, reporting y administration.\nsync aporta el contrato outbox que se confirma con negocio. El transporte pertenece a branch-sync-worker y la ACL ERP a erp-worker. Bibliotecas no\nequivalen a microservicios; las capacidades de negocio aún requieren implementación. devices autoriza y conserva trabajos, auditoría y observaciones de\nperiféricos en PostgreSQL de sucursal. Recibe evidencia de device-agent por conexiones iniciadas por el agente; los clientes no actúan como relé.\nRegistrar o imprimir un trabajo conserva la referencia del documento y no modifica la confirmación de la venta.\n\nAUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos internos, un proceso.\n\nCONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del escritor autorizado.",
      "autoResize": true,
      "lineHeight": 1.25
    },
