    {
      "id": "notes-2351-6-body",
      "type": "text",
      "x": 2350.6874023437495,
      "y": 2833.725678998418,
      "width": 1049.2109375,
      "height": 330,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2351-6"
      ],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 477243100,
      "version": 2,
      "versionNonce": 111887964,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792682522578,
      "link": null,
      "locked": false,
      "text": "Contenedor · NestJS / Node.js · sin servidor HTTP\n\napps/branch-sync-worker compone libs/backend/sync con pricing/catalog para preparar y activar versiones.\nEntrega outbox por HTTPS con identidad y cursor; confirma acuses durables. El proceso supervisado sigue\nactivo aunque el cliente se cierre. Descarga, staging, validación y activación conservan límites\ntransaccionales.\n\nAUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de maestros, nunca venta\nlibremente.\n\nCONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita reintentos y trabajo en\ncurso.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contenedor · NestJS / Node.js · sin servidor HTTP\n\napps/branch-sync-worker compone libs/backend/sync con pricing/catalog para preparar y activar versiones.\nEntrega outbox por HTTPS con identidad y cursor; confirma acuses durables. El proceso supervisado sigue\nactivo aunque el cliente se cierre. Descarga, staging, validación y activación conservan límites\ntransaccionales.\n\nAUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de maestros, nunca venta\nlibremente.\n\nCONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita reintentos y trabajo en\ncurso.",
      "autoResize": true,
      "lineHeight": 1.25
    },
